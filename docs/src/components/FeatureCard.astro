---
interface Props { title: string; does?: string; how?: string; status?: 'built' | 'planned' }
const { title, does, how, status = 'built' } = Astro.props
---
<article class={`card ${status}`}>
  <h3>{title}</h3>
  {does && <p class="does">{does}</p>}
  {how && <p class="how">{how}</p>}
  <slot />
</article>

<style>
  .card {
    border-left-width: 4px;
    border-left-style: solid;
    border-left-color: var(--primary);
  }

  h3 { margin-top: 0; }
  .does { margin: 0 0 6px; font-weight: 500; }
  .how { margin: 0; color: var(--muted); font-size: 0.95rem; }
  article :global(p:last-child) { margin-bottom: 0; }

  .planned {
    background: none;
    border-style: dashed;
    border-left-style: solid;
    border-left-color: var(--muted);
    color: var(--muted);
  }

  .planned h3 { color: var(--text); }
</style>
