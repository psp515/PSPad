---
import Page from '../layouts/Page.astro'
import FeatureCard from '../components/FeatureCard.astro'

const features = [
  { title: 'One Today screen', body: 'Pick any day from a week strip — dots mark the days with something planned, swipe for the next week. Overdue first, then your starred tasks for when you have time, then what fits in any time, and what you finished. Tasks with a time sit on a vertical timeline beside them — even ones that run past midnight — in your own time zone.', status: 'built' },
  { title: 'One Inbox', body: 'Capture anything. Turn it into a finished task — list, due date, priority, goal, steps and a description — in one step later.', status: 'built' },
  { title: 'Areas and lists', body: 'Work, home, side projects — each with its own lists, in the order you choose. An area packs its lists into columns with no gaps under short ones. Deleting an area or a list takes what is in it along, after telling you how much.', status: 'built' },
  { title: 'Tasks and steps', body: 'Due dates, priorities, goals, and steps on every task.', status: 'built' },
  { title: 'Descriptions', body: 'Every task carries a Markdown description — notes, links, checklists — rendered on and offline.', status: 'built' },
  { title: 'Reference lists', body: 'Lists of things you look up rather than do — filament spools, links to documents, project folders. Each item has a Markdown description and labelled fields that show as links, copyable paths or quantities. They never land on Today.', status: 'built' },
  { title: 'Recurrence that never nags', body: 'Daily, weekly, monthly, yearly, or “every 3 weeks on Monday” — with an optional end date and a lead time that shows it coming weeks ahead. Miss a day, it just stays missed. Never overdue.', status: 'in-progress' },
  { title: 'Goals across areas', body: 'One goal, tasks from anywhere — shared lists included — pointed at it; goals stay private to you. A due date and a status: in progress, achieved or not achieved. Each goal has its own screen listing every task, with the list it came from and the day it was added, a weekly progress chart and — for dated goals — a pace gauge comparing time used with work done; achieved goals included.', status: 'in-progress' },
  { title: 'Statistics that don’t lie', body: 'Tiles, four charts, a heatmap of the days you finished things — tap any day for its count — and a record feed, all built from what actually happened, so a deleted task can’t rewrite the past. One chart counts what you captured into the Inbox each week.', status: 'built' },
  { title: 'Budgets', body: 'Keep as many budgets as you like, each with its own expense and income categories, added as you type. Record expenses and incomes in PLN or 28 other currencies: the rate to PLN is frozen on the day you enter it, typed by hand or filled in from NBP when you ask. An Overview of the month against your usual spending with what’s worth a look, entries for any month with search and a category filter, a monthly balance of your cash, savings and investments next to their value at today’s NBP rate, and Stats with per-month averages, a next-month forecast from your last six months and charts over any range. Budgets are archived, never deleted, and work offline — only the NBP lookups need a connection.', status: 'built' },
  { title: 'Works with no signal', body: 'Opens and works offline with your data, syncing once you’re back online. A device untouched for more than 7 days asks you to sign in again. Signing out needs a connection: it ends your session at the sign-in server and wipes this device, and warns you first about changes that haven’t synced yet. A new version announces itself and reloads when you say so.', status: 'in-progress' },
  { title: 'Refresh on demand', body: 'Every screen says when it was last updated — even offline. On your phone pull down to refresh; on a computer use the refresh button next to the title, or Sync now in Settings.', status: 'built' },
  { title: 'Share a budget', body: 'Keep one budget with your household. Invite with the same 30-minute link and 6-character code as a list; whoever joins records expenses and incomes, keeps the monthly balance and edits categories with you, offline too. Only you rename, archive or invite. Each person keeps their own default currency. Money never goes on a public link.', status: 'built' },
  { title: 'Import from a spreadsheet', body: 'Bring your budget history from Excel: save expenses, incomes and monthly balances as two CSV files, comma or semicolon, Polish characters included. A preview shows every row before anything is written — errors with their line, entries already in the budget, new categories, and foreign amounts without a rate. Those rates are fetched from NBP, which needs a connection; the rest works offline. Each file has its own card in the budget’s settings, with its template and a page to drop the file on.', status: 'built' },
  { title: 'Share a list', body: 'Create an invite — a link or QR code with a 6-character code built in. It works for 30 minutes; anyone who opens it in time works on the list with you, offline too — their edits sync, their Today picks up its tasks. Five wrong codes close the invite. People who joined stay until they leave or you remove them; inviting, removing and leaving need a connection so they take effect at once.', status: 'built' },
  { title: 'Public snapshots', body: 'Publish a frozen, read-only link to a list for anyone — no account needed — until an expiry you pick: a day, a week, a month or a date. They tick a task, step or item off — up to 100 changes a day per list — and you see it as a mark on your own copy, never a completion. Each live link has a QR code and shows how many entries visitors ticked. Every snapshot you open yourself shows up under List snapshots.', status: 'built' },
  { title: 'Yours, and multi-user', body: 'Your hardware, your Keycloak, your data.', status: 'built' },
  { title: 'Settings, in one place', body: 'Time zone, light or dark theme, an accent colour from presets or your own picked colour, sync status, a password change through the Keycloak account console, and account deletion, which asks you to sign in again when your last sign-in is more than five minutes old — no longer buried in a menu.', status: 'built' },
  { title: 'Speaks your language', body: 'English and Polish, chosen once in Settings and followed on every device, offline included. Dates, numbers, money amounts and the week start follow the language; the sign-in page stays in Keycloak’s language. Adding a language is one resource file per feature plus one list entry.', status: 'built' },
  { title: 'Made for your phone', body: 'On a phone, a bottom bar puts Inbox, Areas, My Day, Goals and Budgets one tap away, My Day in the middle. Areas switch with a row of chips, and your account sits behind the avatar, with Statistics in its drawer.', status: 'built' }
]

const built = features.filter((feature) => feature.status === 'built')
const inProgress = features.filter((feature) => feature.status === 'in-progress')

const planned = [
  ['Habits', 'Streaks for daily habits.'],
  ['Annual plans', 'Yearly goals, year-end summary.'],
  ['Reminders', 'Push notifications, daily motivation.'],
  ['GitHub issues', 'GitHub issues as tasks.'],
  ['Cloud storage', 'OneDrive and Google Drive.'],
  ['3D printing', 'Materials, parts, Thingiverse links.'],
  ['Checklists', 'Reusable checklists.']
]
---
<Page
  title="PSPad features"
  description="What PSPad does today: one Today screen across every area, one Inbox, recurrence that never goes overdue, statistics built from the event log, budgets in 29 currencies, and full offline use."
>
  <div class="wrap">
    <div class="prose">
      <h1>Features</h1>
      <p>My own take on GTD, not a certified method.</p>
    </div>

    <div class="grid">
      {built.map((feature) => (
        <FeatureCard title={feature.title} status={feature.status}><p>{feature.body}</p></FeatureCard>
      ))}
    </div>

    <div class="prose">
      <h2>Adding a language</h2>
      <ol>
        <li>Add the language tag to <code>SupportedLanguages.All</code>.</li>
        <li>Copy each <code>src/PSPad.App/Resources/&lt;Feature&gt;Strings.resx</code> to <code>&lt;Feature&gt;Strings.&lt;tag&gt;.resx</code> and translate every value as a whole sentence.</li>
        <li>Add plural forms to <code>PluralRules</code> if the language is not One/Many.</li>
        <li>Add seed area names to <code>ProvisioningPlan</code>.</li>
        <li>Add the native name in <code>SettingsPage</code>.</li>
        <li>Run the unit tests; <code>ResourceGuardTests</code> reports any missing key.</li>
      </ol>
    </div>

    <div class="prose">
      <h2>In progress</h2>
    </div>

    <div class="grid">
      {inProgress.map((feature) => (
        <FeatureCard title={feature.title} status={feature.status}><p>{feature.body}</p></FeatureCard>
      ))}
    </div>

    <div class="prose">
      <h2>Planned</h2>
    </div>

    <div class="grid">
      {planned.map(([title, body]) => (
        <FeatureCard title={title} status="planned"><p>{body}</p></FeatureCard>
      ))}
    </div>
  </div>
</Page>

<style>
  .grid { margin: 32px 0; }
</style>
