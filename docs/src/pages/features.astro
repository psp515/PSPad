---
import Page from '../layouts/Page.astro'
import FeatureCard from '../components/FeatureCard.astro'
import { features, planned } from '../data/features'

const built = features.filter((item) => item.status === 'built')
---
<Page
  title="PSPad features"
  description="What PSPad does, one feature at a time: My Day, Inbox, areas and lists, repeats that are never overdue, budgets in 29 currencies, sharing, and full offline use."
>
  <div class="wrap">
    <div class="prose">
      <h1>Features</h1>
      <p>What is built and what each part does. My own take on GTD, not a certified method.</p>
    </div>

    <div class="grid">
      {built.map((item) => <FeatureCard title={item.title} does={item.does} how={item.how} />)}
    </div>

    <div class="prose">
      <h2>Planned</h2>
    </div>

    <div class="grid">
      {planned.map((item) => <FeatureCard title={item.title} status="planned"><p>{item.body}</p></FeatureCard>)}
    </div>
  </div>
</Page>

<style>
  .grid { margin: 32px 0; }
</style>
