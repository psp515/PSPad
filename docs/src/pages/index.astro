---
import Page from '../layouts/Page.astro'
import Hero from '../components/Hero.astro'
import FeatureCard from '../components/FeatureCard.astro'
import { join } from '../lib/repo'

const base = import.meta.env.BASE_URL

const proof = [
  { title: 'One Today screen', body: 'What’s due, overdue first, in your own time zone.' },
  { title: 'One Inbox', body: 'Capture anything. Decide where it goes later.' },
  { title: 'Areas and lists', body: 'Work, home, side projects — each with its own lists.' },
  { title: 'Tasks and steps', body: 'Due dates, priorities, goals, and steps on every task.' },
  { title: 'Statistics', body: 'Charts, a consistency heatmap, an Inbox-backlog heatmap and a record feed that show what actually got done.' },
  { title: 'Yours, and multi-user', body: 'Your hardware, your Keycloak, your data.' }
]
---
<Page
  title="PSPad — a self-hosted GTD notepad"
  description="PSPad is a self-hosted GTD notepad with one Today screen across every area, one Inbox, recurrence that never goes overdue, and full offline use on your phone."
  heroNav
>
  <Hero />

  <div class="wrap" id="more">
    <div class="grid">
      {proof.map((item) => <FeatureCard title={item.title}><p>{item.body}</p></FeatureCard>)}
      <a class="card see-all" href={join(base, 'features')}>
        <h3>See all features →</h3>
        <p>What's built, what's in progress, what's still planned.</p>
      </a>
    </div>

    <div class="prose steps">
      <h2>How it goes</h2>
      <ol>
        <li><strong>Capture.</strong> Anything, into the Inbox, without deciding where it belongs.</li>
        <li><strong>Organize.</strong> Give it a list, a date, a goal — once, on purpose.</li>
        <li><strong>Today.</strong> Open the app and do what is there.</li>
      </ol>
    </div>

    <div class="call">
      <h2>Run it yourself</h2>
      <p>One Compose file, four containers, about ten minutes.</p>
      <p><a class="button button-primary" href={join(base, 'install')}>Install PSPad</a></p>
    </div>
  </div>
</Page>

<style>
  .grid { margin: 32px 0 48px; }

  .see-all {
    display: block;
    text-decoration: none;
    color: inherit;
    border-color: var(--primary);
  }

  .see-all h3 { margin-top: 0; color: var(--primary); }
  .see-all p { margin-bottom: 0; color: var(--muted); }

  .steps ol { padding-left: 1.2em; }
  .steps li { margin-bottom: 8px; }

  .call {
    margin-top: 64px;
    padding: 40px 24px;
    border-radius: var(--radius);
    background: var(--raised);
    border: 1px solid var(--lines);
    text-align: center;
  }

  .call h2 { margin-top: 0; }
</style>
