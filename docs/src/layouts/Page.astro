---
import Mark from '../components/Mark.astro'
import { join } from '../lib/repo'
import '../styles/theme.css'

interface Props { title: string; description: string; heroNav?: boolean }
const { title, description, heroNav = false } = Astro.props
const base = import.meta.env.BASE_URL
const nav = [
  { href: join(base, 'features'), label: 'Features' },
  { href: join(base, 'install'), label: 'Install' },
  { href: 'https://github.com/psp515/PSPad', label: 'GitHub' }
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(join(base, 'og.png'), Astro.site)} />
    <link rel="icon" href={join(base, 'favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('pspad-theme')
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class:list={['site-header', { 'site-header-hero': heroNav }]}>
      <div class="wrap header-inner">
        <a class="brand" href={base}>
          <Mark size={28} />
          <span>PSPad</span>
        </a>
        <nav>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <button type="button" class="theme-toggle" aria-label="Toggle light and dark theme">
            <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="wrap site-footer">
      <p>My own take on GTD. See <a href={join(base, 'features')}>what's built</a>.</p>
      <p>Free software, GPL v3. <a href="https://github.com/psp515/PSPad">Source on GitHub</a>.</p>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement
        const toggle = document.querySelector('.theme-toggle')
        if (!toggle) return

        const isDark = () => root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches

        const sync = () => toggle.classList.toggle('is-dark', isDark())
        sync()

        toggle.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark'
          root.dataset.theme = next
          localStorage.setItem('pspad-theme', next)
          sync()
        })
      })()
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--background);
    border-bottom: 1px solid var(--lines);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
    flex-wrap: wrap;
  }

  @supports (animation-timeline: scroll()) {
    .site-header-hero {
      opacity: 0;
      transform: translateY(-12px);
      border-bottom-color: transparent;
      pointer-events: none;
      animation: reveal-nav linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 200px;
    }
  }

  @keyframes reveal-nav {
    to {
      opacity: 1;
      transform: translateY(0);
      border-bottom-color: var(--lines);
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-hero {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      pointer-events: auto !important;
      border-bottom-color: var(--lines) !important;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
  }

  nav { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  nav a { text-decoration: none; font-weight: 500; }
  nav a:hover { text-decoration: underline; }

  .theme-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    padding: 0;
    border: 1px solid var(--lines);
    border-radius: 50%;
    background: transparent;
    appearance: none;
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle:hover { border-color: var(--primary); color: var(--primary); }

  .theme-toggle .icon-moon { display: none; }
  .theme-toggle.is-dark .icon-sun { display: none; }
  .theme-toggle.is-dark .icon-moon { display: block; }

  .site-footer {
    margin-top: 80px;
    padding: 24px 24px 48px;
    border-top: 1px solid var(--lines);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
