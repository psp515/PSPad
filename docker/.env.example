# Password for the pspad MongoDB root user. Compose builds the API's connection string from it. Change it before the stack is reachable from anywhere but localhost.
MONGO_PASSWORD=pspad
# Name of the MongoDB database PSPad stores its documents in.
MONGO_DATABASE=pspad
# Realm URL as the browser reaches it. The WebAssembly client is redirected here to sign in.
KEYCLOAK_AUTHORITY=http://localhost:8080/realms/psplace
# Realm URL as the API container reaches it. Differs from KEYCLOAK_AUTHORITY only because the browser and the API reach Keycloak by different names; set it to the same value as KEYCLOAK_AUTHORITY when Keycloak is not part of this stack.
KEYCLOAK_INTERNAL_AUTHORITY=http://keycloak:8080/realms/psplace
# Audience the API requires on incoming access tokens. Matches the pspad-backend client in the realm.
KEYCLOAK_AUDIENCE=pspad-backend
# Public client the browser authenticates as. Matches the pspad-frontend client in the realm.
KEYCLOAK_CLIENT_ID=pspad-frontend
# Keycloak administrator created on the very first start only — Keycloak itself ignores later changes. The api container also reads this at runtime to call Keycloak's admin API for account deletion, so keep it in sync with whatever admin username the Keycloak console actually has.
KEYCLOAK_ADMIN_USER=admin
# Password for that administrator. Keycloak applies it on the very first start only, but the api container reads it at runtime to delete Keycloak users on account deletion — rotate the password in the Keycloak console and forget to update this, and account deletion silently stops removing the Keycloak login.
KEYCLOAK_ADMIN_PASSWORD=admin
# Public URL Keycloak builds its own links against. Must be the URL a browser uses, including the scheme.
KEYCLOAK_HOSTNAME=http://localhost:8080
# API URL as the browser reaches it. Substituted into the client's appsettings.json when its container starts.
API_BASE_ADDRESS=http://localhost:5000
# Client URL as the browser reaches it. Drives the OIDC redirect URIs and the API's allowed CORS origin.
APP_BASE_ADDRESS=http://localhost:5001
# Address range (CIDR) of the reverse proxy or Cloudflare Tunnel connector that reaches the API, e.g. the subnet of the pspad_pspad Docker network. Only requests arriving from inside it may name the visitor's address, so public snapshot links are rate-limited per visitor. Leave empty when nothing sits in front of the API: forwarded headers are then ignored.
API_TRUSTED_PROXY_NETWORK=
# Header the trusted proxy puts the visitor's address in, read only on requests from API_TRUSTED_PROXY_NETWORK. CF-Connecting-IP only behind a Cloudflare Tunnel (cloudflared), where the tunnel is the origin's only way in. Everywhere else, the orange-cloud proxy in front of your own nginx or Caddy included, keep X-Forwarded-For with the host proxy appending the caller (nginx: $proxy_add_x_forwarded_for): nothing overwrites CF-Connecting-IP after Cloudflare, so anyone reaching the origin directly could forge it.
API_CLIENT_IP_HEADER=X-Forwarded-For
