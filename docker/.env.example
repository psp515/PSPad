# Password for the pspad MongoDB root user. Compose builds the API's connection string from it. Change it before the stack is reachable from anywhere but localhost.
MONGO_PASSWORD=pspad
# Name of the MongoDB database PSPad stores its documents in.
MONGO_DATABASE=pspad
# Realm URL as the browser reaches it. The WebAssembly client is redirected here to sign in.
KEYCLOAK_AUTHORITY=http://localhost:8080/realms/psplace
# Realm URL as the API container reaches it, over the shared psplace network the Keycloak stack (docker/keycloak/compose.yaml) creates. Differs from KEYCLOAK_AUTHORITY only because the browser and the API reach Keycloak by different names; set it to the same value as KEYCLOAK_AUTHORITY when Keycloak runs somewhere else.
KEYCLOAK_INTERNAL_AUTHORITY=http://keycloak:8080/realms/psplace
# Audience the API requires on incoming access tokens. Matches the pspad-backend client in the realm.
KEYCLOAK_AUDIENCE=pspad-backend
# Public client the browser authenticates as. Matches the pspad-frontend client in the realm.
KEYCLOAK_CLIENT_ID=pspad-frontend
# Keycloak administrator the api container uses to call Keycloak's admin API for account deletion. Must equal KEYCLOAK_ADMIN_USER in docker/keycloak/.env, or whatever admin username the Keycloak console actually has.
KEYCLOAK_ADMIN_USER=admin
# Password for that administrator. Must equal KEYCLOAK_ADMIN_PASSWORD in docker/keycloak/.env — rotate the password in the Keycloak console and forget to update this, and account deletion silently stops removing the Keycloak login.
KEYCLOAK_ADMIN_PASSWORD=admin
# API URL as the browser reaches it. Substituted into the client's appsettings.json when its container starts.
API_BASE_ADDRESS=http://localhost:5000
# Client URL as the browser reaches it. Drives the OIDC redirect URIs and the API's allowed CORS origin.
APP_BASE_ADDRESS=http://localhost:5001
# true once the API is reached only through your reverse proxy: the API then takes the visitor's address from X-Forwarded-For, so the per-visitor rate limit on public snapshot links works. Leave false while port 5000 is open directly, or anyone could fake that header to dodge the limit.
API_BEHIND_PROXY=false

# --- Backups: the mongo-backup service, started with --profile backup (specs/backup-design.md) ---
# Daily run time, HH:mm, in BACKUP_TZ. Keep it before the Keycloak stack's BACKUP_AT, so a same-night pair never has accounts older than data.
BACKUP_AT=03:17
# IANA time zone BACKUP_AT is read in.
BACKUP_TZ=UTC
# Days of backups kept at every destination. Older ones are deleted after each successful run, never after a failed one.
BACKUP_KEEP_DAYS=14
# Host directory to keep local backups in instead of the mongo-backups volume. It must be writable by uid 10001.
BACKUP_LOCAL_DIR=
# age public key (age1…) every off-host copy is encrypted to. Required as soon as S3 or Google Drive is set; the backup container refuses to start without it. Keep the private key off this server.
BACKUP_AGE_RECIPIENT=
# Host path to the age private key. Only needed while restoring from S3 or Google Drive; leave blank otherwise.
BACKUP_AGE_IDENTITY_FILE=
# S3-compatible endpoint URL (AWS, Backblaze B2, Cloudflare R2, MinIO). Uploading to S3 is on once BACKUP_S3_BUCKET is set.
BACKUP_S3_ENDPOINT=
# Region of the bucket; any value for stores that ignore it.
BACKUP_S3_REGION=
# Bucket to upload to. Turn on versioning or object lock there, so a leaked key cannot erase your history.
BACKUP_S3_BUCKET=
# Folder inside the bucket; each stack writes below <prefix>/<stack>/.
BACKUP_S3_PREFIX=pspad
# Access key for the bucket. Needs list, read and write, plus delete unless BACKUP_REMOTE_PRUNE=false.
BACKUP_S3_ACCESS_KEY_ID=
# Secret for that access key.
BACKUP_S3_SECRET_ACCESS_KEY=
# Your own Google OAuth client of type "TVs and Limited Input devices" (Google Cloud console → Credentials). Required for Google Drive. Publish its consent screen to "In production": a client left in Testing issues tokens that expire after 7 days.
BACKUP_GDRIVE_CLIENT_ID=
# Secret of that OAuth client.
BACKUP_GDRIVE_CLIENT_SECRET=
# Refresh token printed by `docker compose run --rm mongo-backup gdrive-login`. Uploading to Drive is on once this is set.
BACKUP_GDRIVE_REFRESH_TOKEN=
# Name of the folder created in your My Drive for backups; each stack writes into a subfolder of it.
BACKUP_GDRIVE_FOLDER=pspad-backups
# false when the S3 key may not delete; retention then belongs to a bucket lifecycle rule.
BACKUP_REMOTE_PRUNE=true
# URL called after every run, with /fail appended when it failed (healthchecks.io style). Blank to skip.
BACKUP_PING_URL=
