#!/usr/bin/env bash
set -euo pipefail

source /usr/local/lib/backup/common.sh
source "/usr/local/lib/backup/${BACKUP_STACK:?BACKUP_STACK is not set}.sh"

command=${1:-run}
shift || true

case $command in
  run) validate && require_recipient && start_clock && schedule ;;
  check) validate && require_recipient && render_crontab ;;
  now) validate && require_recipient && run_backup ;;
  list) validate && list_backups ;;
  restore) validate && restore_backup "$@" ;;
  healthcheck) healthcheck ;;
  start-clock) start_clock ;;
  *) fail "unknown command '$command' (run, check, now, list, restore, healthcheck)" ;;
esac
