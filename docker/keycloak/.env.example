# Password for Keycloak's Postgres database. Required; set it before the first start, since Postgres only applies it when the volume is created.
KEYCLOAK_DB_PASSWORD=
# Keycloak administrator created on the very first start only — Keycloak itself ignores later changes. docker/.env carries the same value for the API's account deletion; keep the two equal.
KEYCLOAK_ADMIN_USER=admin
# Password for that administrator. Keycloak applies it on the very first start only; docker/.env carries the same value, keep the two equal.
KEYCLOAK_ADMIN_PASSWORD=admin
# Public URL Keycloak builds its own links against. Must be the URL a browser uses, including the scheme.
KEYCLOAK_HOSTNAME=http://localhost:8080
# API URL as the browser reaches it. Same value as in docker/.env.
API_BASE_ADDRESS=http://localhost:5000
# Client URL as the browser reaches it. Same value as in docker/.env.
APP_BASE_ADDRESS=http://localhost:5001

# --- Backups: the keycloak-backup service, started with --profile backup (specs/backup-design.md) ---
# Daily run time, HH:mm, in BACKUP_TZ. Keep it after the PSPad stack's BACKUP_AT, so a same-night pair never has accounts older than data.
BACKUP_AT=03:47
# IANA time zone BACKUP_AT is read in.
BACKUP_TZ=UTC
# Days of backups kept at every destination. Older ones are deleted after each successful run, never after a failed one.
BACKUP_KEEP_DAYS=14
# Host directory to keep local backups in instead of the keycloak-backups volume. It must be writable by uid 10001.
BACKUP_LOCAL_DIR=
# age public key (age1…) every off-host copy is encrypted to. Required as soon as S3 or Google Drive is set. The same key as the PSPad stack is fine.
BACKUP_AGE_RECIPIENT=
# Host path to the age private key. Only needed while restoring from S3 or Google Drive.
BACKUP_AGE_IDENTITY_FILE=
# S3-compatible endpoint URL. Uploading to S3 is on once BACKUP_S3_BUCKET is set.
BACKUP_S3_ENDPOINT=
# Region of the bucket; any value for stores that ignore it.
BACKUP_S3_REGION=
# Bucket to upload to; it may be the PSPad stack's, each stack writes below its own folder.
BACKUP_S3_BUCKET=
# Folder inside the bucket; this stack writes below <prefix>/keycloak/.
BACKUP_S3_PREFIX=pspad
# Access key for the bucket. Needs list, read and write, plus delete unless BACKUP_REMOTE_PRUNE=false.
BACKUP_S3_ACCESS_KEY_ID=
# Secret for that access key.
BACKUP_S3_SECRET_ACCESS_KEY=
# Your own Google OAuth client of type "TVs and Limited Input devices" (Google Cloud console → Credentials). Required for Google Drive. Publish its consent screen to "In production": a client left in Testing issues tokens that expire after 7 days.
BACKUP_GDRIVE_CLIENT_ID=
# Secret of that OAuth client.
BACKUP_GDRIVE_CLIENT_SECRET=
# Refresh token printed by `docker compose run --rm keycloak-backup gdrive-login`. Uploading to Drive is on once this is set.
BACKUP_GDRIVE_REFRESH_TOKEN=
# Name of the folder created in your My Drive for backups; each stack writes into a subfolder of it.
BACKUP_GDRIVE_FOLDER=pspad-backups
# false when the S3 key may not delete; retention then belongs to a bucket lifecycle rule.
BACKUP_REMOTE_PRUNE=true
# URL called after every run, with /fail appended when it failed. Blank to skip.
BACKUP_PING_URL=
