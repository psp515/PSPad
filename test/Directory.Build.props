<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <!-- xUnit v2 only discovers [CollectionDefinition] within the test assembly itself, so this
         file must be compiled into every test project that uses it, not merely referenced. -->
    <Compile Include="$(MSBuildThisFileDirectory)PSPad.TestInfrastructure\PostgresCollection.cs" Link="PostgresCollection.cs" />
  </ItemGroup>

</Project>
