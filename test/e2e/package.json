{
  "name": "pspad-e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "stack:up": "docker compose -f ../../docker/compose.yaml -f ../../docker/compose.e2e.yaml --env-file ../../docker/.env.example -p pspad-e2e up -d --build --wait",
    "stack:down": "docker compose -f ../../docker/compose.yaml -f ../../docker/compose.e2e.yaml --env-file ../../docker/.env.example -p pspad-e2e down -v"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
