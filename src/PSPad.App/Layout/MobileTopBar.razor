@using PSPad.App.Components
@using PSPad.App.State
@inject PageHeader Header
@inject IStringLocalizer<SharedStrings> S
@implements IDisposable

<MudAppBar Elevation="0" Gutters="false" Class="d-md-none pspad-top-bar">
    @if (Header.BackHref is not null)
    {
        <MudIconButton Class="pspad-top-back" Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary"
                       Href="@Header.BackHref" aria-label="@(Header.BackLabel ?? S["Back"].Value)" />
    }
    @if (Header.Icon is { } icon)
    {
        <PageIcon Icon="@icon" />
    }
    <div class="pspad-top-title">
        <MudText Typo="Typo.h6" Class="pspad-top-heading pspad-ellipsis"
                 aria-describedby="@(Header.Subtitle is { Length: > 0 } ? SubtitleId : null)">@Header.Title</MudText>
        @if (Header.Subtitle is { Length: > 0 } subtitle)
        {
            <MudText Typo="Typo.caption" Class="pspad-top-subtitle pspad-ellipsis pspad-muted" id="@SubtitleId">@subtitle</MudText>
        }
    </div>
    <MudSpacer />
    <ConnectionStatus />
    <SyncButton WithStamp="true" />
    @Header.Actions
    <MudIconButton Class="pspad-avatar-button" OnClick="@OnAvatar" aria-label="@S["Account"].Value">
        <MudAvatar Style="@($"width:36px;height:36px;background:{AvatarColor.For(UserId)};color:#FFFFFF")">
            @AvatarColor.InitialOf(DisplayName.Length > 0 ? DisplayName : Email)
        </MudAvatar>
    </MudIconButton>
</MudAppBar>

@code {
    const string SubtitleId = "top-bar-subtitle";

    [Parameter] public string Email { get; set; } = "";

    [Parameter] public string DisplayName { get; set; } = "";

    [Parameter] public Guid UserId { get; set; }

    [Parameter] public EventCallback OnAvatar { get; set; }

    protected override void OnInitialized() => Header.Changed += OnHeaderChanged;

    void OnHeaderChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Header.Changed -= OnHeaderChanged;
}
