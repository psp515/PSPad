@using System.Globalization
@using PSPad.Abstractions
@using PSPad.App.Sync
@inject ISyncStatus Status
@inject IConnectivity Connectivity
@inject IClock Clock
@implements IDisposable

<MudText Typo="Typo.caption" Class="pspad-sync-stamp pspad-muted" Color="@Tone"
         title="@Exact">
    @Text
</MudText>

@code {
    static readonly TimeSpan Tick = TimeSpan.FromSeconds(30);

    Timer? _timer;

    bool Offline => !Connectivity.IsOnline;

    bool Failed => Status.LastSyncFailed && !Offline && !Status.IsSyncing;

    Color Tone => Failed ? Color.Error : Offline ? Color.Warning : Color.Default;

    string? Exact => Status.LastSyncedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    string Text
    {
        get
        {
            if (Status.IsSyncing)
            {
                return "Updating…";
            }

            if (Status.LastSyncedAt is not { } at)
            {
                return Failed ? "Couldn't update" : Offline ? "Offline" : "Not synced yet";
            }

            var ago = RelativeTime.Describe(at, Clock.UtcNow);
            return Failed ? $"Couldn't update · updated {ago}"
                : Offline ? $"Offline · updated {ago}"
                : $"Updated {ago}";
        }
    }

    protected override void OnInitialized()
    {
        Status.Changed += OnChanged;
        Connectivity.Changed += OnChanged;
        _timer = new Timer(_ => OnChanged(), null, Tick, Tick);
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        Connectivity.Changed -= OnChanged;
        _timer?.Dispose();
    }
}
