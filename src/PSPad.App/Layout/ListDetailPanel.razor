@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.App.Api
@using PSPad.App.Sync
@using PSPad.Module.Presentation.ListViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.References
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<Area> Areas
@inject IDocumentStore<TaskList> Lists
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<ReferenceItem> ItemStore
@inject IDocumentStore<ListView> ListViews
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IClock Clock
@inject ISnapshotsApi SnapshotsApi
@inject IConnectivity Connectivity

<DetailPanel Open="@(IsNew || _list is not null)" Title="@Title" TitleTypo="Typo.body2" OnClose="@OnClose" OnBack="@BackCallback"
             OnSave="@SaveCallback" SaveText="Add list" CanSave="@(!string.IsNullOrWhiteSpace(_draftName))"
             OnDelete="@DeleteCallback" DeleteText="Delete list" Disabled="@Disabled">
    @if (EffectiveView == ListPanelView.Details)
    {
        <div class="px-2 pt-3 pb-1">
            <MudTextField T="string" Class="pspad-list-name-field flex-grow-1 px-2" Value="@(_list?.Name ?? _draftName)"
                          ValueChanged="@NameChangedAsync" Placeholder="List name" Typo="Typo.h6" Underline="false"
                          Immediate="@IsNew" AutoFocus="@IsNew" Disabled="@(Disabled || !IsMine)"
                          OnKeyDown="@AddOnEnterAsync" />
        </div>

        <MudDivider />
    }

    <div class="pa-4 d-flex flex-column gap-3">
        @if (_list is null)
        {
            <MudToggleGroup T="ListKind" @bind-Value="_kind" Class="pspad-list-kind" Color="Color.Primary"
                            Outlined="true" Disabled="@Disabled">
                <MudToggleItem Value="ListKind.Tasks" Text="Tasks" />
                <MudToggleItem Value="ListKind.Reference" Text="Reference" />
            </MudToggleGroup>
        }
        else
        {
            @switch (EffectiveView)
            {
                case ListPanelView.Members:
                    <ListSharingSection List="@_list" IsMine="@IsMine" Disabled="@Disabled" />
                    break;
                case ListPanelView.Snapshots when IsMine:
                    <SnapshotPublisher List="@_list" Disabled="@Disabled" />
                    break;
                default:
                    <div class="pspad-list-kind-readonly d-flex align-center gap-2">
                        <MudIcon Icon="@ListIcon.For(_list)" Size="Size.Small" Class="pspad-muted" />
                        <MudText Typo="Typo.body2">@ListIcon.LabelFor(_list)</MudText>
                    </div>

                    @if (IsMine)
                    {
                        <MudSelect T="Guid" Class="pspad-list-area" Label="Area" Variant="Variant.Outlined"
                                   Value="@_list.AreaId" ValueChanged="@AreaChangedAsync" Disabled="@Disabled"
                                   ToStringFunc="@AreaName" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var area in _areas)
                            {
                                <MudSelectItem T="Guid" Value="@area.Id">@area.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudSelect T="Guid?" Class="pspad-list-filed-area" Label="File under" Variant="Variant.Outlined"
                                   Value="@_filedAreaId" ValueChanged="@FileUnderAsync" Disabled="@Disabled"
                                   ToStringFunc="@FiledAreaName" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@SharedWithMe.Name</MudSelectItem>
                            @foreach (var area in _areas)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)area.Id)">@area.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudPaper Outlined="true">
                        <MudList T="string" Dense="false">
                            <MudListItem T="string" Class="pspad-list-members-link"
                                         Icon="@Icons.Material.Outlined.Group" IconColor="Color.Primary"
                                         Text="Members" SecondaryText="@MembersSummary"
                                         OnClick="@(() => Go(ListPanelView.Members))" />
                            @if (IsMine)
                            {
                                <MudDivider />
                                <MudListItem T="string" Class="pspad-list-snapshots-link"
                                             Icon="@Icons.Material.Outlined.Public" IconColor="Color.Primary"
                                             Text="Public snapshots" SecondaryText="@_snapshotsSummary"
                                             OnClick="@(() => Go(ListPanelView.Snapshots))" />
                            }
                        </MudList>
                    </MudPaper>
                    break;
            }
        }
    </div>
</DetailPanel>

@code {
    [Parameter] public Guid? NewInArea { get; set; }

    [Parameter] public Guid? ListId { get; set; }

    [Parameter] public ListPanelView View { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    TaskList? _list;
    IReadOnlyList<Area> _areas = [];
    string _draftName = "";
    string _areaName = "";
    ListKind _kind = ListKind.Tasks;
    Guid? _filedAreaId;

    bool IsNew => NewInArea is not null;

    bool IsMine => _list is null || _list.UserId == State.UserId;

    string Title => EffectiveView switch
    {
        ListPanelView.Members => "Members",
        ListPanelView.Snapshots => "Public snapshots",
        _ => (_list is null ? "New list" : "List") + (_areaName.Length == 0 ? "" : $" · {_areaName}")
    };

    string _snapshotsSummary = "";
    Guid? _summaryListId;

    ListPanelView EffectiveView => View == ListPanelView.Snapshots && !IsMine ? ListPanelView.Details : View;

    EventCallback BackCallback => _list is not null && EffectiveView != ListPanelView.Details
        ? EventCallback.Factory.Create(this, () => Navigation.NavigateTo(ListQuery.For(Navigation.Uri, _list.Id, ListPanelView.Details)))
        : default;

    string MembersSummary => _list is null ? "" : (_list.Members.Count, IsMine, _list.IsInviteLiveAt(Clock.UtcNow)) switch
    {
        (0, true, false) => "Only you",
        (var count, true, true) => $"{Joined(count)} · link {MinutesLeft} min left",
        (var count, _, _) => Joined(count)
    };

    static string Joined(int count) => count switch { 0 => "Nobody joined yet", 1 => "1 joined", _ => $"{count} joined" };

    int MinutesLeft => (int)Math.Ceiling((_list!.InviteExpiresAt!.Value - Clock.UtcNow).TotalMinutes);

    void Go(ListPanelView view) => Navigation.NavigateTo(ListQuery.For(Navigation.Uri, _list!.Id, view));

    EventCallback SaveCallback => IsNew ? EventCallback.Factory.Create(this, CreateAsync) : default;

    EventCallback DeleteCallback => _list is not null && IsMine && EffectiveView == ListPanelView.Details ? EventCallback.Factory.Create(this, DeleteAsync) : default;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNew)
        {
            _draftName = "";
            _kind = ListKind.Tasks;
        }

        var list = ListId is null || IsNew ? null : await Lists.LoadAsync(ListId.Value, CancellationToken.None);
        _list = list is { Deleted: false } && (list.UserId == State.UserId || list.HasMember(State.UserId))
            ? list
            : null;

        if (!IsNew && _list is null)
        {
            return;
        }

        var areas = await Areas.LoadAllAsync(State.UserId, CancellationToken.None);
        _areas = [.. areas.Where(area => !area.Deleted).OrderBy(area => area.Position)];
        _areaName = IsMine ? AreaName(_list?.AreaId ?? NewInArea!.Value) : "";

        if (_list is not null && !IsMine)
        {
            var view = await ListViews.LoadAsync(ListView.IdFor(State.UserId, _list.Id), CancellationToken.None);
            _filedAreaId = view?.AreaId;
        }

        if (_list is not null && IsMine && EffectiveView == ListPanelView.Details && _summaryListId != _list.Id)
        {
            _summaryListId = _list.Id;
            _snapshotsSummary = "";
            _ = RefreshSnapshotsSummaryAsync(_list.Id);
        }
    }

    async Task RefreshSnapshotsSummaryAsync(Guid listId)
    {
        var summary = await LoadSnapshotsSummaryAsync(listId);

        if (_summaryListId != listId)
        {
            return;
        }

        _snapshotsSummary = summary;
        await InvokeAsync(StateHasChanged);
    }

    async Task<string> LoadSnapshotsSummaryAsync(Guid listId)
    {
        if (!Connectivity.IsOnline)
        {
            return "Needs a connection";
        }

        try
        {
            var live = (await SnapshotsApi.ForListAsync(listId)).Count;
            return live switch { 0 => "None live", 1 => "1 live link", _ => $"{live} live links" };
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            return "Needs a connection";
        }
    }

    string AreaName(Guid areaId) => _areas.FirstOrDefault(area => area.Id == areaId)?.Name ?? "";

    string FiledAreaName(Guid? areaId) => areaId is null ? SharedWithMe.Name : AreaName(areaId.Value);

    async Task FileUnderAsync(Guid? areaId)
    {
        if (Disabled || _list is null || areaId == _filedAreaId)
        {
            return;
        }

        await Sender.SendAsync(new PlaceList(Guid.NewGuid(), State.UserId, _list.Id, areaId));
        _filedAreaId = areaId;
    }

    async Task NameChangedAsync(string name)
    {
        if (Disabled)
        {
            return;
        }

        if (_list is null)
        {
            _draftName = name;
            return;
        }

        if (!IsMine)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(name) || name.Trim() == _list.Name)
        {
            return;
        }

        await Sender.SendAsync(new RenameTaskList(Guid.NewGuid(), State.UserId, _list.Id, name.Trim()));
        _list = await Lists.LoadAsync(_list.Id, CancellationToken.None);
    }

    async Task AreaChangedAsync(Guid areaId)
    {
        if (Disabled || _list is null || areaId == _list.AreaId)
        {
            return;
        }

        await Sender.SendAsync(new MoveTaskListToArea(Guid.NewGuid(), State.UserId, _list.Id, areaId));
        _list = await Lists.LoadAsync(_list.Id, CancellationToken.None);
        _areaName = AreaName(areaId);
    }

    async Task AddOnEnterAsync(KeyboardEventArgs args)
    {
        if (IsNew && args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    async Task CreateAsync()
    {
        var name = _draftName.Trim();

        if (Disabled || NewInArea is not { } areaId || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new CreateTaskList(
            Guid.NewGuid(), State.UserId, Guid.NewGuid(), areaId, name, _kind));

        _draftName = "";
        _kind = ListKind.Tasks;
        await OnClose.InvokeAsync();
    }

    async Task DeleteAsync()
    {
        if (Disabled || _list is null)
        {
            return;
        }

        var list = _list;
        var message = list.Kind == ListKind.Reference
            ? DeleteWarning.ForList(list.Name, list.Id, await ItemStore.LoadAllAsync(State.UserId, CancellationToken.None))
            : DeleteWarning.ForList(list.Name, list.Id, await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None));
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteTaskList(Guid.NewGuid(), State.UserId, list.Id));
        Navigation.NavigateTo($"/areas/{list.AreaId}");
    }
}
