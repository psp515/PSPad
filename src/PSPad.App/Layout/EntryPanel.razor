@using PSPad.Abstractions
@using PSPad.Contracts
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Money
@using PSPad.Module.Money.Balance
@using PSPad.Module.Money.Budgets
@using PSPad.Module.Money.Entries
@using PSPad.Module.Money.Preferences
@using PSPad.Module.Money.Reading
@using PSPad.Module.Money.Values
@inject IDocumentStore<Budget> Budgets
@inject IDocumentStore<MoneyEntry> Entries
@inject IDocumentStore<BalanceSnapshot> Snapshots
@inject IDocumentStore<MoneyPreferences> Preferences
@inject AppState State
@inject CommandSender Sender
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<BudgetsStrings> T
@inject IStringLocalizer<SharedStrings> Shared

<DetailPanel Open="@(_budget is not null)" Title="@Title" TitleTypo="Typo.body2" Class="pspad-entry-panel"
             OnClose="@OnClose" OnSave="@SaveCallback" CanSave="@CanSave" OnDelete="@DeleteCallback" Disabled="@(Disabled || _saving)"
             Footer="@DeleteNote">
    <ChildContent>
        <div class="d-flex flex-column gap-3 pa-4">
            <MudTextField T="string" Class="pspad-entry-name-field" Label="@Shared["Name"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          MaxLength="@MoneyEntry.MaxNameLength" @bind-Value="_name" Immediate="true" AutoFocus="@IsNew" Disabled="@ReadOnly" />
            <MudAutocomplete T="string" Class="pspad-entry-category-field" Label="@T["Category"]" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Value="@_category" ValueChanged="@CategoryChanged"
                             SearchFunc="@SearchCategoriesAsync" CoerceValue="true" DebounceInterval="0"
                             ResetValueOnEmptyText="false" Disabled="@ReadOnly">
                <ItemTemplate Context="choice">
                    @(CategoryChoices.IsNew(Categories, choice) ? T["CreateCategory", choice] : choice)
                </ItemTemplate>
            </MudAutocomplete>
            <RateFields @key="@((_loadedEntry, _loadedBudget, _loadedKind))" CssPrefix="pspad-entry" @bind-Amount="_amount" Currency="@_currency" CurrencyChanged="@Suggest"
                        Rate="@_rate" RateTyped="@RateTyped" NbpDate="@EntryDate" NbpFetched="@ApplyNbpRate"
                        ReadOnly="@ReadOnly" CurrencyFixed="@HasReturns" RateFixed="@HasReturns"
                        AmountHelperText="@(HasReturns ? T["ReturnsLockCurrency", MoneyText.Amount(_returns!.Returned)].Value : null)" />
            <MudDatePicker Class="pspad-entry-date-field" Label="@T["Date"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Date="@_date" DateChanged="@DateChanged" Disabled="@ReadOnly" />
            <MudTextField T="string" Class="pspad-entry-note-field" Label="@T["Note"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="3" MaxLength="@MoneyEntry.MaxNoteLength" Counter="@MoneyEntry.MaxNoteLength" @bind-Value="_note" Disabled="@ReadOnly" />
        </div>
        @if (_returns is { } returns && !ReadOnly)
        {
            <PanelSection Title="@T["Returns"]" Class="pspad-entry-returns">
                <div class="d-flex flex-column gap-2">
                    @if (HasReturns)
                    {
                        <MudText Typo="Typo.body2">@T["ReturnedOf", MoneyText.Amount(returns.Returned), MoneyText.Amount(_entry!.Money.Amount)]</MudText>
                        <MudProgressLinear Color="Color.Primary" Rounded="true" Min="0" Max="100" Value="@ReturnedShare(returns)" UserAttributes="@HiddenFromReaders" />
                        <MudList T="MoneyEntry" Dense="true" Class="py-0">
                            @foreach (var returned in returns.Returns)
                            {
                                <MudListItem T="MoneyEntry" @key="returned.Id" Class="pspad-entry-return"
                                             OnClick="@(() => Navigation.NavigateTo(EntryQuery.ForReturn(Navigation.Uri, returned.Id)))">
                                    <div class="d-flex align-center gap-3">
                                        <MudText Typo="Typo.body2" Class="flex-grow-1">@MoneyText.Day(returned.Date)</MudText>
                                        <MudText Typo="Typo.body2" Class="pspad-entry-amount">@MoneyText.SignedAmount(returned.Money.Amount)</MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body2" Class="flex-grow-1 pspad-muted">@T["LeftToReturn", MoneyText.Amount(returns.Left)]</MudText>
                        <MudButton Class="pspad-entry-record-return" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.Undo" Disabled="@(Disabled || returns.IsFull)"
                                   OnClick="@(() => Navigation.NavigateTo(EntryQuery.ForNewReturn(Navigation.Uri, _entry!.Id)))">@T["RecordReturn"]</MudButton>
                    </div>
                </div>
            </PanelSection>
        }
    </ChildContent>
</DetailPanel>

@code {
    static readonly Dictionary<string, object> HiddenFromReaders = new() { ["aria-hidden"] = "true" };

    [Parameter] public Guid? EntryId { get; set; }

    [Parameter] public Guid? NewInBudget { get; set; }

    [Parameter] public CategoryKind NewKind { get; set; }

    [Parameter] public YearMonth? NewMonth { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    Budget? _budget;
    MoneyEntry? _entry;
    IReadOnlyList<MoneyEntry> _budgetEntries = [];
    IReadOnlyList<BalanceSnapshot> _budgetSnapshots = [];
    Guid? _loadedEntry;
    Guid? _loadedBudget;
    bool _loadedOnce;
    string _name = "";
    string _category = "";
    decimal? _amount;
    string _currency = Currencies.Pln;
    decimal? _rate;
    DateOnly? _rateDate;
    DateTime? _date;
    string? _note;
    bool _saving;
    CategoryKind _loadedKind;
    YearMonth? _loadedMonth;
    ReturnState? _returns;

    bool IsNew => _entry is null;

    bool HasReturns => _returns is { Returns.Count: > 0 };

    CategoryKind Kind => _entry?.Kind ?? NewKind;

    bool ReadOnly => _budget?.IsArchived == true;

    IReadOnlyList<string> Categories => _budget?.CategoriesOf(Kind) ?? [];

    string Title => (IsNew, Kind) switch
    {
        (true, CategoryKind.Expense) => T["NewExpense"],
        (true, _) => T["NewIncome"],
        (false, CategoryKind.Expense) => T["KindExpense"],
        _ => T["KindIncome"]
    };

    bool IsPln => _currency == Currencies.Pln;

    decimal Rate => IsPln ? 1m : _rate.GetValueOrDefault();

    bool CanSave => !ReadOnly && !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_category)
        && _amount.GetValueOrDefault() > 0 && _date is not null && Rate > 0
        && (!HasReturns || _amount.GetValueOrDefault() >= _returns!.Returned);

    DateOnly? EntryDate => _date is null ? null : DateOnly.FromDateTime(_date.Value);

    EventCallback SaveCallback => ReadOnly ? default : EventCallback.Factory.Create(this, SaveAsync);

    EventCallback DeleteCallback => ReadOnly || IsNew ? default : EventCallback.Factory.Create(this, DeleteAsync);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOnce && _loadedEntry == EntryId && _loadedBudget == NewInBudget && _loadedKind == NewKind && _loadedMonth == NewMonth)
        {
            return;
        }

        _loadedOnce = true;
        _loadedEntry = EntryId;
        _loadedBudget = NewInBudget;
        _loadedKind = NewKind;
        _loadedMonth = NewMonth;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        var entry = EntryId is null ? null : await Entries.LoadAsync(EntryId.Value, CancellationToken.None);
        _returns = null;

        if (entry is { Deleted: false, IsReturn: true })
        {
            _entry = null;
            _budget = null;
            Navigation.NavigateTo(EntryQuery.ForReturn(Navigation.Uri, entry.Id), replace: true);
            return;
        }

        _entry = entry is { Deleted: false } ? entry : null;
        var budgetId = _entry?.BudgetId ?? (EntryId is null ? NewInBudget : null);
        var budget = budgetId is null ? null : await Budgets.LoadAsync(budgetId.Value, CancellationToken.None);
        _budget = budget is null || !budget.Admits(State.UserId) ? null : budget;

        if (_budget is null)
        {
            return;
        }

        var all = await Entries.LoadAllAsync(State.UserId, CancellationToken.None);
        _budgetEntries = [.. all.Where(candidate => candidate.BudgetId == _budget.Id && !candidate.Deleted)];
        var snapshots = await Snapshots.LoadAllAsync(State.UserId, CancellationToken.None);
        _budgetSnapshots = [.. snapshots.Where(candidate => candidate.BudgetId == _budget.Id && !candidate.Deleted)];

        if (_entry is not null)
        {
            _returns = _entry.Kind == CategoryKind.Expense ? ReturnState.Of(_entry, _budgetEntries) : null;
            Fill(_entry);
        }
        else
        {
            await StartNewAsync();
        }
    }

    RenderFragment? DeleteNote => HasReturns && !ReadOnly
        ? @<MudText Typo="Typo.caption" Class="pspad-muted pspad-entry-delete-returns">@T.Plural(_returns!.Returns.Count, "DeleteAlsoReturns")</MudText>
        : null;

    static double ReturnedShare(ReturnState returns) =>
        returns.Returned + returns.Left == 0 ? 0 : (double)(returns.Returned / (returns.Returned + returns.Left) * 100);

    void Fill(MoneyEntry entry)
    {
        _name = entry.Name;
        _category = entry.Category;
        _amount = entry.Money.Amount;
        _currency = entry.Money.Currency;
        _rate = entry.Money.RateToPln;
        _rateDate = entry.Money.RateDate;
        _date = entry.Date.ToDateTime(TimeOnly.MinValue);
        _note = entry.Note;
    }

    async Task StartNewAsync()
    {
        var preferences = await Preferences.LoadAsync(MoneyPreferences.IdFor(State.UserId), CancellationToken.None);
        _name = "";
        _category = "";
        _amount = null;
        _note = null;
        _date = EntryDefaultDate.For(NewMonth, State.Today).ToDateTime(TimeOnly.MinValue);
        Suggest(preferences?.DefaultCurrency ?? Currencies.Pln);
    }

    void Suggest(string currency)
    {
        _currency = currency;
        var suggestion = RateSuggestion.For(currency, _budgetEntries, _budgetSnapshots);
        _rate = suggestion?.RateToPln;
        _rateDate = suggestion?.RateDate;
    }

    void CategoryChanged(string? category) => _category = category ?? "";

    void RateTyped(decimal? rate)
    {
        _rate = rate;
        _rateDate = null;
    }

    void DateChanged(DateTime? date) => _date = date;

    Task<IEnumerable<string>> SearchCategoriesAsync(string? text, CancellationToken ct) =>
        Task.FromResult<IEnumerable<string>>(CategoryChoices.Search(Categories, text));

    void ApplyNbpRate(NbpRateView rate)
    {
        _rate = rate.Rate;
        _rateDate = rate.EffectiveDate;
    }

    async Task SaveAsync()
    {
        if (Disabled || _saving || !CanSave || _budget is null)
        {
            return;
        }

        var date = DateOnly.FromDateTime(_date!.Value);
        var money = new Money(_amount.GetValueOrDefault(), _currency, Rate, _rateDate ?? date);
        var name = _name.Trim();
        var category = _category.Trim();
        var note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim();

        _saving = true;
        CommandResult result;

        try
        {
            result = _entry is not null
                ? await Sender.SendAsync(new EditEntry(Guid.NewGuid(), State.UserId, _entry.Id, name, category, money, date, note))
                : Kind == CategoryKind.Expense
                    ? await Sender.SendAsync(new RecordExpense(Guid.NewGuid(), State.UserId, Guid.NewGuid(), _budget.Id, name,
                        category, money, date, note))
                    : await Sender.SendAsync(new RecordIncome(Guid.NewGuid(), State.UserId, Guid.NewGuid(), _budget.Id, name,
                        category, money, date, note));
        }
        finally
        {
            _saving = false;
        }

        if (!result.Accepted)
        {
            Snackbar.Add(result.Rejection ?? T["SaveEntryFailed"].Value, Severity.Warning);
            return;
        }

        await OnClose.InvokeAsync();
    }

    async Task DeleteAsync()
    {
        if (Disabled || _saving || _entry is null)
        {
            return;
        }

        _saving = true;
        CommandResult result;

        try
        {
            result = await Sender.SendAsync(new DeleteEntry(Guid.NewGuid(), State.UserId, _entry.Id));
        }
        finally
        {
            _saving = false;
        }

        if (!result.Accepted)
        {
            Snackbar.Add(result.Rejection ?? T["DeleteEntryFailed"].Value, Severity.Warning);
            return;
        }

        await OnClose.InvokeAsync();
    }
}
