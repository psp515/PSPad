@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.Module.Money.Budgets
@using PSPad.Module.Tasks.Areas
@inject SidebarCounts Counts
@implements IDisposable

<div class="d-flex flex-column pspad-nav" style="height:100%">
    <AccountBadge Email="@Email" DisplayName="@DisplayName" UserId="@UserId" />

    <MudNavMenu>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.WbSunny">
            My Day@(Count(Counts.Today))
        </MudNavLink>
        <MudNavLink Href="/inbox" Icon="@Icons.Material.Outlined.Inbox">
            Inbox@(Count(Counts.Inbox))
        </MudNavLink>
        <MudNavLink Href="/goals" Icon="@Icons.Material.Outlined.Flag">
            Goals
        </MudNavLink>
        <MudNavLink Href="/statistics" Icon="@Icons.Material.Outlined.History">
            Statistics
        </MudNavLink>
        <MudNavLink Href="/snapshots" Icon="@Icons.Material.Outlined.Link">
            List snapshots
        </MudNavLink>
    </MudNavMenu>

    <MudDivider Class="my-2" Style="flex-grow:0" />

    <MudNavMenu>
        @GroupHeader(NavGroupState.Budgets, "Budgets", BudgetLinks.Index, ActiveBudgets.Count)
        @if (Groups.IsExpanded(NavGroupState.Budgets))
        {
            @foreach (var budget in ActiveBudgets)
            {
                <MudNavLink @key="budget.Id" Href="@BudgetLinks.For(budget.Id)"
                            Icon="@Icons.Material.Outlined.AccountBalanceWallet">
                    @budget.Name
                </MudNavLink>
            }
        }
    </MudNavMenu>

    <MudDivider Class="my-2" Style="flex-grow:0" />

    <MudNavMenu>
        @GroupHeader(NavGroupState.Areas, "Areas", null, Areas.Count)
        @if (Groups.IsExpanded(NavGroupState.Areas))
        {
            @if (!AreasLoaded)
            {
                <div role="status" aria-busy="true">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-3 my-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-3 my-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-3 my-2" />
                </div>
            }
            else
            {
                @foreach (var area in Areas.OrderBy(area => area.Position))
                {
                    <MudNavLink @key="area.Id" Href="@AreaLinks.For(area.Id)" Icon="@Icons.Material.Outlined.Folder">
                        @area.Name
                    </MudNavLink>
                }
            }

            @if (HasShared)
            {
                <MudNavLink Href="@AreaLinks.For(SharedWithMe.AreaId)" Icon="@Icons.Material.Outlined.People">
                    @SharedWithMe.Name
                </MudNavLink>
            }

            <MudNavLink Icon="@Icons.Material.Outlined.Add" Class="pspad-new-area"
                        Disabled="@Disabled" OnClick="@OnNewAreaClick">
                New area
            </MudNavLink>
        }
    </MudNavMenu>

    <MudDivider Class="my-2" Style="flex-grow:0" />

    <MudNavMenu>
        <MudNavLink Href="/settings" Icon="@Icons.Material.Outlined.Settings">
            Settings
        </MudNavLink>
        <MudNavLink Href="/app-info" Icon="@Icons.Material.Outlined.Info">
            App info
        </MudNavLink>
    </MudNavMenu>

    <div class="flex-grow-1"></div>

    <SidebarFooter />
</div>

@code {
    [Parameter] public IReadOnlyList<Area> Areas { get; set; } = [];

    [Parameter] public bool AreasLoaded { get; set; } = true;

    [Parameter] public bool HasShared { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Email { get; set; } = "";

    [Parameter] public string DisplayName { get; set; } = "";

    [Parameter] public Guid UserId { get; set; }

    [Parameter] public EventCallback OnNewArea { get; set; }

    [Parameter] public IReadOnlyList<Budget> Budgets { get; set; } = [];

    [Inject] NavGroupState Groups { get; set; } = default!;

    IReadOnlyList<Budget> ActiveBudgets =>
        [.. Budgets.Where(budget => !budget.IsArchived).OrderBy(budget => budget.CreatedAt)];

    protected override void OnInitialized()
    {
        Counts.Changed += OnCountsChanged;
        Groups.Changed += OnCountsChanged;
    }

    protected override Task OnInitializedAsync() => Groups.LoadAsync();

    RenderFragment GroupHeader(string group, string label, string? href, int count) =>
        @<div class="d-flex align-center px-4 pt-2 pb-1 pspad-nav-group">
            @if (href is null)
            {
                <MudText Typo="Typo.caption" Class="pspad-nav-caption pspad-muted flex-grow-1">
                    @(Groups.IsExpanded(group) ? label : $"{label} · {count}")
                </MudText>
            }
            else
            {
                <MudLink Href="@href" Typo="Typo.caption" Class="pspad-nav-caption flex-grow-1">
                    @(Groups.IsExpanded(group) ? label : $"{label} · {count}")
                </MudLink>
            }
            <MudIconButton Size="Size.Small"
                           Icon="@(Groups.IsExpanded(group) ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ChevronRight)"
                           aria-label="@($"{(Groups.IsExpanded(group) ? "Collapse" : "Expand")} {label.ToLowerInvariant()}")"
                           aria-expanded="@(Groups.IsExpanded(group) ? "true" : "false")"
                           OnClick="@(() => Groups.SetAsync(group, !Groups.IsExpanded(group)))" />
        </div>;

    void OnCountsChanged() => InvokeAsync(StateHasChanged);

    static RenderFragment Count(int count) => count == 0 ? (_ => { }) : @<span class="pspad-nav-count">@count</span>;

    Task OnNewAreaClick() => Disabled ? Task.CompletedTask : OnNewArea.InvokeAsync();

    public void Dispose()
    {
        Counts.Changed -= OnCountsChanged;
        Groups.Changed -= OnCountsChanged;
    }
}
