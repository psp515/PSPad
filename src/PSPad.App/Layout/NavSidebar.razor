@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.Module.Tasks.Areas
@inject SidebarCounts Counts
@implements IDisposable

<div class="d-flex flex-column" style="height:100%">
    <AccountBadge Email="@Email" DisplayName="@DisplayName" UserId="@UserId" />

    <MudNavMenu>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.WbSunny">
            @($"My Day{Badge(Counts.Today)}")
        </MudNavLink>
        <MudNavLink Href="/inbox" Icon="@Icons.Material.Filled.Inbox">
            @($"Inbox{Badge(Counts.Inbox)}")
        </MudNavLink>
        <MudNavLink Href="/goals" Icon="@Icons.Material.Filled.Flag">
            Goals
        </MudNavLink>
        <MudNavLink Href="/statistics" Icon="@Icons.Material.Filled.History">
            Statistics
        </MudNavLink>
        <MudNavLink Href="/snapshots" Icon="@Icons.Material.Filled.Link">
            List snapshots
        </MudNavLink>
    </MudNavMenu>

    <MudDivider Class="my-2" Style="flex-grow:0" />

    <MudNavMenu>
        @if (!AreasLoaded)
        {
            <div role="status" aria-busy="true">
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-3 my-2" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-3 my-2" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-3 my-2" />
            </div>
        }
        else
        {
            @foreach (var area in Areas.OrderBy(area => area.Position))
            {
                <MudNavLink @key="area.Id" Href="@AreaLinks.For(area.Id)" Icon="@Icons.Material.Filled.Folder">
                    @area.Name
                </MudNavLink>
            }
        }

        @if (HasShared)
        {
            <MudNavLink Href="@AreaLinks.For(SharedWithMe.AreaId)" Icon="@Icons.Material.Filled.People">
                @SharedWithMe.Name
            </MudNavLink>
        }

        <MudNavLink Icon="@Icons.Material.Filled.Add" Class="pspad-new-area"
                    Disabled="@Disabled" OnClick="@OnNewAreaClick">
            New area
        </MudNavLink>
    </MudNavMenu>

    <MudDivider Class="my-2" Style="flex-grow:0" />

    <MudNavMenu>
        <SyncButton AsNavRow="true" />
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
            Settings
        </MudNavLink>
        <MudNavLink Href="/app-info" Icon="@Icons.Material.Filled.Info">
            App info
        </MudNavLink>
    </MudNavMenu>

    <div class="flex-grow-1"></div>

    <SidebarFooter />
</div>

@code {
    [Parameter] public IReadOnlyList<Area> Areas { get; set; } = [];

    [Parameter] public bool AreasLoaded { get; set; } = true;

    [Parameter] public bool HasShared { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Email { get; set; } = "";

    [Parameter] public string DisplayName { get; set; } = "";

    [Parameter] public Guid UserId { get; set; }

    [Parameter] public EventCallback OnNewArea { get; set; }

    protected override void OnInitialized() => Counts.Changed += OnCountsChanged;

    void OnCountsChanged() => InvokeAsync(StateHasChanged);

    static string Badge(int count) => count == 0 ? "" : $"  ({count})";

    Task OnNewAreaClick() => Disabled ? Task.CompletedTask : OnNewArea.InvokeAsync();

    public void Dispose() => Counts.Changed -= OnCountsChanged;
}
