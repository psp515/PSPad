@inherits LayoutComponentBase
@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.Auth
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.App.State.Viewport
@using PSPad.App.Sync
@using PSPad.App.Theme
@using PSPad.App.Updates
@using PSPad.Contracts
@using PSPad.Module.Money.Budgets
@using PSPad.Module.Presentation.AreaViews
@using PSPad.Module.Presentation.ListViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Today
@inject SyncCoordinator Coordinator
@inject ISyncTrigger Trigger
@inject AppState State
@inject PSPadApiClient Api
@inject ThemePreference Preference
@inject SidebarCounts Counts
@inject CardCollapseState Collapse
@inject CommandSender Sender
@inject ReplicaOwnership Ownership
@inject IDocumentStore<Area> AreaStore
@inject IDocumentStore<Budget> BudgetStore
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<AreaView> AreaViewStore
@inject IDocumentStore<ListView> ListViewStore
@inject NavigationManager Navigation
@inject IViewport Viewport
@inject ILocalSessionStore Sessions
@inject LocalAuthenticationStateProvider Authentication
@inject IClock Clock
@inject ServerReachability Reachability
@inject IConnectivity Connectivity
@inject StatusBelts Belts
@inject IAppUpdates Updates
@inject ILogger<AppShell> Logger
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@Preference.Theme" IsDarkMode="@Preference.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MobileTopBar Email="@_email" DisplayName="@_displayName" UserId="@State.UserId"
                  OnAvatar="@(() => _accountOpen = true)" />

    <MudDrawer Variant="DrawerVariant.Persistent" Open="@_isDesktop" Elevation="1"
               ClipMode="DrawerClipMode.Never" Class="d-none d-md-flex">
        <NavSidebar Areas="@_areas" Budgets="@_budgets" AreasLoaded="@_ready" HasShared="@_hasShared" Email="@_email" DisplayName="@_displayName"
                    UserId="@State.UserId" Disabled="@(!_ready)"
                    OnNewArea="@NewArea" />
    </MudDrawer>

    <AccountDrawer @bind-Open="_accountOpen" Email="@_email" DisplayName="@_displayName" UserId="@State.UserId" />

    <MudMainContent>
        <StatusBeltStack />
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 mt-md-0 pt-md-6 mb-4 pspad-content">
            @if (_ready)
            {
                <CascadingValue Value="@Coordinator.Revision" Name="SyncRevision">
                    @Body
                </CascadingValue>

                @if (_signedIn)
                {
                    <BootSplashRelease />
                }
            }
            else
            {
                <BrandLoader />
            }
        </MudContainer>
    </MudMainContent>

    <BottomNav />
    <PullToRefresh />

    <TaskDetailPanel TaskId="@_openTask" NewInList="@_newTaskList" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <ListDetailPanel NewInArea="@_newListArea" ListId="@_openList" View="@_listView" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <AreaDetailPanel AreaId="@_openArea" IsNew="@_newArea" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <GoalDetailPanel GoalId="@_openGoal" IsNew="@_newGoal" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <BudgetPanel BudgetId="@_openBudget" IsNew="@_newBudget" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <InboxItemPanel ItemId="@_openInboxItem" IsNew="@_newInboxItem" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <ReferenceItemPanel ItemId="@_openReferenceItem" NewInList="@_newReferenceItemList" OnClose="@ClosePanel" Disabled="@(!_ready)" />
</MudLayout>

@code {
    MudThemeProvider? _themeProvider;
    bool _themeReady;
    bool _ready;
    bool _signedIn;
    bool _accountOpen;
    bool _isDesktop = true;
    string _email = "";
    string _displayName = "";
    IReadOnlyList<Area> _areas = [];
    IReadOnlyList<Budget> _budgets = [];
    bool _hasShared;
    Guid? _openTask;
    Guid? _newTaskList;
    Guid? _newListArea;
    Guid? _openList;
    ListPanelView _listView;
    Guid? _openArea;
    bool _newArea;
    Guid? _openGoal;
    Guid? _openBudget;
    bool _newBudget;
    bool _newGoal;
    Guid? _openInboxItem;
    bool _newInboxItem;
    Guid? _openReferenceItem;
    Guid? _newReferenceItemList;

    protected override async Task OnInitializedAsync()
    {
        Coordinator.Changed += OnSyncChanged;
        Reachability.Changed += OnReachabilityChanged;
        Preference.Changed += OnPreferenceChanged;
        Sender.Sent += OnCommandSent;
        Navigation.LocationChanged += OnLocationChanged;
        Updates.Available += OnUpdateAvailable;

        if (Updates.IsAvailable)
        {
            OfferUpdate();
        }

        await Viewport.SubscribeAsync(OnDesktopChanged);

        var session = await Authentication.SessionAsync();
        var nothingLocalYet = false;

        if (session is not null)
        {
            _signedIn = true;
            _displayName = session.DisplayName;
            _email = session.Email;
            State.UserId = session.UserId;
            State.DisplayName = session.DisplayName;
            State.Email = session.Email;
            State.TimeZone = session.TimeZone;
            State.Today = TodayIn(session.TimeZone);

            nothingLocalYet = await TakeOwnershipAndReportEmptyAsync(session.UserId);
            await LoadLocalDataAsync();
        }

        Coordinator.Start();

        if (nothingLocalYet)
        {
            // Signing in wipes the replica, so there is nothing to draw until the first pull
            // lands. Rendering the empty app over a full account reads as lost data, and leaves
            // the user looking at it for as long as the pull takes.
            await FirstPullAsync();
            await LoadLocalDataAsync();
        }

        _ready = true;
        ReadOpenPanels();
        // Only the first await in this method renders; a network that never answers must not own that one.
        StateHasChanged();

        if (session is not null)
        {
            await RefreshAccountAsync();
        }
    }

    async Task<bool> TakeOwnershipAndReportEmptyAsync(Guid userId)
    {
        try
        {
            await Ownership.EnsureCurrentUserAsync(userId);
            return await Ownership.NothingSyncedYetAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Local replica ownership check failed: {Reason}", exception.Message);
            return false;
        }
    }

    async Task LoadLocalDataAsync()
    {
        try
        {
            await ReloadAreasAndCountsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Local replica load failed: {Reason}", exception.Message);
        }
    }

    static readonly TimeSpan FirstPullTimeout = TimeSpan.FromSeconds(10);

    async Task FirstPullAsync()
    {
        try
        {
            // A held splash is an unrecoverable blank screen, so a pull that never answers
            // still has to let the app through.
            await Coordinator.Started.WaitAsync(FirstPullTimeout);
        }
        catch (Exception exception)
        {
            Logger.LogWarning("First pull after sign-in did not finish: {Reason}", exception.Message);
        }
    }

    async Task<LocalSession?> SessionOrNullAsync()
    {
        try
        {
            return await Sessions.LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Session load failed: {Reason}", exception.Message);
            return null;
        }
    }

    async Task RefreshAccountAsync()
    {
        MeResponse? me;

        try
        {
            me = (await Api.MeAsync()).Sanitized();
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Account refresh failed: {Reason}", exception.Message);
            return;
        }

        if (me is null)
        {
            return;
        }

        _displayName = me.DisplayName;
        _email = me.Email;
        State.DisplayName = me.DisplayName;
        State.Email = me.Email;
        State.TimeZone = me.TimeZone;
        State.Today = TodayIn(me.TimeZone);

        // The fetch itself may have rotated the refresh token and stamped the contact time,
        // so the session read before it started is already stale by here.
        var current = await SessionOrNullAsync();

        if (current is not null)
        {
            await Sessions.SaveAsync(current with
            {
                DisplayName = me.DisplayName,
                Email = me.Email,
                TimeZone = me.TimeZone
            });
        }

        StateHasChanged();
    }

    DateOnly TodayIn(string timeZone) => LocalToday.In(Clock.UtcNow, timeZone);

    void OnDesktopChanged(bool isDesktop)
    {
        _isDesktop = isDesktop;

        if (isDesktop)
        {
            _accountOpen = false;
        }

        InvokeAsync(StateHasChanged);
    }

    void ReadOpenPanels()
    {
        _openTask = TaskQuery.From(Navigation.Uri);
        _newTaskList = TaskQuery.NewTaskListFrom(Navigation.Uri);
        _newListArea = ListQuery.NewListAreaFrom(Navigation.Uri);
        _openList = ListQuery.From(Navigation.Uri);
        _listView = ListQuery.ViewFrom(Navigation.Uri);
        _openArea = AreaQuery.From(Navigation.Uri);
        _newArea = AreaQuery.IsNew(Navigation.Uri);
        _openGoal = GoalQuery.From(Navigation.Uri);
        _newGoal = GoalQuery.IsNew(Navigation.Uri);
        _openBudget = BudgetQuery.From(Navigation.Uri);
        _newBudget = BudgetQuery.IsNew(Navigation.Uri);
        _openInboxItem = InboxQuery.From(Navigation.Uri);
        _newInboxItem = InboxQuery.IsNew(Navigation.Uri);
        _openReferenceItem = ReferenceQuery.From(Navigation.Uri);
        _newReferenceItemList = ReferenceQuery.NewItemListFrom(Navigation.Uri);
    }

    void ClosePanel() => Navigation.NavigateTo(TaskQuery.Without(Navigation.Uri));

    void NewArea() => Navigation.NavigateTo(AreaQuery.ForNew(Navigation.Uri));

    void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _accountOpen = false;
        ReadOpenPanels();
        InvokeAsync(StateHasChanged);
    }

    async Task ReloadAreasAndCountsAsync()
    {
        var loaded = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _areas = [.. loaded.Where(area => !area.Deleted)];
        _budgets = [.. await BudgetStore.LoadAllAsync(State.UserId, CancellationToken.None)];

        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var areaViews = await AreaViewStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var listViews = await ListViewStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _hasShared = ListPlacement.For(State.UserId, loaded, lists, areaViews, listViews).HasShared;

        await Counts.RefreshAsync();
        await Collapse.LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null || _themeReady)
        {
            return;
        }

        _themeReady = true;
        var systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Preference.InitialiseAsync(systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        StateHasChanged();
    }

    async Task OnSystemDarkModeChanged(bool prefersDark)
    {
        await Preference.InitialiseAsync(prefersDark);
        StateHasChanged();
    }

    void OnPreferenceChanged() => InvokeAsync(StateHasChanged);

    void OnSyncChanged() => InvokeAsync(ReloadAreasAndCountsAsync);

    void OnReachabilityChanged() => InvokeAsync(() =>
    {
        if (Reachability.IsReachable)
        {
            Belts.Clear(BeltKind.Offline);
        }
        else
        {
            Belts.Show(
                BeltKind.Offline,
                "Can’t reach the server — working from local data. Changes sync when you’re back.",
                "Retry",
                Trigger.SyncNowAsync);
        }

        StateHasChanged();
    });

    void OnUpdateAvailable() => InvokeAsync(OfferUpdate);

    void OfferUpdate() =>
        Belts.Show(BeltKind.Update, "A new version of PSPad is ready.", "Reload", Updates.ApplyAsync);

    void OnCommandSent() => InvokeAsync(ReloadAreasAndCountsAsync);

    public void Dispose()
    {
        Coordinator.Changed -= OnSyncChanged;
        Reachability.Changed -= OnReachabilityChanged;
        Preference.Changed -= OnPreferenceChanged;
        Sender.Sent -= OnCommandSent;
        Navigation.LocationChanged -= OnLocationChanged;
        Updates.Available -= OnUpdateAvailable;
    }

    public async ValueTask DisposeAsync()
    {
        await Viewport.DisposeAsync();
    }
}
