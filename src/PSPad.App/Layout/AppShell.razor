@inherits LayoutComponentBase
@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.Auth
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.App.State.Viewport
@using PSPad.App.Sync
@using PSPad.App.Theme
@using PSPad.Contracts
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Today
@inject SyncCoordinator Coordinator
@inject AppState State
@inject PSPadApiClient Api
@inject ThemePreference Preference
@inject SidebarCounts Counts
@inject CardCollapseState Collapse
@inject CommandSender Sender
@inject ReplicaOwnership Ownership
@inject IDocumentStore<Area> AreaStore
@inject NavigationManager Navigation
@inject IViewport Viewport
@inject ILocalSessionStore Sessions
@inject IClock Clock
@inject ServerReachability Reachability
@inject IConnectivity Connectivity
@inject ISnackbar Snackbar
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@PSPadTheme.Instance" IsDarkMode="@Preference.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="d-md-none">
        <MudIconButton id="pspad-drawer-toggle" Class="d-md-none" Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudSpacer />
        <ConnectionStatus />
    </MudAppBar>

    <MudDrawer Variant="DrawerVariant.Persistent" Open="@_isDesktop" Elevation="1"
               ClipMode="DrawerClipMode.Never" Class="d-none d-md-flex">
        <NavSidebar Areas="@_areas" AreasLoaded="@_ready" Email="@_email" DisplayName="@_displayName"
                    UserId="@State.UserId" Disabled="@(!_ready)"
                    OnNewArea="@NewArea" />
    </MudDrawer>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary"
               Elevation="1" ClipMode="DrawerClipMode.Never" Class="d-md-none">
        <NavSidebar Areas="@_areas" AreasLoaded="@_ready" Email="@_email" DisplayName="@_displayName"
                    UserId="@State.UserId" Disabled="@(!_ready)"
                    OnNewArea="@NewArea"
                    Navigated="@CloseDrawer" />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pspad-content">
            @if (_ready)
            {
                <CascadingValue Value="@Coordinator.Revision" Name="SyncRevision">
                    @Body
                </CascadingValue>
            }
            else
            {
                <BrandLoader />
            }
        </MudContainer>
    </MudMainContent>

    <TaskDetailPanel TaskId="@_openTask" NewInList="@_newTaskList" OnClose="@ClosePanel" Disabled="@(!_ready)" />
    <AreaDetailPanel AreaId="@_openArea" IsNew="@_newArea" OnClose="@ClosePanel" Disabled="@(!_ready)" />
</MudLayout>

@code {
    MudThemeProvider? _themeProvider;
    bool _themeReady;
    bool _ready;
    bool _drawerOpen;
    bool _isDesktop = true;
    string _email = "";
    string _displayName = "";
    IReadOnlyList<Area> _areas = [];
    Guid? _openTask;
    Guid? _newTaskList;
    Guid? _openArea;
    bool _newArea;

    protected override async Task OnInitializedAsync()
    {
        Coordinator.Changed += OnSyncChanged;
        Reachability.Changed += OnReachabilityChanged;
        Preference.Changed += OnPreferenceChanged;
        Sender.Sent += OnCommandSent;
        Navigation.LocationChanged += OnLocationChanged;

        await Viewport.SubscribeAsync(OnDesktopChanged);

        var session = await SessionOrNullAsync();
        var nothingLocalYet = false;

        if (session is not null)
        {
            _displayName = session.DisplayName;
            _email = session.Email;
            State.UserId = session.UserId;
            State.DisplayName = session.DisplayName;
            State.Email = session.Email;
            State.TimeZone = session.TimeZone;
            State.Today = TodayIn(session.TimeZone);

            nothingLocalYet = await TakeOwnershipAndReportEmptyAsync(session.UserId);
            await LoadLocalDataAsync();
        }

        Coordinator.Start();

        if (nothingLocalYet)
        {
            // Signing in wipes the replica, so there is nothing to draw until the first pull
            // lands. Rendering the empty app over a full account reads as lost data, and leaves
            // the user looking at it for as long as the pull takes.
            await FirstPullAsync();
            await LoadLocalDataAsync();
        }

        _ready = true;

        if (session is not null)
        {
            await RefreshAccountAsync();
        }

        ReadOpenPanels();
    }

    async Task<bool> TakeOwnershipAndReportEmptyAsync(Guid userId)
    {
        try
        {
            await Ownership.EnsureCurrentUserAsync(userId);
            return await Ownership.NothingSyncedYetAsync();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"Local replica ownership check failed: {exception.Message}");
            return false;
        }
    }

    async Task LoadLocalDataAsync()
    {
        try
        {
            await ReloadAreasAndCountsAsync();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"Local replica load failed: {exception.Message}");
        }
    }

    static readonly TimeSpan FirstPullTimeout = TimeSpan.FromSeconds(10);

    async Task FirstPullAsync()
    {
        try
        {
            // A held splash is an unrecoverable blank screen, so a pull that never answers
            // still has to let the app through.
            await Coordinator.Started.WaitAsync(FirstPullTimeout);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"First pull after sign-in did not finish: {exception.Message}");
        }
    }

    async Task<LocalSession?> SessionOrNullAsync()
    {
        try
        {
            return await Sessions.LoadAsync();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"Session load failed: {exception.Message}");
            return null;
        }
    }

    async Task RefreshAccountAsync()
    {
        MeResponse? me;

        try
        {
            me = (await Api.MeAsync()).Sanitized();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"Account refresh failed: {exception.Message}");
            return;
        }

        if (me is null)
        {
            return;
        }

        _displayName = me.DisplayName;
        _email = me.Email;
        State.DisplayName = me.DisplayName;
        State.Email = me.Email;
        State.TimeZone = me.TimeZone;
        State.Today = TodayIn(me.TimeZone);

        // The fetch itself may have rotated the refresh token and stamped the contact time,
        // so the session read before it started is already stale by here.
        var current = await SessionOrNullAsync();

        if (current is not null)
        {
            await Sessions.SaveAsync(current with
            {
                DisplayName = me.DisplayName,
                Email = me.Email,
                TimeZone = me.TimeZone
            });
        }

        StateHasChanged();
    }

    DateOnly TodayIn(string timeZone) => LocalToday.In(Clock.UtcNow, timeZone);

    void OnDesktopChanged(bool isDesktop)
    {
        _isDesktop = isDesktop;
        InvokeAsync(StateHasChanged);
    }

    void ReadOpenPanels()
    {
        _openTask = TaskQuery.From(Navigation.Uri);
        _newTaskList = TaskQuery.NewTaskListFrom(Navigation.Uri);
        _openArea = AreaQuery.From(Navigation.Uri);
        _newArea = AreaQuery.IsNew(Navigation.Uri);
    }

    void ClosePanel() => Navigation.NavigateTo(TaskQuery.Without(Navigation.Uri));

    void CloseDrawer() => _drawerOpen = false;

    void NewArea()
    {
        _drawerOpen = false;
        Navigation.NavigateTo(AreaQuery.ForNew(Navigation.Uri));
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ReadOpenPanels();
        InvokeAsync(StateHasChanged);
    }

    async Task ReloadAreasAndCountsAsync()
    {
        var loaded = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _areas = [.. loaded.Where(area => !area.Deleted)];
        await Counts.RefreshAsync();
        await Collapse.LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null || _themeReady)
        {
            return;
        }

        _themeReady = true;
        var systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Preference.InitialiseAsync(systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        StateHasChanged();
    }

    async Task OnSystemDarkModeChanged(bool prefersDark)
    {
        await Preference.InitialiseAsync(prefersDark);
        StateHasChanged();
    }

    void OnPreferenceChanged() => InvokeAsync(StateHasChanged);

    void OnSyncChanged() => InvokeAsync(ReloadAreasAndCountsAsync);

    void OnReachabilityChanged() => InvokeAsync(() =>
    {
        if (!Reachability.IsReachable)
        {
            Snackbar.Add("Can't reach the server. Working from local data.", Severity.Warning);
        }

        StateHasChanged();
    });

    void OnCommandSent() => InvokeAsync(ReloadAreasAndCountsAsync);

    public void Dispose()
    {
        Coordinator.Changed -= OnSyncChanged;
        Reachability.Changed -= OnReachabilityChanged;
        Preference.Changed -= OnPreferenceChanged;
        Sender.Sent -= OnCommandSent;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        await Viewport.DisposeAsync();
    }
}
