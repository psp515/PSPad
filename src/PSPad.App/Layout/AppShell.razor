@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.Sync
@using PSPad.App.Theme
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Ordering
@using PSPad.Module.Tasks.Today
@inject SyncCoordinator Coordinator
@inject AppState State
@inject PSPadApiClient Api
@inject ThemePreference Preference
@inject SidebarCounts Counts
@inject CardCollapseState Collapse
@inject CommandSender Sender
@inject ReplicaOwnership Ownership
@inject IDocumentStore<Area> AreaStore
@inject NavigationManager Navigation
@inject IViewport Viewport
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@PSPadTheme.Instance" IsDarkMode="@Preference.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="d-md-none">
        <MudIconButton id="pspad-drawer-toggle" Class="d-md-none" Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudSpacer />
        <AccountMenu Email="@_email" DisplayName="@_displayName" UserId="@State.UserId"
                     AvatarOnly="true" />
    </MudAppBar>

    <MudDrawer Variant="DrawerVariant.Persistent" Open="@_isDesktop" Elevation="1"
               ClipMode="DrawerClipMode.Never" Class="d-none d-md-flex">
        <NavSidebar Areas="@_areas" AreasLoaded="@_ready" Email="@_email" DisplayName="@_displayName"
                    UserId="@State.UserId" PendingCommands="@Coordinator.PendingCount"
                    OnNewArea="@NewAreaAsync"
                    OnRenameArea="@RenameAreaAsync"
                    OnDeleteArea="@DeleteAreaAsync" />
    </MudDrawer>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary"
               Elevation="1" ClipMode="DrawerClipMode.Never" Class="d-md-none">
        <NavSidebar Areas="@_areas" AreasLoaded="@_ready" Email="@_email" DisplayName="@_displayName"
                    UserId="@State.UserId" PendingCommands="@Coordinator.PendingCount"
                    OnNewArea="@NewAreaAsync"
                    OnRenameArea="@RenameAreaAsync"
                    OnDeleteArea="@DeleteAreaAsync"
                    Navigated="@CloseDrawer" />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pspad-content">
            @if (_ready)
            {
                @Body
            }
            else
            {
                <BrandLoader />
            }
        </MudContainer>
    </MudMainContent>

    <TaskDetailPanel TaskId="@_openTask" OnClose="@CloseTask" />
</MudLayout>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthStateTask { get; set; }

    MudThemeProvider? _themeProvider;
    bool _themeReady;
    bool _ready;
    bool _drawerOpen;
    bool _isDesktop = true;
    string _email = "";
    string _displayName = "";
    IReadOnlyList<Area> _areas = [];
    Guid? _openTask;

    protected override async Task OnInitializedAsync()
    {
        Coordinator.Changed += OnSyncChanged;
        Preference.Changed += OnPreferenceChanged;
        Sender.Sent += OnCommandSent;
        Navigation.LocationChanged += OnLocationChanged;

        await Viewport.SubscribeAsync(OnDesktopChanged);

        var authState = AuthStateTask is null ? null : await AuthStateTask;
        if (authState?.User.Identity?.IsAuthenticated == true)
        {
            var me = await Api.MeAsync();

            if (me is not null)
            {
                _displayName = me.DisplayName;
                _email = me.Email;
                State.UserId = me.UserId;
                State.DisplayName = me.DisplayName;
                State.Email = me.Email;
                State.TimeZone = me.TimeZone;
                State.Today = TodayRule.TodayIn(
                    DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(me.TimeZone));
                await Ownership.EnsureCurrentUserAsync(me.UserId);
                await ReloadAreasAndCountsAsync();
            }
        }

        _ready = true;
        Coordinator.Start();
        ReadOpenTask();
    }

    void OnDesktopChanged(bool isDesktop)
    {
        _isDesktop = isDesktop;
        InvokeAsync(StateHasChanged);
    }

    [Inject] IDialogService Dialogs { get; set; } = null!;

    void ReadOpenTask()
    {
        _openTask = TaskQuery.From(Navigation.Uri);
    }

    void CloseTask() => Navigation.NavigateTo(TaskQuery.Without(Navigation.Uri));

    void CloseDrawer() => _drawerOpen = false;

    async Task NewAreaAsync()
    {
        _drawerOpen = false;

        var name = await AskForNameAsync("New area", "Area name", "");
        if (name is null)
        {
            return;
        }

        await Sender.SendAsync(new CreateArea(
            Guid.NewGuid(), State.UserId, Guid.NewGuid(), name,
            Positions.Next(_areas.Select(area => area.Position))));

        await ReloadAreasAndCountsAsync();
    }

    async Task RenameAreaAsync(Area area)
    {
        var name = await AskForNameAsync("Rename area", "Area name", area.Name);
        if (name is null)
        {
            return;
        }

        await Sender.SendAsync(new RenameArea(Guid.NewGuid(), State.UserId, area.Id, name));
        await ReloadAreasAndCountsAsync();
    }

    async Task DeleteAreaAsync(Area area)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"Delete “{area.Name}”? Its lists stay, without an area." }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteArea(Guid.NewGuid(), State.UserId, area.Id));
        await ReloadAreasAndCountsAsync();

        if (Navigation.Uri.Contains($"/areas/{area.Id}", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
        }
    }

    async Task<string?> AskForNameAsync(string title, string label, string value)
    {
        var parameters = new DialogParameters<NameDialog>
        {
            { dialog => dialog.Title, label },
            { dialog => dialog.Value, value }
        };
        var dialog = await Dialogs.ShowAsync<NameDialog>(title, parameters);
        var result = await dialog.Result;

        return result is null || result.Canceled || result.Data is not string name || name.Length == 0
            ? null
            : name;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ReadOpenTask();
        InvokeAsync(StateHasChanged);
    }

    async Task ReloadAreasAndCountsAsync()
    {
        var loaded = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _areas = [.. loaded.Where(area => !area.Deleted)];
        await Counts.RefreshAsync();
        await Collapse.LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null || _themeReady)
        {
            return;
        }

        _themeReady = true;
        var systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Preference.InitialiseAsync(systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        StateHasChanged();
    }

    async Task OnSystemDarkModeChanged(bool prefersDark)
    {
        await Preference.InitialiseAsync(prefersDark);
        StateHasChanged();
    }

    void OnPreferenceChanged() => InvokeAsync(StateHasChanged);

    void OnSyncChanged()
    {
        State.PendingCommands = Coordinator.PendingCount;
        InvokeAsync(ReloadAreasAndCountsAsync);
    }

    void OnCommandSent() => InvokeAsync(ReloadAreasAndCountsAsync);

    public void Dispose()
    {
        Coordinator.Changed -= OnSyncChanged;
        Preference.Changed -= OnPreferenceChanged;
        Sender.Sent -= OnCommandSent;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        await Viewport.DisposeAsync();
    }
}
