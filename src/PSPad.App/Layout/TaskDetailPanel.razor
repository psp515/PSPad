@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<TodoTask> Store
@inject IDocumentStore<TaskList> Lists
@inject IDocumentStore<Goal> Goals
@inject AppState State
@inject CommandSender Sender

<DetailPanel Open="@IsOpen" Title="@(_task is null ? "New task" : "Task")" OnClose="@OnClose"
             OnSave="@SaveCallback" SaveText="Add task" CanSave="@(!string.IsNullOrWhiteSpace(_draft.Name))"
             OnDelete="@DeleteCallback" DeleteText="Delete task" Disabled="@Disabled">
    <Header>
        @if (_task is not null)
        {
            <div class="d-flex align-center gap-2">
                <MudCheckBox T="bool" Class="pspad-task-done" Value="@Done" ValueChanged="@CompleteAsync"
                             Color="Color.Primary" Disabled="@Disabled" />
                <MudTextField T="string" Class="pspad-task-name-field" Value="@_task.Name"
                              ValueChanged="@RenameAsync" Variant="Variant.Text" Immediate="false"
                              Disabled="@Disabled" />
                <MudIconButton Size="Size.Small" Color="Color.Primary" Disabled="@Disabled"
                               Icon="@(_task.Starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                               OnClick="@(() => StarAsync(!_task.Starred))" />
            </div>
        }
        else if (NewInList is not null)
        {
            <div class="d-flex align-center gap-2">
                <MudTextField T="string" Class="pspad-task-name-field" @bind-Value="_draft.Name"
                              Placeholder="Task name" Variant="Variant.Text" Immediate="true" AutoFocus="true"
                              Disabled="@Disabled" />
                <MudIconButton Class="pspad-new-task-star" Size="Size.Small" Color="Color.Primary"
                               Disabled="@Disabled"
                               Icon="@(_draft.Starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                               OnClick="@(() => _draft.Starred = !_draft.Starred)" />
            </div>
        }
    </Header>
    <ChildContent>
        @if (_task is not null)
        {
            <div class="pa-3">
                <StepList Task="@_task" UserId="@State.UserId" Disabled="@Disabled" Changed="@ReloadAsync" />
            </div>

            <MudDivider />

            <div class="pa-3 d-flex flex-column gap-3">
                <MudDatePicker Label="Due date" Date="@DueDate" DateChanged="@DueDateAsync"
                               Disabled="@(_task.IsRecurring || Disabled)" />

                <RecurrenceEditor Task="@_task" UserId="@State.UserId" Today="@State.Today"
                                  Disabled="@Disabled" Changed="@ReloadAsync" />

                <MudSelect T="Priority" Value="@_task.Priority" ValueChanged="@PriorityAsync" Label="Priority"
                           Disabled="@Disabled">
                    @foreach (var priority in Enum.GetValues<Priority>())
                    {
                        <MudSelectItem T="Priority" Value="@priority">@priority</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid?" Value="@_task.GoalId" ValueChanged="@LinkGoalAsync" Label="Goal"
                           Disabled="@Disabled">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>
                    @foreach (var goal in _goals)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)goal.Id)">@goal.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid" Value="@_task.ListId" ValueChanged="@MoveToListAsync" Label="List"
                           Disabled="@Disabled">
                    @foreach (var list in _lists)
                    {
                        <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
        else if (NewInList is not null)
        {
            <div class="pa-3 d-flex flex-column gap-3">
                <MudDatePicker Label="Due date" @bind-Date="_draft.DueDate" Disabled="@Disabled" />

                <MudSelect T="Priority" @bind-Value="_draft.Priority" Label="Priority" Disabled="@Disabled">
                    @foreach (var priority in Enum.GetValues<Priority>())
                    {
                        <MudSelectItem T="Priority" Value="@priority">@priority</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid?" @bind-Value="_draft.GoalId" Label="Goal" Disabled="@Disabled">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>
                    @foreach (var goal in _goals)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)goal.Id)">@goal.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid" @bind-Value="_draft.ListId" Label="List" Disabled="@Disabled">
                    @foreach (var list in _lists)
                    {
                        <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </ChildContent>
</DetailPanel>

@code {
    [Parameter] public Guid? TaskId { get; set; }

    [Parameter] public Guid? NewInList { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    TodoTask? _task;
    IReadOnlyList<TaskList> _lists = [];
    IReadOnlyList<Goal> _goals = [];
    Guid? _draftFor;
    TaskDraft _draft = new();

    bool IsOpen => _task is not null || NewInList is not null;

    EventCallback SaveCallback => _task is null && NewInList is not null
        ? EventCallback.Factory.Create(this, CreateAsync)
        : default;

    EventCallback DeleteCallback => _task is not null
        ? EventCallback.Factory.Create(this, DeleteAsync)
        : default;

    bool Done => _task is not null && (_task.IsRecurring
        ? _task.CompletedDays.Contains(State.Today)
        : _task.CompletedAt is not null);

    DateTime? DueDate => _task?.DueOn?.ToDateTime(TimeOnly.MinValue);

    protected override async Task OnParametersSetAsync()
    {
        if (NewInList != _draftFor)
        {
            _draftFor = NewInList;
            _draft = new TaskDraft { ListId = NewInList ?? Guid.Empty };
        }

        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        _task = TaskId is null ? null : await Store.LoadAsync(TaskId.Value, CancellationToken.None);

        if (_task is null && NewInList is null)
        {
            return;
        }

        var lists = await Lists.LoadAllAsync(State.UserId, CancellationToken.None);
        _lists = [.. lists.Where(list => !list.Deleted).OrderBy(list => list.Position)];
        var goals = await Goals.LoadAllAsync(State.UserId, CancellationToken.None);
        _goals = [.. goals.Where(goal => !goal.Deleted)];
    }

    async Task CreateAsync()
    {
        var name = _draft.Name.Trim();

        if (Disabled || name.Length == 0)
        {
            return;
        }

        var taskId = Guid.NewGuid();
        await Sender.SendAsync(new CreateTask(Guid.NewGuid(), State.UserId, taskId, _draft.ListId, name));

        if (_draft.DueDate is { } due)
        {
            await Sender.SendAsync(new SetTaskDueDate(
                Guid.NewGuid(), State.UserId, taskId, DateOnly.FromDateTime(due)));
        }

        if (_draft.Priority != Priority.None)
        {
            await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, taskId, _draft.Priority));
        }

        if (_draft.GoalId is not null)
        {
            await Sender.SendAsync(new LinkTaskToGoal(Guid.NewGuid(), State.UserId, taskId, _draft.GoalId));
        }

        if (_draft.Starred)
        {
            await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, taskId, true));
        }

        _draft = new TaskDraft { ListId = _draft.ListId };
        await OnClose.InvokeAsync();
    }

    async Task RenameAsync(string name)
    {
        if (Disabled || string.IsNullOrWhiteSpace(name) || name.Trim() == _task!.Name)
        {
            return;
        }

        await Sender.SendAsync(new RenameTask(Guid.NewGuid(), State.UserId, _task.Id, name.Trim()));
        await ReloadAsync();
    }

    async Task CompleteAsync(bool completed)
    {
        if (Disabled)
        {
            return;
        }

        if (_task!.IsRecurring)
        {
            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, _task.Id, State.Today, completed));
        }
        else if (completed)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, _task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, _task.Id));
        }

        await ReloadAsync();
    }

    async Task StarAsync(bool starred)
    {
        if (Disabled)
        {
            return;
        }

        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, _task!.Id, starred));
        await ReloadAsync();
    }

    async Task PriorityAsync(Priority priority)
    {
        if (Disabled)
        {
            return;
        }

        await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, _task!.Id, priority));
        await ReloadAsync();
    }

    async Task DueDateAsync(DateTime? date)
    {
        if (Disabled)
        {
            return;
        }

        var dueOn = date is null ? null : (DateOnly?)DateOnly.FromDateTime(date.Value);
        await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, _task!.Id, dueOn));
        await ReloadAsync();
    }

    async Task MoveToListAsync(Guid listId)
    {
        if (Disabled)
        {
            return;
        }

        await Sender.SendAsync(new MoveTaskToList(Guid.NewGuid(), State.UserId, _task!.Id, listId));
        await ReloadAsync();
    }

    async Task LinkGoalAsync(Guid? goalId)
    {
        if (Disabled)
        {
            return;
        }

        await Sender.SendAsync(new LinkTaskToGoal(Guid.NewGuid(), State.UserId, _task!.Id, goalId));
        await ReloadAsync();
    }

    async Task DeleteAsync()
    {
        if (Disabled || _task is null)
        {
            return;
        }

        await Sender.SendAsync(new DeleteTask(Guid.NewGuid(), State.UserId, _task.Id));
        await OnClose.InvokeAsync();
    }

    sealed class TaskDraft
    {
        public string Name { get; set; } = "";

        public DateTime? DueDate { get; set; }

        public Priority Priority { get; set; } = Priority.None;

        public Guid? GoalId { get; set; }

        public Guid ListId { get; set; }

        public bool Starred { get; set; }
    }
}
