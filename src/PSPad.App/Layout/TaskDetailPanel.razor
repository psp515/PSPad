@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Presentation.AreaViews
@using PSPad.Module.Presentation.ListViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Recurrence
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<TodoTask> Store
@inject IDocumentStore<Area> Areas
@inject IDocumentStore<TaskList> Lists
@inject IDocumentStore<AreaView> Views
@inject IDocumentStore<ListView> ListViews
@inject IDocumentStore<Goal> Goals
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<TasksStrings> T
@inject IStringLocalizer<SharedStrings> Shared
@inject IStringLocalizer<ListsStrings> ListText

<DetailPanel Open="@(Mode != PanelMode.Closed)" Title="@Title" TitleTypo="Typo.body2" OnClose="@OnClose"
             OnSave="@SaveCallback" SaveText="@T["AddTask"]" CanSave="@(!_creating && !string.IsNullOrWhiteSpace(_draft.Name) && _draft.ListId is not null)"
             Disabled="@Disabled">
    <HeaderActions>
        <MudIconButton Class="pspad-task-star" Color="Color.Primary" Disabled="@Disabled"
                       Icon="@(Starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                       aria-label="@(Starred ? T["Unstar"].Value : T["Star"].Value)" OnClick="@ToggleStarAsync" />
    </HeaderActions>
    <ChildContent>
        <div class="d-flex align-center gap-1 px-2 pt-3 pb-1">
            @if (_task is not null)
            {
                <MudCheckBox T="bool" Class="pspad-task-done" Value="@Done" ValueChanged="@CompleteAsync"
                             Color="Color.Primary" Disabled="@Disabled" aria-label="@Shared["Done"].Value" />
            }
            <MudTextField T="string" Class="@($"pspad-task-name-field flex-grow-1 {(_task is null ? "px-2" : "")}")"
                          Value="@Name" ValueChanged="@NameChangedAsync" Placeholder="@T["TaskName"]" MaxLength="@ContentLimits.Name"
                          Typo="Typo.h6" Underline="false" Immediate="@(Mode == PanelMode.Add)"
                          AutoFocus="@(Mode == PanelMode.Add)" Disabled="@Disabled"
                          OnKeyDown="@AddOnEnterAsync"
                          Style="@(Done ? "text-decoration:line-through" : "")" />
        </div>

        @if (_task is not null)
        {
            <div class="pl-5 pr-3 pb-3">
                <StepList Task="@_task" UserId="@State.UserId" Today="@State.Today" Disabled="@Disabled" Changed="@ReloadAsync" />
            </div>
        }
        else if (Mode == PanelMode.Add)
        {
            <div class="pl-5 pr-3 pb-3">
                <StepList @key="_draft" Draft="@_draft.Steps" UserId="@State.UserId" Today="@State.Today" Repeating="@Repeats"
                          Disabled="@Disabled" />
            </div>
        }

        <MudDivider />

        <div class="py-2 px-2 d-flex flex-column gap-1">
            <MudToggleGroup T="bool" Value="@Repeats" ValueChanged="@KindAsync" Class="pspad-task-kind mx-2 mb-1"
                            Color="Color.Primary" Outlined="true" Size="Size.Small" Disabled="@Disabled">
                <MudToggleItem Value="false" Text="@T["OneTime"]" />
                <MudToggleItem Value="true" Text="@T["Repeating"]" />
            </MudToggleGroup>

            @if (Repeats)
            {
                <RecurrenceEditor Value="@Recurrence" ValueChanged="@RecurrenceAsync" Task="@_task"
                                  Today="@State.Today" Disabled="@Disabled" />
            }

            <DueDateRow Value="@DueOn" ValueChanged="@DueDateAsync" Today="@State.Today" Disabled="@Disabled"
                        Label="@(Repeats ? T["Until"] : T["Due"])" EmptyText="@(Repeats ? T["NoEndDate"] : T["NoDueDate"])"
                        FlagsPast="@(!Repeats)" />

            @if (Repeats || DueOn is not null)
            {
                <TimeRow Value="@Time" ValueChanged="@TimeAsync" Disabled="@Disabled" />
                <LeadTimeRow Value="@LeadTime" ValueChanged="@LeadTimeAsync" Disabled="@Disabled" />
            }

            <PriorityRow Value="@Priority" ValueChanged="@PriorityAsync" Disabled="@Disabled" />

            <GoalRow Goals="@_goals" Value="@GoalId" ValueChanged="@LinkGoalAsync" Disabled="@Disabled" />

            @if (_task is not null)
            {
                <ListRow Placement="@_placement" Lists="@_lists" Value="@_task.ListId" ValueChanged="@MoveToListAsync"
                         Disabled="@Disabled" />
            }
            else if (NewInList is null)
            {
                <ListRow Placement="@_placement" Lists="@_lists" Value="@_draft.ListId" ValueChanged="@PickList"
                         Disabled="@Disabled" />
            }
        </div>

        @if (_task is not null)
        {
            <PanelSection Title="@T["Description"]" Class="pspad-task-description">
                <MarkdownField @key="_task.Id" Value="@_task.Description" OnSave="@SaveDescriptionAsync"
                               Disabled="@Disabled" />
            </PanelSection>
        }

        @if (_task is not null && _task.SnapshotMarks.Count > 0)
        {
            <PanelSection Title="@T["SnapshotMarks"]" Class="pspad-task-snapshot-marks">
                <div class="d-flex align-center gap-2">
                    <SnapshotMarkChip />
                    <MudText Typo="Typo.caption" Class="pspad-muted">
                        @NewestMark(_task.SnapshotMarks)!.MarkedAt.ToString("d MMM yyyy")
                    </MudText>
                    <MudSpacer />
                    <MudButton Class="pspad-task-snapshot-dismiss" Variant="Variant.Text" Disabled="@Disabled"
                               OnClick="@DismissSnapshotMarksAsync">
                        @T["SnapshotDismiss"]
                    </MudButton>
                </div>
            </PanelSection>
        }
    </ChildContent>
    <Footer>
        @if (_task is not null)
        {
            <div class="d-flex align-center pspad-task-footer">
                <MudText Typo="Typo.caption" Class="pspad-muted">@CreatedText</MudText>
                <MudSpacer />
                <MudTooltip Text="@T["DeleteTask"]">
                    <MudIconButton Class="pspad-task-delete" Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error" aria-label="@T["DeleteTask"].Value" Disabled="@Disabled"
                                   OnClick="@DeleteAsync" />
                </MudTooltip>
            </div>
        }
    </Footer>
</DetailPanel>

@code {
    [Parameter] public Guid? TaskId { get; set; }

    [Parameter] public Guid? NewInList { get; set; }

    [Parameter] public bool NewTask { get; set; }

    [Parameter] public DateOnly? NewDue { get; set; }

    [Parameter] public TimeOnly? NewTime { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    enum PanelMode { Closed, Add, Edit, View }

    TodoTask? _task;

    int _reload;
    ListPlacement _placement = ListPlacement.Empty;
    IReadOnlyList<TaskList> _lists = [];
    IReadOnlyList<Goal> _goals = [];
    (bool, Guid?, DateOnly?, TimeOnly?) _draftFor;
    bool _creating;
    TaskDraft _draft = new();

    bool Adding => NewTask || NewInList is not null;

    PanelMode Mode => (_task, Adding, Disabled) switch
    {
        ({ }, _, true) => PanelMode.View,
        ({ }, _, false) => PanelMode.Edit,
        (null, true, _) => PanelMode.Add,
        _ => PanelMode.Closed
    };

    string Title => Mode switch
    {
        PanelMode.Add => _draft.ListId is { } listId && PathOf(listId) is { } path ? T["NewTaskIn", path] : T["NewTask"],
        PanelMode.Closed => "",
        _ => PathOf(_task!.ListId) ?? T["TaskTitle"]
    };

    EventCallback SaveCallback => Mode == PanelMode.Add
        ? EventCallback.Factory.Create(this, CreateAsync)
        : default;

    string Name => _task?.Name ?? _draft.Name;

    bool Starred => _task?.Starred ?? _draft.Starred;

    Priority Priority => _task?.Priority ?? _draft.Priority;

    Guid? GoalId => _task is null ? _draft.GoalId : Goal.Holding(_goals, _task.Id)?.Id;


    DateOnly? DueOn => _task is null ? _draft.DueOn : _task.DueOn;

    RecurrenceRule? Recurrence => _task is null ? _draft.Recurrence : _task.Recurrence;

    TaskTime? Time => _task is null ? _draft.Time : _task.Time;

    LeadTime? LeadTime => _task is null ? _draft.LeadTime : _task.LeadTime;

    bool Repeats => Recurrence is not null;

    bool Done => _task is not null && (_task.IsRecurring
        ? _task.EndedBy(State.Today) || _task.CompletedDays.Contains(State.Today)
        : _task.CompletedAt is not null);

    string CreatedText => _task?.CreatedAt is { } created ? T["Created", created.ToString("ddd, d MMM yyyy")] : "";

    string? PathOf(Guid listId) => ListRow.PathOf(listId, _placement, _lists, ListText["SharedWithMe"]);

    protected override async Task OnParametersSetAsync()
    {
        if ((NewTask, NewInList, NewDue, NewTime) != _draftFor)
        {
            _draftFor = (NewTask, NewInList, NewDue, NewTime);
            _draft = NewDraft();
        }

        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        var reload = ++_reload;
        var loaded = TaskId is null ? null : await Store.LoadAsync(TaskId.Value, CancellationToken.None);
        var task = loaded is { Deleted: false } ? loaded : null;

        if (task is null && !Adding)
        {
            if (reload == _reload)
            {
                _task = null;
            }

            return;
        }

        var areas = await Areas.LoadAllAsync(State.UserId, CancellationToken.None);
        var lists = await Lists.LoadAllAsync(State.UserId, CancellationToken.None);
        var views = await Views.LoadAllAsync(State.UserId, CancellationToken.None);
        var listViews = await ListViews.LoadAllAsync(State.UserId, CancellationToken.None);
        var goals = await Goals.LoadAllAsync(State.UserId, CancellationToken.None);

        // A reload started later has already read newer documents; letting this one land would show the task as it was before the last command.
        if (reload != _reload)
        {
            return;
        }

        _task = task;
        _placement = ListPlacement.For(State.UserId, areas, lists, views, listViews);
        var current = task is null ? null : _placement.All.FirstOrDefault(list => list.Id == task.ListId);
        _lists = [.. _placement.All.Where(list =>
            list.Kind == ListKind.Tasks && (current is null || list.UserId == current.UserId))];
        _goals = [.. goals.Where(goal => !goal.Deleted)];
    }

    async Task AddOnEnterAsync(KeyboardEventArgs args)
    {
        if (Mode == PanelMode.Add && args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    async Task CreateAsync()
    {
        if (_creating)
        {
            return;
        }

        _creating = true;
        try
        {
            await CreateOnceAsync();
        }
        finally
        {
            _creating = false;
        }
    }

    async Task CreateOnceAsync()
    {
        var name = _draft.Name.Trim();

        if (Disabled || _draft.ListId is not { } listId || name.Length == 0)
        {
            return;
        }

        var taskId = Guid.NewGuid();
        await Sender.SendAsync(new CreateTask(Guid.NewGuid(), State.UserId, taskId, listId, name));

        foreach (var step in _draft.Steps)
        {
            var stepId = Guid.NewGuid();
            await Sender.SendAsync(new AddStep(Guid.NewGuid(), State.UserId, taskId, stepId, step.Name));
            if (step.DueOn is { } stepDue)
            {
                await Sender.SendAsync(new SetStepDueDate(Guid.NewGuid(), State.UserId, taskId, stepId, stepDue));
            }
        }

        if (_draft.Recurrence is { } rule)
        {
            await Sender.SendAsync(new SetTaskRecurrence(Guid.NewGuid(), State.UserId, taskId, rule));
        }

        if (_draft.DueOn is { } due)
        {
            await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, taskId, due));
        }

        if (_draft.Time is { } time)
        {
            await Sender.SendAsync(new SetTaskTime(Guid.NewGuid(), State.UserId, taskId, time));
        }

        if (_draft.LeadTime is { } lead)
        {
            await Sender.SendAsync(new SetTaskLeadTime(Guid.NewGuid(), State.UserId, taskId, lead));
        }

        if (_draft.Priority != Priority.None)
        {
            await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, taskId, _draft.Priority));
        }

        if (_draft.GoalId is { } goalId)
        {
            await Sender.SendAsync(new AddTaskToGoal(Guid.NewGuid(), State.UserId, goalId, taskId));
        }

        if (_draft.Starred)
        {
            await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, taskId, true));
        }

        _draft = NewDraft();
        await OnClose.InvokeAsync();
    }

    async Task NameChangedAsync(string name)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Name = name;
            return;
        }

        if (string.IsNullOrWhiteSpace(name) || name.Trim() == _task.Name)
        {
            return;
        }

        await Sender.SendAsync(new RenameTask(Guid.NewGuid(), State.UserId, _task.Id, name.Trim()));
        await ReloadAsync();
    }

    async Task<bool> SaveDescriptionAsync(string text)
    {
        if (Disabled || _task is null)
        {
            return false;
        }

        var result = await Sender.SendAsync(new SetTaskDescription(Guid.NewGuid(), State.UserId, _task.Id, text));

        if (!result.Accepted)
        {
            Snackbar.Add(result.Rejection ?? T["DescriptionNotSaved"], Severity.Warning);
            return false;
        }

        await ReloadAsync();
        StateHasChanged();
        return true;
    }

    async Task ToggleStarAsync()
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Starred = !_draft.Starred;
            return;
        }

        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, _task.Id, !_task.Starred));
        await ReloadAsync();
    }

    async Task DueDateAsync(DateOnly? dueOn)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.DueOn = dueOn;
            return;
        }

        await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, _task.Id, dueOn));
        await ReloadAsync();
    }

    async Task RecurrenceAsync(RecurrenceRule? rule)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Recurrence = rule;
            if (rule is not null && _draft.DueOn < rule.StartsOn)
            {
                _draft.DueOn = null;
            }

            return;
        }

        await Sender.SendAsync(new SetTaskRecurrence(Guid.NewGuid(), State.UserId, _task.Id, rule));

        if (rule is not null && _task.DueOn < rule.StartsOn)
        {
            await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, _task.Id, null));
        }
        await ReloadAsync();
    }

    async Task KindAsync(bool repeats)
    {
        if (Disabled || repeats == Repeats)
        {
            return;
        }

        var rule = repeats ? RecurrenceRule.Daily(State.Today) : null;

        if (_task is null)
        {
            _draft.Recurrence = rule;
            _draft.DueOn = null;
            return;
        }

        await Sender.SendAsync(new SetTaskRecurrence(Guid.NewGuid(), State.UserId, _task.Id, rule));

        if (_task.DueOn is not null)
        {
            await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, _task.Id, null));
        }

        await ReloadAsync();
    }

    async Task TimeAsync(TaskTime? time)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Time = time;
            return;
        }

        await Sender.SendAsync(new SetTaskTime(Guid.NewGuid(), State.UserId, _task.Id, time));
        await ReloadAsync();
    }

    async Task LeadTimeAsync(LeadTime? lead)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.LeadTime = lead;
            return;
        }

        await Sender.SendAsync(new SetTaskLeadTime(Guid.NewGuid(), State.UserId, _task.Id, lead));
        await ReloadAsync();
    }

    async Task PriorityAsync(Priority priority)
    {
        if (Disabled || priority == Priority)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Priority = priority;
            return;
        }

        await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, _task.Id, priority));
        await ReloadAsync();
    }

    async Task LinkGoalAsync(Guid? goalId)
    {
        if (Disabled || goalId == GoalId)
        {
            return;
        }

        if (_task is null)
        {
            _draft.GoalId = goalId;
            return;
        }

        if (goalId is { } chosen)
        {
            await Sender.SendAsync(new AddTaskToGoal(Guid.NewGuid(), State.UserId, chosen, _task.Id));
        }
        else
        {
            await Sender.SendAsync(new RemoveTaskFromGoal(Guid.NewGuid(), State.UserId, GoalId!.Value, _task.Id));
        }

        await ReloadAsync();
    }

    async Task CompleteAsync(bool completed)
    {
        if (Disabled || _task is null)
        {
            return;
        }

        if (_task.IsRecurring && !_task.OccursOn(State.Today) && !_task.CompletedDays.Contains(State.Today))
        {
            return;
        }

        if (_task.IsRecurring)
        {
            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, _task.Id, State.Today, completed));
        }
        else if (completed)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, _task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, _task.Id));
        }

        await ReloadAsync();
    }

    async Task MoveToListAsync(Guid listId)
    {
        if (Disabled || _task is null || listId == _task.ListId)
        {
            return;
        }

        await Sender.SendAsync(new MoveTaskToList(Guid.NewGuid(), State.UserId, _task.Id, listId));
        await ReloadAsync();
    }

    async Task DismissSnapshotMarksAsync()
    {
        if (Disabled || _task is null)
        {
            return;
        }

        await Sender.SendAsync(new ClearTaskSnapshotMarks(Guid.NewGuid(), State.UserId, _task.Id));
        await ReloadAsync();
    }

    static SnapshotMark? NewestMark(IReadOnlyList<SnapshotMark> marks) =>
        marks.OrderByDescending(mark => mark.MarkedAt).FirstOrDefault();

    async Task DeleteAsync()
    {
        if (Disabled || _task is null)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, T["DeleteTaskConfirm", _task.Name].Value }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(T["DeleteTask"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteTask(Guid.NewGuid(), State.UserId, _task.Id));
        await OnClose.InvokeAsync();
    }

    TaskDraft NewDraft() => new()
    {
        ListId = NewInList,
        DueOn = NewDue,
        Time = NewTime is { } start ? new TaskTime(start, start.AddHours(1)) : null
    };

    void PickList(Guid listId) => _draft.ListId = listId;

    sealed class TaskDraft
    {
        public string Name { get; set; } = "";

        public Guid? ListId { get; set; }

        public List<StepDraft> Steps { get; } = [];

        public DateOnly? DueOn { get; set; }

        public RecurrenceRule? Recurrence { get; set; }

        public TaskTime? Time { get; set; }

        public LeadTime? LeadTime { get; set; }

        public Priority Priority { get; set; } = Priority.None;

        public Guid? GoalId { get; set; }

        public bool Starred { get; set; }
    }
}
