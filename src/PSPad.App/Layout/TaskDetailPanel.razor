@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<TodoTask> Store
@inject IDocumentStore<Area> Areas
@inject IDocumentStore<TaskList> Lists
@inject IDocumentStore<Goal> Goals
@inject AppState State
@inject CommandSender Sender

<DetailPanel Open="@(Mode != PanelMode.Closed)" Title="@Title" OnClose="@OnClose"
             OnSave="@SaveCallback" SaveText="Add task" CanSave="@(!string.IsNullOrWhiteSpace(_draft.Name))"
             Disabled="@Disabled">
    <HeaderActions>
        @if (_task is not null)
        {
            <MudCheckBox T="bool" Class="pspad-task-done" Value="@Done" ValueChanged="@CompleteAsync"
                         Color="Color.Primary" Disabled="@Disabled" aria-label="Done" />
        }
        <MudIconButton Class="pspad-task-star" Color="Color.Primary" Disabled="@Disabled"
                       Icon="@(Starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                       aria-label="Star" OnClick="@ToggleStarAsync" />
    </HeaderActions>
    <Header>
        <MudTextField T="string" Class="pspad-task-name-field" Label="Name" Value="@Name"
                      ValueChanged="@NameChangedAsync" Immediate="@(Mode == PanelMode.Add)"
                      AutoFocus="@(Mode == PanelMode.Add)" Disabled="@Disabled" />
    </Header>
    <ChildContent>
        <div class="pa-3 d-flex flex-column gap-4">
            <DueDatePicker Value="@DueOn" ValueChanged="@DueDateAsync" Today="@State.Today"
                           Disabled="@(Disabled || _task?.IsRecurring == true)" />

            <div class="d-flex flex-column gap-1">
                <MudText Typo="Typo.caption">Priority</MudText>
                <MudToggleGroup T="Priority" Class="pspad-task-priority" Value="@Priority"
                                ValueChanged="@PriorityAsync" Color="Color.Primary" Size="Size.Small"
                                Outlined="true" Delimiters="true" Disabled="@Disabled">
                    @foreach (var priority in Enum.GetValues<Priority>())
                    {
                        <MudToggleItem Value="@priority" Text="@priority.ToString()" />
                    }
                </MudToggleGroup>
            </div>

            <MudSelect T="Guid?" Class="pspad-task-goal" Value="@GoalId" ValueChanged="@LinkGoalAsync"
                       Label="Goal" Disabled="@Disabled">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>
                @foreach (var goal in _goals)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)goal.Id)">@goal.Name</MudSelectItem>
                }
            </MudSelect>

            @if (_task is not null)
            {
                <RecurrenceEditor Task="@_task" UserId="@State.UserId" Today="@State.Today"
                                  Disabled="@Disabled" Changed="@ReloadAsync" />

                <StepList Task="@_task" UserId="@State.UserId" Disabled="@Disabled" Changed="@ReloadAsync" />
            }
        </div>
    </ChildContent>
    <Footer>
        @if (_task is not null)
        {
            <div class="d-flex flex-column gap-2 pspad-task-actions">
                <MudText Typo="Typo.overline">Actions</MudText>

                <div class="d-flex gap-2">
                    <MudSelect T="Guid" Class="pspad-task-area flex-1" Value="@_moveAreaId"
                               ValueChanged="@MoveAreaChanged" Label="Area" Dense="true" Disabled="@Disabled">
                        @foreach (var area in _areas)
                        {
                            <MudSelectItem T="Guid" Value="@area.Id">@area.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="Guid" Class="pspad-task-list flex-1" @bind-Value="_moveListId" Label="List"
                               Dense="true" Disabled="@Disabled">
                        @foreach (var list in ListsIn(_moveAreaId))
                        {
                            <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="d-flex align-center mt-2">
                    <MudButton Class="pspad-task-move" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.DriveFileMove"
                               Disabled="@(Disabled || !MoveChanged)" OnClick="@MoveAsync">
                        Move
                    </MudButton>
                    <MudSpacer />
                    <MudButton Class="pspad-task-delete" Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete" Disabled="@Disabled"
                               OnClick="@DeleteAsync">
                        Delete
                    </MudButton>
                </div>
            </div>
        }
    </Footer>
</DetailPanel>

@code {
    [Parameter] public Guid? TaskId { get; set; }

    [Parameter] public Guid? NewInList { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    enum PanelMode { Closed, Add, Edit, View }

    TodoTask? _task;
    IReadOnlyList<Area> _areas = [];
    IReadOnlyList<TaskList> _lists = [];
    IReadOnlyList<Goal> _goals = [];
    Guid? _draftFor;
    TaskDraft _draft = new();
    Guid? _moveFor;
    Guid _moveAreaId;
    Guid _moveListId;

    PanelMode Mode => (_task, NewInList, Disabled) switch
    {
        ({ }, _, true) => PanelMode.View,
        ({ }, _, false) => PanelMode.Edit,
        (null, { }, _) => PanelMode.Add,
        _ => PanelMode.Closed
    };

    string Title => Mode switch
    {
        PanelMode.Add => "New task",
        PanelMode.Edit => "Edit task",
        _ => "Task"
    };

    EventCallback SaveCallback => Mode == PanelMode.Add
        ? EventCallback.Factory.Create(this, CreateAsync)
        : default;

    string Name => _task?.Name ?? _draft.Name;

    bool Starred => _task?.Starred ?? _draft.Starred;

    Priority Priority => _task?.Priority ?? _draft.Priority;

    Guid? GoalId => _task is null ? _draft.GoalId : _task.GoalId;

    DateOnly? DueOn => _task is null ? _draft.DueOn : _task.DueOn;

    bool Done => _task is not null && (_task.IsRecurring
        ? _task.CompletedDays.Contains(State.Today)
        : _task.CompletedAt is not null);

    bool MoveChanged => _task is not null && _moveListId != Guid.Empty && _moveListId != _task.ListId;

    protected override async Task OnParametersSetAsync()
    {
        if (NewInList != _draftFor)
        {
            _draftFor = NewInList;
            _draft = new TaskDraft();
        }

        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        _task = TaskId is null ? null : await Store.LoadAsync(TaskId.Value, CancellationToken.None);

        if (_task is null && NewInList is null)
        {
            return;
        }

        var areas = await Areas.LoadAllAsync(State.UserId, CancellationToken.None);
        _areas = [.. areas.Where(area => !area.Deleted).OrderBy(area => area.Position)];
        var lists = await Lists.LoadAllAsync(State.UserId, CancellationToken.None);
        _lists = [.. lists.Where(list => !list.Deleted).OrderBy(list => list.Position)];
        var goals = await Goals.LoadAllAsync(State.UserId, CancellationToken.None);
        _goals = [.. goals.Where(goal => !goal.Deleted)];

        if (_task is not null && _moveFor != _task.Id)
        {
            ResetMoveTarget();
        }
    }

    void ResetMoveTarget()
    {
        _moveFor = _task!.Id;
        _moveListId = _task.ListId;
        _moveAreaId = _lists.FirstOrDefault(list => list.Id == _task.ListId)?.AreaId ?? Guid.Empty;
    }

    IReadOnlyList<TaskList> ListsIn(Guid areaId) => [.. _lists.Where(list => list.AreaId == areaId)];

    void MoveAreaChanged(Guid areaId)
    {
        _moveAreaId = areaId;
        _moveListId = ListsIn(areaId).FirstOrDefault()?.Id ?? Guid.Empty;
    }

    async Task CreateAsync()
    {
        var name = _draft.Name.Trim();

        if (Disabled || NewInList is not { } listId || name.Length == 0)
        {
            return;
        }

        var taskId = Guid.NewGuid();
        await Sender.SendAsync(new CreateTask(Guid.NewGuid(), State.UserId, taskId, listId, name));

        if (_draft.DueOn is { } due)
        {
            await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, taskId, due));
        }

        if (_draft.Priority != Priority.None)
        {
            await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, taskId, _draft.Priority));
        }

        if (_draft.GoalId is not null)
        {
            await Sender.SendAsync(new LinkTaskToGoal(Guid.NewGuid(), State.UserId, taskId, _draft.GoalId));
        }

        if (_draft.Starred)
        {
            await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, taskId, true));
        }

        _draft = new TaskDraft();
        await OnClose.InvokeAsync();
    }

    async Task NameChangedAsync(string name)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Name = name;
            return;
        }

        if (string.IsNullOrWhiteSpace(name) || name.Trim() == _task.Name)
        {
            return;
        }

        await Sender.SendAsync(new RenameTask(Guid.NewGuid(), State.UserId, _task.Id, name.Trim()));
        await ReloadAsync();
    }

    async Task ToggleStarAsync()
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Starred = !_draft.Starred;
            return;
        }

        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, _task.Id, !_task.Starred));
        await ReloadAsync();
    }

    async Task DueDateAsync(DateOnly? dueOn)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.DueOn = dueOn;
            return;
        }

        await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, _task.Id, dueOn));
        await ReloadAsync();
    }

    async Task PriorityAsync(Priority priority)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.Priority = priority;
            return;
        }

        await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, _task.Id, priority));
        await ReloadAsync();
    }

    async Task LinkGoalAsync(Guid? goalId)
    {
        if (Disabled)
        {
            return;
        }

        if (_task is null)
        {
            _draft.GoalId = goalId;
            return;
        }

        await Sender.SendAsync(new LinkTaskToGoal(Guid.NewGuid(), State.UserId, _task.Id, goalId));
        await ReloadAsync();
    }

    async Task CompleteAsync(bool completed)
    {
        if (Disabled || _task is null)
        {
            return;
        }

        if (_task.IsRecurring)
        {
            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, _task.Id, State.Today, completed));
        }
        else if (completed)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, _task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, _task.Id));
        }

        await ReloadAsync();
    }

    async Task MoveAsync()
    {
        if (Disabled || !MoveChanged)
        {
            return;
        }

        await Sender.SendAsync(new MoveTaskToList(Guid.NewGuid(), State.UserId, _task!.Id, _moveListId));
        await ReloadAsync();
        ResetMoveTarget();
    }

    async Task DeleteAsync()
    {
        if (Disabled || _task is null)
        {
            return;
        }

        await Sender.SendAsync(new DeleteTask(Guid.NewGuid(), State.UserId, _task.Id));
        await OnClose.InvokeAsync();
    }

    sealed class TaskDraft
    {
        public string Name { get; set; } = "";

        public DateOnly? DueOn { get; set; }

        public Priority Priority { get; set; } = Priority.None;

        public Guid? GoalId { get; set; }

        public bool Starred { get; set; }
    }
}
