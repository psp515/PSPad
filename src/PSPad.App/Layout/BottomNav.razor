@using PSPad.App.State
@inject NavigationManager Navigation
@inject SidebarCounts Counts
@inject IStringLocalizer<ShellStrings> T
@inject IStringLocalizer<SharedStrings> S
@implements IDisposable

<MudAppBar Bottom="true" Elevation="1" Class="d-md-none pspad-bottom-nav">
    <nav class="pspad-bottom-nav-slots" aria-label="@T["MainNavigation"].Value">
        @Tab(NavTab.Inbox, "/inbox", Icons.Material.Filled.Inbox, S["Inbox"], Counts.Inbox)
        @Tab(NavTab.Areas, "/areas", Icons.Material.Filled.Folder, S["Areas"], 0)
        <a href="/" class="@($"pspad-tab-myday {(Active == NavTab.MyDay ? "pspad-tab-active" : "")}")"
           aria-label="@S["MyDay"].Value"
           aria-current="@(Active == NavTab.MyDay ? "page" : null)">
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.WbSunny"
                    Class="pspad-myday-fab" UserAttributes="@MyDayFabAttributes" />
            <span class="pspad-tab-label" aria-hidden="true">@S["MyDay"]</span>
        </a>
        @Tab(NavTab.Budgets, "/budgets", Icons.Material.Filled.AccountBalanceWallet, S["Budgets"], 0)
        @Tab(NavTab.Portfolio, "/investments", Icons.Material.Rounded.ShowChart, T["NavPortfolio"], 0)
    </nav>
</MudAppBar>

@code {
    static readonly Dictionary<string, object> CurrentPage = new() { ["aria-current"] = "page" };
    static readonly Dictionary<string, object> NoAttributes = [];
    static readonly Dictionary<string, object> MyDayFabAttributes =
        new() { ["aria-hidden"] = "true", ["tabindex"] = "-1" };

    NavTab Active => ActiveTab.For(Navigation.ToBaseRelativePath(Navigation.Uri));

    RenderFragment Tab(NavTab tab, string href, string icon, string label, int badge) =>
        @<MudButton Href="@href" Variant="Variant.Text"
                    Color="@(Active == tab ? Color.Primary : Color.Default)"
                    Class="@($"pspad-tab {(Active == tab ? "pspad-tab-active" : "")}")"
                    UserAttributes="@(Active == tab ? CurrentPage : NoAttributes)">
            <span class="pspad-tab-icon">
                <MudBadge Content="@badge" Visible="@(badge > 0)" Color="Color.Error" Overlap="true">
                    <MudIcon Icon="@icon" />
                </MudBadge>
            </span>
            <span class="pspad-tab-label">@label</span>
        </MudButton>;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Counts.Changed += OnCountsChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs args) => InvokeAsync(StateHasChanged);

    void OnCountsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Counts.Changed -= OnCountsChanged;
    }
}
