@inject NavigationManager Navigation

<MudPaper Elevation="8" Square="true" Class="pspad-bottom-nav d-flex justify-space-around align-center">
    <MudButton StartIcon="@Icons.Material.Filled.Today" Color="@ColourFor("/")"
               OnClick="@(() => Navigation.NavigateTo("/"))">Today</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Inbox" Color="@ColourFor("/inbox")"
               OnClick="@(() => Navigation.NavigateTo("/inbox"))">Inbox</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Folder" Color="Color.Default"
               OnClick="@OnAreasRequested">Areas</MudButton>
</MudPaper>

@code {
    [Parameter] public EventCallback OnAreasRequested { get; set; }

    Color ColourFor(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var current = "/" + relative.Split('?')[0].TrimEnd('/');
        return current == path ? Color.Primary : Color.Default;
    }
}
