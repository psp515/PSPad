@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.State
@using PSPad.App.Sync
@using PSPad.App.Theme
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Today
@inject SyncCoordinator Coordinator
@inject AppState State
@inject PSPadApiClient Api
@inject ThemePreference Preference
@inject IDocumentStore<Area> AreaStore
@inject NavigationManager Navigation
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@PSPadTheme.Instance" IsDarkMode="@Preference.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">PSPad</MudText>
        <MudSpacer />
        @if (Coordinator.PendingCount > 0)
        {
            <MudBadge Content="@Coordinator.PendingCount" Color="Color.Warning" Overlap="true" Class="mr-4">
                <MudIcon Icon="@Icons.Material.Filled.CloudSync" />
            </MudBadge>
        }
        <ThemeToggle />
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="1" Class="d-none d-md-flex">
        <NavSidebar />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pspad-content">
            @if (_ready)
            {
                @Body
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

<AppFab />

<div class="d-md-none">
    <BottomNav OnAreasRequested="@(() => _sheetOpen = true)" />
    <AreaSheet Open="_sheetOpen" OpenChanged="@(open => _sheetOpen = open)" Areas="@_areas"
               OnAreaSelected="@GoToArea" OnNewAreaRequested="@GoToAreas" />
</div>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthStateTask { get; set; }

    MudThemeProvider? _themeProvider;
    bool _themeReady;
    bool _ready;
    bool _sheetOpen;
    IReadOnlyList<Area> _areas = [];

    protected override async Task OnInitializedAsync()
    {
        Coordinator.Changed += OnCoordinatorChanged;
        Preference.Changed += OnThemeChanged;

        var authState = AuthStateTask is null ? null : await AuthStateTask;
        if (authState?.User.Identity?.IsAuthenticated == true)
        {
            var me = await Api.MeAsync();

            if (me is not null)
            {
                State.UserId = me.UserId;
                State.TimeZone = me.TimeZone;
                State.Today = TodayRule.TodayIn(
                    DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(me.TimeZone));
                _areas = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
            }
        }

        _ready = true;
        Coordinator.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null || _themeReady)
        {
            return;
        }

        _themeReady = true;
        var systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Preference.InitialiseAsync(systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        StateHasChanged();
    }

    async Task OnSystemDarkModeChanged(bool prefersDark)
    {
        await Preference.InitialiseAsync(prefersDark);
        StateHasChanged();
    }

    void GoToArea(Area area)
    {
        _sheetOpen = false;
        Navigation.NavigateTo($"/areas?area={area.Id}");
    }

    void GoToAreas()
    {
        _sheetOpen = false;
        Navigation.NavigateTo("/areas");
    }

    void OnCoordinatorChanged() => InvokeAsync(StateHasChanged);

    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Coordinator.Changed -= OnCoordinatorChanged;
        Preference.Changed -= OnThemeChanged;
    }
}
