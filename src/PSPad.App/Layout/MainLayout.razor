@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using PSPad.App.Api
@using PSPad.App.State
@using PSPad.App.Sync
@using PSPad.App.Theme
@using PSPad.Module.Tasks.Today
@inject SyncCoordinator Coordinator
@inject AppState State
@inject PSPadApiClient Api
@inject ThemePreference Preference
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@PSPadTheme.Instance" IsDarkMode="@Preference.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">PSPad</MudText>
        @if (Coordinator.PendingCount > 0)
        {
            <MudSpacer />
            <MudBadge Content="@Coordinator.PendingCount" Color="Color.Warning" Overlap="true" Class="mr-4">
                <MudIcon Icon="@Icons.Material.Filled.CloudSync" />
            </MudBadge>
        }
    </MudAppBar>
    <MudDrawer Open="_open" OpenChanged="@(value => _open = value)" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Today">Today</MudNavLink>
            <MudNavLink Href="/inbox" Icon="@Icons.Material.Filled.Inbox">Inbox</MudNavLink>
            <MudNavLink Href="/areas" Icon="@Icons.Material.Filled.Folder">Areas</MudNavLink>
            <MudNavLink Href="/goals" Icon="@Icons.Material.Filled.Flag">Goals</MudNavLink>
            <MudNavLink Href="/history" Icon="@Icons.Material.Filled.History">History</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @if (_ready)
            {
                @Body
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthStateTask { get; set; }

    MudThemeProvider? _themeProvider;
    bool _themeReady;
    bool _open = true;
    bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Coordinator.Changed += OnCoordinatorChanged;
        Preference.Changed += OnThemeChanged;

        var authState = AuthStateTask is null ? null : await AuthStateTask;
        if (authState?.User.Identity?.IsAuthenticated == true)
        {
            var me = await Api.MeAsync();
            State.UserId = me!.UserId;
            State.TimeZone = me.TimeZone;
            State.Today = TodayRule.TodayIn(DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(me.TimeZone));
        }

        _ready = true;
        Coordinator.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null || _themeReady)
        {
            return;
        }

        _themeReady = true;
        var systemPrefersDark = await _themeProvider.GetSystemDarkModeAsync();
        await Preference.InitialiseAsync(systemPrefersDark);
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        StateHasChanged();
    }

    async Task OnSystemDarkModeChanged(bool prefersDark)
    {
        await Preference.InitialiseAsync(prefersDark);
        StateHasChanged();
    }

    void OnCoordinatorChanged() => InvokeAsync(StateHasChanged);

    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    void ToggleDrawer() => _open = !_open;

    public void Dispose()
    {
        Coordinator.Changed -= OnCoordinatorChanged;
        Preference.Changed -= OnThemeChanged;
    }
}
