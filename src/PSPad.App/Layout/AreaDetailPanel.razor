@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Presentation.AreaViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Ordering
@using PSPad.Module.Tasks.References
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<Area> Areas
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<ReferenceItem> ItemStore
@inject IDocumentStore<AreaView> ViewStore
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<DetailPanel Open="@(IsNew || _area is not null)" Title="@(IsNew ? "New area" : "Area")" OnClose="@OnClose"
             OnSave="@SaveCallback" SaveText="Add area" CanSave="@(!string.IsNullOrWhiteSpace(_draftName))"
             OnDelete="@DeleteCallback" DeleteText="Delete area" Disabled="@Disabled">
    <div class="pa-4">
        <MudTextField T="string" Class="pspad-area-name-field" Label="Name" Variant="Variant.Outlined"
                      Value="@(_area?.Name ?? _draftName)" ValueChanged="@NameChangedAsync"
                      Immediate="@IsNew" AutoFocus="@IsNew" Disabled="@Disabled" OnKeyDown="@AddOnEnterAsync" />
    </div>
    @if (_area is not null)
    {
        <PanelSection Title="@($"Lists · {_lists.Count}")" Class="pspad-area-lists">
            @if (_lists.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pspad-muted">No lists yet.</MudText>
            }
            @for (var index = 0; index < _lists.Count; index++)
            {
                var position = index;
                var list = _lists[index];
                <div @key="list.Id" class="pspad-step pspad-area-list-row d-flex align-center gap-1">
                    <span class="pspad-step-lead">
                        <MudIcon Icon="@ListIcon.For(list)" Size="Size.Small" Class="pspad-muted" />
                    </span>
                    <MudText Typo="Typo.body2" Class="pspad-area-list-name flex-grow-1">@list.Name</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                   Class="pspad-area-list-up pspad-step-action" aria-label="@($"Move {list.Name} up")"
                                   Disabled="@(Disabled || _moving || position == 0)"
                                   OnClick="@(() => MoveAsync(list.Id, position - 1))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                   Class="pspad-area-list-down pspad-step-action" aria-label="@($"Move {list.Name} down")"
                                   Disabled="@(Disabled || _moving || position == _lists.Count - 1)"
                                   OnClick="@(() => MoveAsync(list.Id, position + 1))" />
                </div>
            }
        </PanelSection>
    }
</DetailPanel>

@code {
    [Parameter] public Guid? AreaId { get; set; }

    [Parameter] public bool IsNew { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    Area? _area;
    IReadOnlyList<TaskList> _lists = [];
    bool _moving;
    string _draftName = "";

    EventCallback SaveCallback => IsNew ? EventCallback.Factory.Create(this, CreateAsync) : default;

    EventCallback DeleteCallback => _area is not null ? EventCallback.Factory.Create(this, DeleteAsync) : default;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNew)
        {
            _draftName = "";
        }

        var area = AreaId is null ? null : await Areas.LoadAsync(AreaId.Value, CancellationToken.None);
        _area = area is null || area.Deleted ? null : area;
        await LoadListsAsync();
    }

    async Task LoadListsAsync()
    {
        if (_area is null)
        {
            _lists = [];
            return;
        }

        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var view = await ViewStore.LoadAsync(AreaView.IdFor(State.UserId, _area.Id), CancellationToken.None);
        _lists = ListOrder.InArea(_area.Id, lists, view);
    }

    async Task MoveAsync(Guid listId, int toIndex)
    {
        if (Disabled || _moving || _area is null)
        {
            return;
        }

        _moving = true;

        try
        {
            await Sender.SendAsync(new ReorderLists(
                Guid.NewGuid(), State.UserId, _area.Id, [.. _lists.Select(list => list.Id)], listId, toIndex));
            await LoadListsAsync();
        }
        finally
        {
            _moving = false;
        }
    }

    async Task NameChangedAsync(string name)
    {
        if (Disabled)
        {
            return;
        }

        if (_area is null)
        {
            _draftName = name;
            return;
        }

        if (string.IsNullOrWhiteSpace(name) || name.Trim() == _area.Name)
        {
            return;
        }

        await Sender.SendAsync(new RenameArea(Guid.NewGuid(), State.UserId, _area.Id, name.Trim()));
        _area = await Areas.LoadAsync(_area.Id, CancellationToken.None);
    }

    async Task AddOnEnterAsync(KeyboardEventArgs args)
    {
        if (IsNew && args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    async Task CreateAsync()
    {
        var name = _draftName.Trim();

        if (Disabled || !IsNew || name.Length == 0)
        {
            return;
        }

        var existing = await Areas.LoadAllAsync(State.UserId, CancellationToken.None);
        var areaId = Guid.NewGuid();
        await Sender.SendAsync(new CreateArea(
            Guid.NewGuid(), State.UserId, areaId, name,
            Positions.Next(existing.Where(area => !area.Deleted).Select(area => area.Position))));

        _draftName = "";
        Navigation.NavigateTo($"/areas/{areaId}");
    }

    async Task DeleteAsync()
    {
        if (Disabled || _area is null)
        {
            return;
        }

        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var tasks = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var items = await ItemStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, DeleteWarning.ForArea(_area.Name, _area.Id, lists, tasks, items) }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteArea(Guid.NewGuid(), State.UserId, _area.Id));
        Navigation.NavigateTo("/");
    }
}
