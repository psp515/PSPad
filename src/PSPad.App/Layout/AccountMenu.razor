@using PSPad.App.State
@using PSPad.App.Theme
@inject ThemePreference Preference

<MudMenu ActivationEvent="@MouseEvent.LeftClick" AnchorOrigin="Origin.BottomLeft" FullWidth="true"
         Class="pspad-account-menu">
    <ActivatorContent>
        @if (AvatarOnly)
        {
            <MudAvatar Style="@($"background:{AvatarColor.For(UserId)};color:#FFFFFF")" Size="Size.Medium">
                @AvatarColor.InitialOf(Email)
            </MudAvatar>
        }
        else
        {
            <div class="d-flex align-center gap-2 px-3 py-2">
                <MudAvatar Style="@($"background:{AvatarColor.For(UserId)};color:#FFFFFF")" Size="Size.Medium">
                    @AvatarColor.InitialOf(Email)
                </MudAvatar>
                <MudText Typo="Typo.body2">@Email</MudText>
            </div>
        }
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Href="/history" Icon="@Icons.Material.Filled.History">History</MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Brightness4">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.body2">Theme</MudText>
                <MudButtonGroup Size="Size.Small" Variant="Variant.Text">
                    @foreach (var mode in Enum.GetValues<ThemeMode>())
                    {
                        <MudButton OnClick="@(() => Preference.SetAsync(mode))"
                                   Color="@(Preference.Mode == mode ? Color.Primary : Color.Default)">
                            @mode
                        </MudButton>
                    }
                </MudButtonGroup>
            </div>
        </MudMenuItem>
        @if (PendingCommands > 0)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.CloudSync">
                @($"Sync: {PendingCommands} pending")
            </MudMenuItem>
        }
        <MudDivider />
        <MudMenuItem Href="/authentication/logout" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public string Email { get; set; } = "";

    [Parameter] public string DisplayName { get; set; } = "";

    [Parameter] public Guid UserId { get; set; }

    [Parameter] public int PendingCommands { get; set; }

    [Parameter] public bool AvatarOnly { get; set; }
}
