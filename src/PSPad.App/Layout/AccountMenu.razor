@using PSPad.App.State

<MudMenu ActivationEvent="@MouseEvent.LeftClick" AnchorOrigin="Origin.BottomLeft" FullWidth="true"
         Class="pspad-account-menu">
    <ActivatorContent>
        @if (AvatarOnly)
        {
            <MudSpacer/>
            <div class="px-3 py-2 pspad-account-avatar-only">
                <MudAvatar Style="@($"background:{AvatarColor.For(UserId)};color:#FFFFFF")" Size="Size.Medium">
                    @AvatarColor.InitialOf(DisplayName.Length > 0 ? DisplayName : Email)
                </MudAvatar>
            </div>
        }
        else
        {
            <div class="d-flex align-center gap-2 px-3 py-2 pspad-account-activator">
                <MudAvatar Style="@($"background:{AvatarColor.For(UserId)};color:#FFFFFF")" Size="Size.Medium">
                    @AvatarColor.InitialOf(DisplayName.Length > 0 ? DisplayName : Email)
                </MudAvatar>
                <div class="pspad-account-identity">
                    <MudText Typo="Typo.body2">@(DisplayName.Length > 0 ? DisplayName : Email)</MudText>
                    @if (DisplayName.Length > 0 && Email.Length > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Email</MudText>
                    }
                </div>
                <MudSpacer />
                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
            </div>
        }
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudMenuItem>
        <MudMenuItem Href="/history" Icon="@Icons.Material.Filled.History">History</MudMenuItem>
        <MudDivider />
        <MudMenuItem Href="/authentication/logout" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public string Email { get; set; } = "";

    [Parameter] public string DisplayName { get; set; } = "";

    [Parameter] public Guid UserId { get; set; }

    [Parameter] public bool AvatarOnly { get; set; }
}
