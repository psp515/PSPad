@using PSPad.App.Theme
@inject ThemePreference Preference
@implements IDisposable

<MudTooltip Text="@Label">
    <MudIconButton Icon="@Icon" Color="Color.Inherit" aria-label="@Label" OnClick="@CycleAsync" />
</MudTooltip>

@code {
    string Label => $"Theme: {Preference.Mode}";

    string Icon => Preference.Mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto
    };

    protected override void OnInitialized() => Preference.Changed += OnChanged;

    async Task CycleAsync() => await Preference.SetAsync(ThemeMode.Dark);

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Preference.Changed -= OnChanged;
}
