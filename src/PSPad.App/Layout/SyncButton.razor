@using PSPad.App.Sync
@inject ISyncTrigger Trigger
@inject ISyncStatus Status
@inject IConnectivity Connectivity
@implements IDisposable

@if (Labeled)
{
    <MudButton Class="pspad-sync-button" Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Sync" Disabled="@Blocked" OnClick="@Trigger.SyncNowAsync">
        Sync now
    </MudButton>
}
else
{
    <MudIconButton Class="@(Status.IsSyncing ? "pspad-sync-button pspad-spin" : "pspad-sync-button")"
                   Icon="@Icons.Material.Filled.Sync" Color="Color.Primary" Size="Size.Small" Disabled="@Blocked"
                   OnClick="@Trigger.SyncNowAsync" aria-label="Sync now" />
}

@code {
    [Parameter] public bool Labeled { get; set; }

    bool Blocked => Status.IsSyncing || !Connectivity.IsOnline;

    protected override void OnInitialized()
    {
        Status.Changed += OnChanged;
        Connectivity.Changed += OnChanged;
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        Connectivity.Changed -= OnChanged;
    }
}
