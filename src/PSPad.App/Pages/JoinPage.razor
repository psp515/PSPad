@page "/join/{Token}"
@page "/budgets/join/{Token}"
@attribute [Authorize]
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.Sync
@using PSPad.Module.Tasks.Lists
@inject SyncService Sync
@inject PSPad.App.Api.IBudgetSharingApi BudgetSharing
@inject IConnectivity Connectivity
@inject ISyncTrigger SyncTrigger
@inject NavigationManager Navigation
@inject IStringLocalizer<SharingStrings> T
@inject IStringLocalizer<SharedStrings> Shared

@if (_state == JoinState.Expired)
{
    <MudStack Class="pa-4 mx-auto" Style="max-width: 420px" Spacing="2" AlignItems="AlignItems.Center">
        <EmptyState Icon="@Icons.Material.Outlined.TimerOff" Message="@T["InviteExpired"]"
                    CreateText="@T["GoToMyDay"]" OnCreate="@GoHome" />
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            @T["InviteWorksThirtyMinutes"]
        </MudText>
    </MudStack>
}
else if (_state == JoinState.Offline)
{
    <EmptyState Icon="@Icons.Material.Outlined.WifiOff" Message="@T["JoiningNeedsConnection"]"
                CreateText="@Shared["Retry"]" OnCreate="@JoinAsync" />
}
else if (_state != JoinState.Joining)
{
    <MudStack Class="pa-4 mx-auto" Style="max-width: 420px" Spacing="2">
        <MudPaper Elevation="1" Class="pa-6">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" />
                </MudAvatar>
                <MudText Typo="Typo.h6">@T["EnterInviteCode"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    @T[IsBudget ? "CodeAskForBudget" : "CodeAskForList"]
                </MudText>
                @if (_state == JoinState.Invalid)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="pspad-join-invalid" Style="width: 100%">
                        @T["InvalidLinkOrCode"]
                    </MudAlert>
                }
                else if (_state == JoinState.Throttled)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="pspad-join-throttled" Style="width: 100%">
                        @T["TooManyTries"]
                    </MudAlert>
                }
                <MudTextField T="string" @bind-Value="_input" Immediate="true" Variant="Variant.Outlined"
                              Label="@T["CodeLabel"]" MaxLength="7" InputType="InputType.Text" InputMode="InputMode.text"
                              Typo="Typo.h5" Class="pspad-join-code" Style="text-align: center; letter-spacing: 0.3em; font-family: monospace; text-transform: uppercase"
                              HelperText="@T["CodeHelper"]" OnKeyDown="@SubmitOnEnterAsync"
                              UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "one-time-code" })" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="pspad-join-submit"
                           Disabled="@(!CanSubmit)" OnClick="@SubmitAsync">@T[IsBudget ? "JoinBudget" : "JoinList"]</MudButton>
            </MudStack>
        </MudPaper>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
            @T["QrCodeFilled"]
        </MudText>
    </MudStack>
}

@code {
    [Parameter] public string Token { get; set; } = "";

    enum JoinState
    {
        Joining,
        Entry,
        Invalid,
        Throttled,
        Expired,
        Offline
    }

    JoinState _state = JoinState.Joining;
    string _input = "";

    bool IsBudget => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/budgets/join/", StringComparison.Ordinal);

    async Task<JoinOutcome> JoinOnServerAsync(string code)
    {
        if (!IsBudget)
        {
            return await Sync.JoinAsync(Token, code, CancellationToken.None);
        }

        var outcome = await BudgetSharing.JoinBudgetAsync(Token, code);
        if (outcome is JoinOutcome.Joined joined)
        {
            await Sync.AdoptJoinAsync(joined);
        }

        return outcome;
    }

    bool CanSubmit => InviteCodes.IsWellFormed(InviteCodes.Normalize(_input));

    protected override async Task OnInitializedAsync()
    {
        var code = InviteCodes.Normalize(CodeFromFragment());
        if (InviteCodes.IsWellFormed(code))
        {
            _input = code;
            await JoinAsync();
            return;
        }

        _state = JoinState.Entry;
    }

    Task SubmitAsync() => JoinAsync();

    async Task SubmitOnEnterAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanSubmit && _state != JoinState.Joining)
        {
            await JoinAsync();
        }
    }

    async Task JoinAsync()
    {
        _state = JoinState.Joining;

        if (!Connectivity.IsOnline)
        {
            _state = JoinState.Offline;
            return;
        }

        try
        {
            var outcome = await JoinOnServerAsync(InviteCodes.Normalize(_input));
            if (outcome is JoinOutcome.Joined joined)
            {
                _ = SyncTrigger.SyncNowAsync();
                Navigation.NavigateTo(IsBudget ? BudgetLinks.For(joined.Id) : $"/lists/{joined.Id}", replace: true);
                return;
            }

            _state = outcome switch
            {
                JoinOutcome.Expired => JoinState.Expired,
                JoinOutcome.TooManyTries => JoinState.Throttled,
                _ => JoinState.Invalid
            };
        }
        catch (HttpRequestException)
        {
            _state = JoinState.Offline;
        }

        ForgetCodeInAddress();
    }

    void ForgetCodeInAddress()
    {
        var hash = Navigation.Uri.IndexOf('#');
        if (hash >= 0)
        {
            Navigation.NavigateTo(Navigation.Uri[..hash], replace: true);
        }
    }

    string CodeFromFragment() => ParseCode(new Uri(Navigation.Uri).Fragment);

    static string ParseCode(string fragment)
    {
        const string marker = "code=";
        var trimmed = fragment.TrimStart('#');
        return trimmed.StartsWith(marker, StringComparison.Ordinal)
            ? Uri.UnescapeDataString(trimmed[marker.Length..])
            : "";
    }

    void GoHome() => Navigation.NavigateTo("/");
}
