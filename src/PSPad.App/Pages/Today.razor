@page "/"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Tasks
@using PSPad.Module.Tasks.Today
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<TaskList> ListStore
@inject AppState State
@inject CommandSender Sender
@inject NavigationManager Navigation

<PageHeading Title="My Day" />

<div class="pspad-day-bar d-flex justify-end mb-4">
    <DayPicker Day="@_day" Today="@State.Today" DayChanged="@GoToAsync" />
</div>

@if (!_loaded)
{
    <RowSkeleton Count="6" />
}
else if (_day < State.Today)
{
    <section class="pspad-day-completed mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@($"Completed ({_plan.Completed.Count})")</MudText>
        @if (_plan.Completed.Count > 0)
        {
            @Rows(_plan.Completed)
        }
        else
        {
            <MudPaper Outlined="true"><MudText Typo="Typo.body2" Class="pa-4">@($"Nothing completed on {_day:ddd, d MMM}.")</MudText></MudPaper>
        }
    </section>
}
else
{
    @if (_plan.Overdue.Count > 0)
    {
        <section class="pspad-day-overdue mb-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-2">Overdue</MudText>
            @Rows(_plan.Overdue)
        </section>
    }

    @if (_plan.Scheduled.Count > 0)
    {
        <section class="pspad-day-schedule mb-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">Schedule</MudText>
            <MudStack Spacing="2" Class="pspad-schedule">
                @foreach (var entry in _plan.Scheduled)
                {
                    var task = _byId[entry.TaskId];
                    var day = DayOf(entry);
                    <div @key="entry.TaskId" class="pspad-schedule-slot">
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="pspad-schedule-time">
                            <span class="pspad-schedule-start">@TimeRow.Format(entry.Time!.Start)</span>@if (entry.Time.End is { } end){<span class="pspad-schedule-dash">–</span><span class="pspad-schedule-end">@TimeRow.Format(end)</span>}
                        </MudText>
                        <MudPaper Outlined="true" Class="pspad-day-task">
                            <TaskRow Task="@task" Today="@day" ListName="@NameOf(task.ListId)" ShowTime="false"
                                     OnToggle="@(toggled => ToggleAsync(toggled, day))" OnStar="@StarAsync" OnOpen="@Open" />
                        </MudPaper>
                    </div>
                }
            </MudStack>
        </section>
    }

    @if (_plan.AnyTime.Count > 0 || (_plan.Scheduled.Count == 0 && _plan.Overdue.Count == 0))
    {
        <section class="pspad-day-anytime mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@($"{DueDateRow.Describe(_day, State.Today)}, any time")</MudText>
            @if (_plan.AnyTime.Count > 0)
            {
                @Rows(_plan.AnyTime)
            }
            else
            {
                <MudPaper Outlined="true"><MudText Typo="Typo.body2" Class="pa-4">@NothingPlanned</MudText></MudPaper>
            }
        </section>
    }

    @if (_plan.Starred.Count > 0)
    {
        <section class="pspad-day-starred mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Starred <span class="pspad-muted">· when you have time</span></MudText>
            @Rows(_plan.Starred)
        </section>
    }

    @if (_plan.ComingUp.Count > 0)
    {
        <section class="pspad-day-comingup mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Coming up</MudText>
            @foreach (var group in _plan.ComingUp.GroupBy(entry => entry.DueOn!.Value))
            {
                <MudText Typo="Typo.caption" Class="pspad-muted d-block pt-2 pb-1">@DueDateRow.Describe(group.Key, State.Today)</MudText>
                @Rows([.. group])
            }
        </section>
    }

    @if (_plan.Completed.Count > 0)
    {
        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel Class="pspad-day-completed" Text="@($"Completed ({_plan.Completed.Count})")">
                @Rows(_plan.Completed)
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@code {
    bool _loaded;
    DayPlan _plan = new([], [], [], [], [], []);
    DateOnly _day;
    IReadOnlyDictionary<Guid, TodoTask> _byId = new Dictionary<Guid, TodoTask>();
    IReadOnlyDictionary<Guid, string> _listNames = new Dictionary<Guid, string>();

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    int _rendered = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (_rendered == SyncRevision)
        {
            return;
        }

        _rendered = SyncRevision;
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        var tasks = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);

        _listNames = lists.Where(list => !list.Deleted).ToDictionary(list => list.Id, list => list.Name);
        _byId = tasks.ToDictionary(task => task.Id);
        _day = DayQuery.From(Navigation.Uri, State.Today);
        _plan = TodayRule.Plan(tasks, _day, State.Today, LocalToday.Zone(State.TimeZone));

        _loaded = true;
    }

    RenderFragment Rows(IReadOnlyList<TodayEntry> entries) =>
        @<MudGrid Spacing="4">
            @foreach (var entry in entries)
            {
                var task = _byId[entry.TaskId];
                var day = DayOf(entry);
                <MudItem @key="entry.TaskId" xs="12" sm="6" lg="4" xl="3">
                    <MudPaper Outlined="true" Class="pspad-day-task">
                        <TaskRow Task="@task" Today="@day" ListName="@NameOf(task.ListId)"
                                 OnToggle="@(toggled => ToggleAsync(toggled, day))" OnStar="@StarAsync" OnOpen="@Open" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>;

    DateOnly DayOf(TodayEntry entry) => entry.Recurring ? entry.DueOn ?? _day : _day;

    string NothingPlanned => _day == State.Today ? "Nothing planned for today." : $"Nothing planned for {_day:ddd, d MMM}.";

    string? NameOf(Guid listId) => _listNames.TryGetValue(listId, out var name) ? name : null;

    void Open(TodoTask task) => Navigation.NavigateTo(TaskQuery.For(Navigation.Uri, task.Id));

    protected override void OnInitialized()
    {
        _day = DayQuery.From(Navigation.Uri, State.Today);
        Navigation.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        InvokeAsync(async () =>
        {
            if (DayQuery.From(Navigation.Uri, State.Today) != _day)
            {
                await ReloadAsync();
                StateHasChanged();
            }
        });

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    Task GoToAsync(DateOnly day)
    {
        Navigation.NavigateTo(DayQuery.For(Navigation.Uri, day, State.Today));
        return Task.CompletedTask;
    }

    async Task ToggleAsync(TodoTask task, DateOnly day)
    {
        if (task.IsRecurring)
        {
            if (!task.OccursOn(day) && !task.CompletedDays.Contains(day))
            {
                return;
            }

            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, day, !task.CompletedDays.Contains(day)));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }

        await ReloadAsync();
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
        await ReloadAsync();
    }
}
