@page "/"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Tasks
@using PSPad.Module.Tasks.Today
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<Goal> GoalStore
@inject AppState State
@inject CommandSender Sender
@inject NavigationManager Navigation
@inject IClock Clock
@inject IStringLocalizer<TodayStrings> T
@inject IStringLocalizer<SharedStrings> Shared
@inject IStringLocalizer<TasksStrings> TaskText
@inject ISnackbar Snackbar

<PageHeading Title="@Shared["MyDay"]" />

<div class="pspad-day-bar mb-4">
    <WeekStrip Day="@_day" Today="@State.Today" DayChanged="@GoToAsync" Busy="@_busy" />
</div>

@if (!_loaded)
{
    <RowSkeleton Count="6" />
}
else if (_day < State.Today)
{
    <section class="pspad-day-completed mb-4">
        <SectionHeading Title="@T["Completed"]" Count="@_plan.Completed.Count" />
        @if (_plan.Completed.Count > 0)
        {
            @Rows(_plan.Completed)
        }
        else
        {
            <RowGroup><MudText Typo="Typo.body2" Class="pa-3 pspad-muted">@T["NothingCompletedOn", _day.ToString("ddd, d MMM")]</MudText></RowGroup>
        }
    </section>
}
else
{
    <div class="@DayClass">
        <div class="pspad-day-tabs" role="tablist">
                <MudButton Class="pspad-day-tab-tasks-button" Variant="@(_tab == DayTab.Tasks ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" Size="Size.Small" OnClick="@(() => _tab = DayTab.Tasks)"
                           aria-selected="@(_tab == DayTab.Tasks ? "true" : "false")" role="tab">@T["Tasks"]</MudButton>
                <MudButton Class="pspad-day-tab-schedule-button" Variant="@(_tab == DayTab.Schedule ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" Size="Size.Small" OnClick="@(() => _tab = DayTab.Schedule)"
                           aria-selected="@(_tab == DayTab.Schedule ? "true" : "false")" role="tab">@ScheduleTabText</MudButton>
        </div>

        <div class="pspad-day-lists">
            @if (_plan.Overdue.Count > 0)
            {
                <section class="pspad-day-overdue mb-4">
                    <SectionHeading Title="@T["Overdue"]" Color="Color.Error" />
                    @Rows(_plan.Overdue)
                </section>
            }

            @if (_plan.Starred.Count > 0)
            {
                <section class="pspad-day-starred mb-4">
                    <SectionHeading Title="@T["Starred"]" Hint="@T["StarredHint"]" />
                    @Rows(_plan.Starred)
                </section>
            }

            @if (_plan.Scheduled.Count > 0)
            {
                <section class="pspad-day-scheduled mb-4">
                    <SectionHeading Title="@T["Scheduled"]" Count="@_plan.Scheduled.Count" Color="Color.Primary" />
                    @Rows(_plan.Scheduled)
                </section>
            }

            @if (_plan.AnyTime.Count > 0 || (_plan.Scheduled.Count == 0 && _plan.Overdue.Count == 0))
            {
                <section class="pspad-day-anytime mb-4">
                    <SectionHeading Title="@T["AnyTime", DueDateRow.Describe(_day, State.Today, Shared)]" />
                    @if (_plan.AnyTime.Count > 0)
                    {
                        @Rows(_plan.AnyTime)
                    }
                    else
                    {
                        <RowGroup><MudText Typo="Typo.body2" Class="pa-3 pspad-muted">@NothingPlanned</MudText></RowGroup>
                    }
                </section>
            }

            @if (_plan.Completed.Count > 0)
            {
                <MudExpansionPanels Elevation="0" Gutters="false" Class="pspad-completed">
                    <MudExpansionPanel Class="pspad-day-completed" Text="@T["CompletedCount", _plan.Completed.Count]">
                        @Rows(_plan.Completed)
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </div>

        <section class="pspad-day-schedule mb-4">
            <SectionHeading Title="@T["Schedule"]" Color="Color.Primary" />
            @if (_plan.Scheduled.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pspad-timeline-empty pspad-muted mb-2">@ScheduleEmpty</MudText>
            }
            <DayTimeline Entries="@_plan.Scheduled" Tasks="@_byId" Day="@_day" Now="@NowOnTheDay"
                         ListNameOf="@(task => NameOf(task.ListId))"
                         OnToggle="@(toggled => ToggleAsync(toggled, _day))" OnOpen="@Open" />
        </section>
    </div>
}

<MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pspad-fab" OnClick="@AddTask"
        UserAttributes="@FabAttributes" />

@code {
    Dictionary<string, object> FabAttributes => new() { ["aria-label"] = TaskText["AddTask"].Value };

    void AddTask() =>
        Navigation.NavigateTo(TaskQuery.ForNewTask(Navigation.Uri, due: _day < State.Today ? State.Today : _day));

    bool _loaded;
    DayPlan _plan = new([], [], [], [], [], []);
    DateOnly _day;
    IReadOnlySet<DateOnly> _busy = new HashSet<DateOnly>();
    IReadOnlyDictionary<Guid, TodoTask> _byId = new Dictionary<Guid, TodoTask>();
    IReadOnlyDictionary<Guid, string> _listNames = new Dictionary<Guid, string>();
    IReadOnlyList<Goal> _goals = [];
    readonly HashSet<Guid> _ticked = [];

    DayTab _tab = DayTab.Tasks;

    enum DayTab { Tasks, Schedule }

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    string DayClass => $"pspad-day {(_tab == DayTab.Schedule ? "pspad-day-tab-schedule" : "pspad-day-tab-tasks")}";

    int PendingScheduled => _plan.Scheduled.Count(entry => !IsDone(_byId[entry.TaskId], DayOf(entry)));

    TimeOnly? NowOnTheDay => _day == State.Today
        ? TimeOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.UtcNow, LocalToday.Zone(State.TimeZone)).DateTime)
        : null;

    static bool IsDone(TodoTask task, DateOnly day) =>
        task.IsRecurring ? task.CompletedDays.Contains(day) : task.CompletedAt is not null;

    int _rendered = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (_rendered == SyncRevision)
        {
            return;
        }

        _rendered = SyncRevision;
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        var tasks = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);

        _listNames = lists.Where(list => !list.Deleted).ToDictionary(list => list.Id, list => list.Name);
        var goals = await GoalStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _goals = [.. goals.Where(goal => !goal.Deleted)];
        _byId = tasks.ToDictionary(task => task.Id);
        var day = DayQuery.From(Navigation.Uri, State.Today);
        if (day != _day)
        {
            _ticked.Clear();
        }

        _day = day;
        var zone = LocalToday.Zone(State.TimeZone);
        _plan = TodayRule.Plan(tasks, _day, State.Today, zone);
        _busy = WeekStrip.WeekOf(_day)
            .Where(day => IsBusy(TodayRule.Plan(tasks, day, State.Today, zone), day))
            .ToHashSet();

        _loaded = true;
    }

    RenderFragment Rows(IReadOnlyList<TodayEntry> entries) =>
        @<RowGroup Class="pspad-row-ledger">@RowItems(entries)</RowGroup>;

    RenderFragment RowItems(IReadOnlyList<TodayEntry> entries) =>
        @<text>
            @foreach (var entry in entries)
            {
                var task = _byId[entry.TaskId];
                var day = DayOf(entry);
                var steps = DayStepsOf(task);
                @if (steps.Count == 0)
                {
                    <TaskRow @key="entry.TaskId" Task="@task" Today="@day" ListName="@NameOf(task.ListId)" GoalName="@GoalOf(task)"
                             OnToggle="@(toggled => ToggleAsync(toggled, day))" OnStar="@StarAsync" OnOpen="@Open" />
                }
                else
                {
                    <div @key="entry.TaskId" class="pspad-day-item">
                        <TaskRow Task="@task" Today="@day" ListName="@NameOf(task.ListId)" GoalName="@GoalOf(task)" ShowDueStep="false"
                                 OnToggle="@(toggled => ToggleAsync(toggled, day))" OnStar="@StarAsync" OnOpen="@Open" />
                        <div class="pspad-day-steps">
                            @foreach (var step in steps)
                            {
                                <DayStepRow @key="step.Id" Step="@step" Today="@State.Today" Done="@step.Checked"
                                            OnChecked="@(value => CheckStepAsync(task, step, value))" />
                            }
                        </div>
                    </div>
                }
            }
        </text>;

    IReadOnlyList<Step> DayStepsOf(TodoTask task)
    {
        if (task.IsRecurring || task.CompletedAt is not null)
        {
            return [];
        }

        var due = TodayRule.StepsDueBy(task, _day);
        return [.. task.Steps.Where(step => due.Contains(step) || (_ticked.Contains(step.Id) && step.DueOn <= _day))];
    }

    bool OnTheDay(Guid taskId) =>
        _plan.Overdue.Concat(_plan.Scheduled).Concat(_plan.AnyTime).Any(entry => entry.TaskId == taskId);

    async Task CheckStepAsync(TodoTask task, Step step, bool @checked)
    {
        var wasOnTheDay = OnTheDay(task.Id);
        await Sender.SendAsync(new CheckStep(Guid.NewGuid(), State.UserId, task.Id, step.Id, @checked));

        if (@checked)
        {
            _ticked.Add(step.Id);
        }
        else
        {
            _ticked.Remove(step.Id);
        }

        await ReloadAsync();

        if (@checked && wasOnTheDay && !OnTheDay(task.Id) && _byId.TryGetValue(task.Id, out var moved))
        {
            SayWhereItWent(moved, step);
        }
    }

    void SayWhereItWent(TodoTask task, Step step)
    {
        var message = TodayRule.TriggerOf(task) is { } next
            ? T["StepsDoneMovedTo", task.Name, DueDateRow.Describe(next, State.Today, Shared)]
            : T["StepsDoneNoDate", task.Name];
        Snackbar.Add(message, Severity.Normal, config =>
        {
            config.Action = Shared["Undo"];
            config.OnClick = _ => InvokeAsync(() => CheckStepAsync(task, step, false));
        });
    }

    bool IsBusy(DayPlan plan, DateOnly day) =>
        plan.Scheduled.Count > 0 || plan.AnyTime.Count > 0 || (day == State.Today && plan.Overdue.Count > 0);

    DateOnly DayOf(TodayEntry entry) => entry.Recurring ? entry.DueOn ?? _day : _day;

    string NothingPlanned => _day == State.Today ? T["NothingPlannedToday"] : T["NothingPlannedOn", _day.ToString("ddd, d MMM")];

    string ScheduleEmpty => _day == State.Today ? T["ScheduleEmptyToday"] : T["ScheduleEmptyOn", _day.ToString("ddd, d MMM")];

    string ScheduleTabText => PendingScheduled > 0 ? T["ScheduleCount", PendingScheduled] : T["Schedule"];

    string? GoalOf(TodoTask task) => Goal.Holding(_goals, task.Id)?.Name;

    string? NameOf(Guid listId) => _listNames.TryGetValue(listId, out var name) ? name : null;

    void Open(TodoTask task) => Navigation.NavigateTo(TaskQuery.For(Navigation.Uri, task.Id));

    protected override void OnInitialized()
    {
        _day = DayQuery.From(Navigation.Uri, State.Today);
        Navigation.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        InvokeAsync(async () =>
        {
            if (DayQuery.From(Navigation.Uri, State.Today) != _day)
            {
                await ReloadAsync();
                StateHasChanged();
            }
        });

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    Task GoToAsync(DateOnly day)
    {
        Navigation.NavigateTo(DayQuery.For(Navigation.Uri, day, State.Today));
        return Task.CompletedTask;
    }

    async Task ToggleAsync(TodoTask task, DateOnly day)
    {
        if (task.IsRecurring)
        {
            if (!task.OccursOn(day) && !task.CompletedDays.Contains(day))
            {
                return;
            }

            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, day, !task.CompletedDays.Contains(day)));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }

        await ReloadAsync();
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
        await ReloadAsync();
    }
}
