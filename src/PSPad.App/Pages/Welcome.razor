@page "/welcome"
@layout PublicLayout
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using PSPad.Abstractions
@using PSPad.App.Auth
@using PSPad.App.Components
@using PSPad.App.Layout
@using PSPad.Module.Tasks.Recurrence
@using PSPad.Module.Tasks.Tasks
@inject NavigationManager Navigation
@inject SignInFailure Failure
@inject IClock Clock
@inject IStringLocalizer<AuthStrings> T
@inject IStringLocalizer<SharedStrings> S
@implements IDisposable

<div class="pspad-welcome">
    <div class="pspad-welcome-content">
        <header class="pspad-welcome-text">
            <div class="pspad-welcome-icon">
                <BrandMark />
            </div>
            <h1>@T["WelcomeHeadline"]</h1>
            <a class="pspad-welcome-tagline" href="https://en.wikipedia.org/wiki/Getting_Things_Done"
               target="_blank" rel="noopener noreferrer">
                @T["WelcomeTagline"]
            </a>
            @if (_signInFailed)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="pspad-welcome-sign-in-failed">
                    @T["SignInDidNotFinish"]
                </MudAlert>
            }
            <p class="pspad-welcome-actions">
                <a class="pspad-welcome-button pspad-welcome-login" href="@LoginUrl"
                   @onclick="LogIn" @onclick:preventDefault="true">@T["LogIn"]</a>
                <a class="pspad-welcome-button pspad-welcome-docs" href="https://psp515.com/pspad">
                    @T["Docs"]
                </a>
            </p>
        </header>

        <section class="pspad-welcome-demo">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@S["MyDay"]</MudText>
            <MudPaper Outlined="true">
                @foreach (var task in DemoTasks)
                {
                    <TaskRow Task="@task" Today="@Today" />
                }
            </MudPaper>
        </section>
    </div>
</div>

@code {
    DateOnly Today => DateOnly.FromDateTime(Clock.UtcNow.UtcDateTime);

    IReadOnlyList<TodoTask> DemoTasks = [];

    bool _signInFailed;

    string? ReturnUrl => ReturnUrlQuery.SafeFrom(Navigation.Uri, Navigation.BaseUri);

    string LoginUrl => ReturnUrl is { } returnUrl
        ? $"authentication/login?returnUrl={Uri.EscapeDataString(returnUrl)}"
        : "authentication/login";

    protected override void OnInitialized()
    {
        DemoTasks = BuildDemoTasks();
        _signInFailed = Failure.Take();
        Navigation.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (Navigation.ToBaseRelativePath(args.Location).Split('?', '#')[0] != "welcome")
        {
            return;
        }

        _signInFailed = Failure.Take();
        InvokeAsync(StateHasChanged);
    }

    void LogIn() => Navigation.NavigateToLogin("authentication/login", new InteractiveRequestOptions
    {
        Interaction = InteractionType.SignIn,
        ReturnUrl = ReturnUrl ?? Navigation.BaseUri
    });

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    IReadOnlyList<TodoTask> BuildDemoTasks()
    {
        var listId = Guid.NewGuid();
        var user = Guid.NewGuid();
        var now = Clock.UtcNow;

        var renewDomain = NewTask(listId, user, now, T["DemoRenewDomain"]);
        Due(renewDomain, user, now, Today.AddDays(-1));

        var draftReleaseNotes = NewTask(listId, user, now, T["DemoDraftReleaseNotes"]);
        Due(draftReleaseNotes, user, now, Today);

        var readABook = NewTask(listId, user, now, T["DemoReadABook"]);
        Recur(readABook, user, now, Today.AddDays(-30));

        var waterThePlants = NewTask(listId, user, now, T["DemoWaterThePlants"]);
        Due(waterThePlants, user, now, Today);

        return [renewDomain, draftReleaseNotes, readABook, waterThePlants];
    }

    static TodoTask NewTask(Guid listId, Guid user, DateTimeOffset now, string name)
    {
        var task = new TodoTask();
        task.ApplyAll(TodoTask.Decide(null, new CreateTask(Guid.NewGuid(), user, Guid.NewGuid(), listId, name), now));
        return task;
    }

    static void Due(TodoTask task, Guid user, DateTimeOffset now, DateOnly dueOn) =>
        task.ApplyAll(TodoTask.Decide(task, new SetTaskDueDate(Guid.NewGuid(), user, task.Id, dueOn), now));

    static void Recur(TodoTask task, Guid user, DateTimeOffset now, DateOnly from) =>
        task.ApplyAll(TodoTask.Decide(
            task, new SetTaskRecurrence(Guid.NewGuid(), user, task.Id, RecurrenceRule.Daily(from)), now));
}
