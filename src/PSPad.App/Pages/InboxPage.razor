@page "/inbox"
@attribute [Authorize]
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Inbox
@inject IDocumentStore<Inbox> InboxStore
@inject AppState State
@inject CommandSender Sender
@inject NavigationManager Navigation
@implements IDisposable

<PageHeading Title="Inbox" Subtitle="@Subtitle" />

@if (!_loaded)
{
    <RowSkeleton Count="5" />
}
else
{
    @if (Items.Count == 0)
    {
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" lg="4" xl="3">
                <EmptyState Icon="@Icons.Material.Outlined.Inbox" Message="Nothing captured." CreateText="Capture"
                            OnCreate="@Capture" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        <RowGroup Columns="true">
            @foreach (var day in Days)
            {
                <div class="pspad-row-subhead">@DueDateRow.Describe(day.Key, State.Today)</div>
                @foreach (var item in day)
                {
                    <InboxItemRow @key="item.Id" Item="@item" Zone="@Zone" OnOpen="@Open" />
                }
            }
        </RowGroup>
    }
}

<MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pspad-fab" OnClick="@Capture"
        UserAttributes="@FabAttributes" />

@code {
    bool _loaded;
    Inbox? _inbox;

    static readonly Dictionary<string, object> FabAttributes = new() { ["aria-label"] = "Capture" };

    IReadOnlyList<InboxItem> Items => _inbox?.Items ?? [];

    TimeZoneInfo Zone => LocalToday.Zone(State.TimeZone);

    string? Subtitle => Items.Count == 0 ? null : $"{Items.Count} to process";

    IEnumerable<IGrouping<DateOnly, InboxItem>> Days => Items
        .OrderByDescending(item => item.CapturedAt)
        .GroupBy(item => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(item.CapturedAt, Zone).DateTime));

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    int _rendered = -1;

    protected override void OnInitialized() => Sender.Sent += OnCommandSent;

    void OnCommandSent() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        if (_rendered == SyncRevision)
        {
            return;
        }

        _rendered = SyncRevision;
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        _inbox = (await InboxStore.LoadAllAsync(State.UserId, CancellationToken.None))
            .FirstOrDefault(inbox => !inbox.Deleted);

        _loaded = true;
    }

    void Open(InboxItem item) => Navigation.NavigateTo(InboxQuery.For(Navigation.Uri, item.Id));

    void Capture() => Navigation.NavigateTo(InboxQuery.ForNew(Navigation.Uri));

    public void Dispose() => Sender.Sent -= OnCommandSent;
}
