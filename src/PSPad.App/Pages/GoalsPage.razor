@page "/goals"
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<Goal> GoalStore
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<TaskList> ListStore
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">Goals</MudText>

<MudTextField T="string" @bind-Value="_newGoalName" Placeholder="New goal" Immediate="true"
              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Add"
              OnKeyDown="@OnKeyDown" />

@if (!_loaded)
{
    <CardSkeleton Count="3" />
}
else
{
    @if (_active.Count == 0 && _achieved.Count == 0)
    {
        <MudText Typo="Typo.body2">No goals yet.</MudText>
    }

    <div class="pspad-grid">
        @foreach (var goal in _active)
        {
            <GoalCard Goal="@goal" Tasks="@TasksOf(goal.Id)" ListNames="@_listNames" Today="@State.Today"
                      OnToggle="@ToggleAsync" OnStar="@StarAsync" OnOpen="@Open"
                      OnAchieve="@(() => AchieveAsync(goal))"
                      OnReopen="@(() => ReopenAsync(goal))"
                      OnRename="@(() => RenameAsync(goal))"
                      OnDelete="@(() => DeleteAsync(goal))" />
        }
    </div>
}

@if (_achieved.Count > 0)
{
    <MudExpansionPanels Elevation="0" Class="mt-4">
        <MudExpansionPanel Text="@($"Achieved ({_achieved.Count})")">
            <div class="pspad-grid">
                @foreach (var goal in _achieved)
                {
                    <GoalCard Goal="@goal" Tasks="@TasksOf(goal.Id)" ListNames="@_listNames" Today="@State.Today"
                              OnToggle="@ToggleAsync" OnStar="@StarAsync" OnOpen="@Open"
                              OnAchieve="@(() => AchieveAsync(goal))"
                              OnReopen="@(() => ReopenAsync(goal))"
                              OnRename="@(() => RenameAsync(goal))"
                              OnDelete="@(() => DeleteAsync(goal))" />
                }
            </div>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    bool _loaded;
    IReadOnlyList<Goal> _active = [];
    IReadOnlyList<Goal> _achieved = [];
    IReadOnlyList<TodoTask> _tasks = [];
    IReadOnlyDictionary<Guid, string> _listNames = new Dictionary<Guid, string>();
    string _newGoalName = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        var goals = await GoalStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var kept = goals.Where(goal => !goal.Deleted).OrderBy(goal => goal.Name).ToArray();
        _active = [.. kept.Where(goal => !goal.Achieved)];
        _achieved = [.. kept.Where(goal => goal.Achieved)];

        _tasks = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);

        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _listNames = lists.Where(list => !list.Deleted).ToDictionary(list => list.Id, list => list.Name);
        _loaded = true;
    }

    IReadOnlyList<TodoTask> TasksOf(Guid goalId) => [.. _tasks.Where(task => task.GoalId == goalId)];

    void Open(TodoTask task) =>
        Navigation.NavigateTo($"{Navigation.Uri.Split('?')[0]}?task={task.Id}");

    async Task ToggleAsync(TodoTask task)
    {
        if (task.IsRecurring)
        {
            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, State.Today, !task.CompletedDays.Contains(State.Today)));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }

        await ReloadAsync();
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
        await ReloadAsync();
    }

    async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key != "Enter" || string.IsNullOrWhiteSpace(_newGoalName))
        {
            return;
        }

        await Sender.SendAsync(new CreateGoal(Guid.NewGuid(), State.UserId, Guid.NewGuid(), _newGoalName));
        _newGoalName = "";
        await ReloadAsync();
    }

    async Task RenameAsync(Goal goal)
    {
        var parameters = new DialogParameters<NameDialog>
        {
            { dialog => dialog.Title, "Goal name" },
            { dialog => dialog.Value, goal.Name }
        };
        var dialog = await Dialogs.ShowAsync<NameDialog>("Rename goal", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new RenameGoal(Guid.NewGuid(), State.UserId, goal.Id, name));
        await ReloadAsync();
    }

    async Task AchieveAsync(Goal goal)
    {
        await Sender.SendAsync(new AchieveGoal(Guid.NewGuid(), State.UserId, goal.Id));
        await ReloadAsync();
    }

    async Task ReopenAsync(Goal goal)
    {
        await Sender.SendAsync(new ReopenGoal(Guid.NewGuid(), State.UserId, goal.Id));
        await ReloadAsync();
    }

    async Task DeleteAsync(Goal goal)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"Delete “{goal.Name}”? Its tasks stay, without a goal." }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete goal", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteGoal(Guid.NewGuid(), State.UserId, goal.Id));
        await ReloadAsync();
    }
}
