@page "/areas/{AreaId:guid}"
@attribute [Authorize]
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Presentation.AreaViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Ordering
@using PSPad.Module.Tasks.References
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<Area> AreaStore
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<ReferenceItem> ItemStore
@inject IDocumentStore<AreaView> ViewStore
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LastArea Remembered
@implements IDisposable

@if (!_loaded)
{
    <PageHeading Title="" />
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" Height="40px" Class="mb-4" />
    <CardSkeleton Count="3" />
}
else if (_area is not null)
{
    <div class="d-md-none">
        <AreaChips Areas="@_areas" Current="@AreaId" />
    </div>

    <PageHeading Title="@_area.Name" />

    @if (_lists.Count == 0)
    {
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" lg="4" xl="3">
                <EmptyState Icon="@Icons.Material.Outlined.ListAlt" Message="No lists yet." CreateText="New list"
                            OnCreate="@NewList" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MasonryGrid TItem="TaskList" Items="@_lists" Key="@(list => list.Id)">
            <ItemTemplate Context="list">
                <ListCard List="@list" Tasks="@TasksOf(list.Id)" Items="@ItemsOf(list.Id)" Today="@State.Today"
                          OnToggle="@ToggleAsync" OnStar="@StarAsync" OnOpen="@Open"
                          OnOpenItem="@OpenItem" OnStarItem="@StarItemAsync"
                          OnAddTaskClick="@(() => AddTask(list.Id))"
                          OnAddItemClick="@(() => AddItem(list.Id))"
                          OnRename="@(() => RenameListAsync(list))"
                          OnDelete="@(() => DeleteListAsync(list))"
                          OnMove="@(() => MoveListAsync(list))" />
            </ItemTemplate>
        </MasonryGrid>
    }

    <MudFabMenu Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pspad-fab" UserAttributes="@ActivatorAttributes">
        <MudTooltip Text="New list">
            <MudFabMenuItem OnClick="@NewList" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                            Size="Size.Small" UserAttributes="@NewListAttributes" />
        </MudTooltip>
        <MudTooltip Text="Edit area & order lists">
            <MudFabMenuItem OnClick="@EditArea" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                            Size="Size.Small" UserAttributes="@EditAreaAttributes" />
        </MudTooltip>
        <MudTooltip Text="Delete area">
            <MudFabMenuItem OnClick="@DeleteAreaAsync" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Primary"
                            Size="Size.Small" UserAttributes="@DeleteAreaAttributes" />
        </MudTooltip>
    </MudFabMenu>
}
else
{
    <PageHeading Title="" />
    <MudText Typo="Typo.body1">This area is not there anymore.</MudText>
}

@code {
    [Parameter] public Guid AreaId { get; set; }

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    bool _loaded;
    Area? _area;
    IReadOnlyList<Area> _areas = [];
    IReadOnlyList<TaskList> _lists = [];
    IReadOnlyList<TodoTask> _tasks = [];
    IReadOnlyList<ReferenceItem> _items = [];

    static readonly Dictionary<string, object> ActivatorAttributes = new() { ["aria-label"] = "Actions" };
    static readonly Dictionary<string, object> NewListAttributes = new() { ["aria-label"] = "New list" };
    static readonly Dictionary<string, object> EditAreaAttributes = new() { ["aria-label"] = "Edit area" };
    static readonly Dictionary<string, object> DeleteAreaAttributes = new() { ["aria-label"] = "Delete area" };

    protected override void OnInitialized() => Sender.Sent += OnCommandSent;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    void OnCommandSent() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    async Task ReloadAsync()
    {
        var area = await AreaStore.LoadAsync(AreaId, CancellationToken.None);
        _area = area is null || area.Deleted ? null : area;

        _areas = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);

        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var view = await ViewStore.LoadAsync(AreaView.IdFor(State.UserId, AreaId), CancellationToken.None);
        _lists = ListOrder.InArea(AreaId, lists, view);

        _tasks = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _items = await ItemStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _loaded = true;

        if (_area is not null)
        {
            await Remembered.RememberAsync(AreaId);
        }
    }

    IReadOnlyList<TodoTask> TasksOf(Guid listId) => [.. _tasks.Where(task => task.ListId == listId)];

    IReadOnlyList<ReferenceItem> ItemsOf(Guid listId) =>
        [.. _items.Where(item => item.ListId == listId && !item.Deleted)
            .OrderByDescending(item => item.Starred).ThenBy(item => item.Position)];

    void Open(TodoTask task) =>
        Navigation.NavigateTo($"{Navigation.Uri.Split('?')[0]}?task={task.Id}");

    void OpenItem(ReferenceItem item) => Navigation.NavigateTo(ReferenceQuery.ForItem(Navigation.Uri, item.Id));

    async Task StarItemAsync(ReferenceItem item)
    {
        var result = await Sender.SendAsync(new StarReferenceItem(Guid.NewGuid(), State.UserId, item.Id, !item.Starred));

        if (!result.Accepted)
        {
            Snackbar.Add(result.Rejection ?? "Couldn't star the item.", Severity.Warning);
        }
    }

    async Task ToggleAsync(TodoTask task)
    {
        if (task.IsRecurring)
        {
            if (!task.OccursOn(State.Today) && !task.CompletedDays.Contains(State.Today))
            {
                return;
            }

            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, State.Today, !task.CompletedDays.Contains(State.Today)));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
    }

    void AddTask(Guid listId) => Navigation.NavigateTo(TaskQuery.ForNewTask(Navigation.Uri, listId));

    void AddItem(Guid listId) => Navigation.NavigateTo(ReferenceQuery.ForNewItem(Navigation.Uri, listId));

    void NewList() => Navigation.NavigateTo(ListQuery.ForNewList(Navigation.Uri, AreaId));

    async Task RenameListAsync(TaskList list)
    {
        var parameters = new DialogParameters<NameDialog>
        {
            { dialog => dialog.Title, "List name" },
            { dialog => dialog.Value, list.Name }
        };
        var dialog = await Dialogs.ShowAsync<NameDialog>("Rename list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new RenameTaskList(Guid.NewGuid(), State.UserId, list.Id, name));
    }

    async Task DeleteListAsync(TaskList list)
    {
        var message = list.Kind == ListKind.Reference
            ? DeleteWarning.ForList(list.Name, list.Id, _items)
            : DeleteWarning.ForList(list.Name, list.Id, _tasks);
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteTaskList(Guid.NewGuid(), State.UserId, list.Id));
    }

    void EditArea() => Navigation.NavigateTo(AreaQuery.For(Navigation.Uri, AreaId));

    async Task DeleteAreaAsync()
    {
        var area = _area!;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, DeleteWarning.ForArea(area.Name, area.Id, _lists, _tasks, _items) }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteArea(Guid.NewGuid(), State.UserId, area.Id));
        Navigation.NavigateTo("/");
    }

    async Task MoveListAsync(TaskList list)
    {
        var areas = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var targets = areas.Where(area => !area.Deleted && area.Id != AreaId).ToArray();

        if (targets.Length == 0)
        {
            return;
        }

        var parameters = new DialogParameters<AreaPickerDialog>
        {
            { dialog => dialog.Areas, targets }
        };
        var dialog = await Dialogs.ShowAsync<AreaPickerDialog>("Move to area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not Guid target)
        {
            return;
        }

        await Sender.SendAsync(new MoveTaskListToArea(Guid.NewGuid(), State.UserId, list.Id, target));
    }

    public void Dispose() => Sender.Sent -= OnCommandSent;
}
