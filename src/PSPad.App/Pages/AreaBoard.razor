@page "/areas/{AreaId:guid}"
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Ordering
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<Area> AreaStore
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<Goal> GoalStore
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject NavigationManager Navigation

@if (!_loaded)
{
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" Height="40px" Class="mb-4" />
    <CardSkeleton Count="3" />
}
else if (_area is not null)
{
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@_area.Name</MudText>

    <div class="pspad-grid">
        @foreach (var list in _lists)
        {
            <ListCard List="@list" Tasks="@TasksOf(list.Id)" Today="@State.Today"
                      OnToggle="@ToggleAsync" OnStar="@StarAsync" OnOpen="@Open"
                      OnAddTaskClick="@(() => AddTaskAsync(list.Id))"
                      OnRename="@(() => RenameListAsync(list))"
                      OnDelete="@(() => DeleteListAsync(list))"
                      OnMove="@(() => MoveListAsync(list))" />
        }
    </div>

    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="New list"
            Class="pspad-fab" OnClick="@NewListAsync" />

    <MudMenu Class="pspad-area-fab" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
        <ActivatorContent>
            <MudFab Color="Color.Default" StartIcon="@Icons.Material.Filled.MoreHoriz" />
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem OnClick="@RenameAreaAsync">Rename</MudMenuItem>
            <MudMenuItem OnClick="@DeleteAreaAsync">Delete</MudMenuItem>
        </ChildContent>
    </MudMenu>
}
else
{
    <MudText Typo="Typo.body1">This area is not there anymore.</MudText>
}

@code {
    [Parameter] public Guid AreaId { get; set; }

    bool _loaded;
    Area? _area;
    IReadOnlyList<TaskList> _lists = [];
    IReadOnlyList<TodoTask> _tasks = [];
    IReadOnlyList<Goal> _goals = [];

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        var area = await AreaStore.LoadAsync(AreaId, CancellationToken.None);
        _area = area is null || area.Deleted ? null : area;

        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _lists = [.. lists.Where(list => list.AreaId == AreaId && !list.Deleted).OrderBy(list => list.Position)];

        _tasks = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _goals = await GoalStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _loaded = true;
    }

    IReadOnlyList<TodoTask> TasksOf(Guid listId) => [.. _tasks.Where(task => task.ListId == listId)];

    void Open(TodoTask task) =>
        Navigation.NavigateTo($"{Navigation.Uri.Split('?')[0]}?task={task.Id}");

    async Task ToggleAsync(TodoTask task)
    {
        if (task.IsRecurring)
        {
            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, State.Today, true));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }

        await ReloadAsync();
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
        await ReloadAsync();
    }

    async Task AddTaskAsync(Guid listId)
    {
        var parameters = new DialogParameters<AddTaskDialog> { { dialog => dialog.Goals, _goals } };
        var dialog = await Dialogs.ShowAsync<AddTaskDialog>("New task", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not AddTaskResult task
            || task.Name.Length == 0)
        {
            return;
        }

        var taskId = Guid.NewGuid();
        await Sender.SendAsync(new CreateTask(Guid.NewGuid(), State.UserId, taskId, listId, task.Name));

        if (task.DueOn is not null)
        {
            await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, taskId, task.DueOn));
        }

        if (task.Priority != Priority.None)
        {
            await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, taskId, task.Priority));
        }

        if (task.GoalId is not null)
        {
            await Sender.SendAsync(new LinkTaskToGoal(Guid.NewGuid(), State.UserId, taskId, task.GoalId));
        }

        if (task.Starred)
        {
            await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, taskId, true));
        }

        await ReloadAsync();
    }

    async Task NewListAsync()
    {
        var parameters = new DialogParameters<NameDialog> { { dialog => dialog.Title, "List name" } };
        var dialog = await Dialogs.ShowAsync<NameDialog>("New list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new CreateTaskList(
            Guid.NewGuid(), State.UserId, Guid.NewGuid(), AreaId, name,
            Positions.Next(_lists.Select(list => list.Position))));

        await ReloadAsync();
    }

    async Task RenameListAsync(TaskList list)
    {
        var parameters = new DialogParameters<NameDialog>
        {
            { dialog => dialog.Title, "List name" },
            { dialog => dialog.Value, list.Name }
        };
        var dialog = await Dialogs.ShowAsync<NameDialog>("Rename list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new RenameTaskList(Guid.NewGuid(), State.UserId, list.Id, name));
        await ReloadAsync();
    }

    async Task DeleteListAsync(TaskList list)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"Delete “{list.Name}”? Its tasks stay, without a list." }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteTaskList(Guid.NewGuid(), State.UserId, list.Id));
        await ReloadAsync();
    }

    async Task RenameAreaAsync()
    {
        var area = _area!;
        var parameters = new DialogParameters<NameDialog>
        {
            { dialog => dialog.Title, "Area name" },
            { dialog => dialog.Value, area.Name }
        };
        var dialog = await Dialogs.ShowAsync<NameDialog>("Rename area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new RenameArea(Guid.NewGuid(), State.UserId, area.Id, name));
        await ReloadAsync();
    }

    async Task DeleteAreaAsync()
    {
        var area = _area!;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"Delete “{area.Name}”? Its lists stay, without an area." }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await Sender.SendAsync(new DeleteArea(Guid.NewGuid(), State.UserId, area.Id));
        Navigation.NavigateTo("/");
    }

    async Task MoveListAsync(TaskList list)
    {
        var areas = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var targets = areas.Where(area => !area.Deleted && area.Id != AreaId).ToArray();

        if (targets.Length == 0)
        {
            return;
        }

        var parameters = new DialogParameters<AreaPickerDialog>
        {
            { dialog => dialog.Areas, targets }
        };
        var dialog = await Dialogs.ShowAsync<AreaPickerDialog>("Move to area", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not Guid target)
        {
            return;
        }

        await Sender.SendAsync(new MoveTaskListToArea(Guid.NewGuid(), State.UserId, list.Id, target));
        await ReloadAsync();
    }
}
