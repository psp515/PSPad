@page "/app-info"
@attribute [Authorize]
@using System.Reflection
@using PSPad.App.Components
@inject IStringLocalizer<ShellStrings> T

<PageHeading Title="@T["AppInfo"]" />

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle2" Class="mb-3">PSPad</MudText>
    <MudText Typo="Typo.body2">@T["AppVersion", Version]</MudText>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle2" Class="mb-3">@T["License"]</MudText>
    <MudText Typo="Typo.body2">@T["LicenseText"]</MudText>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.subtitle2" Class="mb-3">@T["Links"]</MudText>
    <MudLink Href="https://github.com/psp515/PSPad" Target="_blank">@T["SourceOnGitHub"]</MudLink>
    <br />
    <MudLink Href="https://psp515.github.io" Target="_blank">@T["Documentation"]</MudLink>
</MudPaper>

@code {
    string Version =>
        typeof(AppInfoPage).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion ?? T["VersionUnknown"];
}
