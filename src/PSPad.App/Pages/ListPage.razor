@page "/lists/{ListId:guid}"
@attribute [Authorize]
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.Tasks
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<Goal> GoalStore
@inject AppState State
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject NavigationManager Navigation

@if (!_loaded)
{
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" Height="40px" Class="mb-4" />
    <RowSkeleton Count="6" />
}
else if (_list is not null)
{
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@_list.Name</MudText>

    <MudPaper Outlined="true">
        @if (_open.Count == 0 && _done.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="pa-4">No tasks yet.</MudText>
        }
        <MudGrid Spacing="4">
            @foreach (var task in _open)
            {
                <MudItem xs="12" sm="6" md="4" xl="3">
                    <TaskRow Task="@task" Today="@State.Today" OnToggle="@ToggleAsync" OnStar="@StarAsync"
                             OnOpen="@Open" />
                </MudItem>
            }
        </MudGrid>

        @if (_done.Count > 0)
        {
            <MudDivider />
            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="@($"Completed ({_done.Count})")">
                    <MudGrid Spacing="4">
                        @foreach (var task in _done)
                        {
                            <MudItem xs="12" sm="6" md="4" xl="3">
                                <TaskRow Task="@task" Today="@State.Today" OnToggle="@ToggleAsync"
                                         OnStar="@StarAsync" OnOpen="@Open" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudPaper>

    <MudMenu Class="pspad-fab" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight">
        <ActivatorContent>
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" UserAttributes="@ActivatorAttributes" />
        </ActivatorContent>
        <ChildContent>
            <MudTooltip Text="Add task">
                <MudMenuItem OnClick="@AddTaskAsync" Icon="@Icons.Material.Filled.Add" UserAttributes="@AddTaskAttributes" />
            </MudTooltip>
            <MudTooltip Text="Rename list">
                <MudMenuItem OnClick="@RenameAsync" Icon="@Icons.Material.Filled.Edit" UserAttributes="@RenameListAttributes" />
            </MudTooltip>
            <MudTooltip Text="Delete list">
                <MudMenuItem OnClick="@DeleteAsync" Icon="@Icons.Material.Filled.Delete" UserAttributes="@DeleteListAttributes" />
            </MudTooltip>
        </ChildContent>
    </MudMenu>
}
else
{
    <MudText Typo="Typo.body1">This list is not there anymore.</MudText>
}

@code {
    [Parameter] public Guid ListId { get; set; }

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    bool _loaded;
    TaskList? _list;
    IReadOnlyList<TodoTask> _open = [];
    IReadOnlyList<TodoTask> _done = [];
    IReadOnlyList<Goal> _goals = [];

    static readonly Dictionary<string, object> ActivatorAttributes = new() { ["aria-label"] = "Actions" };
    static readonly Dictionary<string, object> AddTaskAttributes = new() { ["aria-label"] = "Add task" };
    static readonly Dictionary<string, object> RenameListAttributes = new() { ["aria-label"] = "Rename list" };
    static readonly Dictionary<string, object> DeleteListAttributes = new() { ["aria-label"] = "Delete list" };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        var list = await ListStore.LoadAsync(ListId, CancellationToken.None);
        _list = list is null || list.Deleted ? null : list;

        var all = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var mine = all.Where(task => task.ListId == ListId && !task.Deleted).ToArray();

        _open = [.. mine.Where(task => task.CompletedAt is null)];
        _done = [.. mine.Where(task => task.CompletedAt is not null)];
        _goals = await GoalStore.LoadAllAsync(State.UserId, CancellationToken.None);

        _loaded = true;
    }

    void Open(TodoTask task) => Navigation.NavigateTo($"/lists/{ListId}?task={task.Id}");

    async Task RenameAsync()
    {
        if (_list is null)
        {
            return;
        }

        var parameters = new DialogParameters<NameDialog>
        {
            { dialog => dialog.Title, "List name" },
            { dialog => dialog.Value, _list.Name }
        };
        var dialog = await Dialogs.ShowAsync<NameDialog>("Rename list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string name || name.Length == 0)
        {
            return;
        }

        await Sender.SendAsync(new RenameTaskList(Guid.NewGuid(), State.UserId, ListId, name));
        await ReloadAsync();
    }

    async Task DeleteAsync()
    {
        if (_list is null)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, $"Delete “{_list.Name}”? Its tasks stay, without a list." }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Delete list", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        var areaId = _list.AreaId;
        await Sender.SendAsync(new DeleteTaskList(Guid.NewGuid(), State.UserId, ListId));
        Navigation.NavigateTo($"/areas/{areaId}");
    }

    async Task ToggleAsync(TodoTask task)
    {
        if (task.IsRecurring)
        {
            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, State.Today, true));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }

        await ReloadAsync();
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
        await ReloadAsync();
    }

    async Task AddTaskAsync()
    {
        var parameters = new DialogParameters<AddTaskDialog> { { dialog => dialog.Goals, _goals } };
        var dialog = await Dialogs.ShowAsync<AddTaskDialog>("New task", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not AddTaskResult task || task.Name.Length == 0)
        {
            return;
        }

        var taskId = Guid.NewGuid();
        await Sender.SendAsync(new CreateTask(Guid.NewGuid(), State.UserId, taskId, ListId, task.Name));

        if (task.DueOn is not null)
        {
            await Sender.SendAsync(new SetTaskDueDate(Guid.NewGuid(), State.UserId, taskId, task.DueOn));
        }

        if (task.Priority != Priority.None)
        {
            await Sender.SendAsync(new SetTaskPriority(Guid.NewGuid(), State.UserId, taskId, task.Priority));
        }

        if (task.GoalId is not null)
        {
            await Sender.SendAsync(new LinkTaskToGoal(Guid.NewGuid(), State.UserId, taskId, task.GoalId));
        }

        if (task.Starred)
        {
            await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, taskId, true));
        }

        await ReloadAsync();
    }
}
