@page "/lists/{ListId:guid}"
@attribute [Authorize]
@using System.Globalization
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Presentation.AreaViews
@using PSPad.Module.Presentation.ListViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.References
@using PSPad.Module.Tasks.Tasks
@using PSPad.Module.Tasks.Today
@inject IDocumentStore<Area> AreaStore
@inject IDocumentStore<TaskList> ListStore
@inject IDocumentStore<TodoTask> TaskStore
@inject IDocumentStore<Goal> GoalStore
@inject IDocumentStore<ReferenceItem> ItemStore
@inject IDocumentStore<AreaView> ViewStore
@inject IDocumentStore<ListView> ListViewStore
@inject AppState State
@inject ListScreenState Screen
@inject CommandSender Sender
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<TasksStrings> TaskText
@inject IStringLocalizer<ListsStrings> T
@inject IStringLocalizer<ReferenceStrings> Ref
@inject IStringLocalizer<SharedStrings> Shared
@implements IDisposable

@if (!_loaded)
{
    <PageHeading Title="" />
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="30%" Height="40px" Class="mb-4" />
    <RowSkeleton Count="6" />
}
else if (_list is not null)
{
    <PageHeading Title="@_list.Name" Subtitle="@Summary" Icon="@ListIcon.For(_list)" IconLabel="@ListIcon.LabelFor(_list, T)" BackHref="@AreaLinks.For(_areaId)"
                 BackLabel="@T["BackToArea"]" BackClass="pspad-back-to-area" />

    @if (_list.Kind == ListKind.Reference)
    {
        @if (_items.Count == 0)
        {
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6" lg="4" xl="3">
                    <EmptyState Icon="@Icons.Material.Outlined.LibraryBooks" Message="@Ref["NoItemsYet"]" CreateText="@Ref["AddItem"]"
                                OnCreate="@(EventCallback.Factory.Create(this, AddItem))" />
                </MudItem>
            </MudGrid>
        }
        else
        {
            <RowGroup Columns="true">
                @foreach (var item in _items)
                {
                    <ReferenceRow @key="item.Id" Item="@item" OnStar="@StarItemAsync" OnOpen="@OpenItem" />
                }
                <AddRow Text="@Ref["AddItem"]" OnClick="@AddItem" />
            </RowGroup>
        }
    }
    else if (_open.Count == 0 && _done.Count == 0)
    {
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" lg="4" xl="3">
                <EmptyState Icon="@Icons.Material.Outlined.TaskAlt" Message="@T["NoTasksYet"]" CreateText="@TaskText["AddTask"]"
                            OnCreate="@(EventCallback.Factory.Create(this, AddTask))" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        <ListToolbar Choice="@_choice" ChoiceChanged="@ChooseAsync" Goals="@_listGoals" Shown="@_shownOpen.Count" Total="@_open.Count" />

        @if (_choice.View == ListScreenView.Calendar)
        {
            <ListMonthView Tasks="@_shownOpen" Sort="@_choice.Sort" Today="@State.Today" Undated="@UndatedCount"
                           GoalNameOf="@GoalOf" OnShowUndated="@ShowUndatedAsync"
                           OnToggle="@ToggleAsync" OnStar="@StarAsync" OnOpen="@Open" />
        }
        else if (_shownOpen.Count == 0 && _open.Count > 0)
        {
            <RowGroup>
                <div class="pspad-list-no-match d-flex align-center gap-2 px-3 py-2">
                    <MudText Typo="Typo.body2" Class="pspad-muted">@T["NoTasksMatch"]</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => ChooseAsync(_choice with { Filter = ListFilter.None }))">@T["FilterClear"]</MudButton>
                </div>
            </RowGroup>
        }
        else
        {
            <RowGroup Columns="true">
                @foreach (var task in _shownOpen)
                {
                    <TaskRow @key="task.Id" Task="@task" Today="@State.Today" GoalName="@GoalOf(task)" OnToggle="@ToggleAsync"
                             OnStar="@StarAsync" OnOpen="@Open" />
                }
                <AddRow Text="@TaskText["AddTask"]" OnClick="@AddTask" />
            </RowGroup>
        }
    }

    @if (_list.Kind != ListKind.Reference && _choice.View == ListScreenView.List && _shownDone.Count > 0)
    {
        <MudExpansionPanels Elevation="0" Gutters="false" Class="pspad-completed mt-2">
            <MudExpansionPanel Text="@T["CompletedCount", _shownDone.Count]">
                <RowGroup Columns="true">
                    @foreach (var task in _shownDone)
                    {
                        <TaskRow @key="task.Id" Task="@task" Today="@State.Today" GoalName="@GoalOf(task)" OnToggle="@ToggleAsync"
                                 OnStar="@StarAsync" OnOpen="@Open" />
                    }
                </RowGroup>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudFabMenu Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pspad-fab" UserAttributes="@ActivatorAttributes">
        @if (_list.Kind == ListKind.Reference)
        {
            <MudTooltip Text="@Ref["AddItem"]">
                <MudFabMenuItem OnClick="@AddItem" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                Size="Size.Small" UserAttributes="@AddItemAttributes" />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="@TaskText["AddTask"]">
                <MudFabMenuItem OnClick="@AddTask" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                Size="Size.Small" UserAttributes="@AddTaskAttributes" />
            </MudTooltip>
        }
        @if (_isMine)
        {
            <MudTooltip Text="@T["EditList"]">
                <MudFabMenuItem OnClick="@EditList" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                Size="Size.Small" UserAttributes="@EditListAttributes" />
            </MudTooltip>
            <MudTooltip Text="@T["DeleteList"]">
                <MudFabMenuItem OnClick="@DeleteAsync" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Primary"
                                Size="Size.Small" UserAttributes="@DeleteListAttributes" />
            </MudTooltip>
        }
    </MudFabMenu>
}
else
{
    <PageHeading Title="" />
    <MudText Typo="Typo.body1">@T["ListGone"]</MudText>
}

@code {
    [Parameter] public Guid ListId { get; set; }

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    bool _loaded;
    bool _isMine = true;
    TaskList? _list;
    Guid _areaId;
    string? _areaName;
    IReadOnlyList<TodoTask> _open = [];
    IReadOnlyList<Goal> _goals = [];
    IReadOnlyList<TodoTask> _done = [];
    IReadOnlyList<ReferenceItem> _items = [];
    IReadOnlyList<Goal> _listGoals = [];
    IReadOnlyList<TodoTask> _shownOpen = [];
    IReadOnlyList<TodoTask> _shownDone = [];
    ListScreenChoice _choice = ListScreenChoice.Default;
    Guid? _choiceFor;

    Dictionary<string, object> ActivatorAttributes => new() { ["aria-label"] = Shared["Actions"].Value };
    Dictionary<string, object> AddTaskAttributes => new() { ["aria-label"] = TaskText["AddTask"].Value };
    Dictionary<string, object> AddItemAttributes => new() { ["aria-label"] = Ref["AddItem"].Value };
    Dictionary<string, object> EditListAttributes => new() { ["aria-label"] = T["EditList"].Value };
    Dictionary<string, object> DeleteListAttributes => new() { ["aria-label"] = T["DeleteList"].Value };

    protected override void OnInitialized() => Sender.Sent += OnCommandSent;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    void OnCommandSent() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    string? GoalOf(TodoTask task) => Goal.Holding(_goals, task.Id)?.Name;

    async Task ReloadAsync()
    {
        var areas = await AreaStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var lists = await ListStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var views = await ViewStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var listViews = await ListViewStore.LoadAllAsync(State.UserId, CancellationToken.None);
        var placement = ListPlacement.For(State.UserId, areas, lists, views, listViews);

        var list = lists.FirstOrDefault(candidate => candidate.Id == ListId);
        _list = list is null || list.Deleted ? null : list;
        _isMine = _list is null || ListPlacement.IsMine(State.UserId, _list);
        _areaId = _list is null ? Guid.Empty : placement.AreaOf(_list);
        _areaName = _list is null ? null : placement.AreaName(_areaId, T["SharedWithMe"]);

        if (_list is { Kind: ListKind.Reference })
        {
            _open = [];
            _done = [];
        }
        else
        {
            var all = await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None);
            var mine = all.Where(task => task.ListId == ListId && !task.Deleted).ToArray();

            var goals = await GoalStore.LoadAllAsync(State.UserId, CancellationToken.None);
            _goals = [.. goals.Where(goal => !goal.Deleted)];
            _open = [.. mine.Where(task => !IsDone(task))];
            _done = [.. mine.Where(IsDone)];
            _listGoals = [.. _goals.Where(goal => mine.Any(task => goal.TaskIds.Contains(task.Id))).OrderBy(goal => goal.Name, Names)];

            if (_choiceFor != ListId)
            {
                _choiceFor = ListId;
                _choice = await Screen.LoadAsync(ListId);
            }

            Project();
        }

        var items = await ItemStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _items = [.. items.Where(item => item.ListId == ListId && !item.Deleted)
            .OrderByDescending(item => item.Starred).ThenBy(item => item.Position)];

        _loaded = true;
    }

    string Summary => _list is { Kind: ListKind.Reference }
        ? _areaName ?? ""
        : string.Join(" · ", new[] { _areaName, OpenTaskCount.Describe(_open.Count, TaskText) }.Where(part => !string.IsNullOrEmpty(part)));

    static StringComparer Names => StringComparer.Create(CultureInfo.CurrentCulture, ignoreCase: true);

    static DayOfWeek FirstDay => CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;

    int UndatedCount => _shownOpen.Count(task => TodayRule.DateOf(task, State.Today) is null);

    void Project()
    {
        bool Keep(TodoTask task) => _choice.Filter.Matches(task, State.Today, FirstDay, _goals);
        _shownOpen = _choice.Sort.Apply(_open.Where(Keep), State.Today, Names);
        _shownDone = _choice.Sort.Apply(_done.Where(Keep), State.Today, Names);
    }

    async Task ChooseAsync(ListScreenChoice choice)
    {
        _choice = choice;
        Project();
        await Screen.SaveAsync(ListId, choice);
    }

    Task ShowUndatedAsync() => ChooseAsync(_choice with
    {
        View = ListScreenView.List,
        Filter = _choice.Filter with { When = new HashSet<WhenBucket> { WhenBucket.NoDate } }
    });

    bool IsDone(TodoTask task) => task.CompletedAt is not null || task.EndedBy(State.Today);

    void Open(TodoTask task) => Navigation.NavigateTo($"/lists/{ListId}?task={task.Id}");

    void EditList() => Navigation.NavigateTo(ListQuery.For(Navigation.Uri, ListId));

    async Task DeleteAsync()
    {
        if (_list is null)
        {
            return;
        }

        var message = _list.Kind == ListKind.Reference
            ? DeleteWarning.ForList(_list.Name, ListId, await ItemStore.LoadAllAsync(State.UserId, CancellationToken.None), T)
            : DeleteWarning.ForList(_list.Name, ListId, await TaskStore.LoadAllAsync(State.UserId, CancellationToken.None), T);
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(T["DeleteList"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        var areaId = _areaId;
        await Sender.SendAsync(new DeleteTaskList(Guid.NewGuid(), State.UserId, ListId));
        Navigation.NavigateTo(AreaLinks.For(areaId));
    }

    async Task ToggleAsync(TodoTask task)
    {
        if (task.IsRecurring)
        {
            if (!task.OccursOn(State.Today) && !task.CompletedDays.Contains(State.Today))
            {
                return;
            }

            await Sender.SendAsync(new CompleteOccurrence(
                Guid.NewGuid(), State.UserId, task.Id, State.Today, !task.CompletedDays.Contains(State.Today)));
        }
        else if (task.CompletedAt is null)
        {
            await Sender.SendAsync(new CompleteTask(Guid.NewGuid(), State.UserId, task.Id));
        }
        else
        {
            await Sender.SendAsync(new ReopenTask(Guid.NewGuid(), State.UserId, task.Id));
        }
    }

    async Task StarAsync(TodoTask task)
    {
        await Sender.SendAsync(new StarTask(Guid.NewGuid(), State.UserId, task.Id, !task.Starred));
    }

    void AddTask() => Navigation.NavigateTo(TaskQuery.ForNewTask(Navigation.Uri, ListId));

    void AddItem() => Navigation.NavigateTo(ReferenceQuery.ForNewItem(Navigation.Uri, ListId));

    void OpenItem(ReferenceItem item) => Navigation.NavigateTo(ReferenceQuery.ForItem(Navigation.Uri, item.Id));

    async Task StarItemAsync(ReferenceItem item)
    {
        var result = await Sender.SendAsync(new StarReferenceItem(Guid.NewGuid(), State.UserId, item.Id, !item.Starred));

        if (!result.Accepted)
        {
            Snackbar.Add(result.Rejection ?? Ref["CouldntStarItem"], Severity.Warning);
        }
    }

    public void Dispose() => Sender.Sent -= OnCommandSent;
}
