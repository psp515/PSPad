@page "/history"
@using PSPad.App.Api
@using PSPad.Contracts
@inject IHistorySource History

<MudText Typo="Typo.h5" Class="mb-4">History</MudText>

@if (_entries is not null)
{
    @foreach (var day in _entries.GroupBy(entry => entry.At.Date))
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4">@day.Key.ToString("yyyy-MM-dd")</MudText>
        <MudList T="string">
            @foreach (var entry in day)
            {
                <MudListItem T="string">@entry.Description</MudListItem>
            }
        </MudList>
    }

    @if (_entries.Count > 0)
    {
        <MudButton OnClick="@LoadOlderAsync">load older</MudButton>
    }
}

@code {
    List<HistoryEntry> _entries = [];

    protected override async Task OnInitializedAsync() => await LoadAsync(null);

    async Task LoadAsync(long? before)
    {
        var page = await History.ReadAsync(before, 50);
        _entries.AddRange(page);
    }

    async Task LoadOlderAsync()
    {
        var before = _entries.Count > 0 ? _entries[^1].Seq : (long?)null;
        await LoadAsync(before);
    }
}
