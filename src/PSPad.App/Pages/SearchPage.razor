@page "/search"
@using PSPad.App.State
@inject ReplicaSearch Search
@inject AppState State
@inject NavigationManager Navigation

<MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@($"Search: {_query}")</MudText>

@if (_hits.Count == 0)
{
    <MudText Typo="Typo.body2">Nothing matches.</MudText>
}
else
{
    <MudList T="string">
        @foreach (var hit in _hits)
        {
            <MudListItem T="string" Href="@HrefOf(hit)">
                <MudText>@hit.Name</MudText>
                <MudText Typo="Typo.caption">@hit.Path</MudText>
            </MudListItem>
        }
    </MudList>
}

@code {
    string _query = "";
    IReadOnlyList<SearchHit> _hits = [];

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("q", out var value) ? value.ToString() : "";

        _hits = await Search.FindAsync(State.UserId, _query);
    }

    static string HrefOf(SearchHit hit) => hit.IsList ? $"/lists/{hit.Id}" : $"/search?task={hit.Id}";
}
