@page "/public/snapshot/{Token}"
@layout PublicLayout
@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.Auth
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.Contracts
@using PSPad.Module.Tasks.References
@inject PublicSnapshotsClient Client
@inject ISnapshotCache Cache
@inject ISnapshotsApi SnapshotsApi
@inject LocalAuthenticationStateProvider Authentication
@inject IClock Clock
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="pspad-snapshot-page pa-0">
    <div class="pspad-snapshot-topbar d-flex align-center justify-space-between pa-2">
        <div class="d-flex align-center gap-2">
            <div class="pspad-snapshot-brand"><BrandMark /></div>
            <MudText Typo="Typo.h6">PSPad</MudText>
        </div>
        @if (_signedIn)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/">Open PSPad</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="authentication/login">Log in</MudButton>
        }
    </div>

    @if (_state == SnapshotPageState.NotFound)
    {
        <EmptyState Icon="@Icons.Material.Outlined.LinkOff" Message="This snapshot has expired or never existed." />
        <div class="pspad-snapshot-welcome-link pa-2">
            <MudLink Href="/welcome">What is PSPad?</MudLink>
        </div>
    }
    else if (_state == SnapshotPageState.NoConnection)
    {
        <EmptyState Icon="@Icons.Material.Outlined.WifiOff" Message="Connect to the internet to open this snapshot." />
    }
    else if (_snapshot is not null)
    {
        @if (_offline)
        {
            <MudAlert Severity="Severity.Warning" Class="pspad-snapshot-offline-banner ma-2">
                Offline — showing the copy from @_snapshot.CreatedAt.ToString("d MMM yyyy"). Ticks are paused.
            </MudAlert>
        }

        <MudPaper Elevation="2" Class="mud-theme-primary pa-6 ma-2 pspad-snapshot-hero">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Outlined.Public" Size="Size.Small" />
                <MudText Typo="Typo.caption">Public snapshot@(HasOwner ? $" · shared by {_snapshot.OwnerName}" : "")</MudText>
            </div>
            <MudText Typo="Typo.h4" Class="pspad-snapshot-name">@_snapshot.Name</MudText>
            <div class="d-flex flex-wrap gap-2 my-3">
                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="pspad-snapshot-hero-chip ma-0">Copy from @_snapshot.CreatedAt.ToString("d MMM")</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="pspad-snapshot-hero-chip ma-0">Link works until @_snapshot.ExpiresAt.ToString("d MMM")</MudChip>
            </div>
            <MudText Typo="Typo.caption">@Ticked of @Entries ticked by visitors</MudText>
            <MudProgressLinear Color="Color.Inherit" Rounded="true" Size="Size.Medium" Class="pspad-snapshot-progress mt-2" Value="@(Entries == 0 ? 0 : 100.0 * Ticked / Entries)" />
        </MudPaper>

        @if (!_offline)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mx-2">
                Tick anything you have taken care of. Everyone with this link sees your tick, and @OwnerLabel sees it on the list.
            </MudAlert>
        }

        <div class="pspad-snapshot-entries pa-2">
            @if (_snapshot.Kind == "Tasks")
            {
                @if (OpenTasks.Length > 0)
                {
                    <MudText Typo="Typo.overline" Class="pspad-muted d-block mt-2">To do · @OpenTasks.Length</MudText>
                }
                @foreach (var task in OpenTasks)
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-2 pspad-snapshot-task">
                        <div class="d-flex align-center gap-2">
                            <MudCheckBox T="bool" Value="@task.Marked" Disabled="@_offline"
                                         ValueChanged="@(_ => ToggleTaskAsync(task))" Color="Color.Primary" Dense="true" />
                            <MudText Typo="Typo.body1">@task.Name</MudText>
                            @if (task.Starred)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                            }
                            @if (task.DueOn is { } due)
                            {
                                <MudChip T="string" Size="Size.Small">@due.ToString("d MMM")</MudChip>
                            }
                            @if (task.Marked)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small">ticked</MudChip>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <div class="pspad-snapshot-description">
                                <MarkdownField Value="@task.Description" ReadOnly="true" />
                            </div>
                        }

                        @foreach (var step in task.Steps)
                        {
                            <div class="d-flex align-center gap-2 pspad-snapshot-step">
                                @if (step.Done)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                             Class="pspad-snapshot-step-done" aria-label="Done by the owner" />
                                    <MudText Typo="Typo.body2" Class="pspad-muted" Style="text-decoration:line-through">@step.Name</MudText>
                                }
                                else
                                {
                                    <MudCheckBox T="bool" Value="@step.Marked" Disabled="@_offline"
                                                 ValueChanged="@(_ => ToggleStepAsync(task, step))" Color="Color.Primary" Dense="true" />
                                    <MudText Typo="Typo.body2">@step.Name</MudText>
                                }
                                @if (step.Marked)
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small">ticked</MudChip>
                                }
                            </div>
                        }
                    </MudPaper>
                }

                @if (DoneTasks.Length > 0)
                {
                <div class="pspad-snapshot-done mt-4">
                    <MudText Typo="Typo.overline" Class="pspad-muted d-block">Already done by @OwnerLabel · @DoneTasks.Length</MudText>
                    @foreach (var task in DoneTasks)
                    {
                        <MudPaper Outlined="true" Class="pa-2 mb-2 d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                            <MudText Typo="Typo.body1" Class="pspad-muted" Style="text-decoration:line-through">@task.Name</MudText>
                        </MudPaper>
                    }
                </div>
                }
            }
            else
            {
                @foreach (var item in _snapshot.Items)
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-2 pspad-snapshot-item">
                        <div class="d-flex align-center gap-2">
                            <MudCheckBox T="bool" Value="@item.Marked" Disabled="@_offline"
                                         ValueChanged="@(_ => ToggleItemAsync(item))" Color="Color.Primary" Dense="true" />
                            <MudText Typo="Typo.body1">@item.Name</MudText>
                            @if (item.Starred)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                            }
                            @if (item.Marked)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small">ticked</MudChip>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="pspad-snapshot-description">
                                <MarkdownField Value="@item.Description" ReadOnly="true" />
                            </div>
                        }

                        @foreach (var field in item.Fields)
                        {
                            <div class="pspad-snapshot-field">
                                <MudText Typo="Typo.caption">@field.Label</MudText>
                                <ReferenceFieldValue Field="@ToReferenceField(field)" />
                            </div>
                        }
                    </MudPaper>
                }
            }
        </div>

        <div class="text-center pa-4">
            <MudText Typo="Typo.caption">A read-only copy made with PSPad.</MudText>
            <MudLink Href="/welcome" Typo="Typo.caption">What is PSPad?</MudLink>
        </div>
    }
</MudContainer>

@code {
    [Parameter] public string Token { get; set; } = "";

    enum SnapshotPageState
    {
        Loading,
        NotFound,
        NoConnection,
        Ready
    }

    SnapshotPageState _state = SnapshotPageState.Loading;
    SnapshotView? _snapshot;
    bool _offline;
    bool _signedIn;

    bool HasOwner => !string.IsNullOrWhiteSpace(_snapshot?.OwnerName);

    string OwnerLabel => HasOwner ? _snapshot!.OwnerName : "the owner";

    SnapshotTaskView[] OpenTasks => _snapshot!.Tasks.Where(task => !task.Done).ToArray();

    SnapshotTaskView[] DoneTasks => _snapshot!.Tasks.Where(task => task.Done).ToArray();

    int Entries => _snapshot!.Kind == "Tasks" ? OpenTasks.Length : _snapshot.Items.Length;

    int Ticked => _snapshot!.Kind == "Tasks" ? OpenTasks.Count(task => task.Marked) : _snapshot.Items.Count(item => item.Marked);

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync()
    {
        var session = await Authentication.SessionAsync();
        _signedIn = session is not null;

        SnapshotView? snapshot;
        try
        {
            snapshot = await Client.GetAsync(Token);
        }
        catch (HttpRequestException)
        {
            var cached = await Cache.GetAsync(Token);
            if (cached is not null && cached.ExpiresAt > Clock.UtcNow)
            {
                _snapshot = cached;
                _offline = true;
                _state = SnapshotPageState.Ready;
                return;
            }

            _state = SnapshotPageState.NoConnection;
            return;
        }

        if (snapshot is null)
        {
            _state = SnapshotPageState.NotFound;
            return;
        }

        _snapshot = snapshot;
        _offline = false;
        _state = SnapshotPageState.Ready;

        if (_signedIn)
        {
            _ = SnapshotsApi.RecordVisitAsync(Token);
            await Cache.SaveAsync(Token, snapshot, Clock.UtcNow);
        }
    }

    async Task ToggleTaskAsync(SnapshotTaskView task) => await ToggleAsync(task.Id, null, !task.Marked);

    async Task ToggleStepAsync(SnapshotTaskView task, SnapshotStepView step) =>
        await ToggleAsync(task.Id, step.Id, !step.Marked);

    async Task ToggleItemAsync(SnapshotItemView item) => await ToggleAsync(item.Id, null, !item.Marked);

    async Task ToggleAsync(Guid entryId, Guid? stepId, bool marked)
    {
        if (_snapshot is null)
        {
            return;
        }

        var previous = _snapshot;
        _snapshot = WithMark(_snapshot, entryId, stepId, marked);

        var ok = await Client.MarkAsync(Token, entryId, stepId, marked);
        if (!ok)
        {
            _snapshot = previous;
            Snackbar.Add("Couldn't save that tick. Try again.", Severity.Warning);
        }
    }

    static SnapshotView WithMark(SnapshotView snapshot, Guid entryId, Guid? stepId, bool marked) =>
        snapshot with
        {
            Tasks = snapshot.Tasks.Select(task => WithTaskMark(task, entryId, stepId, marked)).ToArray(),
            Items = snapshot.Items
                .Select(item => item.Id == entryId ? item with { Marked = marked } : item)
                .ToArray()
        };

    static SnapshotTaskView WithTaskMark(SnapshotTaskView task, Guid entryId, Guid? stepId, bool marked)
    {
        if (stepId is { } step)
        {
            return task with
            {
                Steps = task.Steps.Select(s => s.Id == step ? s with { Marked = marked } : s).ToArray()
            };
        }

        return task.Id == entryId ? task with { Marked = marked } : task;
    }

    static ReferenceField ToReferenceField(SnapshotFieldView field) =>
        new(Guid.Empty, field.Label, field.Value, field.Display, 0);
}
