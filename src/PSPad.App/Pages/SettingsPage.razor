@page "/settings"
@attribute [Authorize]
@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.Auth
@using PSPad.App.Components
@using PSPad.App.Localization
@using PSPad.App.Resources
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.App.State.Outbox
@using PSPad.App.Sync
@using PSPad.App.Theme
@using PSPad.Module.Money.Preferences
@using PSPad.Module.Money.Values
@using PSPad.Module.Tasks.Today
@inject IConfiguration Configuration
@inject IDocumentStore<MoneyPreferences> PreferencesStore
@inject IConnectivity Connectivity
@inject PSPadApiClient Api
@inject AppState State
@inject LanguagePreference Languages
@inject IStringLocalizer<SettingsStrings> T
@inject IStringLocalizer<SharedStrings> S
@inject IStringLocalizer<ShellStrings> Shell
@inject ThemePreference Preference
@inject IOutbox Outbox
@inject CommandSender Sender
@inject LocalSignOut SignOut
@inject NavigationManager Navigation
@inject IClock Clock
@inject ISyncStatus SyncStatus
@inject IDialogService Dialogs
@inject LocalAccountDeletion AccountDeletion
@inject ISnackbar Snackbar
@implements IDisposable

<PageHeading Title="@S["Settings"]" Subtitle="@T["SettingsSubtitle"]" Icon="@Icons.Material.Outlined.Settings" />

<MudGrid Spacing="4">
    <MudItem xs="12" sm="6" lg="4" xl="3">
        <MudPaper Outlined="true" Class="pa-4 pspad-account-card">
            <SectionHeading Title="@S["Account"]" />
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Style="@($"background:{AvatarColor.For(State.UserId)};color:#FFFFFF")" Size="Size.Large">
                    @AvatarColor.InitialOf(State.DisplayName.Length > 0 ? State.DisplayName : State.Email)
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.body1">@State.DisplayName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@State.Email</MudText>
                </div>
            </div>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                <MudButton Class="pspad-change-password" Href="@KeycloakAccountConsole.UrlFor(Configuration["Keycloak:Authority"]!)"
                           Target="_blank" StartIcon="@Icons.Material.Filled.Password" Variant="Variant.Outlined">
                    @T["ChangePassword"]
                </MudButton>
                <MudButton Class="pspad-sign-out" OnClick="@SignOutAsync" StartIcon="@Icons.Material.Filled.Logout"
                           Color="Color.Error" Variant="Variant.Outlined" Disabled="@(!Connectivity.IsOnline || _signingOut)">
                    @T["SignOut"]
                </MudButton>
            </MudStack>
            @if (!Connectivity.IsOnline)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2 pspad-sign-out-offline">
                    @T["SignOutNeedsConnection"]
                </MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="4" xl="3">
        <MudPaper Outlined="true" Class="pa-4 pspad-application-settings">
            <SectionHeading Title="@T["ApplicationSettings"]" />
            <MudAutocomplete T="string" Value="@State.TimeZone" ValueChanged="@ApplyTimeZoneAsync"
                             SearchFunc="@SearchTimeZonesAsync" Label="@T["TimeZone"]"
                             Variant="Variant.Outlined" Margin="Margin.Dense" ResetValueOnEmptyText="false" />
            <MudText Typo="Typo.caption">@T["TimeZoneNeedsConnection"]</MudText>
            @if (_rejected)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@S["ThatChangeDidNotGoThrough"]</MudText>
            }
            <MudSelect T="string" Class="pspad-language mt-3" Label="@T["Language"]"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Value="@Languages.Language" ValueChanged="@ApplyLanguageAsync">
                @foreach (var language in SupportedLanguages.All)
                {
                    <MudSelectItem T="string" Value="@language">@NativeName(language)</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption">@T["LanguageReloads"]</MudText>
            <MudSelect T="string" Class="pspad-default-currency mt-3" Label="@T["DefaultCurrency"]"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Value="@_defaultCurrency" ValueChanged="@ApplyDefaultCurrencyAsync">
                @foreach (var currency in Currencies.All)
                {
                    <MudSelectItem T="string" Value="@currency">@currency</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="ThemeMode" Value="@Preference.Mode" ValueChanged="@SelectThemeAsync" Label="@T["Theme"]"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4">
                @foreach (var mode in Enum.GetValues<ThemeMode>())
                {
                    <MudSelectItem T="ThemeMode" Value="@mode">@T[$"Theme{mode}"]</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Class="d-block mt-4 mb-2">@T["Accent"]</MudText>
            <AccentPicker />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="4" xl="3">
        <MudPaper Outlined="true" Class="pa-4" id="sync">
            <SectionHeading Title="@T["Sync"]" />
            <MudText Typo="Typo.body2" Color="@(Failed ? Color.Error : Color.Default)">@SyncLine</MudText>
            <MudText Typo="Typo.caption" Class="d-block mb-3 pspad-muted">@LastSyncedText</MudText>
            @if (SyncStatus.LastRejections.Count > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Error">@T["CouldNotBeSaved"]</MudText>
                <MudList T="string" Dense="true" ReadOnly="true" Class="pspad-sync-rejections mb-3">
                    @foreach (var rejection in SyncStatus.LastRejections)
                    {
                        <MudListItem T="string" Class="pspad-sync-rejection" Icon="@Icons.Material.Outlined.ErrorOutline"
                                     IconColor="Color.Error" Text="@rejection" />
                    }
                </MudList>
                @if (SyncStatus.HasStuckChange)
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-2">
                        @T["StuckChangeHoldsBack"]
                    </MudText>
                    <MudButton Class="pspad-discard-stuck mb-3" Color="Color.Error" Variant="Variant.Outlined"
                               OnClick="@SyncStatus.DiscardStuckChangeAsync">
                        @T["DiscardChange"]
                    </MudButton>
                }
            }
            <SyncButton Labeled="true" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="4" xl="3">
        <MudPaper Outlined="true" Class="pa-4">
            <SectionHeading Title="@T["DangerZone"]" Color="Color.Error" />
            <MudText Typo="Typo.body2" Class="mb-3">
                @T["DeleteAccountWarning"]
            </MudText>
            <MudButton Class="pspad-delete-account" Color="Color.Error" Variant="Variant.Outlined"
                       Disabled="@(!Connectivity.IsOnline)" OnClick="@OpenDeleteAccountDialogAsync">
                @T["DeleteAccount"]
            </MudButton>
            @if (!Connectivity.IsOnline)
            {
                <MudText Typo="Typo.caption" Class="mt-2">@T["RequiresConnection"]</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    bool _rejected;
    string _defaultCurrency = Currencies.Pln;
    int _pendingCommands;
    bool _signingOut;

    static readonly string[] TimeZoneIds =
        TimeZoneInfo.GetSystemTimeZones().Select(zone => zone.Id).OrderBy(id => id, StringComparer.Ordinal).ToArray();

    static readonly TimeSpan Tick = TimeSpan.FromSeconds(30);

    Timer? _timer;

    bool Failed => SyncStatus.LastSyncFailed && Connectivity.IsOnline && !SyncStatus.IsSyncing;

    string SyncLine =>
        SyncStatus.IsSyncing ? T["Syncing"]
        : Failed ? (_pendingCommands == 0 ? T["SyncFailed"] : T["SyncFailedPending", _pendingCommands])
        : _pendingCommands == 0 ? T["SyncedEverything"]
        : T["SyncPending", _pendingCommands];

    string LastSyncedText => SyncStatus.LastSyncedAt is { } at
        ? T["LastSynced", RelativeTime.Describe(at, Clock.UtcNow, Shell)]
        : T["NotSyncedYet"];

    [SupplyParameterFromQuery(Name = StepUpSignIn.DeleteAccountQuery)]
    public string? DeleteAccount { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && DeleteAccount is not null)
        {
            Navigation.NavigateTo("settings", replace: true);
            await OpenDeleteAccountDialogAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Sender.Sent += OnCommandSent;
        SyncStatus.Changed += OnSyncChanged;
        Connectivity.Changed += OnConnectivityChanged;
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, Tick, Tick);
        await RefreshPendingAsync();
        await LoadDefaultCurrencyAsync();
    }

    async Task LoadDefaultCurrencyAsync()
    {
        var preferences = await PreferencesStore.LoadAsync(MoneyPreferences.IdFor(State.UserId), CancellationToken.None);
        _defaultCurrency = preferences?.DefaultCurrency ?? Currencies.Pln;
    }

    async Task ApplyDefaultCurrencyAsync(string currency)
    {
        var previous = _defaultCurrency;
        _defaultCurrency = currency;
        var result = await Sender.SendAsync(new SetDefaultCurrency(Guid.NewGuid(), State.UserId, currency));
        if (!result.Accepted)
        {
            _defaultCurrency = previous;
        }
    }

    async Task RefreshPendingAsync()
    {
        _pendingCommands = await Outbox.CountAsync();
        StateHasChanged();
    }

    void OnCommandSent() => InvokeAsync(RefreshPendingAsync);

    void OnSyncChanged() => InvokeAsync(RefreshPendingAsync);

    void OnConnectivityChanged() => InvokeAsync(StateHasChanged);

    async Task SignOutAsync()
    {
        if (_signingOut || !Connectivity.IsOnline || !await ConfirmLosingUnsyncedChangesAsync())
        {
            return;
        }

        _signingOut = true;

        // Storage is cleared before the redirect leaves the app, so an interrupted round trip still signs out.
        if (await SignOut.SignOutAsync() is not SignOutOutcome.Cleared cleared)
        {
            _signingOut = false;
            Snackbar.Add(T["SignOutServerUnreachable"], Severity.Warning);
            return;
        }

        Navigation.NavigateTo(
            KeycloakEndSession.UrlFor(
                Configuration["Keycloak:Authority"]!,
                Configuration["Keycloak:ClientId"]!,
                Navigation.ToAbsoluteUri("welcome").ToString(),
                cleared.IdTokenHint),
            forceLoad: true);
    }

    async Task<bool> ConfirmLosingUnsyncedChangesAsync()
    {
        var pending = await Outbox.CountAsync();

        if (pending == 0)
        {
            return true;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, T.Plural(pending, "UnsyncedChanges") },
            { dialog => dialog.ConfirmText, T["SignOut"].Value }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(T["SignOut"], parameters);
        var result = await dialog.Result;

        return result is { Canceled: false };
    }

    public void Dispose()
    {
        Sender.Sent -= OnCommandSent;
        SyncStatus.Changed -= OnSyncChanged;
        Connectivity.Changed -= OnConnectivityChanged;
        _timer?.Dispose();
    }

    public async Task ApplyTimeZoneAsync(string timeZone)
    {
        var me = (await Api.SetTimeZoneAsync(timeZone)).Sanitized();

        if (me is null)
        {
            _rejected = true;
            return;
        }

        _rejected = false;
        State.TimeZone = me.TimeZone;
        State.Today = LocalToday.In(Clock.UtcNow, me.TimeZone);
        StateHasChanged();
    }

    static string NativeName(string language) => language switch
    {
        "pl" => "Polski",
        _ => "English"
    };

    public async Task ApplyLanguageAsync(string language)
    {
        await Languages.ChooseAsync(language);
        State.Language = language;

        var me = (await Api.SetLanguageAsync(language)).Sanitized();
        if (me is not null && me.Language == language)
        {
            await Languages.ClearPendingAsync();
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    public Task SelectThemeAsync(ThemeMode mode) => Preference.SetAsync(mode);

    public Task<IEnumerable<string>> SearchTimeZonesAsync(string value, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? TimeZoneIds.AsEnumerable()
            : TimeZoneIds.Where(id => id.Contains(value, StringComparison.OrdinalIgnoreCase)));

    async Task OpenDeleteAccountDialogAsync()
    {
        var parameters = new DialogParameters<DeleteAccountDialog> { { dialog => dialog.Email, State.Email } };
        var dialog = await Dialogs.ShowAsync<DeleteAccountDialog>(T["DeleteAccount"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        // Clearing before the redirect leaves the app is what makes an interrupted deletion
        // still finish signing the browser out of an account that is already gone server-side.
        await AccountDeletion.ClearStorageAsync();
        Navigation.NavigateTo("welcome");
        AccountDeletion.Announce();
    }
}
