@page "/budgets/{BudgetId:guid}"
@page "/budgets/{BudgetId:guid}/{Tab}"
@attribute [Authorize]
@using PSPad.Abstractions
@using PSPad.App.Components
@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Money.Balance
@using PSPad.Module.Money.Budgets
@using PSPad.Module.Money.Entries
@using PSPad.Module.Money.Reading
@using PSPad.Module.Money.Values
@inject IDocumentStore<Budget> BudgetStore
@inject IDocumentStore<MoneyEntry> EntryStore
@inject IDocumentStore<BalanceSnapshot> SnapshotStore
@inject AppState State
@inject CommandSender Sender
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable

@if (!_loaded)
{
    <CardSkeleton Count="2" />
}
else if (_budget is null)
{
    <PageHeading Title="Budget" Icon="@Icons.Material.Outlined.AccountBalanceWallet" BackHref="@BudgetLinks.Index" />
    <MudAlert Severity="Severity.Warning">That budget does not exist.</MudAlert>
}
else
{
    <div class="pspad-budget-page">
    <PageHeading Title="@_budget.Name" Icon="@Icons.Material.Outlined.AccountBalanceWallet" BackHref="@BudgetLinks.Index"
                 BackLabel="Back to budgets" />

    @if (_budget.IsArchived)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4 pspad-archived-banner">@ArchivedText</MudAlert>
    }

    <div class="d-flex align-center gap-2 mb-4 pspad-budget-nav">
        <MudToggleGroup T="int" Class="flex-grow-1 pspad-budget-views" Color="Color.Primary" Size="Size.Small"
                        SelectionMode="SelectionMode.SingleSelection" Value="@TabIndex" ValueChanged="@SelectTab">
            <MudToggleItem Value="@MonthTab" Text="Month" />
            <MudToggleItem Value="@BalanceTab" Text="Balance" />
            <MudToggleItem Value="@SummaryTab" Text="Summary" />
        </MudToggleGroup>
        @if (_budget.IsShared)
        {
            <MudBadge Class="pspad-budget-members-button" Content="@(_budget.Members.Count + 1)" Color="Color.Primary"
                      Overlap="true" Bordered="true">
                <MudIconButton Icon="@Icons.Material.Outlined.People" aria-label="@($"Members, {_budget.Members.Count + 1} people")"
                               OnClick="@OpenMembers" />
            </MudBadge>
        }
        <MudIconButton Class="pspad-budget-settings" Icon="@Icons.Material.Outlined.Settings" aria-label="Budget settings"
                       aria-pressed="@(TabIndex == SettingsTab ? "true" : "false")"
                       Color="@(TabIndex == SettingsTab ? Color.Primary : Color.Default)" OnClick="@(() => SelectTab(SettingsTab))" />
        @if (TabIndex is MonthTab or BalanceTab)
        {
            <MonthSwitcher Month="@_month" Current="@Current" OnMonthChanged="@ShowMonth">
                @if (TabIndex == BalanceTab && Balance.Snapshot is not null && !_budget.IsArchived)
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Month actions" Class="pspad-balance-menu" Dense="true"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Class="pspad-delete-month" OnClick="@DeleteMonthAsync">Delete month</MudMenuItem>
                    </MudMenu>
                }
            </MonthSwitcher>
        }
    </div>

    @switch (TabIndex)
    {
        case MonthTab:
            <BudgetMonthTab Month="@_month" Totals="@MonthTotals.For(_entries, _month)"
                            OnOpen="@OpenEntry" />
            break;
        case BalanceTab:
            <BudgetBalanceTab Month="@_month" Totals="@Balance" ReadOnly="@_budget.IsArchived"
                              OnStart="@StartMonthAsync" OnOpen="@OpenHolding" />
            break;
        case SummaryTab:
            <BudgetSummaryTab Entries="@_entries" Snapshots="@_snapshots" />
            break;
        default:
            <BudgetSettingsTab Budget="@_budget" Entries="@_entries" Viewer="@State.UserId" OnOpenMembers="@OpenMembers"
                               OnAddCategory="@AddCategoryAsync"
                               OnRenameCategory="@RenameCategoryAsync" OnMergeCategory="@MergeCategoryAsync"
                               OnRemoveCategory="@RemoveCategoryAsync"
                               OnRename="@(() => Navigation.NavigateTo(BudgetQuery.For(Navigation.Uri, _budget.Id)))"
                               OnImport="@(kind => Navigation.NavigateTo(BudgetLinks.ForImport(BudgetId, kind)))"
                               OnArchive="@ArchiveAsync" OnRestore="@RestoreAsync" />
            break;
    }
    </div>

    @if (TabIndex == MonthTab && !_budget.IsArchived)
    {
        <MudFabMenu Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pspad-fab" UserAttributes="@ActivatorAttributes">
            <MudTooltip Text="Add expense">
                <MudFabMenuItem OnClick="@(() => AddEntry(CategoryKind.Expense))" StartIcon="@Icons.Material.Filled.Remove"
                                Color="Color.Primary" Size="Size.Small" UserAttributes="@AddExpenseAttributes" />
            </MudTooltip>
            <MudTooltip Text="Add income">
                <MudFabMenuItem OnClick="@(() => AddEntry(CategoryKind.Income))" StartIcon="@Icons.Material.Filled.Add"
                                Color="Color.Primary" Size="Size.Small" UserAttributes="@AddIncomeAttributes" />
            </MudTooltip>
        </MudFabMenu>
    }
    else if (TabIndex == BalanceTab && !_budget.IsArchived && Balance.Snapshot is not null)
    {
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pspad-fab" OnClick="@NewHolding"
                UserAttributes="@AddHoldingAttributes" />
    }
}

@code {
    const int MonthTab = 0;
    const int BalanceTab = 1;
    const int SummaryTab = 2;
    const int SettingsTab = 3;
    static readonly string[] Tabs = ["month", "balance", "summary", "settings"];
    static readonly Dictionary<string, object> ActivatorAttributes = new() { ["aria-label"] = "Add entry" };
    static readonly Dictionary<string, object> AddExpenseAttributes = new() { ["aria-label"] = "Add expense" };
    static readonly Dictionary<string, object> AddIncomeAttributes = new() { ["aria-label"] = "Add income" };
    static readonly Dictionary<string, object> AddHoldingAttributes = new() { ["aria-label"] = "Add holding" };

    [Parameter] public Guid BudgetId { get; set; }

    [Parameter] public string? Tab { get; set; }

    [CascadingParameter(Name = "SyncRevision")] public int SyncRevision { get; set; }

    bool _loaded;
    int _rendered = -1;
    Guid _renderedId;
    Budget? _budget;
    IReadOnlyList<MoneyEntry> _entries = [];
    IReadOnlyList<BalanceSnapshot> _snapshots = [];
    YearMonth _month;

    int TabIndex => Math.Max(MonthTab, Array.IndexOf(Tabs, Tab?.ToLowerInvariant() ?? ""));

    YearMonth Current => YearMonth.Of(State.Today);

    BalanceTotals Balance => BalanceTotals.For(_snapshots, _month);

    protected override void OnInitialized()
    {
        _month = YearMonth.Of(State.Today);
        Sender.Sent += OnCommandSent;
    }

    void OnCommandSent() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        if (_rendered == SyncRevision && _renderedId == BudgetId)
        {
            return;
        }

        _rendered = SyncRevision;
        _renderedId = BudgetId;
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        var budget = await BudgetStore.LoadAsync(BudgetId, CancellationToken.None);
        _budget = budget is null || !budget.Admits(State.UserId) ? null : budget;
        var entries = await EntryStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _entries = [.. entries.Where(entry => entry.BudgetId == BudgetId && !entry.Deleted)];
        var snapshots = await SnapshotStore.LoadAllAsync(State.UserId, CancellationToken.None);
        _snapshots = [.. snapshots.Where(snapshot => snapshot.BudgetId == BudgetId && !snapshot.Deleted)];
        _loaded = true;
    }

    void SelectTab(int index)
    {
        if (index != TabIndex)
        {
            Navigation.NavigateTo(BudgetLinks.ForTab(BudgetId, Tabs[index]));
        }
    }

    void ShowMonth(YearMonth month) => _month = month;

    string ArchivedText => _budget!.UserId == State.UserId
        ? "This budget is archived. It is read-only."
        : $"{_budget.OwnerName} archived this budget. It is read-only.";

    void OpenMembers() => Navigation.NavigateTo(BudgetMembersQuery.For(Navigation.Uri, BudgetId));

    void OpenEntry(MoneyEntry entry) => Navigation.NavigateTo(EntryQuery.For(Navigation.Uri, entry.Id));

    void AddEntry(CategoryKind kind) => Navigation.NavigateTo(EntryQuery.ForNew(Navigation.Uri, BudgetId, kind));

    void OpenHolding(Holding holding) =>
        Navigation.NavigateTo(HoldingQuery.For(Navigation.Uri, Balance.Snapshot!.Id, holding.HoldingId));

    void NewHolding() => Navigation.NavigateTo(HoldingQuery.ForNew(Navigation.Uri, Balance.Snapshot!.Id));

    async Task StartMonthAsync() =>
        Surface(await Sender.SendAsync(new StartBalanceMonth(Guid.NewGuid(), State.UserId, BudgetId, _month)),
            "Couldn't start the month.");

    async Task DeleteMonthAsync() =>
        Surface(await Sender.SendAsync(new DeleteBalanceMonth(Guid.NewGuid(), State.UserId, BudgetId, _month)),
            "Couldn't delete the month.");

    async Task<bool> AddCategoryAsync((CategoryKind Kind, string Name) category) =>
        Surface(await Sender.SendAsync(new AddCategory(Guid.NewGuid(), State.UserId, BudgetId, category.Kind, category.Name)),
            "Couldn't add the category.");

    async Task<bool> RenameCategoryAsync((CategoryKind Kind, string From, string To) change) =>
        Surface(await Sender.SendAsync(new RenameCategory(Guid.NewGuid(), State.UserId, BudgetId, change.Kind, change.From, change.To)),
            "Couldn't rename the category.");

    async Task<bool> MergeCategoryAsync((CategoryKind Kind, string From, string Into) change) =>
        Surface(await Sender.SendAsync(new MergeCategory(Guid.NewGuid(), State.UserId, BudgetId, change.Kind, change.From, change.Into)),
            "Couldn't merge the categories.");

    async Task<bool> RemoveCategoryAsync((CategoryKind Kind, string Name) category) =>
        Surface(await Sender.SendAsync(new RemoveCategory(Guid.NewGuid(), State.UserId, BudgetId, category.Kind, category.Name)),
            "Couldn't remove the category.");

    async Task ArchiveAsync() =>
        Surface(await Sender.SendAsync(new ArchiveBudget(Guid.NewGuid(), State.UserId, BudgetId)),
            "Couldn't archive the budget.");

    async Task RestoreAsync() =>
        Surface(await Sender.SendAsync(new RestoreBudget(Guid.NewGuid(), State.UserId, BudgetId)),
            "Couldn't restore the budget.");

    bool Surface(CommandResult result, string fallback)
    {
        if (!result.Accepted)
        {
            Snackbar.Add(result.Rejection ?? fallback, Severity.Warning);
        }

        return result.Accepted;
    }

    public void Dispose() => Sender.Sent -= OnCommandSent;
}
