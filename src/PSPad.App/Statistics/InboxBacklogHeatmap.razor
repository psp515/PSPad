@using PSPad.Contracts

<div class="pspad-heatmap">
    <div class="pspad-heatmap-flow" style="--pspad-heatmap-cell-min:30px;--pspad-heatmap-cell-cap:44px;">
        @foreach (var week in Weeks)
        {
            <div class="pspad-heatmap-swatch pspad-heatmap-week"
                 data-level="@HeatmapLevel.Of(week.Count, Maximum)"
                 data-today="@(week.WeekStart == CurrentWeekStart ? "true" : "false")"
                 title="@LabelOf(week)"
                 aria-label="@LabelOf(week)">
            </div>
        }
    </div>
    <HeatmapKey Caption="Each square is one week; darker means more captures were still waiting in the Inbox when that week ended."
                Less="Empty" More="Piling up" />
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WeeklyCountView> Weeks { get; set; } = [];

    [Parameter] public DateOnly Today { get; set; }

    int Maximum => Weeks.Count == 0 ? 0 : Weeks.Max(week => week.Count);

    DateOnly CurrentWeekStart => Today.AddDays(-(int)Today.DayOfWeek);

    static string LabelOf(WeeklyCountView week) =>
        $"week of {week.WeekStart:yyyy-MM-dd}: {week.Count} still in the Inbox";
}
