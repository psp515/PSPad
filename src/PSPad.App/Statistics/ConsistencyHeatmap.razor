@using PSPad.Contracts
@inject IStringLocalizer<StatisticsStrings> T

<div class="pspad-heatmap">
    @if (Days.Count > MonthSectionThreshold)
    {
        @foreach (var month in Days.GroupBy(day => new DateOnly(day.Day.Year, day.Day.Month, 1)))
        {
            <div class="pspad-heatmap-month" role="group" aria-label="@month.Key.ToString("MMM yyyy")">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pspad-heatmap-month-label">
                    @month.Key.ToString("MMM yyyy")
                </MudText>
                @Grid(month.ToList())
            </div>
        }
    }
    else
    {
        @Grid(Days)
    }
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pspad-heatmap-readout"
             data-selected="@Flag(_selected is not null)" aria-live="polite">
        @Readout()
    </MudText>
    <HeatmapKey Caption="@T["HeatmapCaption"]" />
</div>

@code {
    const int MonthSectionThreshold = 30;

    [Parameter, EditorRequired] public IReadOnlyList<DailyCountView> Days { get; set; } = [];

    [Parameter] public DateOnly Today { get; set; }

    DailyCountView? _selected;

    int Maximum => Days.Count == 0 ? 0 : Days.Max(day => day.Count);

    RenderFragment Grid(IReadOnlyList<DailyCountView> days) =>
        @<div class="pspad-heatmap-flow" style="--pspad-heatmap-cell-min:30px;--pspad-heatmap-cell-cap:44px;">
            @foreach (var day in days)
            {
                <button type="button" class="pspad-heatmap-swatch pspad-heatmap-cell"
                        data-level="@HeatmapLevel.Of(day.Count, Maximum)"
                        data-today="@Flag(day.Day == Today)"
                        data-sunday="@Flag(day.Day.DayOfWeek == DayOfWeek.Sunday)"
                        data-selected="@Flag(day.Day == _selected?.Day)"
                        aria-pressed="@Flag(day.Day == _selected?.Day)"
                        title="@LabelOf(day)"
                        aria-label="@LabelOf(day)"
                        @onclick="@(() => Toggle(day))">
                    <span class="pspad-heatmap-day-number" aria-hidden="true">@day.Day.Day</span>
                </button>
            }
        </div>;

    void Toggle(DailyCountView day) => _selected = _selected?.Day == day.Day ? null : day;

    string Readout() =>
        _selected is { } day ? T["HeatmapReadout", day.Day.ToString("d MMM yyyy"), day.Count] : T["HeatmapHint"];

    static string Flag(bool set) => set ? "true" : "false";

    string LabelOf(DailyCountView day) => T["HeatmapCell", day.Day.ToString("yyyy-MM-dd"), day.Count];
}
