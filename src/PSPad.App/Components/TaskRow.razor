@using PSPad.Module.Tasks.Tasks
@using PSPad.Module.Tasks.Today
@inject IStringLocalizer<TasksStrings> T

<div class="pspad-row d-flex align-center gap-2 pr-1 @(HasMeta ? "pspad-row-has-meta" : "") @(Overdue ? "pspad-overdue overdue" : "")">
    @if (Task.Priority != Priority.None)
    {
        <span class="@($"pspad-priority pspad-priority-{Task.Priority.ToString().ToLowerInvariant()}")" role="img"
              title="@T[$"PriorityLabel{Task.Priority}"].Value" aria-label="@T[$"PriorityLabel{Task.Priority}"].Value"></span>
    }
    else
    {
        <span class="pspad-priority-slot" aria-hidden="true"></span>
    }
    @Lead
    <MudCheckBox T="bool" Value="@Done" ValueChanged="@(_ => OnToggle.InvokeAsync(Task))"
                 Color="Color.Primary" UncheckedColor="Color.Default" Dense="true"
                 UncheckedIcon="@Icons.Material.Filled.RadioButtonUnchecked" CheckedIcon="@Icons.Material.Filled.CheckCircle" />

    <div class="pspad-row-body pspad-task-name" @onclick="@(() => OnOpen.InvokeAsync(Task))">
        <MudText Typo="Typo.body2" Class="pspad-row-name" title="@Task.Name"
                 Style="@(Done ? "text-decoration:line-through" : "")">@Task.Name</MudText>

        @if (HasMeta)
        {
            <div class="pspad-row-meta">
                @if (ShowTime && Task.EffectiveTime is { } time)
                {
                    <MudText Typo="Typo.caption" Class="pspad-row-time" Color="Color.Primary">@TimeRow.Describe(time)</MudText>
                }
                @if (Task.DueOn is { } due)
                {
                    <MudText Typo="Typo.caption" Class="pspad-due" Color="@(Overdue ? Color.Error : Color.Inherit)">
                        @(Task.IsRecurring ? T["UntilDate", due.ToString("d MMM")] : due.ToString("d MMM"))
                    </MudText>
                }
                @if (!Task.IsRecurring && Task.EarliestDueStep is { DueOn: { } stepDue } dueStep)
                {
                    <MudText Typo="Typo.caption" Class="pspad-step-due-mark d-inline-flex align-center gap-1"
                             Color="@(stepDue < Today ? Color.Error : Color.Inherit)">
                        <MudIcon Icon="@Icons.Material.Outlined.SubdirectoryArrowRight" Size="Size.Small" />
                        <span class="pspad-step-due-name" title="@dueStep.Name">@dueStep.Name</span>
                        <span class="flex-shrink-0">· @stepDue.ToString("d MMM")</span>
                    </MudText>
                }
                @if (Task.Steps.Count > 0)
                {
                    <span class="pspad-steps-progress d-inline-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Outlined.Checklist" Size="Size.Small" />
                        <MudText Typo="Typo.caption">@($"{Task.Steps.Count(step => step.Checked)}/{Task.Steps.Count}")</MudText>
                    </span>
                }
                @if (Task.IsRecurring)
                {
                    <MudIcon Class="pspad-recurring" Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" />
                }
                @if (HasDescription)
                {
                    <MudIcon Class="pspad-has-description" Icon="@Icons.Material.Outlined.Notes" Size="Size.Small" />
                }
                @if (Task.SnapshotMarks.Count > 0)
                {
                    <SnapshotMarkChip Compact="true" />
                }
                @if (GoalName is not null)
                {
                    <span class="pspad-row-goal d-inline-flex align-center gap-1" title="@GoalName">
                        <MudIcon Icon="@Icons.Material.Outlined.TrackChanges" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="pspad-row-goal-name">@GoalName</MudText>
                    </span>
                }
                @if (ListName is not null)
                {
                    <MudText Typo="Typo.caption" Class="pspad-row-list">@ListName</MudText>
                }
            </div>
        }
    </div>

    <MudIconButton Class="@(Task.Starred ? "pspad-row-star" : "pspad-row-star pspad-muted")" Size="Size.Small"
                   Color="@(Task.Starred ? Color.Primary : Color.Default)"
                   Icon="@(Task.Starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                   aria-label="@(Task.Starred ? T["Unstar"].Value : T["Star"].Value)"
                   OnClick="@(() => OnStar.InvokeAsync(Task))" />
</div>

@code {
    [Parameter, EditorRequired] public TodoTask Task { get; set; } = null!;

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public bool ShowTime { get; set; } = true;

    [Parameter] public RenderFragment? Lead { get; set; }

    [Parameter] public string? ListName { get; set; }

    [Parameter] public string? GoalName { get; set; }

    [Parameter] public EventCallback<TodoTask> OnToggle { get; set; }

    [Parameter] public EventCallback<TodoTask> OnStar { get; set; }

    [Parameter] public EventCallback<TodoTask> OnOpen { get; set; }

    bool Done => Task.CompletedAt is not null || Task.CompletedDays.Contains(Today) || Task.EndedBy(Today);

    bool Overdue => IsOverdue(Task, Today);

    bool HasDescription => Task.Description.Length > 0;

    bool HasMeta => ListName is not null || GoalName is not null || Task.Steps.Count > 0 || Task.DueOn is not null
        || (ShowTime && Task.EffectiveTime is not null) || Task.IsRecurring || HasDescription || Task.SnapshotMarks.Count > 0;

    public static bool IsOverdue(TodoTask task, DateOnly today) =>
        TodayRule.Select([task], today).FirstOrDefault()?.Overdue == true;
}
