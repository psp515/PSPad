@using PSPad.App.Sync
@inject IConnectivity Connectivity
@inject ServerReachability Reachability
@inject IStringLocalizer<ShellStrings> T
@inject IStringLocalizer<SharedStrings> S
@implements IDisposable

@if (!Connectivity.IsOnline)
{
    <MudTooltip Text="@S["Offline"]">
        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Default" Size="Size.Small"
                 Class="pspad-connection-status" role="img" aria-label="@S["Offline"].Value" />
    </MudTooltip>
}
else if (!Reachability.IsReachable)
{
    <MudTooltip Text="@T["ServerUnreachable"]">
        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Warning" Size="Size.Small"
                 Class="pspad-connection-status" role="img" aria-label="@T["ServerUnreachable"].Value" />
    </MudTooltip>
}

@code {
    protected override void OnInitialized()
    {
        Connectivity.Changed += OnChanged;
        Reachability.Changed += OnChanged;
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connectivity.Changed -= OnChanged;
        Reachability.Changed -= OnChanged;
    }
}
