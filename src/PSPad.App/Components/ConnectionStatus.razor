@using PSPad.App.Sync
@inject IConnectivity Connectivity
@inject ServerReachability Reachability
@implements IDisposable

@if (!Connectivity.IsOnline)
{
    <MudTooltip Text="Offline">
        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Default" Size="Size.Small"
                 Class="pspad-connection-status" role="img" aria-label="Offline" />
    </MudTooltip>
}
else if (!Reachability.IsReachable)
{
    <MudTooltip Text="Server unreachable">
        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Warning" Size="Size.Small"
                 Class="pspad-connection-status" role="img" aria-label="Server unreachable" />
    </MudTooltip>
}

@code {
    protected override void OnInitialized()
    {
        Connectivity.Changed += OnChanged;
        Reachability.Changed += OnChanged;
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connectivity.Changed -= OnChanged;
        Reachability.Changed -= OnChanged;
    }
}
