<MudText Typo="Typo.h6" HtmlTag="h2" Color="@Color" Class="@($"pspad-section-heading {Class}")">
    @Title
    @if (Hint is not null)
    {
        <span class="pspad-section-hint pspad-muted">@Hint</span>
    }
    @if (Count is { } count)
    {
        <span class="pspad-section-count">@count</span>
    }
</MudText>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public int? Count { get; set; }

    [Parameter] public Color Color { get; set; } = Color.Default;

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string Class { get; set; } = "";
}
