@using PSPad.App.State
@using PSPad.Module.Tasks.Tasks
@inject IStringLocalizer<TasksStrings> T

<div class="pspad-property-row pspad-task-time d-flex align-start">
    <div class="pspad-time-head d-flex align-center flex-shrink-0">
        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="pspad-time-icon mr-3" />
        <MudText Typo="Typo.body2" Class="pspad-property-label">@T["Time"]</MudText>
    </div>
    <div class="pspad-time-lines d-flex flex-column flex-grow-1">
        <div class="pspad-time-line d-flex align-center">
            <span class="pspad-time-line-label">@T["TimeFrom"]</span>
            <TimeField Class="pspad-time-start" Label="@T["TimeStart"]" Placeholder="@T["TimeStart"]" ClockLabel="@T["PickStartTime"]"
                       Value="@_current?.Start" ValueChanged="@StartChangedAsync" InvalidChanged="@InvalidChanged"
                       Shown="@_current" Disabled="@Disabled" />
            @if (_current is not null && !Disabled)
            {
                <MudIconButton Class="pspad-property-clear pspad-time-clear" Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               aria-label="@T["ClearTime"].Value" OnClick="@(() => SendAsync(null))" />
            }
            else
            {
                <span class="pspad-time-clear-placeholder" aria-hidden="true"></span>
            }
        </div>
        @if (_current is not null)
        {
            <div class="pspad-time-line pspad-time-line-end d-flex align-center">
                <span class="pspad-time-line-label">@T["TimeTo"]</span>
                <TimeField Class="pspad-time-end" Label="@T["TimeEnd"]" Placeholder="@T["TimeEnd"]" ClockLabel="@T["PickEndTime"]"
                           Value="@_current?.End" ValueChanged="@EndChangedAsync" InvalidChanged="@InvalidChanged"
                           Shown="@_current" Error="@_endClash" Disabled="@Disabled" />
            </div>
        }
    </div>
</div>
@if (_error is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="pspad-time-error pspad-time-note d-block" role="alert">@_error</MudText>
}
else if (_current is { Overnight: true })
{
    <MudText Typo="Typo.caption" Class="pspad-time-hint pspad-time-note pspad-muted d-block" role="status">@T["EndsNextDay"]</MudText>
}

@code {
    [Parameter] public TaskTime? Value { get; set; }

    [Parameter] public EventCallback<TaskTime?> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    TaskTime? _shown;

    TaskTime? _current;

    string? _error;

    bool _endClash;

    protected override void OnParametersSet()
    {
        if (_shown != Value)
        {
            _shown = Value;
            _current = Value;
            _error = null;
            _endClash = false;
        }
    }

    void InvalidChanged(bool invalid)
    {
        _endClash = false;
        _error = invalid ? T["TimeFormatHint"].Value : null;
    }

    Task StartChangedAsync(TimeOnly? start) =>
        start is { } typed ? TrySendAsync(typed, _current?.End) : SendAsync(null);

    Task EndChangedAsync(TimeOnly? end) =>
        _current is { } current ? TrySendAsync(current.Start, end) : Task.CompletedTask;

    async Task TrySendAsync(TimeOnly start, TimeOnly? end)
    {
        if (end == start)
        {
            _endClash = true;
            _error = T["EndMustDiffer"].Value;
            return;
        }

        await SendAsync(new TaskTime(start, end));
    }

    async Task SendAsync(TaskTime? time)
    {
        _error = null;
        _endClash = false;
        _current = time;
        await ValueChanged.InvokeAsync(time);
    }
}
