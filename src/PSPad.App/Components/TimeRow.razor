@using System.Globalization
@using PSPad.Module.Tasks.Tasks
@inject IStringLocalizer<TasksStrings> T

<div class="pspad-property-row pspad-task-time d-flex align-start">
    <div class="pspad-time-head d-flex align-center flex-shrink-0">
        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="pspad-time-icon mr-3" />
        <MudText Typo="Typo.body2" Class="pspad-property-label">@T["Time"]</MudText>
    </div>
    <div class="pspad-time-lines d-flex flex-column flex-grow-1">
        <div class="pspad-time-line d-flex align-center">
            <span class="pspad-time-line-label">@T["TimeFrom"]</span>
            <MudTextField T="string" Class="pspad-time-start pspad-time-input" Placeholder="@T["TimeStart"]" aria-label="@T["TimeStart"].Value"
                          InputMode="InputMode.numeric" Value="@StartText" ValueChanged="@StartTypedAsync" Error="@(_startDraft is not null)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Disabled"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Schedule" AdornmentAriaLabel="@T["PickStartTime"]"
                          OnAdornmentClick="@(() => OpenClockAsync(false))" />
            @if (Value is not null && !Disabled)
            {
                <MudIconButton Class="pspad-property-clear pspad-time-clear" Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               aria-label="@T["ClearTime"].Value" OnClick="@(() => SendAsync(null))" />
            }
            else
            {
                <span class="pspad-time-clear-placeholder" aria-hidden="true"></span>
            }
        </div>
        @if (Value is not null)
        {
            <div class="pspad-time-line pspad-time-line-end d-flex align-center">
                <span class="pspad-time-line-label">@T["TimeTo"]</span>
                <MudTextField T="string" Class="pspad-time-end pspad-time-input" Placeholder="@T["TimeEnd"]" aria-label="@T["TimeEnd"].Value"
                              InputMode="InputMode.numeric" Value="@EndText" ValueChanged="@EndTypedAsync" Error="@(_endDraft is not null)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Disabled"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Schedule" AdornmentAriaLabel="@T["PickEndTime"]"
                              OnAdornmentClick="@(() => OpenClockAsync(true))" />
            </div>
        }
    </div>
</div>
@if (_error is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="pspad-time-error pspad-time-note d-block">@_error</MudText>
}
else if (Value is { Overnight: true })
{
    <MudText Typo="Typo.caption" Class="pspad-time-hint pspad-time-note pspad-muted d-block">@T["EndsNextDay"]</MudText>
}

@* The picker's own dialog commits once, after the minute click or a click outside; a static clock submits on every hour click. *@
<MudTimePicker @ref="_clock" PickerVariant="PickerVariant.Dialog" Elevation="0" Class="d-none pspad-time-clock" AmPm="false"
               @bind-Time="_pickerTime" PickerClosed="@ClockClosedAsync" />

@code {
    [Parameter] public TaskTime? Value { get; set; }

    [Parameter] public EventCallback<TaskTime?> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    TaskTime? _shown;

    string? _startDraft;

    string? _endDraft;

    string? _error;

    MudTimePicker? _clock;

    bool _pickingEnd;

    TimeSpan? _pickerTime;

    string StartText => _startDraft ?? (Value is { } time ? Format(time.Start) : "");

    string EndText => _endDraft ?? (Value?.End is { } end ? Format(end) : "");

    protected override void OnParametersSet()
    {
        if (_shown != Value)
        {
            _shown = Value;
            _startDraft = null;
            _endDraft = null;
            _error = null;
        }
    }

    public static string Format(TimeOnly time) => time.ToString("HH:mm", CultureInfo.InvariantCulture);

    public const string NextDay = "(+1)";

    public static string Describe(TaskTime time) =>
        time.End is { } end
            ? $"{Format(time.Start)}–{Format(end)}{(time.Overnight ? $" {NextDay}" : "")}"
            : Format(time.Start);

    Task StartTypedAsync(string? text)
    {
        if (!TimeText.TryParse(text, out var start))
        {
            _startDraft = text;
            _error = T["TimeFormatHint"];
            return Task.CompletedTask;
        }

        _startDraft = null;
        return start is { } typed ? TrySendAsync(typed, Value?.End) : SendAsync(null);
    }

    Task EndTypedAsync(string? text)
    {
        if (Value is not { } current)
        {
            return Task.CompletedTask;
        }

        if (!TimeText.TryParse(text, out var end))
        {
            _endDraft = text;
            _error = T["TimeFormatHint"];
            return Task.CompletedTask;
        }

        _endDraft = null;
        return TrySendAsync(current.Start, end, text);
    }

    Task OpenClockAsync(bool end)
    {
        if (Disabled || _clock is null)
        {
            return Task.CompletedTask;
        }

        _pickingEnd = end;
        _pickerTime = end ? Value?.End?.ToTimeSpan() : Value?.Start.ToTimeSpan();
        return _clock.OpenAsync();
    }

    async Task ClockClosedAsync()
    {
        if (_pickerTime is not { } span)
        {
            return;
        }

        var time = TimeOnly.FromTimeSpan(span);

        if (!_pickingEnd)
        {
            if (Value?.Start != time)
            {
                await TrySendAsync(time, Value?.End);
            }
        }
        else if (Value is { } current && current.End != time)
        {
            await TrySendAsync(current.Start, time, Format(time));
        }
    }

    async Task TrySendAsync(TimeOnly start, TimeOnly? end, string? typedEnd = null)
    {
        if (end == start)
        {
            _endDraft = typedEnd ?? Format(start);
            _error = T["EndMustDiffer"];
            return;
        }

        await SendAsync(new TaskTime(start, end));
    }

    async Task SendAsync(TaskTime? time)
    {
        _startDraft = null;
        _endDraft = null;
        _error = null;
        await ValueChanged.InvokeAsync(time);
    }
}
