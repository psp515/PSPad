@using PSPad.App.State
@using PSPad.Module.Money.Balance
@using PSPad.Module.Money.Entries
@using PSPad.Module.Money.Reading
@inject AppState State

<div class="@($"pspad-summary {Class}")">
    <MudChipSet T="SummaryPreset" SelectedValue="@_preset" SelectedValueChanged="@Choose" Class="pspad-summary-presets"
                SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Color="Color.Primary" Variant="Variant.Outlined"
                SelectedColor="Color.Primary">
        <MudChip Value="SummaryPreset.ThisYear" aria-pressed="@Pressed(SummaryPreset.ThisYear)" Text="This year" />
        <MudChip Value="SummaryPreset.Last12Months" aria-pressed="@Pressed(SummaryPreset.Last12Months)" Text="Last 12 months" />
        <MudChip Value="SummaryPreset.LastYear" aria-pressed="@Pressed(SummaryPreset.LastYear)" Text="Last year" />
        <MudChip Value="SummaryPreset.Custom" aria-pressed="@Pressed(SummaryPreset.Custom)" Text="Custom" />
    </MudChipSet>
    @if (_preset == SummaryPreset.Custom)
    {
        <MudDateRangePicker Class="mt-2 pspad-summary-picker" Label="Range" Variant="Variant.Outlined" Margin="Margin.Dense"
                            DateRange="@Picked" DateRangeChanged="@Pick" />
    }
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1 mb-4 pspad-summary-range">@MoneyText.Range(_range.From, _range.To)</MudText>

    <MoneyHero Class="mb-3" HeadlineClass="pspad-summary-saved" Label="Saved" Text="@MoneyText.SignedPln(_summary.Saved)"
               Negative="@(_summary.Saved < 0)">
        <MoneyFigure Class="pspad-summary-income" Label="Income" Text="@MoneyText.Pln(_summary.Income)" />
        <MoneyFigure Class="pspad-summary-expenses" Label="Expenses" Text="@MoneyText.Pln(_summary.Expenses)" />
        <MoneyFigure Class="pspad-summary-rate" Label="Savings rate" Text="@MoneyText.Percent(_summary.SavingsRate)"
                     Negative="@MoneyText.PercentIsNegative(_summary.SavingsRate)" />
    </MoneyHero>

    <MoneyTile Class="mb-4 pspad-summary-net-worth" Label="@NetWorthLabel" Text="@NetWorthText" />

    <BudgetSummaryCharts Summary="@_summary" />
</div>

@code {
    SummaryPreset _preset = SummaryPreset.ThisYear;
    SummaryRange _range = default!;
    MoneySummary _summary = default!;

    [Parameter, EditorRequired] public IReadOnlyList<MoneyEntry> Entries { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<BalanceSnapshot> Snapshots { get; set; } = [];

    [Parameter] public string Class { get; set; } = "";

    DateRange Picked => new(_range.From.ToDateTime(TimeOnly.MinValue), _range.To.ToDateTime(TimeOnly.MinValue));

    string NetWorthLabel => _summary.Latest is { } latest ? $"Net worth · {MoneyText.MonthTitle(latest.Month)}" : "Net worth";

    string NetWorthText => _summary.LatestNetWorth is { } value ? MoneyText.Pln(value) : "—";

    protected override void OnInitialized() => _range = SummaryRange.For(_preset, State.Today);

    protected override void OnParametersSet() => Summarise();

    void Summarise() => _summary = MoneySummary.For(Entries, Snapshots, _range.From, _range.To);

    string Pressed(SummaryPreset preset) => preset == _preset ? "true" : "false";

    void Choose(SummaryPreset preset)
    {
        if (preset == _preset)
        {
            return;
        }

        _preset = preset;

        if (preset != SummaryPreset.Custom)
        {
            _range = SummaryRange.For(preset, State.Today);
            Summarise();
        }
    }

    void Pick(DateRange? picked)
    {
        if (SummaryRange.Picked(picked?.Start, picked?.End) is { } range)
        {
            _range = range;
            Summarise();
        }
    }
}
