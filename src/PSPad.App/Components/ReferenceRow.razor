@using PSPad.App.Markdown
@using PSPad.App.State
@using PSPad.Module.Tasks.References
@inject Clipboard Clipboard
@inject ISnackbar Snackbar

<div class="pspad-row pspad-reference-row d-flex align-center gap-2 px-1">
    <span class="pspad-row-lead">
        <MudIcon Icon="@Icons.Material.Outlined.BookmarkBorder" Size="Size.Small" Class="pspad-muted" />
    </span>

    <div class="pspad-row-body pspad-reference-name" @onclick="@(() => OnOpen.InvokeAsync(Item))">
        <MudText Typo="Typo.body2" Class="pspad-row-name" title="@Item.Name">@Item.Name</MudText>

        @if (Item.Fields.Count > 0)
        {
            <div class="pspad-row-meta pspad-row-chips">
                @foreach (var field in Item.Fields)
                {
                    <span @key="field.Id" class="pspad-row-chip-slot" @onclick:stopPropagation="true">
                        @switch (KindOf(field))
                        {
                            case FieldKind.Link:
                                <MudChip T="string" Class="pspad-row-chip pspad-row-chip-link" Size="Size.Small"
                                         Variant="Variant.Text" Color="Color.Primary" Icon="@Icons.Material.Filled.Link"
                                         Href="@field.Value" Target="_blank" Rel="noopener noreferrer"
                                         title="@field.Value">@field.Label</MudChip>
                                break;
                            case FieldKind.Path:
                                <MudChip T="string" Class="pspad-row-chip pspad-row-chip-path" Size="Size.Small"
                                         Variant="Variant.Text" Icon="@Icons.Material.Outlined.Folder"
                                         title="@($"Copy {field.Value}")"
                                         OnClick="@(() => CopyAsync(field.Value))">@field.Label</MudChip>
                                break;
                            default:
                                <MudChip T="string" Class="pspad-row-chip" Size="Size.Small" Variant="Variant.Text"
                                         title="@($"{field.Label}: {field.Value}")">@($"{field.Label}: {DisplayValue(field)}")</MudChip>
                                break;
                        }
                    </span>
                }
            </div>
        }

        @if (Item.SnapshotMarks.Count > 0)
        {
            <div class="pspad-row-meta">
                <SnapshotMarkChip Compact="true" />
            </div>
        }
    </div>

    <MudIconButton Class="@(Item.Starred ? "pspad-row-star" : "pspad-row-star pspad-muted")" Size="Size.Small"
                   Color="@(Item.Starred ? Color.Primary : Color.Default)"
                   Icon="@(Item.Starred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                   aria-label="@(Item.Starred ? "Unstar" : "Star")"
                   OnClick="@(() => OnStar.InvokeAsync(Item))" />
</div>

@code {
    [Parameter, EditorRequired] public ReferenceItem Item { get; set; } = null!;

    [Parameter] public EventCallback<ReferenceItem> OnStar { get; set; }

    [Parameter] public EventCallback<ReferenceItem> OnOpen { get; set; }

    static FieldKind KindOf(ReferenceField field) => FieldDisplay.Of(field) switch
    {
        FieldKind.Link when !LinkSafety.IsSafe(field.Value, LinkSafety.LinkSchemes) => FieldKind.Text,
        var kind => kind
    };

    static string DisplayValue(ReferenceField field) => FieldDisplay.Of(field) == FieldKind.Quantity
        ? FieldDisplay.NormalizeQuantity(field.Value)
        : field.Value;

    async Task CopyAsync(string path)
    {
        var copied = await Clipboard.CopyAsync(path);
        Snackbar.Add(
            copied ? "Copied" : "Could not copy — open the item to select the path.",
            copied ? Severity.Success : Severity.Warning);
    }
}
