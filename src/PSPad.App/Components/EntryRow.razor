@using PSPad.App.State
@using PSPad.Module.Money
@using PSPad.Module.Money.Budgets
@using PSPad.Module.Money.Entries
@using PSPad.Module.Money.Values

<MudListItem T="MoneyEntry" Class="pspad-entry-row" OnClick="@(() => OnOpen.InvokeAsync(Entry))">
    <div class="d-flex align-center gap-3">
        <span class="@AvatarClass" aria-hidden="true">@Initial</span>
        <div class="d-flex flex-column flex-grow-1 pspad-entry-main">
            <MudText Typo="Typo.body1" Class="pspad-entry-name">@Entry.Name</MudText>
            <MudText Typo="Typo.caption" Class="pspad-entry-sub">
                <span class="pspad-entry-category">@Entry.Category</span>
                @if (Entry.Money.Currency != Currencies.Pln)
                {
                    <span> · </span><span class="pspad-entry-foreign">@MoneyText.Amount(Entry.Money.Amount) @Entry.Money.Currency @@ @MoneyText.Rate(Entry.Money.RateToPln)</span>
                }
            </MudText>
        </div>
        <MudText Typo="Typo.body1" Class="pspad-entry-amount"
                 Color="@(IsIncome ? Color.Success : Color.Default)">@MoneyText.SignedAmount(IsIncome ? Entry.Money.InPln : -Entry.Money.InPln)</MudText>
    </div>
</MudListItem>

@code {
    [Parameter, EditorRequired] public MoneyEntry Entry { get; set; } = default!;

    [Parameter] public EventCallback<MoneyEntry> OnOpen { get; set; }

    bool IsIncome => Entry.Kind == CategoryKind.Income;

    string Initial => Entry.Category.Length == 0 ? "?" : Entry.Category[..1].ToUpperInvariant();

    string AvatarClass => $"pspad-entry-avatar {(IsIncome ? "pspad-entry-income" : "pspad-entry-expense")}";
}
