@using PSPad.App.Api
@using PSPad.App.State
@using PSPad.App.Sync
@using PSPad.Contracts
@using PSPad.Module.Money
@using PSPad.Module.Money.Values
@inject INbpRates Nbp
@inject IConnectivity Connectivity
@inject AppState State
@inject ISnackbar Snackbar
@implements IDisposable

<div class="d-flex gap-3">
    <MudNumericField T="decimal?" Class="@($"{CssPrefix}-amount-field flex-grow-1")" Label="Amount" Variant="Variant.Outlined"
                     Margin="Margin.Dense" Value="@Amount" ValueChanged="@AmountChanged" Immediate="true" HideSpinButtons="true"
                     Max="@Money.MaxAmount" Disabled="@ReadOnly" />
    <MudSelect T="string" Class="@($"{CssPrefix}-currency-field")" Label="Currency" Variant="Variant.Outlined"
               Margin="Margin.Dense" Value="@Currency" ValueChanged="@CurrencyChanged" Disabled="@ReadOnly">
        @foreach (var currency in Currencies.All)
        {
            <MudSelectItem T="string" Value="@currency">@currency</MudSelectItem>
        }
    </MudSelect>
</div>
@if (!IsPln)
{
    <div class="@($"d-flex align-center gap-2 {CssPrefix}-rate")">
        <MudNumericField T="decimal?" Class="@($"{CssPrefix}-rate-field flex-grow-1")" Label="Rate to PLN"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Value="@Rate" ValueChanged="@RateTyped"
                         Immediate="true" HideSpinButtons="true" Max="@Money.MaxRate" Disabled="@ReadOnly" />
        <MudButton Class="@($"{CssPrefix}-nbp")" Variant="Variant.Outlined" Color="Color.Primary"
                   Disabled="@(ReadOnly || _fetching || !Connectivity.IsOnline)" OnClick="@FetchNbpRateAsync">NBP</MudButton>
    </div>
}
<MudTextField T="string" Class="@($"{CssPrefix}-pln")" Label="In PLN" Variant="Variant.Outlined" Margin="Margin.Dense"
              Value="@InPlnText" ReadOnly="true" />

@code {
    [Parameter] public decimal? Amount { get; set; }

    [Parameter] public EventCallback<decimal?> AmountChanged { get; set; }

    [Parameter, EditorRequired] public string Currency { get; set; } = Currencies.Pln;

    [Parameter] public EventCallback<string> CurrencyChanged { get; set; }

    [Parameter] public decimal? Rate { get; set; }

    [Parameter] public EventCallback<decimal?> RateTyped { get; set; }

    [Parameter] public DateOnly? NbpDate { get; set; }

    [Parameter] public EventCallback<NbpRateView> NbpFetched { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter, EditorRequired] public string CssPrefix { get; set; } = "";

    bool _fetching;
    bool _disposed;

    bool IsPln => Currency == Currencies.Pln;

    decimal RateToPln => IsPln ? 1m : Rate.GetValueOrDefault();

    string InPlnText => Amount.GetValueOrDefault() > 0 && RateToPln > 0
        ? MoneyText.Pln(new Money(Amount.GetValueOrDefault(), Currency, RateToPln, State.Today).InPln)
        : "";

    async Task FetchNbpRateAsync()
    {
        if (NbpDate is not { } asked || IsPln || !Connectivity.IsOnline)
        {
            return;
        }

        var currency = Currency;
        _fetching = true;
        NbpRateView? rate;

        try
        {
            rate = await Nbp.RateAsync(currency, asked);
        }
        finally
        {
            _fetching = false;
        }

        if (_disposed || Currency != currency || NbpDate != asked)
        {
            return;
        }

        if (rate is null)
        {
            Snackbar.Add("Couldn't get the NBP rate. Type the rate instead.", Severity.Warning);
            return;
        }

        await NbpFetched.InvokeAsync(rate);
    }

    public void Dispose() => _disposed = true;
}
