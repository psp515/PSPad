@using PSPad.App.State
@using PSPad.App.Statistics
@using PSPad.Module.Money.Reading

<MudGrid Spacing="4" Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-3 pspad-summary-cumulative">
            <SectionHeading Title="Income vs expenses" />
            <MudChart ChartType="ChartType.Line" ChartSeries="@_cumulative" ChartLabels="@_labels"
                      ChartOptions="@_cumulativeOptions" Width="100%" Height="260px" />
            <table class="mud-sr-only">
                <caption>Income vs expenses</caption>
                <thead>
                    <tr>
                        <th scope="col">Month</th>
                        <th scope="col">Income</th>
                        <th scope="col">Expenses</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var month in Summary.Cumulative)
                    {
                        <tr>
                            <td>@MoneyText.MonthTitle(month.Month)</td>
                            <td>@MoneyText.Pln(month.Income)</td>
                            <td>@MoneyText.Pln(month.Expenses)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-3 pspad-summary-by-month">
            <SectionHeading Title="Expenses by month" />
            @if (Summary.ExpensesByMonth.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-summary-no-expenses">No expenses in this range.</MudText>
            }
            else
            {
                <MudChart ChartType="ChartType.StackedBar" ChartSeries="@_byMonth" ChartLabels="@_labels"
                          ChartOptions="@_byMonthOptions" Width="100%" Height="260px" />
                <table class="mud-sr-only">
                    <caption>Expenses by month</caption>
                    <thead>
                        <tr>
                            <th scope="col">Month</th>
                            @foreach (var series in Summary.ExpensesByMonth)
                            {
                                <th scope="col">@series.Category</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < Summary.Months.Count; index++)
                        {
                            var month = index;
                            <tr>
                                <td>@MoneyText.MonthTitle(Summary.Months[month])</td>
                                @foreach (var series in Summary.ExpensesByMonth)
                                {
                                    <td>@MoneyText.Pln(series.PerMonth[month])</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-3 pspad-summary-net-worth-chart">
            <SectionHeading Title="Net worth by holding type" />
            @if (Summary.NetWorth.All(month => month.IsGap))
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-summary-no-balances">No balances in this range.</MudText>
            }
            else
            {
                <MudChart ChartType="ChartType.StackedBar" ChartSeries="@_netWorth" ChartLabels="@_labels"
                          ChartOptions="@_netWorthOptions" Width="100%" Height="260px" />
                <table class="mud-sr-only">
                    <caption>Net worth by holding type</caption>
                    <thead>
                        <tr>
                            <th scope="col">Month</th>
                            <th scope="col">Cash</th>
                            <th scope="col">Savings</th>
                            <th scope="col">Investment</th>
                            <th scope="col">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var month in Summary.NetWorth)
                        {
                            <tr>
                                <td>@MoneyText.MonthTitle(month.Month)</td>
                                <td>@PlnOrGap(month.Cash)</td>
                                <td>@PlnOrGap(month.Savings)</td>
                                <td>@PlnOrGap(month.Investment)</td>
                                <td>@PlnOrGap(month.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Outlined="true" Class="pa-3 pspad-summary-ranking">
            <SectionHeading Title="Category ranking" />
            @if (Summary.Ranking.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-summary-no-ranking">No expenses in this range.</MudText>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var total in Summary.Ranking)
                    {
                        <div @key="total.Category" class="pspad-summary-ranking-row">
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.body2" Class="pspad-summary-ranking-name">@total.Category</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pspad-summary-ranking-pln">@MoneyText.Pln(total.Pln)</MudText>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Rounded="true" Min="0" Max="@_rankingMax"
                                               Value="@((double)total.Pln)" UserAttributes="@HiddenFromReaders" />
                        </div>
                    }
                </MudStack>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    string[] _labels = [];
    List<ChartSeries<double>> _cumulative = [];
    LineChartOptions _cumulativeOptions = new();
    List<ChartSeries<double>> _byMonth = [];
    StackedBarChartOptions _byMonthOptions = new();
    List<ChartSeries<double>> _netWorth = [];
    StackedBarChartOptions _netWorthOptions = new();
    double _rankingMax = 1d;
    static readonly Dictionary<string, object> HiddenFromReaders = new() { ["aria-hidden"] = "true" };

    [Parameter, EditorRequired] public MoneySummary Summary { get; set; } = default!;

    protected override void OnParametersSet()
    {
        _labels = MoneyText.MonthAxis(Summary.Months);

        _cumulative =
        [
            Series("Income", Summary.Cumulative.Select(month => month.Income)),
            Series("Expenses", Summary.Cumulative.Select(month => month.Expenses))
        ];
        _cumulativeOptions = new LineChartOptions
        {
            YAxisTicks = Step(Summary.Cumulative.Select(month => Math.Max(month.Income, month.Expenses))),
            MaxNumYAxisTicks = ChartAxis.MaxTicks,
            YAxisRequireZeroPoint = true,
            ShowDataMarkers = true
        };

        _byMonth = [.. Summary.ExpensesByMonth.Select(series => Series(series.Category, series.PerMonth))];
        _byMonthOptions = new StackedBarChartOptions
        {
            YAxisTicks = Step(Summary.Months.Select((_, index) => Summary.ExpensesByMonth.Sum(series => series.PerMonth[index]))),
            MaxNumYAxisTicks = ChartAxis.MaxTicks
        };

        _netWorth =
        [
            Series("Cash", Summary.NetWorth.Select(month => month.Cash ?? 0m)),
            Series("Savings", Summary.NetWorth.Select(month => month.Savings ?? 0m)),
            Series("Investment", Summary.NetWorth.Select(month => month.Investment ?? 0m))
        ];
        _netWorthOptions = new StackedBarChartOptions
        {
            YAxisTicks = Step(Summary.NetWorth.Select(month => month.Total ?? 0m)),
            MaxNumYAxisTicks = ChartAxis.MaxTicks
        };

        _rankingMax = Summary.Ranking.Count == 0 ? 1d : Math.Max((double)Summary.Ranking[0].Pln, 1d);
    }

    static ChartSeries<double> Series(string name, IEnumerable<decimal> values) =>
        new() { Name = name, Data = values.Select(value => (double)value).ToArray() };

    static int Step(IEnumerable<decimal> values) => ChartAxis.Step((double)values.DefaultIfEmpty(0m).Max());

    static string PlnOrGap(decimal? value) => value is { } pln ? MoneyText.Pln(pln) : "—";
}
