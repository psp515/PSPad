<div class="pspad-grid" role="status" aria-busy="true">
    @for (var index = 0; index < Count; index++)
    {
        <div class="pspad-row-skeleton px-3 py-2">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="35%" Height="12px" />
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 5;
}
