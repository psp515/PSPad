@inject IStringLocalizer<SharedStrings> T

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@(Message ?? T["DeleteThis"])</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@T["Cancel"]</MudButton>
        <MudButton Color="Color.Error" OnClick="@(() => Dialog.Close(DialogResult.Ok(true)))">
            @(ConfirmText ?? T["Delete"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string? Message { get; set; }

    [Parameter] public string? ConfirmText { get; set; }
}
