@using PSPad.App.State
@inject IStringLocalizer<GoalsStrings> T

<MudPaper Outlined="true" Class="pspad-goal-pace pa-3 d-flex flex-column" Style="height:100%">
    <MudText Typo="Typo.subtitle2" Class="mb-3">@T["Pace"]</MudText>
    <div class="d-flex justify-space-around align-center flex-grow-1 gap-4">
        <div class="d-flex flex-column align-center gap-2">
            <MudProgressCircular Value="@Pace.TimePercent" Color="@(Overdue ? Color.Error : Color.Primary)"
                                 StrokeWidth="6" Rounded="true" Style="@RingSize">
                <MudText Typo="Typo.h6" Color="@(Overdue ? Color.Error : Color.Default)">@TimeText</MudText>
            </MudProgressCircular>
            <MudText Typo="Typo.caption" Class="pspad-muted">@TimeCaption</MudText>
        </div>
        <div class="d-flex flex-column align-center gap-2">
            <MudProgressCircular Value="@Pace.WorkPercent" Color="@(Pace.Behind ? Color.Warning : Color.Success)"
                                 StrokeWidth="6" Rounded="true" Style="@RingSize">
                <MudText Typo="Typo.h6">@($"{Pace.WorkPercent}%")</MudText>
            </MudProgressCircular>
            <MudText Typo="Typo.caption" Class="pspad-muted">@(Pace.Behind ? T["WorkBehind"] : T["WorkOnPace"])</MudText>
        </div>
    </div>
</MudPaper>

@code {
    const string RingSize = "width:112px;height:112px";

    [Parameter, EditorRequired] public GoalPaceView Pace { get; set; } = null!;

    bool Overdue => Pace.DaysLeft < 0;

    string TimeText => $"{Pace.TimePercent}%";

    string TimeCaption =>
        Overdue ? T.Plural(-Pace.DaysLeft, "PaceOverdue")
        : Pace.DaysLeft == 0 ? T["PaceDueToday"]
        : T.Plural(Pace.DaysLeft, "PaceDaysLeft");
}
