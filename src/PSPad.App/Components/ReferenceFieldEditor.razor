@using PSPad.App.State
@using PSPad.Module.Tasks.References

<MudTextField T="string" Label="Label" Class="pspad-field-label-input" Margin="Margin.Dense" AutoFocus="true"
              @bind-Value="_label" />
<MudTextField T="string" Label="Value" Class="pspad-field-value-input" Margin="Margin.Dense" Lines="1"
              Sizing="InputSizing.Auto" @bind-Value="_value" />
<MudSelect T="FieldKind?" Label="Display" Class="pspad-field-kind-input" Margin="Margin.Dense" @bind-Value="_kind">
    <MudSelectItem T="FieldKind?" Value="@((FieldKind?)null)">Automatic</MudSelectItem>
    <MudSelectItem T="FieldKind?" Value="@((FieldKind?)FieldKind.Text)">Text</MudSelectItem>
    <MudSelectItem T="FieldKind?" Value="@((FieldKind?)FieldKind.Link)">Link</MudSelectItem>
    <MudSelectItem T="FieldKind?" Value="@((FieldKind?)FieldKind.Path)">Path</MudSelectItem>
    <MudSelectItem T="FieldKind?" Value="@((FieldKind?)FieldKind.Quantity)">Quantity</MudSelectItem>
</MudSelect>
<div class="d-flex align-center gap-1 mt-1">
    <MudButton Class="pspad-field-save" Size="Size.Small" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_label)"
               OnClick="@SaveAsync">Save</MudButton>
    <MudButton Class="pspad-field-cancel" Size="Size.Small" OnClick="@CancelAsync">Cancel</MudButton>
    <MudSpacer />
    @if (Field is not null)
    {
        <MudButton Class="pspad-field-editor-remove" Size="Size.Small" Color="Color.Error" OnClick="@RemoveAsync">Remove</MudButton>
    }
</div>

@code {
    [Parameter] public ReferenceField? Field { get; set; }

    [Parameter] public Func<(string Label, string Value, string? Display), Task>? OnSave { get; set; }

    [Parameter] public Func<Task>? OnCancel { get; set; }

    [Parameter] public Func<Task>? OnRemove { get; set; }

    string _label = "";
    string _value = "";
    FieldKind? _kind;

    protected override void OnInitialized()
    {
        _label = Field?.Label ?? "";
        _value = Field?.Value ?? "";
        _kind = Field is { Display: { } hint } && Enum.TryParse<FieldKind>(hint, ignoreCase: true, out var kind)
            ? kind
            : null;
    }

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_label) || OnSave is null)
        {
            return;
        }

        await OnSave((_label.Trim(), _value, FieldDisplay.HintFor(_kind)));
    }

    Task CancelAsync() => OnCancel?.Invoke() ?? Task.CompletedTask;

    Task RemoveAsync() => OnRemove?.Invoke() ?? Task.CompletedTask;
}
