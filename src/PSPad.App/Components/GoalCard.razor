@using PSPad.App.State
@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Tasks

<ThingCard Id="@Goal.Id" Name="@Goal.Name" Href="@($"/goals/{Goal.Id}")" TitleClass="pspad-goal-name"
           CountText="@(count => $"{count} open")" EmptyText="No open tasks."
           Tasks="@Tasks" Today="@Today" ListNameOf="@NameOf"
           OnToggle="@OnToggle" OnStar="@OnStar" OnOpen="@OnOpen">
    <Subtitle>
        @if (Goal.DueOn is { } due)
        {
            <MudText Typo="Typo.caption" Class="@($"pspad-goal-due {(IsOverdue ? "" : "pspad-muted")}")"
                     Color="@(IsOverdue ? Color.Error : Color.Inherit)">@($"Due {DueDateRow.Describe(due, Today)}")</MudText>
        }
    </Subtitle>
    <Actions>
        <ThingMenu Class="pspad-goal-menu" OnEdit="@OnEdit" OnDelete="@OnDelete">
            <Extra>
                @foreach (var status in Enum.GetValues<GoalStatus>().Where(status => status != Goal.Status))
                {
                    <MudMenuItem Class="pspad-goal-status-option" OnClick="@(() => OnStatus.InvokeAsync(status))">
                        @($"Mark {GoalStatusText.Of(status).ToLowerInvariant()}")
                    </MudMenuItem>
                }
            </Extra>
        </ThingMenu>
    </Actions>
</ThingCard>

@code {
    [Parameter, EditorRequired] public Goal Goal { get; set; } = null!;

    [Parameter] public IReadOnlyList<TodoTask> Tasks { get; set; } = [];

    [Parameter] public IReadOnlyDictionary<Guid, string> ListNames { get; set; } = new Dictionary<Guid, string>();

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public EventCallback<TodoTask> OnToggle { get; set; }

    [Parameter] public EventCallback<TodoTask> OnStar { get; set; }

    [Parameter] public EventCallback<TodoTask> OnOpen { get; set; }

    [Parameter] public EventCallback<GoalStatus> OnStatus { get; set; }

    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    bool IsOverdue => Goal.Status == GoalStatus.InProgress && Goal.DueOn < Today;

    string? NameOf(TodoTask task) => ListNames.TryGetValue(task.ListId, out var name) ? name : null;

}
