@using PSPad.Abstractions
@using PSPad.App.State
@using PSPad.App.Api
@using PSPad.App.Sync
@using PSPad.Module.Money.Budgets
@inject AppState State
@inject IBudgetSharingApi Sharing
@inject ISyncTrigger SyncTrigger
@inject IConnectivity Connectivity
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IClock Clock
@inject IStringLocalizer<BudgetsStrings> T
@implements IDisposable

<div class="pspad-budget-members d-flex flex-column gap-3">
    @if (!Connectivity.IsOnline)
    {
        <MudAlert Class="pspad-share-offline" Severity="Severity.Info" Dense="true">@T["SharingNeedsConnection"]</MudAlert>
    }
    @if (IsMine)
    {
        <InviteCard Invite="@Invite" LinkFor="@LinkFor" Thing="budget" Disabled="@Locked" OnChanged="@OnChanged"
                    Invitation="@T["InviteDescription"]"
                    BlockedReason="@(Budget.IsArchived ? T["RestoreToInvite"].Value : null)"
                    OnShare="@((token, code) => Sharing.ShareBudgetAsync(Budget.Id, token, code))"
                    OnEnd="@(() => Sharing.StopSharingBudgetAsync(Budget.Id))" />
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4 d-flex align-center gap-3">
            <MudAvatar Color="Color.Primary">@AvatarColor.InitialsOf(Budget.OwnerName)</MudAvatar>
            <div class="flex-grow-1">
                <MudText Typo="Typo.caption" Class="pspad-muted d-block">@T["SharedByLabel"]</MudText>
                <MudText Typo="Typo.subtitle1" Class="pspad-share-owner">@Budget.OwnerName</MudText>
            </div>
            <MudChip T="string" Class="ma-0" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@T["YouCanEdit"]</MudChip>
        </MudPaper>
    }

    <SharePeople OwnerIsMe="@IsMine" OwnerName="@(Budget.OwnerName ?? "")" Disabled="@Locked" OnRemove="@RemoveMemberAsync"
                 Members="@([.. Budget.Members.Select(member => new SharePerson(member.UserId, member.DisplayName, member.JoinedAt))])" />

    @if (IsMine)
    {
        @if (Budget.Members.Count > 0 || Budget.IsInviteLiveAt(Clock.UtcNow))
        {
            <MudButton Class="pspad-share-stop align-self-start" Variant="Variant.Text" Color="Color.Error"
                       Disabled="@Locked" OnClick="@StopSharingAsync">
                @T["StopSharingEveryone"]
            </MudButton>
        }
    }
    else
    {
        <MudText Typo="Typo.body2" Class="pspad-muted">@T["MemberExplain"]</MudText>
        <MudButton Class="pspad-share-leave align-self-start" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Outlined.Logout" Disabled="@Locked" OnClick="@LeaveAsync">
            @T["LeaveBudget"]
        </MudButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public Budget Budget { get; set; } = null!;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    bool IsMine => Budget.UserId == State.UserId;

    bool Locked => Disabled || !Connectivity.IsOnline;

    InviteState Invite =>
        new(Budget.InviteToken, Budget.InviteCode, Budget.InviteExpiresAt, Budget.ClosedByWrongCodes, Budget.Members.Count);

    string LinkFor(string token, string code) => InviteCode.BudgetJoinLinkFor(Navigation.BaseUri, token, code);

    protected override void OnInitialized() => Connectivity.Changed += OnConnectivityChanged;

    void OnConnectivityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Connectivity.Changed -= OnConnectivityChanged;

    async Task StopSharingAsync()
    {
        if (Locked || !await ConfirmAsync(
                T["StopSharing"], T["StopSharingMessage", Budget.Name], T["StopSharing"]))
        {
            return;
        }

        if (Budget.InviteToken is not null && !await SucceededAsync(Sharing.StopSharingBudgetAsync(Budget.Id)))
        {
            return;
        }

        foreach (var member in Budget.Members.ToList())
        {
            if (!await SucceededAsync(Sharing.RemoveBudgetMemberAsync(Budget.Id, member.UserId)))
            {
                break;
            }
        }

        await SyncTrigger.SyncNowAsync();
        await OnChanged.InvokeAsync();
    }

    async Task RemoveMemberAsync(SharePerson member)
    {
        if (Locked || !await ConfirmAsync(T["RemoveMember"], T["RemoveMemberMessage", member.DisplayName], T["Remove"]))
        {
            return;
        }

        if (await SucceededAsync(Sharing.RemoveBudgetMemberAsync(Budget.Id, member.UserId)))
        {
            await SyncTrigger.SyncNowAsync();
            await OnChanged.InvokeAsync();
        }
    }

    async Task LeaveAsync()
    {
        if (Locked || !await ConfirmAsync(T["LeaveBudget"], T["LeaveBudgetMessage", Budget.Name], T["Leave"]))
        {
            return;
        }

        if (!await SucceededAsync(Sharing.LeaveBudgetAsync(Budget.Id)))
        {
            return;
        }

        await SyncTrigger.SyncNowAsync();
        Navigation.NavigateTo(BudgetLinks.Index);
    }

    async Task<bool> SucceededAsync(Task<string?> change)
    {
        if (await change is not { } rejection)
        {
            return true;
        }

        Snackbar.Add(rejection, Severity.Error);
        return false;
    }

    async Task<bool> ConfirmAsync(string title, string message, string confirmText)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message },
            { dialog => dialog.ConfirmText, confirmText }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }
}
