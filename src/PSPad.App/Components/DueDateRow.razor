@inject IStringLocalizer<TasksStrings> T
@inject IStringLocalizer<SharedStrings> Shared

<PropertyRow Class="pspad-task-due" Icon="@Icons.Material.Outlined.Event" Label="@(Label ?? T["Due"])"
             Value="@(Value is not { } day ? EmptyText ?? T["NoDueDate"] : Describe(day, Today, Shared))"
             HasValue="@(Value is not null)" ValueColor="@(FlagsPast && Value < Today ? Color.Error : Color.Default)"
             Disabled="@Disabled" OnClear="@(() => ChooseAsync(null))">
    @foreach (var pick in QuickPicks(Today, Shared, T))
    {
        <MudMenuItem Class="pspad-due-quick" OnClick="@(() => ChooseAsync(pick.Day))">
            <div class="d-flex align-center gap-4">
                <span class="flex-grow-1">@pick.Label</span>
                <MudText Typo="Typo.caption" Class="pspad-muted">@pick.Day.ToString("ddd, d MMM")</MudText>
            </div>
        </MudMenuItem>
    }
    <MudDivider />
    <MudMenuItem Class="pspad-due-pick" Icon="@Icons.Material.Outlined.CalendarMonth" OnClick="@OpenPicker">
        @T["PickDate"]
    </MudMenuItem>
</PropertyRow>

<MudDialog @bind-Visible="_picking" Class="pspad-due-dialog" ContentClass="pa-0" Options="@PickerOptions">
    <DialogContent>
        <MudDatePicker PickerVariant="PickerVariant.Static" Elevation="0" ShowToolbar="false" Date="@AsDateTime(Value)"
                       @bind-PickerMonth="_shownMonth" DateChanged="@PickedAsync" />
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public DateOnly? Value { get; set; }

    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? EmptyText { get; set; }

    [Parameter] public bool FlagsPast { get; set; } = true;

    bool _picking;

    DateTime? _shownMonth;

    static readonly DialogOptions PickerOptions = new() { CloseOnEscapeKey = true, BackdropClick = true, NoHeader = true };

    public sealed record QuickPick(string Label, DateOnly Day);

    public static IReadOnlyList<QuickPick> QuickPicks(
        DateOnly today, IStringLocalizer<SharedStrings> shared, IStringLocalizer<TasksStrings> tasks) =>
    [
        new(shared["Today"], today),
        new(shared["Tomorrow"], today.AddDays(1)),
        new(tasks["QuickInTwoDays"], today.AddDays(2)),
        new(tasks["QuickNextWeek"], NextMonday(today))
    ];

    public static string Describe(DateOnly day, DateOnly today, IStringLocalizer<SharedStrings> shared) => day switch
    {
        var d when d == today => shared["Today"],
        var d when d == today.AddDays(1) => shared["Tomorrow"],
        var d when d == today.AddDays(-1) => shared["Yesterday"],
        var d when d.Year == today.Year => d.ToString("ddd, d MMM"),
        var d => d.ToString("ddd, d MMM yyyy")
    };

    static DateOnly NextMonday(DateOnly today)
    {
        var daysAhead = ((int)DayOfWeek.Monday - (int)today.DayOfWeek + 7) % 7;
        return today.AddDays(daysAhead == 0 ? 7 : daysAhead);
    }

    static DateTime? AsDateTime(DateOnly? day) => day?.ToDateTime(TimeOnly.MinValue);

    static DateTime FirstOfMonth(DateOnly day) => new(day.Year, day.Month, 1);

    void OpenPicker()
    {
        _shownMonth = FirstOfMonth(Value ?? Today);
        _picking = !Disabled;
    }

    async Task PickedAsync(DateTime? date)
    {
        _picking = false;
        await ChooseAsync(date is null ? null : DateOnly.FromDateTime(date.Value));
    }

    async Task ChooseAsync(DateOnly? day)
    {
        if (Disabled || day == Value)
        {
            return;
        }

        await ValueChanged.InvokeAsync(day);
    }
}
