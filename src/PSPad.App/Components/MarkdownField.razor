@using PSPad.App.Markdown
@inject ILogger<MarkdownField> Logger

@if (_editing)
{
    <MudTextField T="string" Lines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Class="pspad-markdown-input"
                  Label="Description" aria-label="Description"
                  @bind-Value="_draft" Disabled="@Disabled" />
    <div class="d-flex gap-2 mt-1">
        <MudButton Class="pspad-markdown-save" Color="Color.Primary" Disabled="@(_saving || Disabled)"
                   OnClick="@SaveAsync">Save</MudButton>
        <MudButton Class="pspad-markdown-cancel" Disabled="@_saving" OnClick="@Cancel">Cancel</MudButton>
    </div>
}
else if (string.IsNullOrWhiteSpace(Value))
{
    @if (ReadOnly)
    {
        <MudText Typo="Typo.body2" Class="pspad-markdown-empty mud-text-secondary">No description</MudText>
    }
    else
    {
        <MudButton Variant="Variant.Text" Color="Color.Default" Class="pspad-markdown-placeholder mud-text-secondary"
                   Disabled="@(!CanEdit)" OnClick="@BeginEdit">
            @Placeholder
        </MudButton>
    }
}
else
{
    <MudPaper Outlined="true" Class="pa-3 pspad-markdown-view">
        <div class="d-flex justify-space-between align-start">
            <div class="flex-grow-1" style="min-width:0">@((MarkupString)_renderedHtml)</div>
            @if (CanEdit)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Class="pspad-markdown-edit" Size="Size.Small"
                               aria-label="Edit description" OnClick="@BeginEdit" />
            }
        </div>
    </MudPaper>
}

@code {
    [Parameter] public string Value { get; set; } = "";

    [Parameter] public Func<string, System.Threading.Tasks.Task<bool>>? OnSave { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Add a description";

    bool _editing;
    bool _saving;
    string _draft = "";
    string? _renderedFor;
    string _renderedHtml = "";

    bool CanEdit => !ReadOnly && !Disabled;

    protected override void OnParametersSet()
    {
        if (_renderedFor != Value)
        {
            _renderedFor = Value;
            _renderedHtml = MarkdownRenderer.ToHtml(Value);
        }
    }

    void BeginEdit()
    {
        if (!CanEdit)
        {
            return;
        }

        _draft = Value;
        _editing = true;
    }

    void Cancel() => _editing = false;

    async System.Threading.Tasks.Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        try
        {
            var accepted = OnSave is null || await OnSave(_draft);

            if (accepted)
            {
                _editing = false;
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning("MarkdownField save failed: {Reason}", exception.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
