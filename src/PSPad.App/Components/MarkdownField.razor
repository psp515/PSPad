@using PSPad.App.Markdown
@inject ILogger<MarkdownField> Logger

@if (ShowsEditor)
{
    <MudTextField @ref="_input" T="string" Lines="3" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Class="pspad-markdown-input mt-0"
                  Placeholder="@Placeholder" aria-label="Description" Immediate="true" AutoFocus="@_editing"
                  Value="@_draft" ValueChanged="@DraftChanged" OnBlur="@CommitAsync" OnKeyDown="@DiscardOnEscape" />
}
else if (string.IsNullOrWhiteSpace(Value))
{
    <MudText Typo="Typo.body2" Class="pspad-markdown-empty pspad-muted">No description</MudText>
}
else
{
    <MudPaper Outlined="true" Class="pa-3 pspad-markdown-view">
        <div class="d-flex justify-space-between align-start gap-1">
            @if (CanEdit)
            {
                <div class="flex-grow-1 pspad-markdown-content" style="min-width:0; cursor:text"
                     @onmarkdownviewclick="@EditUnlessOnLink">@((MarkupString)_renderedHtml)</div>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Class="pspad-markdown-edit" Size="Size.Small"
                               aria-label="Edit description" OnClick="@BeginEdit" />
            }
            else
            {
                <div class="flex-grow-1" style="min-width:0">@((MarkupString)_renderedHtml)</div>
            }
        </div>
    </MudPaper>
}

@code {
    [Parameter] public string Value { get; set; } = "";

    [Parameter] public Func<string, System.Threading.Tasks.Task<bool>>? OnSave { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Add a description…";

    MudTextField<string>? _input;
    bool _editing;
    bool _saving;
    string _draft = "";
    string? _renderedFor;
    string _renderedHtml = "";

    bool CanEdit => !ReadOnly && !Disabled;

    bool ShowsEditor => CanEdit && (_editing || string.IsNullOrWhiteSpace(Value));

    protected override void OnParametersSet()
    {
        if (_renderedFor != Value)
        {
            _renderedFor = Value;
            _renderedHtml = MarkdownRenderer.ToHtml(Value);
        }

        if (!_editing)
        {
            _draft = Value ?? "";
        }
    }

    void EditUnlessOnLink(MarkdownViewClickEventArgs args)
    {
        if (!args.OnLink && !args.HasSelection)
        {
            BeginEdit();
        }
    }

    void BeginEdit()
    {
        if (!CanEdit)
        {
            return;
        }

        _draft = Value ?? "";
        _editing = true;
    }

    void DraftChanged(string? text)
    {
        _draft = text ?? "";
        _editing = true;
    }

    void DiscardOnEscape(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || _saving)
        {
            return;
        }

        _draft = Value ?? "";
        _editing = false;
    }

    async System.Threading.Tasks.Task CommitAsync()
    {
        if (!_editing || _saving || !CanEdit)
        {
            return;
        }

        if (_draft == (Value ?? ""))
        {
            _editing = false;
            return;
        }

        _saving = true;
        try
        {
            var accepted = OnSave is null || await OnSave(_draft);

            if (accepted)
            {
                _editing = false;
                return;
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning("MarkdownField save failed: {Reason}", exception.Message);
        }
        finally
        {
            _saving = false;
        }

        if (_input is not null)
        {
            await _input.FocusAsync();
        }
    }
}
