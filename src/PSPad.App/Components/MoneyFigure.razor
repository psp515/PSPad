<div class="@($"d-flex flex-column pspad-money-figure {Class}")" role="group" aria-label="@Label">
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
    <MudText Typo="Typo.subtitle1" Color="@(Negative ? Color.Error : Color.Default)" Class="pspad-money-value">@Text</MudText>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Text { get; set; } = "";

    [Parameter] public bool Negative { get; set; }

    [Parameter] public string Class { get; set; } = "";
}
