@using PSPad.App.State
@using PSPad.App.Statistics
@using PSPad.Module.Money.Reading
@using PSPad.Module.Money.Values
@inject IStringLocalizer<BudgetsStrings> T

<MudGrid Spacing="4" Class="mb-4">
    <MudItem xs="12" md="5">
        <div class="d-flex flex-column gap-4 pspad-stats-column">
        <MudPaper Outlined="true" Class="pa-3 pspad-stats-forecast" role="region" aria-label="@T["Forecast", MoneyText.MonthTitle(Next)].Value">
            <SectionHeading Title="@T["Forecast", MoneyText.MonthTitle(Next)]" Hint="@ForecastHint" />
            @if (Usual.IsEmpty)
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-stats-forecast-empty">@T["ForecastNeedsMonth"]</MudText>
            }
            else
            {
                <div class="d-flex flex-wrap gap-4 mb-3">
                    <MoneyFigure Class="pspad-stats-forecast-expenses" Label="@T["ExpectedExpenses"]" Text="@($"≈ {MoneyText.Pln(Usual.Expenses)}")" />
                    <MoneyFigure Class="pspad-stats-forecast-income" Label="@T["ExpectedIncome"]" Text="@($"≈ {MoneyText.Pln(Usual.Income)}")" />
                    <MoneyFigure Class="pspad-stats-forecast-saved" Label="@T["ExpectedSaved"]" Text="@($"≈ {MoneyText.SignedPln(Usual.Saved)}")"
                                 Negative="@(Usual.Saved < 0)" />
                </div>
                <MudStack Spacing="2">
                    @foreach (var usual in Usual.ExpenseCategories)
                    {
                        <div @key="usual.Category" class="pspad-stats-forecast-row">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudButton Class="pspad-category-open" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OnOpenCategory.InvokeAsync(usual.Category))">@usual.Category</MudButton>
                                <MudSpacer />
                                <MudText Typo="Typo.body2" Class="pspad-stats-forecast-amount">@MoneyText.Pln(usual.Average)</MudText>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Rounded="true" Min="0" Max="@_forecastMax"
                                               Value="@((double)usual.Average)" UserAttributes="@HiddenFromReaders" />
                        </div>
                    }
                </MudStack>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-3 pspad-stats-ranking" role="region" aria-label="@T["WhereMoneyGoes"].Value">
            <SectionHeading Title="@T["WhereMoneyGoes"]" />
            @if (Summary.Ranking.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-stats-no-ranking">@T["NoExpensesInRange"]</MudText>
            }
            else
            {
                <MudStack Spacing="3">
                    @foreach (var total in Summary.Ranking)
                    {
                        <div @key="total.Category" class="pspad-stats-ranking-row">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudButton Class="pspad-category-open" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OnOpenCategory.InvokeAsync(total.Category))">@total.Category</MudButton>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Class="pspad-muted pspad-stats-ranking-share">@MoneyText.Percent(Summary.Expenses == 0 ? null : total.Pln / Summary.Expenses)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pspad-stats-ranking-pln">@MoneyText.Pln(total.Pln)</MudText>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Rounded="true" Min="0" Max="@_rankingMax"
                                               Value="@((double)total.Pln)" UserAttributes="@HiddenFromReaders" />
                        </div>
                    }
                </MudStack>
            }
        </MudPaper>
        </div>
    </MudItem>
    <MudItem xs="12" md="7">
        <div class="d-flex flex-column gap-4 pspad-stats-column">
        <MudPaper Outlined="true" Class="pa-3 pspad-stats-by-month">
            <SectionHeading Title="@T["IncomeVsExpensesByMonth"]" />
            <MudChart ChartType="ChartType.Bar" ChartSeries="@_perMonth" ChartLabels="@_labels"
                      ChartOptions="@_perMonthOptions" Width="100%" Height="260px" />
            <table class="mud-sr-only">
                <caption>@T["IncomeVsExpensesByMonth"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["Month"]</th>
                        <th scope="col">@T["Income"]</th>
                        <th scope="col">@T["Expenses"]</th>
                        <th scope="col">@T["Net"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var figure in Summary.PerMonth)
                    {
                        <tr>
                            <td>@MoneyText.MonthTitle(figure.Month)</td>
                            <td>@MoneyText.Pln(figure.Income)</td>
                            <td>@MoneyText.Pln(figure.Expenses)</td>
                            <td>@MoneyText.SignedPln(figure.Net)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-3 pspad-stats-categories">
            <SectionHeading Title="@T["SpendByCategoryPerMonth"]" />
            @if (Summary.ExpensesByMonth.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-stats-no-expenses">@T["NoExpensesInRange"]</MudText>
            }
            else
            {
                <MudChart ChartType="ChartType.StackedBar" ChartSeries="@_byCategory" ChartLabels="@_labels"
                          ChartOptions="@_byCategoryOptions" Width="100%" Height="260px" />
                <table class="mud-sr-only">
                    <caption>@T["SpendByCategoryPerMonth"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@T["Month"]</th>
                            @foreach (var series in Summary.ExpensesByMonth)
                            {
                                <th scope="col">@series.Category</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < Summary.Months.Count; index++)
                        {
                            var month = index;
                            <tr>
                                <td>@MoneyText.MonthTitle(Summary.Months[month])</td>
                                @foreach (var series in Summary.ExpensesByMonth)
                                {
                                    <td>@MoneyText.Pln(series.PerMonth[month])</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </MudPaper>
        </div>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Outlined="true" Class="pa-3 pspad-stats-net-worth-chart">
            <SectionHeading Title="@T["NetWorthByHoldingType"]" />
            @if (Summary.NetWorth.All(month => month.IsGap))
            {
                <MudText Typo="Typo.body2" Class="pspad-muted pspad-stats-no-balances">@T["NoBalancesInRange"]</MudText>
            }
            else
            {
                <NetWorthByTypeChart Months="@Summary.NetWorth" Labels="@_labels" Caption="@T["NetWorthByHoldingType"]" />
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    string[] _labels = [];
    List<ChartSeries<double>> _perMonth = [];
    BarChartOptions _perMonthOptions = new();
    List<ChartSeries<double>> _byCategory = [];
    StackedBarChartOptions _byCategoryOptions = new();
    double _rankingMax = 1d;
    double _forecastMax = 1d;
    static readonly Dictionary<string, object> HiddenFromReaders = new() { ["aria-hidden"] = "true" };

    [Parameter, EditorRequired] public MoneySummary Summary { get; set; } = default!;

    [Parameter, EditorRequired] public UsualMonth Usual { get; set; } = default!;

    [Parameter, EditorRequired] public YearMonth Next { get; set; }

    [Parameter] public EventCallback<string> OnOpenCategory { get; set; }

    string? ForecastHint => Usual.IsEmpty
        ? null
        : T.Plural(Usual.SampledMonths, "AvgOfLast");

    protected override void OnParametersSet()
    {
        _labels = MoneyText.MonthAxis(Summary.Months);

        _perMonth =
        [
            Series(T["Income"], Summary.PerMonth.Select(figure => figure.Income)),
            Series(T["Expenses"], Summary.PerMonth.Select(figure => figure.Expenses))
        ];
        _perMonthOptions = new BarChartOptions
        {
            YAxisTicks = Step(Summary.PerMonth.Select(figure => Math.Max(figure.Income, figure.Expenses))),
            MaxNumYAxisTicks = ChartAxis.MaxTicks
        };

        _byCategory = [.. Summary.ExpensesByMonth.Select(series => Series(series.Category, series.PerMonth))];
        _byCategoryOptions = new StackedBarChartOptions
        {
            YAxisTicks = Step(Summary.Months.Select((_, index) => Summary.ExpensesByMonth.Sum(series => series.PerMonth[index]))),
            MaxNumYAxisTicks = ChartAxis.MaxTicks
        };

        _rankingMax = Summary.Ranking.Count == 0 ? 1d : Math.Max((double)Summary.Ranking[0].Pln, 1d);
        _forecastMax = Usual.ExpenseCategories.Count == 0 ? 1d : Math.Max((double)Usual.ExpenseCategories[0].Average, 1d);
    }

    static ChartSeries<double> Series(string name, IEnumerable<decimal> values) =>
        new() { Name = name, Data = values.Select(value => (double)value).ToArray() };

    static int Step(IEnumerable<decimal> values) => ChartAxis.Step((double)values.DefaultIfEmpty(0m).Max());
}
