@using PSPad.App.State
@using PSPad.Abstractions
@using PSPad.Module.Money.Budgets
@using PSPad.Module.Money.Entries
@inject IClock Clock

<MudGrid Spacing="4" Class="@Class">
    <MudItem xs="12" md="7">
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6">
                <CategoryList Title="Expense categories" Names="@Budget.ExpenseCategories" ReadOnly="@Budget.IsArchived"
                              Class="pspad-category-list-expense" Usage="@UsageOf(CategoryKind.Expense)" OnOpen="@OnOpenCategory"
                              OnAdd="@(name => OnAddCategory((CategoryKind.Expense, name)))"
                              OnRename="@(change => OnRenameCategory((CategoryKind.Expense, change.From, change.To)))"
                              OnMerge="@(change => OnMergeCategory((CategoryKind.Expense, change.From, change.Into)))"
                              OnRemove="@(name => OnRemoveCategory((CategoryKind.Expense, name)))" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <CategoryList Title="Income categories" Names="@Budget.IncomeCategories" ReadOnly="@Budget.IsArchived"
                              Class="pspad-category-list-income" Usage="@UsageOf(CategoryKind.Income)" OnOpen="@OnOpenCategory"
                              OnAdd="@(name => OnAddCategory((CategoryKind.Income, name)))"
                              OnRename="@(change => OnRenameCategory((CategoryKind.Income, change.From, change.To)))"
                              OnMerge="@(change => OnMergeCategory((CategoryKind.Income, change.From, change.Into)))"
                              OnRemove="@(name => OnRemoveCategory((CategoryKind.Income, name)))" />
            </MudItem>
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="5">
        <div class="d-flex flex-column gap-4">
            <MudPaper Outlined="true" Class="pa-4 pspad-budget-card-settings">
                <MudText Typo="Typo.subtitle2" Class="mb-3">Budget</MudText>
                @if (!IsMine)
                {
                    <MudText Typo="Typo.body2" Class="pspad-budget-shared-by">@($"Shared by {Budget.OwnerName}.")</MudText>
                }
                else if (Budget.IsArchived)
                {
                    <MudButton Class="pspad-restore-budget" Variant="Variant.Outlined" Color="Color.Primary"
                               OnClick="@OnRestore">Restore budget</MudButton>
                }
                else
                {
                    <MudButton Class="pspad-rename-budget" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@OnRename">Rename</MudButton>
                    <MudText Typo="Typo.body2" Class="pspad-muted mt-3">
                        Archiving makes it read-only and hides it from Budgets. Restore it any time.
                    </MudText>
                    <MudButton Class="pspad-archive-budget mt-2" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="@OnArchive">Archive budget</MudButton>
                }
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-4 pspad-budget-sharing">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Sharing</MudText>
                <MudButton Class="pspad-budget-sharing-open" FullWidth="true" Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Outlined.People" EndIcon="@Icons.Material.Filled.ChevronRight"
                           OnClick="@OnOpenMembers">
                    <span class="d-flex flex-column align-start flex-grow-1 text-left" style="text-transform:none">
                        <span>Members</span>
                        <span class="mud-typography-caption pspad-muted">@SharingSummary</span>
                    </span>
                </MudButton>
                <MudText Typo="Typo.body2" Class="pspad-muted mt-2">
                    @(IsMine
                        ? "Members see every entry and balance and can add and edit them. Only you can rename, archive or invite."
                        : $"Only {Budget.OwnerName} can rename, archive or invite.")
                </MudText>
            </MudPaper>
            @if (!Budget.IsArchived)
            {
                <MudPaper Outlined="true" Class="pa-4 pspad-budget-import-card pspad-budget-import-entries">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Import expenses and incomes</MudText>
                    <MudText Typo="Typo.body2" Class="pspad-muted mb-2">
                        Fills the Month tab. Bring expenses and incomes from a CSV file, for example saved from Excel.
                    </MudText>
                    <MudLink Href="templates/pspad-entries.csv" download="pspad-entries.csv" Typo="Typo.body2" Class="d-block mb-2">Expenses and incomes template</MudLink>
                    <MudButton Class="pspad-budget-import-open" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.UploadFile"
                               OnClick="@(() => OnImport.InvokeAsync(BudgetLinks.EntriesImport))">Upload expenses and incomes</MudButton>
                </MudPaper>
                <MudPaper Outlined="true" Class="pa-4 pspad-budget-import-card pspad-budget-import-balances">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Import balances</MudText>
                    <MudText Typo="Typo.body2" Class="pspad-muted mb-2">
                        Fills the Balance tab. Bring monthly holding balances from a CSV file, for example saved from Excel.
                    </MudText>
                    <MudLink Href="templates/pspad-balances.csv" download="pspad-balances.csv" Typo="Typo.body2" Class="d-block mb-2">Balances template</MudLink>
                    <MudButton Class="pspad-budget-import-open" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.UploadFile"
                               OnClick="@(() => OnImport.InvokeAsync(BudgetLinks.BalancesImport))">Upload balances</MudButton>
                </MudPaper>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string Class { get; set; } = "";

    [Parameter, EditorRequired] public Budget Budget { get; set; } = default!;

    [Parameter] public IReadOnlyList<MoneyEntry> Entries { get; set; } = [];

    [Parameter] public Guid Viewer { get; set; }

    [Parameter] public EventCallback OnOpenMembers { get; set; }

    [Parameter] public Func<(CategoryKind Kind, string Name), Task<bool>> OnAddCategory { get; set; } = _ => Task.FromResult(true);

    [Parameter] public Func<(CategoryKind Kind, string From, string To), Task<bool>> OnRenameCategory { get; set; } =
        _ => Task.FromResult(true);

    [Parameter] public Func<(CategoryKind Kind, string From, string Into), Task<bool>> OnMergeCategory { get; set; } =
        _ => Task.FromResult(true);

    [Parameter] public Func<(CategoryKind Kind, string Name), Task<bool>> OnRemoveCategory { get; set; } =
        _ => Task.FromResult(true);

    [Parameter] public EventCallback<string> OnOpenCategory { get; set; }

    [Parameter] public EventCallback<string> OnImport { get; set; }

    [Parameter] public EventCallback OnRename { get; set; }

    [Parameter] public EventCallback OnArchive { get; set; }

    [Parameter] public EventCallback OnRestore { get; set; }

    bool IsMine => Budget.UserId == Viewer;

    string SharingSummary
    {
        get
        {
            var joined = Budget.Members.Count;

            if (!IsMine)
            {
                return $"{joined + 1} people";
            }

            var people = joined == 0 ? "Nobody joined yet" : $"{joined} joined";

            if (Budget.IsInviteLiveAt(Clock.UtcNow))
            {
                var left = (int)Math.Ceiling((Budget.InviteExpiresAt!.Value - Clock.UtcNow).TotalMinutes);
                return $"{people} · link {left} min left";
            }

            return joined == 0 ? "Only you" : people;
        }
    }

    IReadOnlyDictionary<string, int> UsageOf(CategoryKind kind) =>
        Entries.Where(entry => entry.Kind == kind && !entry.Deleted)
            .GroupBy(entry => entry.Category, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
}
