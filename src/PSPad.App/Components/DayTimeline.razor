@using PSPad.App.State
@using PSPad.Module.Tasks.Tasks
@using PSPad.Module.Tasks.Today
@inject IStringLocalizer<TodayStrings> T

<MudPaper Outlined="true" Elevation="0" Class="pspad-timeline" Style="@($"--pspad-timeline-natural:{_axis.NaturalLength(HourLength)}px")">
    <div class="pspad-timeline-axis">
        @foreach (var segment in _axis.Segments)
        {
            var from = segment.StartHour * 60;
            var to = segment.EndHour * 60;
            var range = $"{segment.StartHour:00}:00–{segment.EndHour:00}:00";
            if (segment.Folded)
            {
                <button type="button" class="pspad-timeline-fold" style="@Place(from, to)"
                        aria-label="@T["ShowHours", range].Value" @onclick="@(() => Unfold(segment.StartHour))">
                    <MudIcon Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" />
                    <span class="pspad-timeline-fold-label">@range</span>
                </button>
            }
            else
            {
                <div class="pspad-timeline-hour" style="@Place(from, to)">
                    <span class="pspad-timeline-hour-label pspad-muted">@($"{segment.StartHour:00}:00")</span>
                    @if (OnAdd.HasDelegate)
                    {
                        @foreach (var slot in new[] { new TimeOnly(segment.StartHour, 0), new TimeOnly(segment.StartHour, HalfHour) })
                        {
                            var label = TimeRow.Format(slot);
                            <button type="button" class="pspad-timeline-slot" data-time="@label"
                                    aria-label="@T["AddTaskAt", label].Value" @onclick="@(() => OnAdd.InvokeAsync(slot))"></button>
                        }
                    }
                    else
                    {
                        <span class="pspad-timeline-half"></span>
                    }
                </div>
            }
        }
        @foreach (var block in _layout.Blocks)
        {
            var task = Tasks[block.Entry.TaskId];
            var done = IsDone(task);
            <div @key="block.Entry.TaskId" class="@BlockClass(block, done)" style="@BlockStyle(block)"
                 title="@($"{task.Name} – {TimeRow.Describe(block.Entry.Time!)}")">
                <MudCheckBox T="bool" Value="@done" ValueChanged="@(_ => OnToggle.InvokeAsync(task))"
                             Color="Color.Primary" UncheckedColor="Color.Default" Dense="true"
                             UncheckedIcon="@Icons.Material.Filled.RadioButtonUnchecked" CheckedIcon="@Icons.Material.Filled.CheckCircle" />
                <div class="pspad-timeline-task-body" @onclick="@(() => OnOpen.InvokeAsync(task))">
                    @Time(block.Entry.Time!)
                    <MudText Typo="Typo.body2" Class="pspad-timeline-task-name pspad-task-name"
                             Style="@(done ? "text-decoration:line-through" : "")">@task.Name</MudText>
                    @if (block.End - block.Start >= RoomForList && ListNameOf?.Invoke(task) is { } listName)
                    {
                        <MudText Typo="Typo.caption" Class="pspad-timeline-task-list pspad-muted">@listName</MudText>
                    }
                </div>
            </div>
        }
        @foreach (var group in _layout.Groups)
        {
            <div @key="group.Entries[0].TaskId" class="@(group.Lanes > 1 ? "pspad-timeline-group pspad-timeline-task-narrow" : "pspad-timeline-group")" style="@GroupStyle(group)">
                @foreach (var entry in group.Entries)
                {
                    var task = Tasks[entry.TaskId];
                    var done = IsDone(task);
                    <div @key="entry.TaskId" class="pspad-timeline-group-line">
                        <MudCheckBox T="bool" Value="@done" ValueChanged="@(_ => OnToggle.InvokeAsync(task))"
                                     Color="Color.Primary" UncheckedColor="Color.Default" Dense="true"
                                     UncheckedIcon="@Icons.Material.Filled.RadioButtonUnchecked" CheckedIcon="@Icons.Material.Filled.CheckCircle" />
                        <div class="pspad-timeline-task-body" @onclick="@(() => OnOpen.InvokeAsync(task))">
                            @Time(entry.Time!)
                            <MudText Typo="Typo.body2" Class="pspad-timeline-task-name pspad-task-name" title="@task.Name"
                                     Style="@(done ? "text-decoration:line-through" : "")">@task.Name</MudText>
                        </div>
                    </div>
                }
            </div>
        }
        @if (Now is { } now)
        {
            <div class="pspad-timeline-now" style="@($"--at:{_axis.At(Minutes(now))}")"><span class="pspad-timeline-now-label">@TimeRow.Format(now)</span></div>
        }
    </div>
</MudPaper>

@code {
    public const int HourLength = 40;
    const int HalfHour = 30;
    const int MinutesPerDay = 24 * 60;
    const int ShortestVisibleSpan = 45;
    const int LineHeight = 24;
    const int GroupPadding = 4;
    const int MaxLanes = 2;
    const int RoomForTwoLines = 90;
    const int RoomForList = 120;

    [Parameter, EditorRequired] public IReadOnlyList<TodayEntry> Entries { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyDictionary<Guid, TodoTask> Tasks { get; set; } = new Dictionary<Guid, TodoTask>();

    [Parameter] public DateOnly Day { get; set; }

    [Parameter] public TimeOnly? Now { get; set; }

    [Parameter] public Func<TodoTask, string?>? ListNameOf { get; set; }

    [Parameter] public EventCallback<TodoTask> OnToggle { get; set; }

    [Parameter] public EventCallback<TodoTask> OnOpen { get; set; }

    [Parameter] public EventCallback<TimeOnly> OnAdd { get; set; }

    sealed record Span(TodayEntry Entry, int Start, int End, int VisibleEnd);

    sealed record Block(TodayEntry Entry, int Start, int End, int Lane, int Lanes);

    sealed record Group(IReadOnlyList<TodayEntry> Entries, int Start, int End, int Lane, int Lanes)
    {
        public int Needs => Entries.Count * LineHeight + GroupPadding;
    }

    sealed record Layout(IReadOnlyList<Block> Blocks, IReadOnlyList<Group> Groups);

    Layout _layout = new([], []);
    TimelineAxis _axis = TimelineAxis.For([], null, new HashSet<int>());
    readonly HashSet<int> _unfolded = [];
    DateOnly? _shown;

    protected override void OnParametersSet()
    {
        if (_shown != Day)
        {
            _shown = Day;
            _unfolded.Clear();
        }

        _layout = Lay(Entries);
        Arrange();
    }

    void Arrange()
    {
        var spans = Entries.Where(entry => entry.Time is not null).Select(SpanOf).Select(span => (span.Start, span.End));
        _axis = TimelineAxis.For(spans, Now is { } now ? Minutes(now) : null, _unfolded);
    }

    void Unfold(int hour)
    {
        _unfolded.Add(hour);
        Arrange();
    }

    string Place(int from, int to) => $"--at:{_axis.At(from)};--size:{_axis.Stretch(from, to)}";

    static int Minutes(TimeOnly time) => time.Hour * 60 + time.Minute;

    static Span SpanOf(TodayEntry entry)
    {
        var time = entry.Time!;
        var start = Minutes(time.Start);
        var end = time.Overnight ? MinutesPerDay
            : time.End is { } finish ? Math.Min(Minutes(finish), MinutesPerDay)
            : start + HalfHour;
        return new Span(entry, start, end, Math.Min(MinutesPerDay, Math.Max(end, start + ShortestVisibleSpan)));
    }

    static Layout Lay(IReadOnlyList<TodayEntry> entries)
    {
        var spans = entries
            .Where(entry => entry.Time is not null)
            .Select(SpanOf)
            .OrderBy(span => span.Start).ThenByDescending(span => span.VisibleEnd)
            .ToList();
        var blocks = new List<Block>();
        var groups = new List<Group>();
        foreach (var cluster in Clusters(spans))
        {
            Place(cluster, blocks, groups);
        }

        return new Layout(blocks, groups);
    }

    static IEnumerable<List<Span>> Clusters(IEnumerable<Span> spans)
    {
        var cluster = new List<Span>();
        var clusterEnd = -1;
        foreach (var span in spans)
        {
            if (span.Start >= clusterEnd && cluster.Count > 0)
            {
                yield return cluster;
                cluster = [];
            }

            cluster.Add(span);
            clusterEnd = cluster.Count == 1 ? span.VisibleEnd : Math.Max(clusterEnd, span.VisibleEnd);
        }

        if (cluster.Count > 0)
        {
            yield return cluster;
        }
    }

    static void Place(List<Span> cluster, List<Block> blocks, List<Group> groups)
    {
        var lanes = Lanes(cluster);
        var laneCount = lanes.Max() + 1;
        if (laneCount <= MaxLanes)
        {
            blocks.AddRange(cluster.Select((span, index) => new Block(span.Entry, span.Start, span.End, lanes[index], laneCount)));
        }
        else if (cluster.All(span => span.Start - cluster[0].Start < HalfHour))
        {
            groups.Add(GroupOf(cluster, 0, 1));
        }
        else
        {
            var first = cluster.Where((_, index) => lanes[index] == 0);
            var beside = cluster.Where((_, index) => lanes[index] > 0);
            blocks.AddRange(first.Select(span => new Block(span.Entry, span.Start, span.End, 0, MaxLanes)));
            foreach (var inner in Clusters(beside))
            {
                if (inner.Count == 1)
                {
                    blocks.Add(new Block(inner[0].Entry, inner[0].Start, inner[0].End, 1, MaxLanes));
                }
                else
                {
                    groups.Add(GroupOf(inner, 1, MaxLanes));
                }
            }
        }
    }

    static int[] Lanes(List<Span> cluster)
    {
        var laneEnds = new List<int>();
        return [.. cluster.Select(span =>
        {
            var lane = laneEnds.FindIndex(laneEnd => laneEnd <= span.Start);
            if (lane < 0)
            {
                lane = laneEnds.Count;
                laneEnds.Add(span.VisibleEnd);
            }
            else
            {
                laneEnds[lane] = span.VisibleEnd;
            }

            return lane;
        })];
    }

    static Group GroupOf(List<Span> members, int lane, int lanes)
    {
        var ordered = members
            .OrderBy(span => span.Start)
            .ThenBy(span => span.Entry.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        return new Group([.. ordered.Select(span => span.Entry)], ordered[0].Start, members.Max(span => span.VisibleEnd), lane, lanes);
    }

    RenderFragment Time(TaskTime time) =>
        @<MudText Typo="Typo.caption" Color="Color.Primary" Class="pspad-schedule-time">
            <span class="pspad-schedule-start">@TimeRow.Format(time.Start)</span>@if (time.End is { } end){<span class="pspad-schedule-dash">–</span><span class="pspad-schedule-end">@TimeRow.Format(end)</span>}@if (time.Overnight){<span class="pspad-schedule-nextday pspad-muted">@TimeRow.NextDay</span>}
        </MudText>;

    string BlockStyle(Block block) =>
        $"{Place(block.Start, block.End)};--lane:{block.Lane};--lanes:{block.Lanes}";

    string GroupStyle(Group group) =>
        $"{Place(group.Start, group.End)};--needs:{group.Needs}px;--lane:{group.Lane};--lanes:{group.Lanes}";

    static string BlockClass(Block block, bool done)
    {
        var oneLine = block.End - block.Start < RoomForTwoLines;
        return "pspad-timeline-task"
            + (done ? " pspad-timeline-task-done" : "")
            + (oneLine ? " pspad-timeline-task-short" : "")
            + (oneLine && block.Lanes > 1 ? " pspad-timeline-task-narrow" : "");
    }

    bool IsDone(TodoTask task) =>
        task.IsRecurring ? task.CompletedDays.Contains(Day) : task.CompletedAt is not null;
}
