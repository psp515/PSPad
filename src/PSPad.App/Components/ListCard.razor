@using PSPad.Module.Tasks.Lists
@using PSPad.Module.Tasks.References
@using PSPad.Module.Tasks.Tasks

<ThingCard Id="@List.Id" Name="@List.Name" Href="@($"/lists/{List.Id}")" Icon="@ListIcon.For(List)"
           IconTitle="@ListIcon.LabelFor(List)" Tasks="@Tasks" Today="@Today"
           Rows="@(IsReference ? ItemRows : null)" RowCount="@(IsReference ? Items.Count : (int?)null)"
           EmptyText="@(IsReference ? "No items yet." : null)"
           OnToggle="@OnToggle" OnStar="@OnStar" OnOpen="@OnOpen">
    <Actions>
        @if (IsReference)
        {
            <MudIconButton Class="pspad-add-item" Size="Size.Small" Icon="@Icons.Material.Filled.Add"
                           OnClick="@OnAddItemClick" />
        }
        else
        {
            <MudIconButton Class="pspad-add-task" Size="Size.Small" Icon="@Icons.Material.Filled.Add"
                           OnClick="@OnAddTaskClick" />
        }
        <ThingMenu Class="pspad-list-menu"
                   OnRename="@OnRename" OnDelete="@OnDelete">
            <Extra>
                <MudMenuItem OnClick="@OnMove">Move to area</MudMenuItem>
            </Extra>
        </ThingMenu>
    </Actions>
</ThingCard>

@code {
    [Parameter, EditorRequired] public TaskList List { get; set; } = null!;

    [Parameter] public IReadOnlyList<TodoTask> Tasks { get; set; } = [];

    [Parameter] public IReadOnlyList<ReferenceItem> Items { get; set; } = [];

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public EventCallback<TodoTask> OnToggle { get; set; }

    [Parameter] public EventCallback<TodoTask> OnStar { get; set; }

    [Parameter] public EventCallback<TodoTask> OnOpen { get; set; }

    [Parameter] public EventCallback<ReferenceItem> OnOpenItem { get; set; }

    [Parameter] public EventCallback<ReferenceItem> OnStarItem { get; set; }

    [Parameter] public EventCallback OnAddTaskClick { get; set; }

    [Parameter] public EventCallback OnAddItemClick { get; set; }

    [Parameter] public EventCallback OnRename { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    [Parameter] public EventCallback OnMove { get; set; }

    bool IsReference => List.Kind == ListKind.Reference;

    RenderFragment ItemRows => @<text>
        @foreach (var item in Items.Take(ThingCard.Preview))
        {
            <ReferenceRow @key="item.Id" Item="@item" OnStar="@OnStarItem" OnOpen="@OnOpenItem" />
        }
    </text>;
}
