<MudPaper Outlined="true" Class="@($"pa-3 pspad-money-tile {Class}")">
    <MudText Typo="Typo.h6" Color="@(Negative ? Color.Error : Color.Primary)" Class="pspad-money-tile-value">@Text</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Text { get; set; } = "";

    [Parameter] public bool Negative { get; set; }

    [Parameter] public string Class { get; set; } = "";
}
