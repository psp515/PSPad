@using PSPad.App.State
@using PSPad.App.Api
@using PSPad.Module.Tasks.Lists
@inject IListSharingApi Sharing
@inject NavigationManager Navigation

<InviteCard Invite="@Invite" LinkFor="@LinkFor" Thing="list" Disabled="@Disabled" OnChanged="@OnChanged"
            Invitation="Create an invite link or QR code. It works for 30 minutes — whoever opens it in that time can add, edit and tick tasks."
            OnShare="@((token, code) => Sharing.ShareListAsync(List.Id, token, code))"
            OnEnd="@(() => Sharing.StopSharingAsync(List.Id))" />

@code {
    [Parameter, EditorRequired] public TaskList List { get; set; } = null!;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    InviteState Invite => new(List.InviteToken, List.InviteCode, List.InviteExpiresAt, List.ClosedByWrongCodes, List.Members.Count);

    string LinkFor(string token, string code) => InviteCode.JoinLinkFor(Navigation.BaseUri, token, code);
}
