@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.Tasks
@inject IServiceProvider Services

<div class="pspad-steps d-flex flex-column">
    @if (Draft is not null)
    {
        @for (var index = 0; index < Draft.Count; index++)
        {
            var position = index;
            var name = Draft[position];
            <div @key="position" class="pspad-step d-flex align-center gap-1">
                <span class="pspad-step-lead">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckBoxOutlineBlank" Size="Size.Small" Class="pspad-muted" />
                </span>
                <MudText Typo="Typo.body2" Class="flex-grow-1 pspad-step-name">@name</MudText>
                <MudIconButton Class="pspad-step-remove" Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                               aria-label="@($"Remove {name}")" Disabled="@Disabled"
                               OnClick="@(() => Draft.RemoveAt(position))" />
            </div>
        }
    }

    @foreach (var step in Task?.Steps ?? [])
    {
        <div @key="step.Id" class="pspad-step d-flex align-center gap-1">
            <MudCheckBox T="bool" Class="pspad-step-check" Value="@step.Checked"
                         ValueChanged="@(value => CheckAsync(step, value))" Color="Color.Primary"
                         Size="Size.Small" Disabled="@Disabled" aria-label="@step.Name" />
            <MudText Typo="Typo.body2" Class="@($"flex-grow-1 pspad-step-name {(step.Checked ? "pspad-muted" : "")}")"
                     Style="@(step.Checked ? "text-decoration:line-through" : "")">@step.Name</MudText>
            <MudIconButton Class="pspad-step-remove" Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                           aria-label="@($"Remove {step.Name}")" Disabled="@Disabled"
                           OnClick="@(() => RemoveAsync(step))" />
        </div>
    }

    <div class="pspad-step pspad-step-add-row d-flex align-center gap-1">
        <span class="pspad-step-lead">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" />
        </span>
        <MudTextField T="string" Class="pspad-step-add flex-grow-1 mt-0" @bind-Value="_newStep"
                      Placeholder="@(StepCount == 0 ? "Add step" : "Next step")" Underline="false"
                      Margin="Margin.Dense" Immediate="true" Disabled="@Disabled" OnKeyDown="@AddOnEnterAsync" />
    </div>
</div>

@code {
    [Parameter] public TodoTask? Task { get; set; }
    [Parameter] public List<string>? Draft { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    string _newStep = "";

    int StepCount => Draft?.Count ?? Task?.Steps.Count ?? 0;

    async System.Threading.Tasks.Task AddOnEnterAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAsync();
        }
    }

    async System.Threading.Tasks.Task AddAsync()
    {
        var name = _newStep.Trim();

        if (Disabled || name.Length == 0)
        {
            return;
        }

        _newStep = "";

        if (Draft is not null)
        {
            Draft.Add(name);
            return;
        }

        if (Task is null)
        {
            return;
        }

        var sender = Services.GetRequiredService<CommandSender>();
        await sender.SendAsync(new AddStep(Guid.NewGuid(), UserId, Task.Id, Guid.NewGuid(), name));
        await Changed.InvokeAsync();
    }

    async System.Threading.Tasks.Task CheckAsync(Step step, bool @checked)
    {
        if (Disabled || Task is null)
        {
            return;
        }

        var sender = Services.GetRequiredService<CommandSender>();
        await sender.SendAsync(new CheckStep(Guid.NewGuid(), UserId, Task.Id, step.Id, @checked));
        await Changed.InvokeAsync();
    }

    async System.Threading.Tasks.Task RemoveAsync(Step step)
    {
        if (Disabled || Task is null)
        {
            return;
        }

        var sender = Services.GetRequiredService<CommandSender>();
        await sender.SendAsync(new RemoveStep(Guid.NewGuid(), UserId, Task.Id, step.Id));
        await Changed.InvokeAsync();
    }
}
