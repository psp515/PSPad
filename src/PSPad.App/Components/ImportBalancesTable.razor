@using System.Globalization
@using PSPad.App.State
@using PSPad.Module.Money.Import
@inject IStringLocalizer<BudgetsStrings> T

<MudChipSet T="ImportEntriesTable.ImportFilter" SelectedValue="@_filter" SelectedValueChanged="@(value => _filter = value)"
            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Color="Color.Primary" Variant="Variant.Outlined"
            SelectedColor="Color.Primary" Size="Size.Small" Class="mb-2 pspad-import-filter">
    <MudChip Value="@ImportEntriesTable.ImportFilter.All" aria-pressed="@Pressed(ImportEntriesTable.ImportFilter.All)" Text="@T["All"]" />
    <MudChip Value="@ImportEntriesTable.ImportFilter.ToImport" aria-pressed="@Pressed(ImportEntriesTable.ImportFilter.ToImport)" Text="@T["ImportToImport"]" />
    <MudChip Value="@ImportEntriesTable.ImportFilter.Errors" aria-pressed="@Pressed(ImportEntriesTable.ImportFilter.Errors)" Text="@T["ImportErrors"]" />
</MudChipSet>

@foreach (var month in Months)
{
    var shown = Shown.Where(row => row.Row?.Month == month.Month).ToList();

    <MudText Typo="Typo.subtitle2" Class="mt-3 pspad-import-month">
        @month.Month · @(month.IsNew
            ? T["NewMonthHoldings", month.Holdings]
            : T["ExistingMonth", month.Updates, month.Adds, month.Unchanged])
    </MudText>
    @if (shown.Count > 0)
    {
        <MudTable T="HoldingPreview" Items="@shown" Dense="true" Hover="true" RowClassFunc="@RowClass" Class="mt-1">
            <HeaderContent>@Header</HeaderContent>
            <RowTemplate>@Row(context)</RowTemplate>
        </MudTable>
    }
}

@{
    var unreadable = Shown.Where(row => row.Row is null).ToList();
}
@if (unreadable.Count > 0)
{
    <MudText Typo="Typo.subtitle2" Class="mt-3 pspad-import-month">@T["UnreadableRows"]</MudText>
    <MudTable T="HoldingPreview" Items="@unreadable" Dense="true" Hover="true" RowClassFunc="@RowClass" Class="mt-1">
        <HeaderContent>@Header</HeaderContent>
        <RowTemplate>@Row(context)</RowTemplate>
    </MudTable>
}

@code {
    ImportEntriesTable.ImportFilter _filter = ImportEntriesTable.ImportFilter.All;

    string Pressed(ImportEntriesTable.ImportFilter filter) => filter == _filter ? "true" : "false";

    [Parameter, EditorRequired] public IReadOnlyList<HoldingPreview> Rows { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<MonthPreview> Months { get; set; } = [];

    IEnumerable<HoldingPreview> Shown => _filter switch
    {
        ImportEntriesTable.ImportFilter.ToImport => Rows.Where(row => row.Status == ImportStatus.ToImport),
        ImportEntriesTable.ImportFilter.Errors => Rows.Where(row => row.Status == ImportStatus.Error),
        _ => Rows
    };

    static string RowClass(HoldingPreview row, int _) =>
        row.Status == ImportStatus.Error ? "pspad-import-row pspad-import-row-error" : "pspad-import-row";

    RenderFragment Header => @<text>
        <MudTh>@T["Line"]</MudTh><MudTh>@T["Month"]</MudTh><MudTh>@T["Holding"]</MudTh><MudTh>@T["Type"]</MudTh><MudTh>@T["Amount"]</MudTh>
        <MudTh>@T["Rate"]</MudTh><MudTh>@T["Status"]</MudTh>
    </text>;

    RenderFragment Row(HoldingPreview row) => @<text>
        <MudTd>@row.Line</MudTd>
        <MudTd>@row.Row?.Month</MudTd>
        <MudTd>@row.Row?.Name</MudTd>
        <MudTd>@(row.Row is { } typed ? T.Of(typed.Type) : "")</MudTd>
        <MudTd>@(row.Row is { } parsed ? ImportText.Amount(parsed.Amount, row.Money?.Currency ?? parsed.Currency ?? "") : "")</MudTd>
        <MudTd>@ImportText.RateSource(row.Row?.Rate, row.Money, T)</MudTd>
        <MudTd Class="@ImportText.StatusClass(row.Status)">@(row.Error ?? ImportText.StatusText(row.Status, T))</MudTd>
    </text>;
}
