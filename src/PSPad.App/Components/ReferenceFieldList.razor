@using PSPad.App.State
@using PSPad.App.State.Dispatch
@using PSPad.Module.Tasks.References
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject CommandSender Sender
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject ILogger<ReferenceFieldList> Logger

<div class="pspad-fields d-flex flex-column">
    @* MudDropZone keeps its own index per item; keying on the order hands it a fresh container after every change. *@
    <MudDropContainer T="ReferenceField" @key="@DropKey" Items="@Fields" ItemsSelector="@((_, _) => true)"
                      ItemDropped="@FieldDroppedAsync" ItemDisabled="@(_ => Disabled || _editingFieldId is not null)"
                      Class="pspad-fields-drop">
        <ChildContent>
            <MudDropZone T="ReferenceField" Identifier="fields" AllowReorder="true" Class="d-flex flex-column" />
        </ChildContent>
        <ItemRenderer>
            @if (_editingFieldId == context.Id)
            {
                <div class="pspad-field-editor d-flex flex-column gap-1 py-2 pl-2 pr-1">
                    <ReferenceFieldEditor Field="@context" OnSave="@(input => EditAsync(context.Id, input))"
                                          OnCancel="@CancelEditAsync" OnRemove="@(() => RemoveAsync(context))" />
                </div>
            }
            else
            {
                <div class="pspad-step pspad-field-row d-flex align-center gap-1">
                    <span class="pspad-step-lead">
                        <MudIcon Icon="@KindIcon(context)" Size="Size.Small" Class="pspad-muted" />
                    </span>
                    <div class="flex-grow-1 pspad-field-row-body py-1" style="cursor:pointer; min-width:0"
                         @onclick="@(() => BeginEdit(context.Id))">
                        <MudText Typo="Typo.caption" Class="pspad-field-label pspad-muted d-block">@context.Label</MudText>
                        <ReferenceFieldValue Field="@context" />
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                   Class="pspad-field-remove pspad-step-remove" aria-label="@($"Remove {context.Label}")"
                                   Disabled="@Disabled" OnClick="@(() => RemoveAsync(context))" />
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"
                             Class="pspad-drag-handle pspad-muted" aria-label="@($"Drag {context.Label}")" />
                </div>
            }
        </ItemRenderer>
    </MudDropContainer>

    <div class="pspad-step pspad-step-add-row pspad-field-add-row d-flex align-center gap-1">
        <span class="pspad-step-lead">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" />
        </span>
        <MudTextField @ref="_labelInput" T="string" Class="pspad-step-add pspad-field-add-label flex-grow-1 mt-0"
                      @bind-Value="_newLabel" Placeholder="Label" aria-label="New label" Underline="false"
                      Margin="Margin.Dense" Immediate="true" Disabled="@Disabled" OnKeyDown="@LabelKeyDownAsync" />
        <MudTextField @ref="_valueInput" T="string" Class="pspad-step-add pspad-field-add-value flex-grow-1 mt-0"
                      @bind-Value="_newValue" Placeholder="Value" aria-label="New label value" Underline="false"
                      Margin="Margin.Dense" Immediate="true" Disabled="@Disabled" OnKeyDown="@ValueKeyDownAsync" />
    </div>
</div>

@code {
    [Parameter] public ReferenceItem? Item { get; set; }
    [Parameter] public List<ReferenceField>? Draft { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    MudTextField<string>? _labelInput;
    MudTextField<string>? _valueInput;
    string _newLabel = "";
    string _newValue = "";
    bool _adding;
    Guid? _editingFieldId;
    IJSObjectReference? _dropModule;
    IJSObjectReference? _dropListener;
    DotNetObjectReference<ReferenceFieldList>? _dropReference;

    IReadOnlyList<ReferenceField> Fields => Item?.Fields ?? Draft ?? [];

    string DropKey => string.Join(",", Fields.Select(entry => entry.Id)) + (_editingFieldId is null ? "" : "|editing");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _valueInput?.InputReference is not null)
        {
            try
            {
                _dropModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/drop.js");
                _dropReference = DotNetObjectReference.Create(this);
                _dropListener = await _dropModule.InvokeAsync<IJSObjectReference>(
                    "attach", _valueInput.InputReference.ElementReference, _dropReference);
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Drop target unavailable for the reference field add row");
            }
        }
    }

    [JSInvokable]
    public async Task OnDropped(string? uriList, string? text, bool hadFiles)
    {
        var dropped = FirstUri(uriList) ?? NonBlank(text);

        if (dropped is not null)
        {
            _newValue = dropped;
            StateHasChanged();

            if (_valueInput is not null)
            {
                await _valueInput.FocusAsync();
            }

            return;
        }

        if (hadFiles)
        {
            Snackbar.Add(
                "Browsers can't read a file's full path. On Windows use Shift+right-click → Copy as path, then paste.",
                Severity.Info);
        }
    }

    static string? FirstUri(string? uriList)
    {
        if (string.IsNullOrWhiteSpace(uriList))
        {
            return null;
        }

        foreach (var rawLine in uriList.Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0 || line.StartsWith('#'))
            {
                continue;
            }

            return line;
        }

        return null;
    }

    static string? NonBlank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_dropListener is not null)
            {
                await _dropListener.InvokeVoidAsync("dispose");
                await _dropListener.DisposeAsync();
            }
        }
        catch (JSException)
        {
        }

        _dropReference?.Dispose();

        if (_dropModule is not null)
        {
            try
            {
                await _dropModule.DisposeAsync();
            }
            catch (JSException)
            {
            }
        }
    }

    async Task LabelKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && _valueInput is not null)
        {
            await _valueInput.FocusAsync();
        }
    }

    async Task ValueKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAsync();
        }
    }

    static string KindIcon(ReferenceField field) => FieldDisplay.Of(field) switch
    {
        FieldKind.Link => Icons.Material.Outlined.Link,
        FieldKind.Path => Icons.Material.Outlined.Folder,
        FieldKind.Quantity => Icons.Material.Outlined.Straighten,
        _ => Icons.Material.Outlined.Notes
    };

    async Task AddAsync()
    {
        var label = (_newLabel ?? "").Trim();

        if (Disabled || _adding)
        {
            return;
        }

        if (label.Length == 0)
        {
            if (_labelInput is not null)
            {
                await _labelInput.FocusAsync();
            }

            return;
        }

        var typedLabel = _newLabel ?? "";
        var value = _newValue ?? "";
        _newLabel = "";
        _newValue = "";
        _adding = true;
        try
        {
            if (Item is null)
            {
                Draft?.Add(new ReferenceField(Guid.NewGuid(), label, value.TrimEnd(), null, Draft.Count));
            }
            else
            {
                var result = await Sender.SendAsync(new AddReferenceField(
                    Guid.NewGuid(), UserId, Item.Id, Guid.NewGuid(), label, value, null));

                if (!result.Accepted)
                {
                    _newLabel = typedLabel;
                    _newValue = value;
                    Snackbar.Add(result.Rejection ?? "Couldn't add the field.", Severity.Warning);
                    return;
                }
            }

            await Changed.InvokeAsync();

            if (_labelInput is not null)
            {
                await _labelInput.FocusAsync();
            }
        }
        finally
        {
            _adding = false;
        }
    }

    void BeginEdit(Guid fieldId)
    {
        if (!Disabled)
        {
            _editingFieldId = fieldId;
        }
    }

    Task CancelEditAsync()
    {
        _editingFieldId = null;
        return Task.CompletedTask;
    }

    async Task EditAsync(Guid fieldId, (string Label, string Value, string? Display) input)
    {
        if (Disabled)
        {
            return;
        }

        if (Item is null)
        {
            ReplaceInDraft(fieldId, field => field with
            {
                Label = input.Label.Trim(), Value = input.Value.TrimEnd(), Display = input.Display
            });
        }
        else
        {
            var result = await Sender.SendAsync(new EditReferenceField(
                Guid.NewGuid(), UserId, Item.Id, fieldId, input.Label, input.Value, input.Display));

            if (!result.Accepted)
            {
                Snackbar.Add(result.Rejection ?? "Couldn't save the field.", Severity.Warning);
                return;
            }
        }

        _editingFieldId = null;
        await Changed.InvokeAsync();
        StateHasChanged();
    }

    async Task RemoveAsync(ReferenceField field)
    {
        if (Disabled)
        {
            return;
        }

        if (Item is null)
        {
            Draft?.RemoveAll(entry => entry.Id == field.Id);
            RenumberDraft();
        }
        else
        {
            var result = await Sender.SendAsync(new RemoveReferenceField(Guid.NewGuid(), UserId, Item.Id, field.Id));

            if (!result.Accepted)
            {
                Snackbar.Add(result.Rejection ?? "Couldn't remove the field.", Severity.Warning);
                return;
            }
        }

        _editingFieldId = null;
        await Changed.InvokeAsync();
        StateHasChanged();
    }

    Task FieldDroppedAsync(MudItemDropInfo<ReferenceField> dropped) =>
        dropped.Item is { } field ? MoveAsync(field.Id, dropped.IndexInZone) : Task.CompletedTask;

    async Task MoveAsync(Guid fieldId, int toIndex)
    {
        if (Disabled)
        {
            return;
        }

        if (Item is null)
        {
            var from = Draft?.FindIndex(field => field.Id == fieldId) ?? -1;
            if (from < 0)
            {
                return;
            }

            var moving = Draft![from];
            Draft.RemoveAt(from);
            Draft.Insert(Math.Clamp(toIndex, 0, Draft.Count), moving);
            RenumberDraft();
        }
        else
        {
            var result = await Sender.SendAsync(new MoveReferenceField(Guid.NewGuid(), UserId, Item.Id, fieldId, toIndex));

            if (!result.Accepted)
            {
                Snackbar.Add(result.Rejection ?? "Couldn't reorder the field.", Severity.Warning);
                return;
            }
        }

        await Changed.InvokeAsync();
    }

    void ReplaceInDraft(Guid fieldId, Func<ReferenceField, ReferenceField> change)
    {
        var index = Draft?.FindIndex(field => field.Id == fieldId) ?? -1;
        if (index >= 0)
        {
            Draft![index] = change(Draft[index]);
        }
    }

    void RenumberDraft()
    {
        for (var index = 0; index < (Draft?.Count ?? 0); index++)
        {
            Draft![index] = Draft[index] with { Position = index };
        }
    }
}
