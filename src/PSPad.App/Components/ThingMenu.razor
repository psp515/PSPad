@inject IStringLocalizer<SharedStrings> Shared

<MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true" AriaLabel="@Shared["Actions"].Value"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="@Class">
    <MudMenuItem OnClick="@OnEdit">@Shared["Edit"]</MudMenuItem>
    @Extra
    @if (OnDelete.HasDelegate)
    {
        <MudMenuItem OnClick="@OnDelete">@Shared["Delete"]</MudMenuItem>
    }
</MudMenu>

@code {
    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    [Parameter] public RenderFragment? Extra { get; set; }

    [Parameter] public string Class { get; set; } = "";
}
