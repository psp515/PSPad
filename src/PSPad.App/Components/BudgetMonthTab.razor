@using PSPad.App.State
@using PSPad.Module.Money.Entries
@using PSPad.Module.Money.Reading
@using PSPad.Module.Money.Values

<div class="@Class">
    <MoneyHero Class="mb-4" HeadlineClass="pspad-month-net" Label="Net" Text="@MoneyText.SignedPln(Totals.Net)" Negative="@(Totals.Net < 0)">
        <ChildContent>
            <MoneyFigure Class="pspad-month-income" Label="Income" Text="@MoneyText.Pln(Totals.Income)" />
            <MoneyFigure Class="pspad-month-expenses" Label="Expenses" Text="@MoneyText.Pln(Totals.Expenses)" />
        </ChildContent>
        <Footer>
            @if (Totals.ExpensesByCategory.Count > 0)
            {
                <CategoryBar Totals="@Totals.ExpensesByCategory" />
            }
        </Footer>
    </MoneyHero>

    @if (Totals.Days.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="pspad-muted pspad-month-empty">No entries in @MoneyText.MonthTitle(Month).</MudText>
    }
    else
    {
        @foreach (var day in Totals.Days)
        {
            <MudPaper @key="day.Date" Outlined="true" Class="mb-3 pspad-entry-day">
                <MudText Typo="Typo.subtitle2" Class="px-4 pt-3">@MoneyText.Day(day.Date)</MudText>
                <MudList T="MoneyEntry" Dense="true">
                    @foreach (var entry in day.Entries)
                    {
                        <EntryRow @key="entry.Id" Entry="@entry" OnOpen="@OnOpen" />
                    }
                </MudList>
            </MudPaper>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public YearMonth Month { get; set; }

    [Parameter, EditorRequired] public MonthTotals Totals { get; set; } = default!;

    [Parameter] public EventCallback<MoneyEntry> OnOpen { get; set; }

    [Parameter] public string Class { get; set; } = "";
}
