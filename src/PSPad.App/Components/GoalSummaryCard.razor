@using PSPad.Module.Tasks.Goals
@using PSPad.Module.Tasks.Tasks

<MudPaper Elevation="0" Outlined="true" Class="@($"pspad-goal-summary pspad-goal-summary-{Kind} pa-4 d-flex gap-3")"
          role="button" tabindex="0" aria-label="@Goal.Name" @onclick="@OnOpen" @onkeydown="@OpenOnKeyAsync">
    <MudIcon Icon="@StatusIcon" Color="@StatusColor" Class="flex-shrink-0" />
    <div class="d-flex flex-column flex-grow-1" style="min-width:0">
        <MudText Typo="Typo.subtitle1" Class="pspad-goal-summary-name">@Goal.Name</MudText>
        @if (InProgress && Goal.DueOn is { } due)
        {
            <MudText Typo="Typo.caption" Class="@($"pspad-goal-summary-due {(Overdue ? "" : "pspad-muted")}")"
                     Color="@(Overdue ? Color.Error : Color.Inherit)">@($"Due {DueDateRow.Describe(due, Today)}")</MudText>
        }
        <MudText Typo="Typo.body2" Class="pspad-goal-summary-tasks pspad-muted">@TasksText</MudText>
        @if (InProgress && Total > 0)
        {
            <MudProgressLinear Value="@Done" Max="@Total" Color="Color.Primary" Rounded="true" Class="mt-2" />
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Goal Goal { get; set; } = null!;

    [Parameter] public IReadOnlyList<TodoTask> Tasks { get; set; } = [];

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public EventCallback OnOpen { get; set; }

    bool InProgress => Goal.Status == GoalStatus.InProgress;

    bool Overdue => InProgress && Goal.DueOn < Today;

    string Kind => Goal.Status switch
    {
        GoalStatus.Achieved => "achieved",
        GoalStatus.NotAchieved => "not-achieved",
        _ => "in-progress"
    };

    string StatusIcon => Goal.Status switch
    {
        GoalStatus.Achieved => Icons.Material.Outlined.EmojiEvents,
        GoalStatus.NotAchieved => Icons.Material.Outlined.HighlightOff,
        _ => Icons.Material.Outlined.Flag
    };

    Color StatusColor => Goal.Status switch
    {
        GoalStatus.Achieved => Color.Success,
        GoalStatus.NotAchieved => Color.Error,
        _ => Color.Primary
    };

    IReadOnlyList<TodoTask> Counted => [.. Tasks.Where(task => !task.Deleted)];

    int Total => Counted.Count;

    int Done => Counted.Count(task => task.CompletedAt is not null);

    string TasksText => Total == 0
        ? "No tasks linked"
        : $"{Done} of {Total} {(Total == 1 ? "task" : "tasks")} done";

    async Task OpenOnKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            await OnOpen.InvokeAsync();
        }
    }
}
