@using PSPad.App.State
@inject IStringLocalizer<SharedStrings> Shared

<MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <ActivatorContent Context="menu">
        @if (Value is { } day)
        {
            <MudButton Class="@Class" Variant="Variant.Text" Size="Size.Small" Disabled="@Disabled"
                       Color="@(day < Today ? Color.Error : Color.Default)"
                       StartIcon="@Icons.Material.Outlined.Event"
                       OnClick="@(args => menu.ToggleAsync(args))">@DueDayText.Describe(day, Today, Shared)</MudButton>
        }
        else
        {
            <MudIconButton Class="@($"{Class} pspad-step-action")" Icon="@Icons.Material.Outlined.Event" Size="Size.Small"
                           Disabled="@Disabled" aria-label="@EmptyLabel"
                           OnClick="@(args => menu.ToggleAsync(args))" />
        }
    </ActivatorContent>
    <ChildContent>
        <DueDateItems Value="@Value" Today="@Today" Clearable="@Clearable" OnChoose="@ChooseAsync"
                      OnPick="@(() => _picker?.Open())" />
    </ChildContent>
</MudMenu>

<DueDatePicker @ref="_picker" Value="@Value" Today="@Today" OnPicked="@ChooseAsync" />

@code {
    [Parameter] public DateOnly? Value { get; set; }

    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Clearable { get; set; }

    [Parameter] public string Class { get; set; } = "";

    [Parameter] public string EmptyLabel { get; set; } = "";

    DueDatePicker? _picker;

    async Task ChooseAsync(DateOnly? day)
    {
        if (Disabled)
        {
            return;
        }

        await ValueChanged.InvokeAsync(day);
    }
}
