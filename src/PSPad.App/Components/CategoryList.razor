@using PSPad.Module.Money.Budgets
@inject IStringLocalizer<BudgetsStrings> T
@inject IStringLocalizer<SharedStrings> Shared
<MudPaper Outlined="true" Class="@($"pa-4 pspad-category-list {Class}")" role="region" aria-label="@Title">
    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.subtitle2" Class="flex-grow-1">@Title</MudText>
        @if (!ReadOnly)
        {
            <MudButton Class="pspad-category-add" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text"
                       Color="Color.Primary" OnClick="@(() => _adding = true)">@T["Add"]</MudButton>
        }
    </div>
    <MudList T="string" Dense="true">
        @foreach (var name in Names)
        {
            var used = UsageOf(name);
            <MudListItem T="string" @key="name" Class="pspad-category-row">
                @if (_renaming == name)
                {
                    <MudTextField T="string" @bind-Value="_renameDraft" Immediate="true" AutoFocus="true" MaxLength="@CategoryName.MaxLength"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="pspad-category-rename-input"
                                  OnKeyDown="@(args => RenameKeyDownAsync(args, name))" />
                }
                else if (_merging == name)
                {
                    <div class="d-flex align-center gap-2">
                        <MudSelect T="string" Class="pspad-category-merge-target flex-grow-1" Label="@T["MergeInto", name]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ValueChanged="@(into => MergeAsync(name, into))">
                            @foreach (var other in Names.Where(other => other != name))
                            {
                                <MudSelectItem T="string" Value="@other">@other</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Class="pspad-category-merge-cancel" Variant="Variant.Text" OnClick="@StopEditing">@Shared["Cancel"]</MudButton>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center gap-1">
                        <button type="button" class="pspad-category-open" @onclick="@(() => OnOpen.InvokeAsync(name))">
                            <span class="pspad-category-name">@name</span>
                            @if (used > 0)
                            {
                                <span class="pspad-muted pspad-category-usage">@T.Plural(used, "CategoryEntries")</span>
                            }
                        </button>
                        @if (!ReadOnly)
                        {
                            <MudMenu Class="pspad-category-menu" Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                     AriaLabel="@T["ActionsFor", name]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <MudMenuItem Class="pspad-category-rename" Icon="@Icons.Material.Outlined.Edit"
                                             OnClick="@(() => StartRenaming(name))">@T["Rename"]</MudMenuItem>
                                <MudMenuItem Class="pspad-category-merge" Icon="@Icons.Material.Outlined.MergeType" Disabled="@(Names.Count < 2)"
                                             OnClick="@(() => StartMerging(name))">@T["Merge"]</MudMenuItem>
                                <MudMenuItem Class="pspad-category-remove" Icon="@Icons.Material.Outlined.Delete" Disabled="@(used > 0 || _busy)"
                                             OnClick="@(() => RemoveAsync(name))">@T["Remove"]</MudMenuItem>
                            </MudMenu>
                        }
                    </div>
                }
            </MudListItem>
        }
    </MudList>
    @if (_adding && !ReadOnly)
    {
        <MudTextField T="string" @bind-Value="_draft" Immediate="true" AutoFocus="true" Placeholder="@T["NewCategory"]" MaxLength="@CategoryName.MaxLength"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="pspad-category-input mt-2"
                      OnKeyDown="@KeyDownAsync" />
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public IReadOnlyList<string> Names { get; set; } = [];

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public string Class { get; set; } = "";

    [Parameter] public IReadOnlyDictionary<string, int> Usage { get; set; } = new Dictionary<string, int>();

    [Parameter] public EventCallback<string> OnOpen { get; set; }

    [Parameter] public Func<string, Task<bool>> OnAdd { get; set; } = _ => Task.FromResult(true);

    [Parameter] public Func<(string From, string To), Task<bool>> OnRename { get; set; } = _ => Task.FromResult(true);

    [Parameter] public Func<(string From, string Into), Task<bool>> OnMerge { get; set; } = _ => Task.FromResult(true);

    [Parameter] public Func<string, Task<bool>> OnRemove { get; set; } = _ => Task.FromResult(true);

    bool _adding;
    bool _busy;
    string _draft = "";
    string? _renaming;
    string _renameDraft = "";
    string? _merging;

    int UsageOf(string name) => Usage.TryGetValue(name, out var count) ? count : 0;

    void StartRenaming(string name)
    {
        _merging = null;
        _renaming = name;
        _renameDraft = name;
    }

    void StartMerging(string name)
    {
        _renaming = null;
        _merging = name;
    }

    void StopEditing()
    {
        _renaming = null;
        _merging = null;
        _renameDraft = "";
    }

    async Task RenameKeyDownAsync(KeyboardEventArgs args, string name)
    {
        if (args.Key == "Escape")
        {
            StopEditing();
            return;
        }

        if (args.Key != "Enter" || string.IsNullOrWhiteSpace(_renameDraft))
        {
            return;
        }

        if (_renameDraft.Trim() == name || await GuardedAsync(() => OnRename((name, _renameDraft))))
        {
            StopEditing();
        }
    }

    async Task MergeAsync(string name, string into)
    {
        if (await GuardedAsync(() => OnMerge((name, into))))
        {
            StopEditing();
        }
    }

    Task RemoveAsync(string name) => GuardedAsync(() => OnRemove(name));

    async Task<bool> GuardedAsync(Func<Task<bool>> action)
    {
        if (_busy)
        {
            return false;
        }

        _busy = true;
        try
        {
            return await action();
        }
        finally
        {
            _busy = false;
        }
    }

    async Task KeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _adding = false;
            _draft = "";
        }
        else if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_draft))
        {
            if (await GuardedAsync(() => OnAdd(_draft)))
            {
                _draft = "";
                _adding = false;
            }
        }
    }
}
