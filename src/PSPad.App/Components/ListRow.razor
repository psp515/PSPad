@using PSPad.App.State
@using PSPad.Module.Tasks.Lists

<PropertyRow Class="pspad-task-list" Icon="@Icons.Material.Outlined.Folder" Label="List"
             Value="@(PathOf(Value) ?? "No list")" HasValue="@(PathOf(Value) is not null)" Disabled="@Disabled">
    @if (Lists.Count == 0)
    {
        <MudMenuItem Disabled="true">No lists yet</MudMenuItem>
    }
    @foreach (var areaId in AreaIds())
    {
        <MudText Typo="Typo.overline" Class="px-4 pt-2 d-block">@Placement.AreaName(areaId)</MudText>
        @foreach (var list in Lists.Where(list => Placement.AreaOf(list) == areaId))
        {
            <MudMenuItem Class="pspad-list-option" OnClick="@(() => ValueChanged.InvokeAsync(list.Id))"
                         Icon="@(list.Id == Value ? Icons.Material.Filled.Check : null)">
                @list.Name
            </MudMenuItem>
        }
    }
</PropertyRow>

@code {
    [Parameter] public ListPlacement Placement { get; set; } = ListPlacement.Empty;

    [Parameter] public IReadOnlyList<TaskList> Lists { get; set; } = [];

    [Parameter] public Guid? Value { get; set; }

    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    public static string? PathOf(Guid? listId, ListPlacement placement, IReadOnlyList<TaskList> lists)
    {
        var list = lists.FirstOrDefault(list => list.Id == listId);
        return list is null ? null : $"{placement.AreaName(placement.AreaOf(list))} › {list.Name}";
    }

    string? PathOf(Guid? listId) => PathOf(listId, Placement, Lists);

    IEnumerable<Guid> AreaIds() => Lists.Select(list => Placement.AreaOf(list)).Distinct();
}
