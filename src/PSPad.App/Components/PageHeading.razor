@using PSPad.App.State
@inject PageHeader Header
@inject IStringLocalizer<SharedStrings> Shared

@if (Title.Length > 0)
{
    <div class="d-none d-md-flex align-center mb-5 pspad-page-heading">
        @if (BackHref is not null)
        {
            <MudIconButton Class="@BackClass" Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary"
                           Href="@BackHref" aria-label="@EffectiveBackLabel" />
        }
        @if (Icon is not null)
        {
            <PageIcon Icon="@Icon" />
        }
        <div class="pspad-page-heading-text d-flex flex-column" style="min-width:0">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="pspad-page-title">@Title@if (IconLabel is not null){<span class="pspad-sr-only"> @IconLabel</span>}</MudText>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <MudText Typo="Typo.body2" Class="pspad-page-subtitle pspad-muted">@Subtitle</MudText>
            }
        </div>
        <MudSpacer />
        <SyncStamp />
        <SyncButton />
        @Actions
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? BackHref { get; set; }

    [Parameter] public string? BackLabel { get; set; }

    [Parameter] public string? BackClass { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public string? IconLabel { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    string EffectiveBackLabel => BackLabel ?? Shared["Back"].Value;

    protected override void OnParametersSet() => Header.Set(Title, Subtitle, BackHref, EffectiveBackLabel, Icon, Actions);
}
