@using PSPad.Module.Tasks.Tasks
@inject IStringLocalizer<TasksStrings> T
@inject IStringLocalizer<SharedStrings> Shared

<PropertyRow Class="pspad-task-lead" Icon="@Icons.Material.Outlined.NotificationsNone" Label="@T["RemindMe"]"
             Value="@Describe(Value, T)" HasValue="@(Value is not null)" Disabled="@Disabled"
             OnClear="@(() => ChooseAsync(null))">
    <MudText Typo="Typo.caption" Class="pspad-lead-hint pspad-muted d-block px-4 pt-2 pb-1" Style="max-width:260px">
        @T["LeadHint"]
    </MudText>
    @foreach (var preset in Presets)
    {
        <MudMenuItem Class="pspad-lead-option" OnClick="@(() => ChooseAsync(preset))">@Describe(preset, T)</MudMenuItem>
    }
    <MudDivider />
    <MudMenuItem Class="pspad-lead-custom" Icon="@Icons.Material.Outlined.Tune" OnClick="@OpenCustom">@T["CustomEllipsis"]</MudMenuItem>
</PropertyRow>

<MudDialog @bind-Visible="_customising" Class="pspad-lead-dialog" Options="@CustomOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@T["RemindMe"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Class="pspad-lead-hint pspad-muted d-block mb-3">@T["LeadHint"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudNumericField T="int" Class="pspad-lead-amount" @bind-Value="_amount" Min="1" Max="99"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:96px" />
            <MudSelect T="LeadUnit" Class="pspad-lead-unit" @bind-Value="_unit"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var unit in Units)
                {
                    <MudSelectItem T="LeadUnit" Value="@unit">@UnitLabel(unit, _amount, T)</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.body2">@T["LeadBefore"]</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Class="pspad-lead-cancel" OnClick="@(() => _customising = false)">@Shared["Cancel"]</MudButton>
        <MudButton Class="pspad-lead-save" Color="Color.Primary" Disabled="@(!CanSave)"
                   OnClick="@SaveCustomAsync">@Shared["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public LeadTime? Value { get; set; }

    [Parameter] public EventCallback<LeadTime?> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    bool _customising;
    int _amount = 1;
    LeadUnit _unit = LeadUnit.Days;

    static readonly DialogOptions CustomOptions = new() { CloseOnEscapeKey = true, BackdropClick = true };

    static readonly LeadTime[] Presets =
    [
        new(1, LeadUnit.Days), new(3, LeadUnit.Days), new(1, LeadUnit.Weeks), new(2, LeadUnit.Weeks),
        new(1, LeadUnit.Months)
    ];

    static readonly LeadUnit[] Units = [LeadUnit.Days, LeadUnit.Weeks, LeadUnit.Months];

    static readonly LeadTime DefaultLookAhead = new(1, LeadUnit.Weeks);

    bool CanSave => _amount is >= 1 and <= 99;

    public static string Describe(LeadTime? lead, IStringLocalizer<TasksStrings> localizer)
    {
        var shown = lead ?? DefaultLookAhead;
        return localizer.Plural(shown.Amount, shown.Unit switch
        {
            LeadUnit.Weeks => "LeadWeeks",
            LeadUnit.Months => "LeadMonths",
            _ => "LeadDays"
        });
    }

    public static string UnitLabel(LeadUnit unit, int amount, IStringLocalizer<TasksStrings> localizer) =>
        localizer.Plural(amount, unit switch
        {
            LeadUnit.Weeks => "UnitWeeks",
            LeadUnit.Months => "UnitMonths",
            _ => "UnitDays"
        });

    void OpenCustom()
    {
        if (Disabled)
        {
            return;
        }

        _amount = Value?.Amount ?? 1;
        _unit = Value?.Unit ?? LeadUnit.Days;
        _customising = true;
    }

    async Task SaveCustomAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _customising = false;
        await ChooseAsync(LeadTime.Of(_amount, _unit));
    }

    async Task ChooseAsync(LeadTime? lead)
    {
        if (Disabled || lead == Value)
        {
            return;
        }

        await ValueChanged.InvokeAsync(lead);
    }
}
