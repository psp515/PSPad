@using PSPad.App.State
@using PSPad.Module.Tasks.Tasks
@inject IStringLocalizer<TasksStrings> T

<div class="@($"pspad-property-row pspad-task-time pspad-task-reminder d-flex align-start {(Dormant ? "pspad-reminder-dormant" : "")}")">
    <div class="pspad-time-head d-flex align-center flex-shrink-0">
        <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Small" Class="pspad-time-icon mr-3" />
        <MudText Typo="Typo.body2" Class="pspad-property-label">@T["RemindMe"]</MudText>
    </div>
    <div class="pspad-time-lines d-flex flex-column flex-grow-1">
        @if (_current is null)
        {
            <div class="pspad-time-line pspad-reminder-off-line d-flex align-center">
                <MudText Typo="Typo.body2" Class="pspad-reminder-off pspad-muted">@T["ReminderOff"]</MudText>
            </div>
        }
        else
        {
            <div class="pspad-time-line d-flex align-center">
                <span class="pspad-time-line-label">@T["ReminderDaysUnit"]</span>
                <MudTextField T="string" Class="pspad-reminder-days pspad-time-input" aria-label="@T["ReminderDaysLabel"].Value"
                              InputMode="InputMode.numeric" Value="@DaysText" ValueChanged="@DaysTypedAsync"
                              Error="@(_daysDraft is not null)" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Disabled"
                              Adornment="Adornment.End" AdornmentText="@T["ReminderBefore"]" />
                @if (!Disabled)
                {
                    <MudIconButton Class="pspad-property-clear pspad-reminder-clear" Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   aria-label="@T["ClearProperty", T["RemindMe"].Value.ToLower()].Value" OnClick="@(() => SendAsync(null))" />
                }
                else
                {
                    <span class="pspad-time-clear-placeholder" aria-hidden="true"></span>
                }
            </div>
            <div class="pspad-time-line pspad-time-line-end d-flex align-center">
                <span class="pspad-time-line-label">@T["ReminderAt"]</span>
                <TimeField Class="pspad-reminder-time" Label="@T["ReminderTimeLabel"]" ClockLabel="@T["PickReminderTime"]"
                           Value="@_current.At" ValueChanged="@AtChangedAsync" InvalidChanged="@(invalid => _timeInvalid = invalid)"
                           Disabled="@Disabled" />
            </div>
        }
        <MudToggleGroup @key="@_current?.DaysBefore" T="int?" Value="@_current?.DaysBefore" ValueChanged="@QuickAsync" Class="pspad-reminder-quick"
                        Color="Color.Primary" Outlined="true" Size="Size.Small" Disabled="@Disabled">
            @foreach (var days in ReminderText.QuickDays)
            {
                <MudToggleItem T="int?" Value="@days" Text="@ReminderText.Quick(days, T)" />
            }
        </MudToggleGroup>
    </div>
</div>

@if (_daysDraft is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="pspad-reminder-note d-block" role="alert">@T["ReminderDaysHint"]</MudText>
}
else if (_timeInvalid)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="pspad-reminder-note d-block" role="alert">@T["TimeFormatHint"]</MudText>
}

@if (Dormant)
{
    <MudText Typo="Typo.caption" Class="pspad-reminder-note pspad-muted d-block" role="status">@T["ReminderNeedsDueDate"]</MudText>
}

@if (Repeats)
{
    <MudText Typo="Typo.caption" Class="pspad-reminder-note pspad-muted d-block">@T["ReminderEachOccurrence"]</MudText>
}

@if (DeviceOff && _current is not null)
{
    <MudLink Href="settings#notifications" Typo="Typo.caption" Class="pspad-reminder-device-off d-block">@T["ReminderDeviceOff"]</MudLink>
}

@code {
    [Parameter] public TaskReminder? Value { get; set; }

    [Parameter] public EventCallback<TaskReminder?> ValueChanged { get; set; }

    [Parameter] public TaskTime? Time { get; set; }

    [Parameter] public bool Repeats { get; set; }

    [Parameter] public bool Dormant { get; set; }

    [Parameter] public bool DeviceOff { get; set; }

    [Parameter] public bool Disabled { get; set; }

    TaskReminder? _shown;

    TaskReminder? _current;

    string? _daysDraft;

    bool _timeInvalid;

    string DaysText => _daysDraft ?? _current?.DaysBefore.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    protected override void OnParametersSet()
    {
        if (_shown != Value)
        {
            _shown = Value;
            _current = Value;
            _daysDraft = null;
            _timeInvalid = false;
        }
    }

    Task DaysTypedAsync(string? text)
    {
        if (!ReminderText.TryParseDays(text, out var days))
        {
            _daysDraft = text;
            return Task.CompletedTask;
        }

        _daysDraft = null;
        return SendAsync(ReminderText.WithDays(_current, days, Time));
    }

    Task QuickAsync(int? days) =>
        days is { } chosen ? SendAsync(ReminderText.WithDays(_current, chosen, Time)) : Task.CompletedTask;

    Task AtChangedAsync(TimeOnly? at) =>
        at is { } time ? SendAsync(ReminderText.WithAt(_current, time)) : MarkTimeInvalid();

    Task MarkTimeInvalid()
    {
        _timeInvalid = true;
        return Task.CompletedTask;
    }

    async Task SendAsync(TaskReminder? reminder)
    {
        if (Disabled || reminder == _current)
        {
            return;
        }

        _current = reminder;
        await ValueChanged.InvokeAsync(reminder);
    }
}
