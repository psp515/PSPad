@using System.Globalization
@using PSPad.Module.Tasks.Recurrence
@using PSPad.Module.Tasks.Tasks
@inject IStringLocalizer<TasksStrings> T
@inject IStringLocalizer<SharedStrings> Shared

<PropertyRow Class="pspad-task-repeat" Icon="@Icons.Material.Outlined.Repeat" Label="@T["Repeat"]"
             Value="@Describe(Value, T)" HasValue="@(Value is not null)" Disabled="@Disabled">
    <MudMenuItem Class="pspad-repeat-option" OnClick="@(() => ChooseAsync(RecurrenceRule.Daily(Today)))">@T["RepeatDaily"]</MudMenuItem>
    <MudMenuItem Class="pspad-repeat-option" OnClick="@(() => ChooseAsync(Weekdays(Today)))">@T["RepeatWeekdays"]</MudMenuItem>
    <MudMenuItem Class="pspad-repeat-option" OnClick="@(() => ChooseAsync(RecurrenceRule.Weekly(Today, Today.DayOfWeek)))">
        @T["RepeatWeeklyOn", Today.ToString("dddd")]
    </MudMenuItem>
    <MudMenuItem Class="pspad-repeat-option" OnClick="@(() => ChooseAsync(RecurrenceRule.MonthlyOnDay(Today, Today.Day)))">
        @T["RepeatMonthlyOnDay", Today.Day]
    </MudMenuItem>
    <MudMenuItem Class="pspad-repeat-option" OnClick="@(() => ChooseAsync(RecurrenceRule.Yearly(Today)))">
        @T["RepeatYearlyOn", YearlyDay(Today)]
    </MudMenuItem>
    <MudMenuItem Class="pspad-repeat-custom" Icon="@Icons.Material.Outlined.Tune" OnClick="@OpenCustom">@T["CustomEllipsis"]</MudMenuItem>
</PropertyRow>

@if (Task?.Recurrence is not null)
{
    <div class="d-flex flex-wrap gap-1 px-3 pb-2 pspad-repeat-history">
        @foreach (var occurrence in Occurrences.Between(Task, Today.AddDays(-6), Today, Today))
        {
            <MudTooltip Text="@($"{occurrence.Day:ddd, d MMM}: {Label(occurrence.Status)}")">
                <MudChip T="string" Size="Size.Small" Class="ma-0 repeat-day" Variant="Variant.Outlined"
                         Color="@ColorOf(occurrence.Status)">
                    @($"{occurrence.Day:ddd} · {Label(occurrence.Status)}")
                </MudChip>
            </MudTooltip>
        }
    </div>
    <MudText Typo="Typo.caption" Class="px-3 pb-2 pspad-muted pspad-repeat-tally">
        @DescribeTally(RepeatTally.Of(Task, Today), T)
    </MudText>
}

<MudDialog @bind-Visible="_customising" Class="pspad-repeat-dialog" Options="@CustomOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@T["CustomRepeat"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.body2">@T["RepeatEvery"]</MudText>
                <MudNumericField T="int" Class="pspad-repeat-every" @bind-Value="_every" Min="1" Max="99"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:96px" />
                <MudSelect T="RecurrenceKind" Class="pspad-repeat-unit" @bind-Value="_kind"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var kind in Units)
                    {
                        <MudSelectItem T="RecurrenceKind" Value="@kind">@UnitLabel(kind, _every, T)</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (_kind == RecurrenceKind.Weekly)
            {
                <MudChipSet T="DayOfWeek" Class="pspad-repeat-weekdays" @bind-SelectedValues="Days"
                            SelectionMode="SelectionMode.MultiSelection" Size="Size.Small" Variant="Variant.Outlined"
                            SelectedColor="Color.Primary">
                    @foreach (var day in WeekOrder)
                    {
                        <MudChip T="DayOfWeek" Value="@day" Text="@AbbreviatedDay(day)" />
                    }
                </MudChipSet>
            }
            else if (_kind == RecurrenceKind.MonthlyOnDay)
            {
                <MudNumericField T="int" Class="pspad-repeat-day" @bind-Value="DayOfMonth" Min="1" Max="31"
                                 Label="@T["RepeatOnDay"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }

            <MudDatePicker Class="pspad-repeat-start" Label="@T["RepeatStarts"]" @bind-Date="Start"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Class="pspad-repeat-cancel" OnClick="@(() => _customising = false)">@Shared["Cancel"]</MudButton>
        <MudButton Class="pspad-repeat-save" Color="Color.Primary" Disabled="@(!CanSaveCustom)"
                   OnClick="@SaveCustomAsync">@Shared["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public RecurrenceRule? Value { get; set; }

    [Parameter] public EventCallback<RecurrenceRule?> ValueChanged { get; set; }

    [Parameter] public TodoTask? Task { get; set; }

    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public bool Disabled { get; set; }

    bool _customising;
    int _every = 1;
    RecurrenceKind _kind = RecurrenceKind.Daily;
    IReadOnlyCollection<DayOfWeek>? _days;
    int _dayOfMonth = 1;
    DateTime? _start;
    bool _daysPicked;
    bool _dayOfMonthPicked;

    IReadOnlyCollection<DayOfWeek>? Days
    {
        get => _days;
        set
        {
            _days = value;
            _daysPicked = true;
        }
    }

    int DayOfMonth
    {
        get => _dayOfMonth;
        set
        {
            _dayOfMonth = value;
            _dayOfMonthPicked = true;
        }
    }

    DateTime? Start
    {
        get => _start;
        set
        {
            _start = value;
            if (value is not { } start)
            {
                return;
            }

            if (!_daysPicked)
            {
                _days = [start.DayOfWeek];
            }

            if (!_dayOfMonthPicked)
            {
                _dayOfMonth = start.Day;
            }
        }
    }

    static readonly DialogOptions CustomOptions = new() { CloseOnEscapeKey = true, BackdropClick = true };

    static readonly RecurrenceKind[] Units =
        [RecurrenceKind.Daily, RecurrenceKind.Weekly, RecurrenceKind.MonthlyOnDay, RecurrenceKind.Yearly];

    static readonly DayOfWeek[] WeekOrder =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday,
        DayOfWeek.Saturday, DayOfWeek.Sunday
    ];

    bool CanSaveCustom => _every is >= 1 and <= 99 && _start is not null
        && (_kind != RecurrenceKind.Weekly || _days is { Count: > 0 })
        && (_kind != RecurrenceKind.MonthlyOnDay || _dayOfMonth is >= 1 and <= 31);

    static RecurrenceRule Weekdays(DateOnly today) => RecurrenceRule.Weekly(
        today, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday);

    public static string Describe(RecurrenceRule? rule, IStringLocalizer<TasksStrings> localizer) => rule switch
    {
        null => localizer["RepeatNever"],
        { Every: > 1 } r => DescribeInterval(r, localizer),
        { Kind: RecurrenceKind.Daily } => localizer["RepeatDaily"],
        { Kind: RecurrenceKind.Weekly, Days.Count: 5 } r when !r.Days.Contains(DayOfWeek.Saturday)
            && !r.Days.Contains(DayOfWeek.Sunday) => localizer["RepeatWeekdays"],
        { Kind: RecurrenceKind.Weekly } r => localizer["RepeatWeeklyOn", DayList(r)],
        { Kind: RecurrenceKind.MonthlyOnDay } r => localizer["RepeatMonthlyOnDay", r.DayOfMonth],
        { Kind: RecurrenceKind.Yearly } r => localizer["RepeatYearlyOn", YearlyDay(r.StartsOn)],
        _ => localizer["RepeatCustom"]
    };

    public static string DescribeTally(RepeatTally tally, IStringLocalizer<TasksStrings> localizer) => tally switch
    {
        { Total: 0 } => localizer["TallyNone"],
        { Streak: 0 } t => localizer.Plural(t.Total, "DoneTimes"),
        var t => localizer.Plural(t.Total, "DoneTimesStreak", t.Streak)
    };

    static string DescribeInterval(RecurrenceRule rule, IStringLocalizer<TasksStrings> localizer) => rule.Kind switch
    {
        RecurrenceKind.Daily => localizer.Plural(rule.Every, "EveryDays"),
        RecurrenceKind.Weekly => localizer.Plural(rule.Every, "EveryWeeks", DayList(rule)),
        RecurrenceKind.MonthlyOnDay => localizer.Plural(rule.Every, "EveryMonths", rule.DayOfMonth),
        RecurrenceKind.Yearly => localizer.Plural(rule.Every, "EveryYears", YearlyDay(rule.StartsOn)),
        _ => localizer["RepeatCustom"]
    };

    static string YearlyDay(DateOnly day) => day.ToString("d MMM");

    static string AbbreviatedDay(DayOfWeek day) => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day);

    static string DayList(RecurrenceRule rule) =>
        string.Join(", ", rule.Days.OrderBy(day => ((int)day + 6) % 7).Select(AbbreviatedDay));

    public static string UnitLabel(RecurrenceKind kind, int every, IStringLocalizer<TasksStrings> localizer) =>
        localizer.Plural(every, kind switch
        {
            RecurrenceKind.Daily => "UnitDays",
            RecurrenceKind.Weekly => "UnitWeeks",
            RecurrenceKind.Yearly => "UnitYears",
            _ => "UnitMonths"
        });

    string Label(OccurrenceStatus status) => status switch
    {
        OccurrenceStatus.Done => Shared["Done"],
        OccurrenceStatus.Pending => T["OccurrencePending"],
        _ => T["OccurrenceSkipped"]
    };

    static Color ColorOf(OccurrenceStatus status) => status switch
    {
        OccurrenceStatus.Done => Color.Primary,
        OccurrenceStatus.Pending => Color.Default,
        _ => Color.Secondary
    };

    void OpenCustom()
    {
        if (Disabled)
        {
            return;
        }

        var start = Value?.StartsOn ?? Today;
        _every = Value?.Every ?? 1;
        _kind = Value?.Kind ?? RecurrenceKind.Daily;
        _days = Value is { Kind: RecurrenceKind.Weekly } weekly ? [.. weekly.Days] : [start.DayOfWeek];
        _dayOfMonth = Value is { Kind: RecurrenceKind.MonthlyOnDay } monthly ? monthly.DayOfMonth : start.Day;
        _start = start.ToDateTime(TimeOnly.MinValue);
        _daysPicked = Value is { Kind: RecurrenceKind.Weekly };
        _dayOfMonthPicked = Value is { Kind: RecurrenceKind.MonthlyOnDay };
        _customising = true;
    }

    async System.Threading.Tasks.Task SaveCustomAsync()
    {
        if (!CanSaveCustom)
        {
            return;
        }

        var start = DateOnly.FromDateTime(_start!.Value);
        var rule = _kind switch
        {
            RecurrenceKind.Weekly => RecurrenceRule.Weekly(start, [.. _days!]),
            RecurrenceKind.MonthlyOnDay => RecurrenceRule.MonthlyOnDay(start, _dayOfMonth),
            RecurrenceKind.Yearly => RecurrenceRule.Yearly(start),
            _ => RecurrenceRule.Daily(start)
        };

        _customising = false;
        await ChooseAsync(rule.EveryNth(_every));
    }

    async System.Threading.Tasks.Task ChooseAsync(RecurrenceRule? rule)
    {
        if (Disabled || (rule is null && Value is null))
        {
            return;
        }

        await ValueChanged.InvokeAsync(rule);
    }
}
