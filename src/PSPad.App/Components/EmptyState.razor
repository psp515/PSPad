<MudPaper Outlined="true" Class="@($"pspad-empty-state pa-4 d-flex flex-column align-center gap-2 {(Clickable ? "pspad-empty-state-clickable" : "")}")"
          role="@(Clickable ? "button" : null)" tabindex="@(Clickable ? "0" : null)"
          aria-label="@(Clickable ? CreateText : null)"
          @onclick="@CreateAsync" @onkeydown="@KeyAsync">
    <MudIcon Icon="@Icon" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.body2" Align="Align.Center">@Message</MudText>
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Inbox;

    [Parameter, EditorRequired] public string Message { get; set; } = "";

    [Parameter] public string CreateText { get; set; } = "Create";

    [Parameter] public EventCallback OnCreate { get; set; }

    bool Clickable => OnCreate.HasDelegate;

    async Task CreateAsync()
    {
        if (Clickable)
        {
            await OnCreate.InvokeAsync();
        }
    }

    async Task KeyAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            await CreateAsync();
        }
    }
}
