@using PSPad.Module.Tasks.Goals
@inject IStringLocalizer<GoalsStrings> T

<PropertyRow Class="pspad-task-goal" Icon="@Icons.Material.Outlined.TrackChanges" Label="@T["Goal"]"
             Value="@(Name ?? T["NoGoal"].Value)" HasValue="@(Name is not null)" Disabled="@Disabled"
             OnClear="@(() => ValueChanged.InvokeAsync(null))">
    @if (Options.Count == 0)
    {
        <MudMenuItem Disabled="true">@T["NoGoalsInProgress"]</MudMenuItem>
    }
    @foreach (var goal in Options)
    {
        <MudMenuItem Class="pspad-goal-option" OnClick="@(() => ValueChanged.InvokeAsync(goal.Id))">@goal.Name</MudMenuItem>
    }
</PropertyRow>

@code {
    [Parameter] public IReadOnlyList<Goal> Goals { get; set; } = [];

    [Parameter] public Guid? Value { get; set; }

    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    IReadOnlyList<Goal> Options => [.. Goals.Where(goal => goal.Status == GoalStatus.InProgress)];

    string? Name => Goals.FirstOrDefault(goal => goal.Id == Value)?.Name;
}
