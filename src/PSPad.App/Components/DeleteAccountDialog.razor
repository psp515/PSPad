@using System.Net
@using PSPad.App.Api
@using PSPad.App.Auth
@inject IStringLocalizer<SettingsStrings> T
@inject IStringLocalizer<SharedStrings> S
<MudDialog>
    <DialogContent>
        @if (_keycloakOrphaned)
        {
            <MudText Typo="Typo.body1" Class="pspad-delete-partial">
                @T["DeleteDataGone"]
            </MudText>
        }
        else if (_reauthenticate)
        {
            <MudText Typo="Typo.body1">
                @T["DeleteNeedsFreshSignIn"]
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="mb-3">
                @((MarkupString)T["DeleteConfirm", WebUtility.HtmlEncode(Email)].Value)
            </MudText>
            <MudTextField T="string" @bind-Value="_confirmation" Label="@T["Email"]" Immediate="true"
                          AutoFocus="true" Disabled="@_deleting" Class="pspad-confirm-email" />
            @if (_error)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">
                    @T["DeleteFailed"]
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_keycloakOrphaned)
        {
            <MudButton Class="pspad-confirm-delete" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="@(() => Dialog.Close(DialogResult.Ok(true)))">
                @S["Continue"]
            </MudButton>
        }
        else if (_reauthenticate)
        {
            <MudButton OnClick="@Cancel">@S["Cancel"]</MudButton>
            <MudButton Class="pspad-reauthenticate" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="@SignInAgain">
                @T["SignInAgain"]
            </MudButton>
        }
        else
        {
            <MudButton OnClick="@Cancel" Disabled="@_deleting">@S["Cancel"]</MudButton>
            <MudButton Class="pspad-confirm-delete" Color="Color.Error" Variant="Variant.Filled"
                       OnClick="@DeleteAsync" Disabled="@(!Confirmed || _deleting)">
                @(_deleting ? T["Deleting"] : T["DeleteAccount"])
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string Email { get; set; } = "";

    [Inject] PSPadApiClient Api { get; set; } = null!;

    [Inject] NavigationManager Navigation { get; set; } = null!;

    string _confirmation = "";
    bool _deleting;
    bool _error;
    bool _keycloakOrphaned;
    bool _reauthenticate;

    bool Confirmed => Email.Length > 0 && string.Equals(_confirmation.Trim(), Email, StringComparison.OrdinalIgnoreCase);

    async Task DeleteAsync()
    {
        _deleting = true;
        _error = false;

        switch (await Api.DeleteAccountAsync())
        {
            case AccountDeletionOutcome.Deleted { KeycloakRemoved: true }:
                Dialog.Close(DialogResult.Ok(true));
                return;
            case AccountDeletionOutcome.Deleted:
                _deleting = false;
                _keycloakOrphaned = true;
                return;
            case AccountDeletionOutcome.ReauthenticationRequired:
                _deleting = false;
                _reauthenticate = true;
                return;
            default:
                _deleting = false;
                _error = true;
                return;
        }
    }

    void SignInAgain() => StepUpSignIn.Begin(Navigation, StepUpSignIn.DeleteAccountReturn);

    void Cancel() => Dialog.Cancel();
}
