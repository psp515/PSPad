@using PSPad.Abstractions
@using PSPad.App.State
@using PSPad.App.Api
@using PSPad.App.State.Dispatch
@using PSPad.App.Sync
@using PSPad.Module.Presentation.ListViews
@using PSPad.Module.Tasks.Areas
@using PSPad.Module.Tasks.Lists
@inject IDocumentStore<TaskList> Lists
@inject IDocumentStore<Area> Areas
@inject IDocumentStore<ListView> ListViews
@inject AppState State
@inject CommandSender Sender
@inject IListSharingApi Sharing
@inject ISyncTrigger SyncTrigger
@inject IConnectivity Connectivity
@inject ISnackbar Snackbar
@implements IDisposable
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IClock Clock
@inject IStringLocalizer<SharingStrings> T

<div class="pspad-list-members d-flex flex-column gap-3">
    @if (!Connectivity.IsOnline)
    {
        <MudAlert Class="pspad-share-offline" Severity="Severity.Info" Dense="true">@T["SharingNeedsConnection"]</MudAlert>
    }
    @if (IsMine)
    {
        <InviteLinkCard List="@_list" Disabled="@Locked" OnChanged="@ReloadAsync" />
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4 d-flex align-center gap-3">
            <MudAvatar Color="Color.Primary">@AvatarColor.InitialsOf(_list.OwnerName)</MudAvatar>
            <div class="flex-grow-1">
                <MudText Typo="Typo.caption" Class="pspad-muted d-block">@T["SharedByLabel"]</MudText>
                <MudText Typo="Typo.subtitle1" Class="pspad-share-owner">@_list.OwnerName</MudText>
            </div>
            <MudChip T="string" Class="ma-0" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@T["YouCanEdit"]</MudChip>
        </MudPaper>
    }

    <SharePeople OwnerIsMe="@IsMine" OwnerName="@(_list.OwnerName ?? "")" Disabled="@Locked" OnRemove="@RemoveMemberAsync"
                 Members="@([.. _list.Members.Select(member => new SharePerson(member.UserId, member.DisplayName, member.JoinedAt))])" />

    @if (IsMine)
    {
        @if (_list.Members.Count > 0 || _list.IsInviteLiveAt(Clock.UtcNow))
        {
            <MudButton Class="pspad-share-stop align-self-start" Variant="Variant.Text" Color="Color.Error"
                       Disabled="@Locked" OnClick="@StopSharingAsync">
                @T["StopSharingEveryone"]
            </MudButton>
        }
    }
    else
    {
        <MudSelect T="Guid?" Class="pspad-list-filed-area" Label="@T["ShowInMyArea"]" Variant="Variant.Outlined"
                   Value="@_filedAreaId" ValueChanged="@FileUnderAsync" Disabled="@Disabled"
                   ToStringFunc="@FiledAreaName" AnchorOrigin="Origin.BottomCenter">
            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@SharedWithMe.Name</MudSelectItem>
            @foreach (var area in _areas)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)area.Id)">@area.Name</MudSelectItem>
            }
        </MudSelect>

        <MudButton Class="pspad-share-leave align-self-start" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Outlined.Logout" Disabled="@Locked" OnClick="@LeaveAsync">
            @T["LeaveList"]
        </MudButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public TaskList List { get; set; } = null!;

    [Parameter] public bool IsMine { get; set; }

    [Parameter] public bool Disabled { get; set; }

    bool Locked => Disabled || !Connectivity.IsOnline;

    TaskList? _source;
    TaskList _list = null!;
    IReadOnlyList<Area> _areas = [];
    Guid? _filedAreaId;

    protected override void OnInitialized() => Connectivity.Changed += OnConnectivityChanged;

    void OnConnectivityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Connectivity.Changed -= OnConnectivityChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_source, List))
        {
            return;
        }

        _source = List;
        _list = List;

        if (IsMine)
        {
            return;
        }

        var areas = await Areas.LoadAllAsync(State.UserId, CancellationToken.None);
        _areas = [.. areas.Where(area => !area.Deleted).OrderBy(area => area.Position)];
        var view = await ListViews.LoadAsync(ListView.IdFor(State.UserId, _list.Id), CancellationToken.None);
        _filedAreaId = view?.AreaId;
    }

    string FiledAreaName(Guid? areaId) =>
        areaId is null ? SharedWithMe.Name : _areas.FirstOrDefault(area => area.Id == areaId)?.Name ?? "";

    async Task FileUnderAsync(Guid? areaId)
    {
        if (Disabled || areaId == _filedAreaId)
        {
            return;
        }

        await Sender.SendAsync(new PlaceList(Guid.NewGuid(), State.UserId, _list.Id, areaId));
        _filedAreaId = areaId;
    }

    async Task StopSharingAsync()
    {
        if (Locked)
        {
            return;
        }

        if (!await ConfirmAsync(
            T["StopSharing"],
            T["StopSharingMessage", _list.Name],
            T["StopSharing"]))
        {
            return;
        }

        if (_list.InviteToken is not null && !await SucceededAsync(Sharing.StopSharingAsync(_list.Id)))
        {
            return;
        }

        foreach (var member in _list.Members.ToList())
        {
            if (!await SucceededAsync(Sharing.RemoveMemberAsync(_list.Id, member.UserId)))
            {
                break;
            }
        }

        await SyncTrigger.SyncNowAsync();
        await ReloadAsync();
    }

    async Task RemoveMemberAsync(SharePerson member)
    {
        if (Locked)
        {
            return;
        }

        if (!await ConfirmAsync(
            T["RemoveMember"], T["RemoveMemberFromList", member.DisplayName], T["Remove"]))
        {
            return;
        }

        if (await SucceededAsync(Sharing.RemoveMemberAsync(_list.Id, member.UserId)))
        {
            await SyncTrigger.SyncNowAsync();
            await ReloadAsync();
        }
    }

    async Task LeaveAsync()
    {
        if (Locked)
        {
            return;
        }

        if (!await ConfirmAsync(
            T["LeaveList"], T["LeaveListMessage", _list.Name], T["Leave"]))
        {
            return;
        }

        if (!await SucceededAsync(Sharing.LeaveListAsync(_list.Id)))
        {
            return;
        }

        await SyncTrigger.SyncNowAsync();
        Navigation.NavigateTo(AreaLinks.For(SharedWithMe.AreaId));
    }

    async Task<bool> SucceededAsync(Task<string?> change)
    {
        if (await change is not { } rejection)
        {
            return true;
        }

        Snackbar.Add(rejection, Severity.Error);
        return false;
    }

    async Task<bool> ConfirmAsync(string title, string message, string confirmText)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message },
            { dialog => dialog.ConfirmText, confirmText }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    async Task ReloadAsync()
    {
        var reloaded = await Lists.LoadAsync(_list.Id, CancellationToken.None);

        if (reloaded is not null)
        {
            _list = reloaded;
        }
    }
}
