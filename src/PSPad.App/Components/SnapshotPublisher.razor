@using PSPad.Abstractions
@using PSPad.App.Api
@using PSPad.App.State
@using PSPad.App.Sync
@using PSPad.Contracts
@using PSPad.Module.Tasks.Lists
@inject ISnapshotsApi Snapshots
@inject ISyncTrigger SyncTrigger
@inject IConnectivity Connectivity
@inject IClock Clock
@inject AppState State
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Clipboard Clipboard
@inject NavigationManager Navigation
@inject IStringLocalizer<SharingStrings> T

<div class="d-flex flex-column gap-3 pspad-snapshot-publisher">
    <MudPaper Outlined="true" Class="pa-4 d-flex flex-column gap-2">
        <MudText Typo="Typo.body2" Class="pspad-muted">
            @T["PublisherIntro"]
        </MudText>
        <MudText Typo="Typo.overline" Class="pspad-muted">@T["LinkWorksFor"]</MudText>
        <MudToggleGroup T="int" Value="@_selectedDays" ValueChanged="@SelectDays" Color="Color.Primary"
                        Outlined="true" Disabled="@Disabled">
            @foreach (var preset in PresetDays)
            {
                <MudToggleItem T="int" Value="@preset" Text="@T.Plural(preset, "PresetDays")" Class="pspad-snapshot-preset" />
            }
            <MudToggleItem T="int" Value="0" Text="@T["PickDatePreset"]" Class="pspad-snapshot-preset-date" />
        </MudToggleGroup>

        @if (_selectedDays == 0)
        {
            <MudDatePicker Class="pspad-snapshot-date" Date="@_date" DateChanged="@DateChangedAsync"
                           MaxDate="@MaxDate" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Disabled" />
        }

        <MudButton Class="pspad-snapshot-publish" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Upload"
                   Disabled="@(Disabled || !Connectivity.IsOnline || _publishing || PlannedExpiry is null)"
                   OnClick="@PublishAsync">
            @PublishText
        </MudButton>

        @if (!Connectivity.IsOnline)
        {
            <MudText Typo="Typo.caption" Class="pspad-muted pspad-snapshot-offline">
                @T["PublishingNeedsConnection"]
            </MudText>
        }
    </MudPaper>

    @if (_unreachable)
    {
        <div class="pspad-snapshot-unreachable">
            <EmptyState Icon="@Icons.Material.Outlined.CloudOff" Message="@T["LiveLinksNeedConnection"]" />
        </div>
    }
    else if (_snapshots.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="pspad-muted">@T["NoLiveLinks"]</MudText>
    }
    else
    {
        <div>
            <MudText Typo="Typo.overline" Class="pspad-muted">@T["LiveLinksHeading", _snapshots.Count]</MudText>
            <MudPaper Outlined="true">
                @foreach (var snapshot in Newest)
                {
                    var expanded = _expanded == snapshot.Id;
                    var daysLeft = DaysLeft(snapshot);
                    <div @key="snapshot.Id" class="pa-3 pspad-snapshot">
                        <div class="d-flex align-center gap-3">
                            <div class="d-flex flex-column align-center pspad-snapshot-days">
                                <MudText Typo="Typo.h6" Color="@(daysLeft.Urgent ? Color.Warning : Color.Primary)">@daysLeft.Days</MudText>
                                <MudText Typo="Typo.caption" Class="pspad-muted">@T.Plural(daysLeft.Days, "DaysLeftCaption")</MudText>
                            </div>
                            <div class="flex-grow-1 d-flex flex-column gap-1">
                                <MudText Typo="Typo.body1">@T["PublishedOn", Local(snapshot.CreatedAt).ToString("d MMM")]</MudText>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (snapshot.Ticks > 0)
                                    {
                                        <MudChip T="string" Class="pspad-snapshot-ticks" Size="Size.Small" Variant="Variant.Text"
                                                 Color="Color.Success">@T["TicksCount", snapshot.Ticks]</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Class="pspad-snapshot-ticks" Size="Size.Small" Variant="Variant.Text">@T["NoTicksYet"]</MudChip>
                                    }
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@T.Plural(snapshot.Entries, "EntriesCount")</MudChip>
                                </div>
                            </div>
                            <MudIconButton Class="pspad-snapshot-qr-toggle" Icon="@Icons.Material.Outlined.QrCode2"
                                           Size="Size.Small" aria-label="@T["ShowQrCode"].Value" aria-expanded="@(expanded ? "true" : "false")"
                                           OnClick="@(() => ToggleExpanded(snapshot.Id))" />
                            <MudIconButton Class="pspad-snapshot-copy" Icon="@Icons.Material.Outlined.ContentCopy"
                                           Size="Size.Small" aria-label="@T["CopyLink"].Value"
                                           OnClick="@(() => CopyAsync(snapshot.Token))" />
                        </div>

                        @if (expanded)
                        {
                            var link = SnapshotLinks.For(Navigation.BaseUri, snapshot.Token);
                            <div class="d-flex gap-3 align-center mt-3">
                                <QrCode Value="@link" Size="120" Label="@T["SnapshotQrLabel"]" />
                                <div class="d-flex flex-column gap-1 flex-grow-1">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => CopyAsync(snapshot.Token))">@T["CopyLink"]</MudButton>
                                    <MudButton Class="pspad-snapshot-open" Variant="Variant.Outlined" Size="Size.Small"
                                               Href="@link" Target="_blank">@T["Open"]</MudButton>
                                    <MudButton Class="pspad-snapshot-revoke" Variant="Variant.Text" Color="Color.Error"
                                               Size="Size.Small" Disabled="@Disabled"
                                               OnClick="@(() => RevokeAsync(snapshot))">@T["Revoke"]</MudButton>
                                </div>
                            </div>
                        }
                    </div>
                    @if (snapshot.Id != Newest[^1].Id)
                    {
                        <MudDivider />
                    }
                }
            </MudPaper>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TaskList List { get; set; } = null!;

    [Parameter] public bool Disabled { get; set; }

    static readonly int[] PresetDays = [1, 7, 30];

    Guid? _listId;
    IReadOnlyList<PublishedSnapshotView> _snapshots = [];
    int _selectedDays = 7;
    Guid? _expanded;
    DateTime? _date;
    bool _publishing;
    bool _unreachable;

    IReadOnlyList<PublishedSnapshotView> Newest => [.. _snapshots.OrderByDescending(snapshot => snapshot.CreatedAt)];

    DateTimeOffset? PlannedExpiry => _selectedDays == 0
        ? _date is { } date ? EndOfLocalDay(DateOnly.FromDateTime(date)) : null
        : Clock.UtcNow.AddDays(_selectedDays);

    string PublishText => (_selectedDays, _date) switch
    {
        (0, { } date) => T["PublishUntil", date.ToString("d MMM")],
        (0, null) => T["PickADate"],
        _ => T["PublishUntil", Local(PlannedExpiry!.Value).ToString("d MMM")]
    };

    DateTime Local(DateTimeOffset moment) => TimeZoneInfo.ConvertTime(moment, LocalToday.Zone(State.TimeZone)).DateTime;

    (int Days, bool Urgent) DaysLeft(PublishedSnapshotView snapshot)
    {
        var days = SnapshotExpiry.DaysLeft(snapshot.ExpiresAt, Clock.UtcNow);
        return (days, days <= 1);
    }

    DateTime MaxDate => Clock.UtcNow.AddDays(365).DateTime;

    protected override async Task OnParametersSetAsync()
    {
        if (_listId != List.Id)
        {
            await LoadAsync();
        }
    }

    async Task LoadAsync()
    {
        _unreachable = true;
        _snapshots = [];

        if (!Connectivity.IsOnline)
        {
            return;
        }

        try
        {
            _snapshots = await Snapshots.ForListAsync(List.Id);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            return;
        }

        _listId = List.Id;
        _unreachable = false;
        _expanded = Newest.Count > 0 ? Newest[0].Id : null;
    }

    void SelectDays(int days)
    {
        if (!Disabled)
        {
            _selectedDays = days;
        }
    }

    void ToggleExpanded(Guid id) => _expanded = _expanded == id ? null : id;

    void DateChangedAsync(DateTime? date) => _date = date;

    async Task PublishAsync()
    {
        if (Disabled || !Connectivity.IsOnline || _publishing || PlannedExpiry is null)
        {
            return;
        }

        _publishing = true;
        try
        {
            await SyncTrigger.SyncNowAsync();

            var published = await TryPublishAsync(PlannedExpiry!.Value);

            if (published is null)
            {
                Snackbar.Add(T["PublishFailed"], Severity.Warning);
                return;
            }

            if (_unreachable)
            {
                await LoadAsync();
            }
            else
            {
                _snapshots = [.. _snapshots, published];
            }

            _expanded = published.Id;
            await Clipboard.CopyAsync(SnapshotLinks.For(Navigation.BaseUri, published.Token));
            Snackbar.Add(T["SnapshotPublished"], Severity.Success);
        }
        finally
        {
            _publishing = false;
        }
    }

    async Task<PublishedSnapshotView?> TryPublishAsync(DateTimeOffset expiresAt)
    {
        try
        {
            return await Snapshots.PublishAsync(List.Id, expiresAt);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            return null;
        }
    }

    DateTimeOffset EndOfLocalDay(DateOnly day) => SnapshotExpiry.EndOfLocalDay(day, LocalToday.Zone(State.TimeZone));

    async Task CopyAsync(string token)
    {
        var copied = await Clipboard.CopyAsync(SnapshotLinks.For(Navigation.BaseUri, token));
        Snackbar.Add(
            copied ? T["LinkCopied"] : T["CopyLinkFailed"],
            copied ? Severity.Success : Severity.Warning);
    }

    async Task RevokeAsync(PublishedSnapshotView snapshot)
    {
        if (Disabled)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, T["RevokeMessage"].Value },
            { dialog => dialog.ConfirmText, T["Revoke"].Value }
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(T["RevokeTitle"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (await TryRevokeAsync(snapshot.Id))
        {
            _snapshots = [.. _snapshots.Where(active => active.Id != snapshot.Id)];
            return;
        }

        Snackbar.Add(T["RevokeFailed"], Severity.Warning);
    }

    async Task<bool> TryRevokeAsync(Guid snapshotId)
    {
        try
        {
            return await Snapshots.RevokeAsync(snapshotId);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            return false;
        }
    }
}
